///|
fn swsd_case(
  in_b64 : Bytes,
  ref_b64 : Bytes,
  sw~ : Int32,
  sh~ : Int32,
  dw~ : Int32,
  dh~ : Int32,
  src_bits~ : Int32,
  dst_bits~ : Int32,
) -> Unit raise {
  let frame = match @libavutil.av_base64_decode(in_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let ref_pcm = match @libavutil.av_base64_decode(ref_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let sb = (src_bits + 7) / 8
  let cw = (sw + 1) >> 1
  let ch = (sh + 1) >> 1
  let yl = sw * sh * sb
  let cl = cw * ch * sb
  let y = frame[0:yl].to_owned()
  let u = frame[yl:yl + cl].to_owned()
  let v = frame[yl + cl:].to_owned()
  let s = @swscale.SwsPlanarScaler::new(
    src_w=sw,
    src_h=sh,
    dst_w=dw,
    dst_h=dh,
    src_bits~,
    dst_bits~,
  )
  let (dy, du, dv) = s.scale(y, u, v)
  let bytes : Array[Byte] = []
  for plane in [dy, du, dv] {
    for b in plane {
      bytes.push(b)
    }
  }
  let ours = Bytes::from_array(bytes)
  inspect(ours.length(), content=ref_pcm.length().to_string())
  let mismatches = {
    let mut m = 0
    for i in 0..<ours.length() {
      if ours[i] != ref_pcm[i] {
        m = m + 1
      }
    }
    m
  }
  inspect(mismatches, content="0")
}

///|
test "swscale d10 realdata: 10->10 upscale 40x30 -> 96x72" {
  swsd_case(
    swsd_d10up_in_b64,
    swsd_d10up_ref_b64,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    src_bits=10,
    dst_bits=10,
  )
}

///|
test "swscale d10 realdata: 10->10 downscale 64x48 -> 40x30" {
  swsd_case(
    swsd_d10down_in_b64,
    swsd_d10down_ref_b64,
    sw=64,
    sh=48,
    dw=40,
    dh=30,
    src_bits=10,
    dst_bits=10,
  )
}

///|
test "swscale d10 realdata: 10->8 depth drop 40x30 -> 96x72" {
  swsd_case(
    swsd_d10to8_in_b64,
    swsd_d10to8_ref_b64,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    src_bits=10,
    dst_bits=8,
  )
}

///|
test "swscale d10 realdata: 10->10 odd dst 50x38 -> 43x29" {
  swsd_case(
    swsd_d10odd_in_b64,
    swsd_d10odd_ref_b64,
    sw=50,
    sh=38,
    dw=43,
    dh=29,
    src_bits=10,
    dst_bits=10,
  )
}

///|
/// Unsupported depths are rejected up front.
test "swscale d10: only 8- and 10-bit depths" {
  let rejected = try {
    let _scaler = @swscale.SwsPlanarScaler::new(
      src_w=40,
      src_h=30,
      dst_w=96,
      dst_h=72,
      src_bits=12,
    )
    false
  } catch {
    @swscale.InvalidScaleConfig(_) => true
  }
  assert_true(rejected)
}
