///|
fn swsr_case(
  in_b64 : Bytes,
  ref_b64 : Bytes,
  src_fmt~ : @swscale.SwsChromaFmt,
  sw~ : Int32,
  sh~ : Int32,
  dw~ : Int32,
  dh~ : Int32,
  bgr~ : Bool,
) -> Unit raise {
  let frame = match @libavutil.av_base64_decode(in_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let ref_pcm = match @libavutil.av_base64_decode(ref_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let (chs, cvs) = match src_fmt {
    Yuv420 => (1, 1)
    Yuv422 => (1, 0)
    Yuv444 => (0, 0)
  }
  let cw = (sw + (1 << chs) - 1) >> chs
  let ch = (sh + (1 << cvs) - 1) >> cvs
  let y = frame[0:sw * sh].to_owned()
  let u = frame[sw * sh:sw * sh + cw * ch].to_owned()
  let v = frame[sw * sh + cw * ch:].to_owned()
  let s = @swscale.SwsRgbScaler::new(
    src_w=sw,
    src_h=sh,
    dst_w=dw,
    dst_h=dh,
    src_fmt~,
    bgr~,
  )
  let ours = s.scale(y, u, v)
  inspect(ours.length(), content=ref_pcm.length().to_string())
  let mismatches = {
    let mut m = 0
    for i in 0..<ours.length() {
      if ours[i] != ref_pcm[i] {
        m = m + 1
      }
    }
    m
  }
  inspect(mismatches, content="0")
}

///|
test "swscale rgbfmt realdata: 422->rgb24 40x30 -> 96x72 (pair template)" {
  swsr_case(
    swsr_f422rgb_up_in_b64,
    swsr_f422rgb_up_ref_b64,
    src_fmt=@swscale.Yuv422,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    bgr=false,
  )
}

///|
test "swscale rgbfmt realdata: 444->rgb24 40x30 -> 96x72 (forced full chroma)" {
  swsr_case(
    swsr_f444rgb_up_in_b64,
    swsr_f444rgb_up_ref_b64,
    src_fmt=@swscale.Yuv444,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    bgr=false,
  )
}

///|
test "swscale rgbfmt realdata: 422->rgb24 50x38 -> 43x29 (odd dst)" {
  swsr_case(
    swsr_f422rgb_odd_in_b64,
    swsr_f422rgb_odd_ref_b64,
    src_fmt=@swscale.Yuv422,
    sw=50,
    sh=38,
    dw=43,
    dh=29,
    bgr=false,
  )
}

///|
test "swscale rgbfmt realdata: 444->bgr24 50x38 -> 43x29 (odd, bgr)" {
  swsr_case(
    swsr_f444bgr_odd_in_b64,
    swsr_f444bgr_odd_ref_b64,
    src_fmt=@swscale.Yuv444,
    sw=50,
    sh=38,
    dw=43,
    dh=29,
    bgr=true,
  )
}

///|
test "swscale rgbfmt realdata: 444->rgb24 64x48 -> 40x30 (downscale)" {
  swsr_case(
    swsr_f444rgb_down_in_b64,
    swsr_f444rgb_down_ref_b64,
    src_fmt=@swscale.Yuv444,
    sw=64,
    sh=48,
    dw=40,
    dh=30,
    bgr=false,
  )
}

///|
/// The subsampling guard follows the source format (4:2:2 needs
/// an even width; 4:4:4 accepts odd everything - covered by the
/// 50x38 -> 43x29 vector above).
test "swscale rgbfmt: odd 4:2:2 source width rejected" {
  try
    @swscale.SwsRgbScaler::new(
      src_w=51,
      src_h=30,
      dst_w=43,
      dst_h=29,
      src_fmt=Yuv422,
    )
  catch {
    @swscale.InvalidScaleConfig(_) => ()
    other => fail("unexpected error: \{other.to_repr()}")
  } noraise {
    _ => fail("expected InvalidScaleConfig for odd 4:2:2 width")
  }
}
