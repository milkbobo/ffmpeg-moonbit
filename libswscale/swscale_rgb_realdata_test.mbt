///|
test "swscale realdata: 64x48 -> 40x30 rgb24" {
  sws_rgb_case(sws_rgb_down_b64, dst_w=40, dst_h=30, allowed_mismatches=0)
}

///|
test "swscale realdata: 64x48 -> 50x38 rgb24" {
  sws_rgb_case(sws_rgb_odd_b64, dst_w=50, dst_h=38, allowed_mismatches=0)
}

///|
test "swscale realdata: 64x48 -> 96x72 rgb24" {
  sws_rgb_case(sws_rgb_up_b64, dst_w=96, dst_h=72, allowed_mismatches=0)
}

///|
test "swscale realdata: 64x48 -> 43x29 rgb24 (odd dst, full chroma)" {
  sws_rgb_case(sws_rgb_oddodd_b64, dst_w=43, dst_h=29, allowed_mismatches=0)
}

///|
test "swscale realdata: 64x48 -> 43x28 rgb24 (odd width)" {
  sws_rgb_case(sws_rgb_oddeven_b64, dst_w=43, dst_h=28, allowed_mismatches=0)
}
