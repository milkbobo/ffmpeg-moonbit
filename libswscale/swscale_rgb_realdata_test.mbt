///|
/// Byte-level vectors for the scaled YUV420P -> RGB24 path
/// against the FFmpeg 9.0.2 C scalar reference (docker harness,
/// av_force_cpu_flags(0), SWS_BICUBIC).  Same SIMD dual-path note
/// as the planar scaler tests.

///|
fn sws_rgb_case(
  ref_b64 : Bytes,
  dst_w~ : Int32,
  dst_h~ : Int32,
  allowed_mismatches~ : Int32,
) -> Unit raise {
  let frame = match @libavutil.av_base64_decode(sws_in_b64_v2, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let ref = match @libavutil.av_base64_decode(ref_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let w = 64
  let h = 48
  let yl = w * h
  let cl = w / 2 * h / 2
  let y = frame[0:yl].to_owned()
  let u = frame[yl:yl + cl].to_owned()
  let v = frame[yl + cl:].to_owned()
  let s = @swscale.SwsRgbScaler::new(src_w=w, src_h=h, dst_w~, dst_h~)
  let ours = s.scale(y, u, v)
  inspect(ours.length(), content=ref.length().to_string())
  let mut m = 0
  for i in 0..<ours.length() {
    if ours[i] != ref[i] {
      m = m + 1
    }
  }
  inspect(m, content=allowed_mismatches.to_string())
}

