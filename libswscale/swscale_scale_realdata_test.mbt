///|
/// Byte-level vectors for the planar scaler against the FFmpeg
/// 9.0.2 C scalar path (`av_force_cpu_flags(0)` harness built inside
/// docker, sws_getContext(SWS_BICUBIC) + sws_scale).  The default
/// x86 SIMD build (what the CLI runs) picks filterAlign=4, whose
/// error-diffusion normalization differs by +/-1 on a handful of
/// pixels - this port follows the C scalar semantics (the port
/// target), so the C harness output is the byte-exact reference.
/// Probe material: .scratch/_sws_scale/.

///|
fn sws_vec_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
fn sws_scale_case(
  in_b64 : Bytes,
  ref_b64 : Bytes,
  dst_w~ : Int32,
  dst_h~ : Int32,
  allowed_mismatches~ : Int32,
) -> Unit raise {
  let frame = match @libavutil.av_base64_decode(in_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let ref = match @libavutil.av_base64_decode(ref_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let w = 64
  let h = 48
  let yl = w * h
  let cl = w / 2 * h / 2
  let y = frame[0:yl].to_owned()
  let u = frame[yl:yl + cl].to_owned()
  let v = frame[yl + cl:].to_owned()
  let s = @swscale.SwsPlanarScaler::new(src_w=w, src_h=h, dst_w~, dst_h~)
  let (dy, du, dv) = s.scale(y, u, v)
  let bytes : Array[Byte] = []
  for plane in [dy, du, dv] {
    for b in plane {
      bytes.push(b)
    }
  }
  let ours = Bytes::from_array(bytes)
  inspect(ours.length(), content=ref.length().to_string())
  let mismatches = {
    let mut m = 0
    for i in 0..<ours.length() {
      if ours[i] != ref[i] {
        m = m + 1
      }
    }
    m
  }
  inspect(mismatches, content=allowed_mismatches.to_string())
}

