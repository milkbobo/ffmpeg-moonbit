///|
test "swscale realdata: 64x48 -> 40x30 downscale" {
  sws_scale_case(
    sws_in_b64,
    sws_ref_down_b64,
    dst_w=40,
    dst_h=30,
    allowed_mismatches=0,
  )
}

///|
test "swscale realdata: 64x48 -> 50x38 fractional" {
  sws_scale_case(
    sws_in_b64,
    sws_ref_odd_b64,
    dst_w=50,
    dst_h=38,
    allowed_mismatches=0,
  )
}

///|
test "swscale realdata: 64x48 -> 96x72 upscale" {
  sws_scale_case(
    sws_in_b64,
    sws_ref_up_b64,
    dst_w=96,
    dst_h=72,
    allowed_mismatches=0,
  )
}
