///|
fn swsj_case(
  in_b64 : Bytes,
  ref_b64 : Bytes,
  src_fmt~ : @swscale.SwsChromaFmt,
  sw~ : Int32,
  sh~ : Int32,
  dw~ : Int32,
  dh~ : Int32,
  bgr~ : Bool,
) -> Unit raise {
  let frame = match @libavutil.av_base64_decode(in_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let ref_pcm = match @libavutil.av_base64_decode(ref_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let (chs, cvs) = match src_fmt {
    Yuv420 => (1, 1)
    Yuv422 => (1, 0)
    Yuv444 => (0, 0)
  }
  let cw = (sw + (1 << chs) - 1) >> chs
  let ch = (sh + (1 << cvs) - 1) >> cvs
  let y = frame[0:sw * sh].to_owned()
  let u = frame[sw * sh:sw * sh + cw * ch].to_owned()
  let v = frame[sw * sh + cw * ch:].to_owned()
  let s = @swscale.SwsRgbScaler::new(
    src_w=sw,
    src_h=sh,
    dst_w=dw,
    dst_h=dh,
    src_fmt~,
    bgr~,
    full_range=true,
  )
  let ours = s.scale(y, u, v)
  inspect(ours.length(), content=ref_pcm.length().to_string())
  let mismatches = {
    let mut m = 0
    for i in 0..<ours.length() {
      if ours[i] != ref_pcm[i] {
        m = m + 1
      }
    }
    m
  }
  inspect(mismatches, content="0")
}

///|
test "swscale jrgb realdata: yuvj420p->rgb24 40x30 -> 96x72 (pair, full range)" {
  swsj_case(
    swsj_fj420rgb_up_in_b64,
    swsj_fj420rgb_up_ref_b64,
    src_fmt=@swscale.Yuv420,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    bgr=false,
  )
}

///|
test "swscale jrgb realdata: yuvj420p->rgb24 50x38 -> 43x29 (full chroma, full range)" {
  swsj_case(
    swsj_fj420rgb_odd_in_b64,
    swsj_fj420rgb_odd_ref_b64,
    src_fmt=@swscale.Yuv420,
    sw=50,
    sh=38,
    dw=43,
    dh=29,
    bgr=false,
  )
}

///|
test "swscale jrgb realdata: yuvj422p->rgb24 40x30 -> 96x72 (pair, full range)" {
  swsj_case(
    swsj_fj422rgb_up_in_b64,
    swsj_fj422rgb_up_ref_b64,
    src_fmt=@swscale.Yuv422,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    bgr=false,
  )
}

///|
test "swscale jrgb realdata: yuvj444p->bgr24 50x38 -> 43x29 (444+bgr+full range)" {
  swsj_case(
    swsj_fj444bgr_odd_in_b64,
    swsj_fj444bgr_odd_ref_b64,
    src_fmt=@swscale.Yuv444,
    sw=50,
    sh=38,
    dw=43,
    dh=29,
    bgr=true,
  )
}
