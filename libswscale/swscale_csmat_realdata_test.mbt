///|
fn swsm_case(
  in_b64 : Bytes,
  ref_b64 : Bytes,
  cs~ : @swscale.SwsColorSpace,
  sw~ : Int32,
  sh~ : Int32,
  dw~ : Int32,
  dh~ : Int32,
  full_range~ : Bool,
) -> Unit raise {
  let frame = match @libavutil.av_base64_decode(in_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let ref_pcm = match @libavutil.av_base64_decode(ref_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let y = frame[0:sw * sh].to_owned()
  let u = frame[sw * sh:sw * sh + sw / 2 * (sh / 2)].to_owned()
  let v = frame[sw * sh + sw / 2 * (sh / 2):].to_owned()
  let s = @swscale.SwsRgbScaler::new(
    src_w=sw,
    src_h=sh,
    dst_w=dw,
    dst_h=dh,
    full_range~,
    colorspace=cs,
  )
  let ours = s.scale(y, u, v)
  inspect(ours.length(), content=ref_pcm.length().to_string())
  let mismatches = {
    let mut m = 0
    for i in 0..<ours.length() {
      if ours[i] != ref_pcm[i] {
        m = m + 1
      }
    }
    m
  }
  inspect(mismatches, content="0")
}

///|
test "swscale csmat realdata: fcc limited pair 40x30 -> 96x72" {
  swsm_case(
    swsm_fcc_lim_in_b64,
    swsm_fcc_lim_ref_b64,
    cs=@swscale.Fcc,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    full_range=false,
  )
}

///|
test "swscale csmat realdata: fcc full-range pair 40x30 -> 96x72" {
  swsm_case(
    swsm_fcc_ful_in_b64,
    swsm_fcc_ful_ref_b64,
    cs=@swscale.Fcc,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    full_range=true,
  )
}

