///|
fn sws_fmt_case(
  in_b64 : Bytes,
  ref_b64 : Bytes,
  src_fmt~ : @swscale.SwsChromaFmt,
  dst_fmt~ : @swscale.SwsChromaFmt,
  sw~ : Int32,
  sh~ : Int32,
  dw~ : Int32,
  dh~ : Int32,
  allowed_mismatches~ : Int32,
) -> Unit raise {
  let frame = match @libavutil.av_base64_decode(in_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let want = match @libavutil.av_base64_decode(ref_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let (chs, cvs) = match src_fmt {
    Yuv420 => (1, 1)
    Yuv422 => (1, 0)
    Yuv444 => (0, 0)
  }
  let cw = (sw + (1 << chs) - 1) >> chs
  let ch = (sh + (1 << cvs) - 1) >> cvs
  let y = frame[0:sw * sh].to_owned()
  let u = frame[sw * sh:sw * sh + cw * ch].to_owned()
  let v = frame[sw * sh + cw * ch:].to_owned()
  let s = @swscale.SwsPlanarScaler::new(
    src_w=sw,
    src_h=sh,
    dst_w=dw,
    dst_h=dh,
    src_fmt~,
    dst_fmt~,
  )
  let (dy, du, dv) = s.scale(y, u, v)
  let bytes : Array[Byte] = []
  for plane in [dy, du, dv] {
    for b in plane {
      bytes.push(b)
    }
  }
  let ours = Bytes::from_array(bytes)
  inspect(ours.length(), content=want.length().to_string())
  let mismatches = {
    let mut m = 0
    for i in 0..<ours.length() {
      if ours[i] != want[i] {
        m = m + 1
      }
    }
    m
  }
  inspect(mismatches, content=allowed_mismatches.to_string())
}

///|
test "swscale fmt realdata: 444->444 40x30 -> 96x72 upscale" {
  sws_fmt_case(
    sws_f444_up_in_b64,
    sws_f444_up_ref_b64,
    src_fmt=@swscale.Yuv444,
    dst_fmt=@swscale.Yuv444,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    allowed_mismatches=0,
  )
}

///|
test "swscale fmt realdata: 422->422 40x30 -> 96x72 upscale" {
  sws_fmt_case(
    sws_f422_up_in_b64,
    sws_f422_up_ref_b64,
    src_fmt=@swscale.Yuv422,
    dst_fmt=@swscale.Yuv422,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    allowed_mismatches=0,
  )
}

///|
test "swscale fmt realdata: 444->420 40x30 -> 96x72 (chroma decimate)" {
  sws_fmt_case(
    sws_f444420_in_b64,
    sws_f444420_ref_b64,
    src_fmt=@swscale.Yuv444,
    dst_fmt=@swscale.Yuv420,
    sw=40,
    sh=30,
    dw=96,
    dh=72,
    allowed_mismatches=0,
