test "swscale fmt realdata: 422->444 50x38 -> 43x29 (odd dst)" {
  sws_fmt_case(
    sws_f422444_odd_in_b64,
    sws_f422444_odd_ref_b64,
    src_fmt=@swscale.Yuv422,
    dst_fmt=@swscale.Yuv444,
    sw=50,
    sh=38,
    dw=43,
    dh=29,
    allowed_mismatches=0,
  )
}

///|
/// Subsampling-driven guards: odd width only rejected for the
/// formats that actually subsample it.
test "swscale fmt: odd widths accepted on the planar path" {
  // Since S344 the planar scaler follows C geometry (AV_CEIL_RSHIFT
  // chroma): odd source widths are accepted and byte-exact (see
  // swscale_odd_realdata_test.mbt).
  // 4:2:2 with odd source width: ceil chroma geometry (26x30).
  let ok0 = @swscale.SwsPlanarScaler::new(
    src_w=51,
    src_h=30,
    dst_w=40,
    dst_h=30,
    src_fmt=Yuv422,
  )
  ignore(ok0)
  // 4:2:2 with odd height is fine (no vertical subsampling).
  let ok = @swscale.SwsPlanarScaler::new(
    src_w=50,
    src_h=29,
    dst_w=40,
    dst_h=30,
    src_fmt=Yuv422,
  )
  ignore(ok)
  // 4:4:4 takes odd everything.
  let ok2 = @swscale.SwsPlanarScaler::new(
    src_w=51,
    src_h=29,
    dst_w=43,
    dst_h=29,
    src_fmt=Yuv444,
    dst_fmt=Yuv444,
  )
  ignore(ok2)
}
