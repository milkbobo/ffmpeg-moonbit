///|
/// Real H.264 B-frame + AAC MPEG-TS remuxed through `TsMuxer`: video PES
/// keeps PTS+DTS, audio PES keeps its PTS/payload, and the decoded frames
/// match the source.

///|
let ts_av_bframes_src_b64 : Bytes = b""

///|
fn ts_av_bframes_md5(yuv : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, yuv, yuv.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
fn ts_av_bframes_decode(payloads : Array[Bytes]) -> Array[String] raise {
  let all : Array[Byte] = []
  for p in payloads {
    for b in p {
      all.push(b)
    }
  }
  let dec = @libavcodec.new_h264_decoder()
  let frames = match dec.decode_annexb(Bytes::from_array(all), false) {
    Ok(v) => @libavcodec.h264_display_order(v)
    Err(e) => fail("h264 decode: \{e}")
  }
  let md5s : Array[String] = []
  for frame in frames {
    md5s.push(ts_av_bframes_md5(frame.yuvp()))
  }
  md5s
}

///|
test "ts muxer: B-frame video + AAC remux" {
  let src = @libavutil.av_base64_decode(ts_av_bframes_src_b64, 100000).unwrap()
  let demux = av_mpegts_open(src).unwrap()
  assert_eq(demux.streams.length(), 2)
  let mut video_count = 0
  let mut audio_count = 0
  let mut reordered = false
  let src_video : Array[Bytes] = []
  for packet in demux.packets {
    if packet.pid == 0x100 {
      video_count = video_count + 1
      src_video.push(packet.payload)
      if packet.pts != packet.dts {
        reordered = true
      }
    } else if packet.pid == 0x101 {
      audio_count = audio_count + 1
    }
  }
  assert_eq(video_count, 5)
  assert_true(audio_count > 0)
  assert_true(reordered, msg="fixture must contain B-frames")
  let mux = ts_muxer_new()
  for packet in demux.packets {
    if packet.pid == 0x100 {
      mux.write_video(packet.pts, packet.payload, dts=packet.dts)
    } else if packet.pid == 0x101 {
      mux.write_audio(packet.pts, packet.payload)
    }
  }
  let remux = av_mpegts_open(mux.finish()).unwrap()
  assert_eq(remux.packets.length(), demux.packets.length())
  // PES completion order can differ from file order; compare per PID.
  let out_video : Array[Bytes] = []
  for pid in [0x100, 0x101] {
    let src_pids = demux.packets.filter(p => p.pid == pid)
    let out_pids = remux.packets.filter(p => p.pid == pid)
    assert_eq(out_pids.length(), src_pids.length(), msg="pid count \{pid}")
    for i in 0..<src_pids.length() {
      let a = src_pids[i]
      let b = out_pids[i]
      assert_eq(b.pts, a.pts, msg="pts \{pid}/\{i}")
      assert_eq(b.dts, a.dts, msg="dts \{pid}/\{i}")
      assert_eq(b.payload, a.payload, msg="payload \{pid}/\{i}")
      if pid == 0x100 {
        out_video.push(b.payload)
      }
    }
  }
  let src_md5 = ts_av_bframes_decode(src_video)
  let out_md5 = ts_av_bframes_decode(out_video)
  assert_eq(out_md5.length(), src_md5.length())
  for i in 0..<src_md5.length() {
    assert_eq(out_md5[i], src_md5[i], msg="frame \{i}")
  }
}
