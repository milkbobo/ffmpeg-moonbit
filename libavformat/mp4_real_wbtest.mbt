///|
/// Real-file cross-validation against FFmpeg 9.0.2 itself.
///
/// `sample.mp4` was produced by the `linuxserver/ffmpeg:9.0.2` image:
///
///   ffmpeg -f lavfi -i testsrc=size=64x64:rate=5 -t 1 -c:v mpeg4 -g 5 \
///          -qscale:v 12 -an sample.mp4
///
/// and the expected per-packet values below are that same file's `ffprobe`
/// output (`-show_entries packet=pts,dts,duration,pos,size,flags`), i.e. the
/// reference demuxer's own result rather than hand-derived numbers. To
/// regenerate: run the above, then base64 the file into `real_mp4_b64` and copy
/// the ffprobe rows into `real_mp4_expected`.

///| base64 of the reference `sample.mp4` (2155 bytes). */
let real_mp4_b64 : Bytes = b""

///| `(pos, size, dts, duration, keyframe)` per packet, from ffprobe. */
let real_mp4_expected : Array[(Int64, UInt, Int64, UInt, Bool)] = [
  (44, 790, 0, 2048, true),
  (834, 97, 2048, 2048, false),
  (931, 132, 4096, 2048, false),
  (1063, 123, 6144, 2048, false),
  (1186, 98, 8192, 2048, false),
]

///|
/// Parse the real MP4 and check every sample against ffprobe: offsets, sizes,
/// DTS/PTS, durations and keyframe flags must all agree.
test "mp4: real ffmpeg output cross-check (ffprobe packets)" {
  let bytes = @libavutil.av_base64_decode(real_mp4_b64, 100000).unwrap()
  let movie = av_mov_open(bytes).unwrap()
  let t = movie.tracks[0]
  assert_eq(t.timescale, 10240)
  assert_eq(t.codec, "mp4v")
  assert_eq(t.width, 64)
  assert_eq(t.height, 64)
  assert_eq(t.samples.length(), 5)
  for i = 0; i < 5; i = i + 1 {
    let (pos, size, dts, duration, keyframe) = real_mp4_expected[i]
    assert_eq(t.samples[i].offset, pos)
    assert_eq(t.samples[i].size, size)
    assert_eq(t.samples[i].dts, dts)
    assert_eq(t.samples[i].pts, dts)
    assert_eq(t.samples[i].duration, duration)
    assert_eq(t.samples[i].keyframe, keyframe)
  }
}

///| base64 of a fragmented reference MP4 (`-movflags frag_keyframe+empty_moov+default_base_moof`). */
let real_frag_b64 : Bytes = b""

///| `(pos, size, dts, duration, keyframe)` per packet from ffprobe of the fragmented file. */
let real_frag_expected : Array[(Int64, UInt, Int64, UInt, Bool)] = [
  (971, 790, 0, 2048, true),
  (1761, 97, 2048, 2048, false),
  (1858, 132, 4096, 2048, false),
  (1990, 123, 6144, 2048, false),
  (2113, 98, 8192, 2048, false),
]

///|
/// Fragmented MP4 cross-check: `moof`/`traf`/`tfhd`/`tfdt`/`trun` must yield the
/// same packets ffprobe reports for a real `frag_keyframe` output.
test "mp4: real fragmented ffmpeg output cross-check" {
  let bytes = @libavutil.av_base64_decode(real_frag_b64, 100000).unwrap()
  let movie = av_mov_open(bytes).unwrap()
  let t = movie.tracks[0]
  assert_eq(t.timescale, 10240)
  assert_eq(t.samples.length(), 5)
  for i = 0; i < 5; i = i + 1 {
    let (pos, size, dts, duration, keyframe) = real_frag_expected[i]
    assert_eq(t.samples[i].offset, pos)
    assert_eq(t.samples[i].size, size)
    assert_eq(t.samples[i].dts, dts)
    assert_eq(t.samples[i].pts, dts)
    assert_eq(t.samples[i].duration, duration)
    assert_eq(t.samples[i].keyframe, keyframe)
  }
}

///|
/// base64 of a real cenc (AES-CTR) reference file: `sample.mp4`'s content muxed
/// with `-encryption_scheme cenc-aes-ctr -encryption_key 000102…0f`.
let real_enc_b64 : Bytes = b""

///|
/// Real cenc cross-check: decrypting `enc.mp4` with the known key must reproduce
/// the plaintext samples of `sample.mp4` (ffprobe reports the same packet layout
/// for both, and mp4 cenc-aes-ctr preserves sample sizes).
test "mp4: real cenc (AES-CTR) decryption reproduces plaintext" {
  let plain_bytes = @libavutil.av_base64_decode(real_mp4_b64, 100000).unwrap()
  let enc_bytes = @libavutil.av_base64_decode(real_enc_b64, 100000).unwrap()
  let key = Bytes::from_array([
    b'\x00', b'\x01', b'\x02', b'\x03', b'\x04', b'\x05', b'\x06', b'\x07',
    b'\x08', b'\x09', b'\x0a', b'\x0b', b'\x0c', b'\x0d', b'\x0e', b'\x0f',
  ])
  let tm = av_mov_open(enc_bytes).unwrap().tracks[0]
  let tp = av_mov_open(plain_bytes).unwrap().tracks[0]
  assert_eq(tm.cenc_scheme, 0x63656E63)
  assert_eq(tm.samples.length(), 5)
  assert_eq(tp.samples.length(), 5)

  let enc_arr = enc_bytes.to_array()
  let plain_arr = plain_bytes.to_array()
  for i = 0; i < 5; i = i + 1 {
    let m = tm.samples[i]
    let p = tp.samples[i]
    assert_eq(m.offset, p.offset)
    assert_eq(m.size, p.size)
    let start = m.offset.to_int()
    let end = (m.offset + m.size.to_int64()).to_int()
    let enc_payload = Bytes::from_array(enc_arr[start:end])
    let plain_payload = Bytes::from_array(plain_arr[start:end])
    let dec = mov_decrypt_sample(tm, i, key, enc_payload).unwrap()
    assert_eq(dec, plain_payload)
  }
}

// ---------------------------------------------------------------------------
// Second-slice real files: AAC esds, PCM chunk demuxing, sidx/mfra fragments
// ---------------------------------------------------------------------------

///|
/// `aac.mp4` (3685 bytes), produced by the `linuxserver/ffmpeg:9.0.2` image:
///
///   ffmpeg -f lavfi -i sine=frequency=440:sample_rate=44100 -t 0.3 ///          -c:a aac -b:a 64k aac.mp4
///
/// ffprobe reports: aac (LC), 44100 Hz, mono. The esds DecoderSpecificInfo is
/// `12 08 56 e5 00` (AAC-LC + implicit-SBR sync extension with the SBR flag
/// 0), and the elst media_time 1024 shifts the first packet to pts -1024.
let real_aac_b64 : Bytes = b""

test "mp4: real AAC file, esds extradata and edit-list shift (ffprobe packets)" {
  let bytes = @libavutil.av_base64_decode(real_aac_b64, 100000).unwrap()
  let movie = av_mov_open(bytes).unwrap()
  let t = movie.tracks[0]
  assert_eq(t.timescale, 44100)
  assert_eq(t.codec, "mp4a")
  assert_eq(t.codec_id, "aac")
  assert_eq(t.channels, 1)
  assert_eq(t.sample_rate, 44100)
  assert_eq(t.frame_length, 1024)
  assert_eq(t.bit_rate, 69376)
  let ed = t.extradata.unwrap()
  assert_eq(ed.length(), 5)
  assert_eq(ed[0], 0x12)
  assert_eq(ed[1], 0x08)
  assert_eq(ed[2], 0x56)
  assert_eq(ed[3], 0xE5)
  assert_eq(ed[4], 0x00)
  // ffprobe packet=pts,dts,duration,pos,size: 14 packets, the first at
  // pts/dts -1024 (edit list media_time 1024), the last one short (942).
  let expected : Array[(Int64, Int64, UInt, Int64, UInt)] = [
    (-1024, -1024, 1024, 44, 278),
    (0, 0, 1024, 322, 278),
    (1024, 1024, 1024, 600, 174),
    (2048, 2048, 1024, 774, 156),
    (3072, 3072, 1024, 930, 215),
    (4096, 4096, 1024, 1145, 223),
    (5120, 5120, 1024, 1368, 170),
    (6144, 6144, 1024, 1538, 143),
    (7168, 7168, 1024, 1681, 216),
    (8192, 8192, 1024, 1897, 196),
    (9216, 9216, 1024, 2093, 168),
    (10240, 10240, 1024, 2261, 201),
    (11264, 11264, 1024, 2462, 201),
    (12288, 12288, 942, 2663, 184),
  ]
  assert_eq(t.samples.length(), expected.length())
  // The advanced edit-list path marks the pre-media_time frame
  // AVINDEX_DISCARD_FRAME (kept for the decoder delay, dropped after
  // decode) and reports its 1024-sample encoder delay as skip_samples.
  assert_eq(t.skip_samples, 1024)
  for i = 0; i < expected.length(); i = i + 1 {
    let (pts, dts, dur, pos, size) = expected[i]
    assert_eq(t.samples[i].offset, pos)
    assert_eq(t.samples[i].size, size)
    assert_eq(t.samples[i].dts, dts)
    assert_eq(t.samples[i].pts, pts)
    assert_eq(t.samples[i].duration, dur)
    assert_eq(t.samples[i].keyframe, true)
    assert_eq(t.samples[i].discard, i == 0)
  }
}

///|
/// `pcm_short.mov` (13915 bytes):
///
///   ffmpeg -f lavfi -i sine=frequency=440:sample_rate=44100 -t 0.15 ///          -c:a pcm_s16le pcm_short.mov
///
/// ffprobe: pcm_s16le (sowt), 44100 Hz, mono, 44100-sample track; packets of
/// 1024 samples (2048 bytes) through the chunked audio index path, the last
/// one 471 samples.
let real_pcm_b64 : Bytes = b""

test "mp4: real PCM MOV, chunked audio index (ffprobe packets)" {
  let bytes = @libavutil.av_base64_decode(real_pcm_b64, 100000).unwrap()
  let movie = av_mov_open(bytes).unwrap()
  let t = movie.tracks[0]
  assert_eq(t.timescale, 44100)
  assert_eq(t.codec, "sowt")
  assert_eq(t.codec_id, "")
  assert_eq(t.channels, 1)
  assert_eq(t.sample_rate, 44100)
  assert_eq(t.bits_per_sample, 16)
  assert_eq(t.sample_size, 2)
  assert_eq(t.extradata is Some(_), false)
  // The chunked "old uncompressed audio" path is taken.
  assert_eq(t.unsupported_audio_chunk_demux, true)
  let expected : Array[(Int64, UInt, Int64, UInt)] = [
    (36, 2048, 0, 1024),
    (2084, 2048, 1024, 1024),
    (4132, 2048, 2048, 1024),
    (6180, 2048, 3072, 1024),
    (8228, 2048, 4096, 1024),
    (10276, 2048, 5120, 1024),
    (12324, 942, 6144, 471),
  ]
  assert_eq(t.samples.length(), expected.length())
  for i = 0; i < expected.length(); i = i + 1 {
    let (pos, size, dts, dur) = expected[i]
    assert_eq(t.samples[i].offset, pos)
    assert_eq(t.samples[i].size, size)
    assert_eq(t.samples[i].dts, dts)
    assert_eq(t.samples[i].pts, dts)
    assert_eq(t.samples[i].duration, dur)
    assert_eq(t.samples[i].keyframe, true)
  }
}

///|
/// `sidx.mp4` (3673 bytes), fragmented with per-subsegment sidx and an mfra:
///
///   ffmpeg -f lavfi -i testsrc=size=64x64:rate=5 -t 2 -c:v mpeg4 -g 5 ///          -qscale:v 12 -an -movflags +frag_keyframe+dash sidx.mp4
///
/// Layout (from the box walk): sidx@839 (refs: offset 891 size 1372 dur
/// 10240; offset 2315 size 1272), moof@891, moof@2315, mfra@3587 with a tfra
/// of entries (0, 891) and (10240, 2315); ffprobe packets follow the two
/// fragments.
let real_sidx_b64 : Bytes = b""

test "mp4: real fragmented file with sidx and mfra (ffprobe packets)" {
  let bytes = @libavutil.av_base64_decode(real_sidx_b64, 100000).unwrap()
  let movie = av_mov_open(bytes).unwrap()
  let t = movie.tracks[0]
  assert_eq(t.timescale, 10240)
  assert_eq(t.codec, "mp4v")
  assert_eq(t.has_sidx, true)
  // sidx references point at the two moofs and accumulate the duration.
  assert_eq(movie.sidx_refs.length(), 2)
  assert_eq(movie.sidx_refs[0].offset, 891)
  assert_eq(movie.sidx_refs[0].pts, 0)
  assert_eq(movie.sidx_refs[0].size, 1372)
  assert_eq(movie.sidx_refs[1].offset, 2315)
  assert_eq(movie.sidx_refs[1].pts, 10240)
  assert_eq(movie.sidx_refs[1].size, 1272)
  assert_eq(t.duration, 20480)
  // The mfra trailer carries the random-access table.
  assert_eq(movie.mfra.length(), 1)
  assert_eq(movie.mfra[0].track_id, 1)
  assert_eq(movie.mfra[0].entries.length(), 2)
  assert_eq(movie.mfra[0].entries[0].time, 0)
  assert_eq(movie.mfra[0].entries[0].offset, 891)
  assert_eq(movie.mfra[0].entries[1].time, 10240)
  assert_eq(movie.mfra[0].entries[1].offset, 2315)
  // ffprobe packet=pts,dts,duration,pos,size across both fragments.
  let expected : Array[(Int64, Int64, UInt, Int64, UInt, Bool)] = [
    (0, 0, 2048, 1023, 790, true),
    (2048, 2048, 2048, 1813, 97, false),
    (4096, 4096, 2048, 1910, 132, false),
    (6144, 6144, 2048, 2042, 123, false),
    (8192, 8192, 2048, 2165, 98, false),
    (10240, 10240, 2048, 2447, 794, true),
    (12288, 12288, 2048, 3241, 72, false),
    (14336, 14336, 2048, 3313, 93, false),
    (16384, 16384, 2048, 3406, 97, false),
    (18432, 18432, 2048, 3503, 84, false),
  ]
  assert_eq(t.samples.length(), expected.length())
  for i = 0; i < expected.length(); i = i + 1 {
    let (pts, dts, dur, pos, size, keyframe) = expected[i]
    assert_eq(t.samples[i].offset, pos)
    assert_eq(t.samples[i].size, size)
    assert_eq(t.samples[i].dts, dts)
    assert_eq(t.samples[i].pts, pts)
    assert_eq(t.samples[i].duration, dur)
    assert_eq(t.samples[i].keyframe, keyframe)
    assert_eq(t.samples[i].discard, false)
  }
  // Seeking into the second fragment lands on its keyframe.
  let seek = mov_seek_track(t, 12000, avseek_flag_backward).unwrap()
  assert_eq(seek.0, 5)
  let seek2 = mov_seek_track(t, 5000, avseek_flag_backward).unwrap()
  assert_eq(seek2.0, 0)
}
