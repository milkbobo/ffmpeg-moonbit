///|
/// First 20 packets of each FATE SIPR stream, with s16le output from
/// FFmpeg 9.0.2. Decode from packet zero to preserve the predictor history.
fn check_sipr_reference(
  packet_size : Int,
  packets_b64 : Bytes,
  pcm_b64 : Bytes,
) -> Unit raise {
  let packets = @libavutil.av_base64_decode(packets_b64, 1000).unwrap()
  let pcm = @libavutil.av_base64_decode(pcm_b64, 20000).unwrap()
  let decoder = @libavcodec.SiprDecoder::new(packet_size)
  let samples = decoder.samples_per_packet()
  assert_eq(pcm.length(), 20 * samples * 2)
  let mut max_error = 0
  let mut max_pos = 0
  for i = 0; i < 20; i = i + 1 {
    let offset = i * packet_size
    let decoded = decoder.decode_packet(packets[offset:offset + packet_size].to_owned()).unwrap()
    assert_eq(decoded.length(), samples)
    for j, sample in decoded {
      let pos = i * samples + j
      let k = pos * 2
      let reference = ((pcm[k].to_int() | (pcm[k + 1].to_int() << 8)) << 16) >> 16
      let actual = (sample * 32768.0).round().clamp(min=-32768.0, max=32767.0).to_int()
      let error = (actual - reference).abs()
      if error > max_error {
        max_error = error
        max_pos = pos
      }
    }
  }
  if max_error > 1 {
    fail("maximum PCM error \{max_error} at sample \{max_pos}")
  }
}

///|
test "SIPR 5k0 FATE stream" {
  check_sipr_reference(
    37,
    b"",
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"/wYALABCADsAQQA3AC8ALAAWABsAbf9u/5L/Jv8v/z//Tv+B/9r/JgAFABsARgD9ABsBBwEUAdUApgBsAFQALQAOAO//wv+w/53/",
  )
}

///|
test "SIPR 6k5 FATE stream" {
  check_sipr_reference(
    29,
    b"",
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"",
  )
}

///|
test "SIPR 8k5 FATE stream" {
  check_sipr_reference(
    19,
    b"",
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"+27+X//X+7sBe/t2+z7+Pfxq/hH/7v8GAhgDXf7G/1AAgv19/qT8fP5BBOgBnQDWAED/VgBOAHH+OwAfAXT/HgD1/c37U/89/BcN8xE8BkoIu/+RBJkFY/pP++H8ifuB/2D/ofkJAKb/Gv1VAJH5ufs+/lz8D/1u/oMA0QKVAtv9ugAiAZH9",
  )
}

///|
test "SIPR 16k FATE stream" {
  check_sipr_reference(
    20,
    b"",
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"",
  )
}
