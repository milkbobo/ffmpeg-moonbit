///|
/// Real-data ASF/WMA demuxer tests.  The files are FFmpeg 9.0.2 `wmav2`
/// encodes inside ASF (`ffmpeg -f lavfi -i <tone> -c:a wmav2 -f asf`), with
/// FFmpeg's own decode as the PCM reference.  `av_asf_open` reads File/Stream
/// Properties and assembles Data Object payload fragments into one packet per
/// WMA frame; decoding those packets (with FFmpeg's two-frame delay and EOF
/// flush semantics) matches the reference within one s16 LSB.

///|
fn asf_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let asf_mono44h_b64 : Bytes = asf_concat([
  b"",
])

///|
let asf_mono44h_ref_b64 : Bytes = asf_concat([
  b"",
  b"",
  b"",
])

///|
let asf_stereo44_b64 : Bytes = asf_concat([
  b"",
])

///|
let asf_stereo44_ref_b64 : Bytes = asf_concat([
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
])

///|
fn asf_decode_file(b64 : Bytes) -> Bytes {
  return @libavutil.av_base64_decode(b64, 1000000).unwrap()
}

///|
fn asf_decode_wma(
  track : AsfTrack,
  packets : Array[AsfPacket],
) -> Array[Array[Int32]] {
  let version = if track.codec == "wmav1" { 1 } else { 2 }
  let flags2 = if version == 1 {
    track.extradata[2].to_int() | (track.extradata[3].to_int() << 8)
  } else {
    track.extradata[4].to_int() | (track.extradata[5].to_int() << 8)
  }
  let dec = @libavcodec.wma_decoder_new(
    version,
    track.sample_rate,
    track.channels,
    track.bit_rate,
    track.block_align,
    flags2,
  ).unwrap()
  let frames : Array[Array[Array[Double]]] = []
  for pkt in packets {
    if pkt.stream_index == 0 {
      frames.push(dec.decode_packet(pkt.data).unwrap())
    }
  }
  frames.push(dec.decode_flush().unwrap())
  let pcm : Array[Array[Int32]] = []
  for _c = 0; _c < track.channels; _c = _c + 1 {
    pcm.push([])
  }
  for fi = 2; fi < frames.length(); fi = fi + 1 {
    for c = 0; c < track.channels; c = c + 1 {
      for v in frames[fi][c] {
        let q = if v >= 1.0 {
          32767
        } else if v <= -1.0 {
          -32768
        } else {
          (v * 32768.0).round().to_int()
        }
        pcm[c].push(q)
      }
    }
  }
  pcm
}

///|
fn asf_check_pcm(
  pcm : Array[Array[Int32]],
  reference : Bytes,
  name : String,
) -> Unit raise {
  assert_eq(reference.length(), pcm[0].length() * pcm.length() * 2, msg=name)
  let mut max_diff = 0
  for c = 0; c < pcm.length(); c = c + 1 {
    for i = 0; i < pcm[c].length(); i = i + 1 {
      let idx = (i * pcm.length() + c) * 2
      let raw = reference[idx].to_int() | (reference[idx + 1].to_int() << 8)
      let want = if raw >= 32768 { raw - 65536 } else { raw }
      let d = if pcm[c][i] > want { pcm[c][i] - want } else { want - pcm[c][i] }
      if d > max_diff {
        max_diff = d
      }
    }
  }
  assert_true(max_diff <= 1, msg="\{name}: max diff \{max_diff}")
}

///|
test "ASF demuxer: WMA stream properties and packet assembly" {
  let data = asf_decode_file(asf_mono44h_b64)
  let asf = av_asf_open(data).unwrap()
  assert_eq(asf.packet_size, 3200)
  assert_eq(asf.preroll, 3100)
  assert_eq(asf.tracks.length(), 1)
  let t = asf.tracks[0]
  assert_eq(t.stream_number, 1)
  assert_eq(t.codec, "wmav2")
  assert_eq(t.sample_rate, 44100)
  assert_eq(t.channels, 1)
  assert_eq(t.bit_rate, 96000)
  assert_eq(t.block_align, 557)
  assert_eq(t.extradata.length(), 10)
  assert_eq(asf.packets.length(), 6)
  let pts : Array[Int64] = [0L, 46L, 92L, 139L, 185L, 232L]
  for i, pkt in asf.packets {
    assert_eq(pkt.stream_index, 0)
    assert_eq(pkt.data.length(), 557)
    assert_eq(pkt.pts, pts[i])
  }
}

///|
test "ASF demuxer: WMA mono/stereo decode matches FFmpeg PCM" {
  let mono = av_asf_open(asf_decode_file(asf_mono44h_b64)).unwrap()
  let mono_pcm = asf_decode_wma(mono.tracks[0], mono.packets)
  asf_check_pcm(mono_pcm, asf_decode_file(asf_mono44h_ref_b64), "mono44h")
  let stereo = av_asf_open(asf_decode_file(asf_stereo44_b64)).unwrap()
  assert_eq(stereo.tracks[0].channels, 2)
  let stereo_pcm = asf_decode_wma(stereo.tracks[0], stereo.packets)
  asf_check_pcm(stereo_pcm, asf_decode_file(asf_stereo44_ref_b64), "stereo44")
}

///|
test "ASF demuxer: rejects non-ASF input" {
  match av_asf_open(b"not an asf file at all") {
    Ok(_) => fail("non-ASF data must be rejected")
    Err(_) => ()
  }
}
