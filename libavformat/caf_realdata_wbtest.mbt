///|
/// Real CAF fixtures written by ffmpeg 9.0.2: ALAC (stereo/mono, old-style
/// `frma`+`alac` cookie and `pakt` variable packet sizes) and big-endian
/// LPCM (16/24-bit). References are FFmpeg decodes to s16le/s32le.

///|
let caf_fixtures : Array[
  (String, Bytes, String, Int32, Int32, Int32, Int32, String),
] = [
  // alac_stereo
  (
    "alac_stereo", b"",
    "alac", 2, 16, 44100, 22050, "38fb308079b63baf40e49bd051d22bc8",
  ),
  // alac_mono
  (
    "alac_mono", b"",
    "alac", 1, 16, 44100, 22050, "509cc1b01befed5df86a6e9b786706b2",
  ),
  // lpcm16_stereo
  (
    "lpcm16_stereo", b"",
    "pcm_s16le", 2, 16, 8000, 8000, "c35b7be85585417ff968a890e9d85a8d",
  ),
  // lpcm16_mono
  (
    "lpcm16_mono", b"",
    "pcm_s16be", 1, 16, 8000, 8000, "998ae6d7b6361fe5caadfb0a41c9e018",
  ),
  // lpcm24_stereo
  (
    "lpcm24_stereo",
    b"" +
    b"" +
    b"",
    "pcm_s24be",
    2,
    24,
    8000,
    20000,
    "322c025b332b30e4de9ab0a987169cea",
  ),
]

///|
fn caf_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
/// Convert big-endian LPCM packets to the reference layout (s16le, or
/// left-justified s32le for 24-bit).
fn caf_pcm_reference(demux : CafDemux, data : Bytes) -> Bytes {
  let bits = demux.format.bits
  let bytes = bits / 8
  let little = demux.format.codec.has_suffix("le")
  let out : Array[Byte] = []
  for packet in demux.packets {
    let start = packet.pos.to_int()
    let end = start + packet.size
    let mut off = start
    while off + bytes <= end {
      let mut v : UInt32 = 0
      for i = 0; i < bytes; i = i + 1 {
        if little {
          v = v | (data[off + i].to_uint() << (8 * i))
        } else {
          v = (v << 8) | data[off + i].to_uint()
        }
      }
      off = off + bytes
      if bits == 16 {
        let sv = v.reinterpret_as_int() << 16 >> 16
        out.push((sv & 0xFF).to_byte())
        out.push(((sv >> 8) & 0xFF).to_byte())
      } else {
        let wide = (v << 8).reinterpret_as_int()
        out.push((wide & 0xFF).to_byte())
        out.push(((wide >> 8) & 0xFF).to_byte())
        out.push(((wide >> 16) & 0xFF).to_byte())
        out.push(((wide >> 24) & 0xFF).to_byte())
      }
    }
  }
  Bytes::from_array(out)
}

///|
fn caf_alac_pcm(demux : CafDemux, data : Bytes) -> Result[Bytes, String] {
  let dec = match @libavcodec.alac_decoder_new(demux.extradata) {
    Ok(v) => v
    Err(e) => return Err(e)
  }
  let pcm : Array[Byte] = []
  for packet in demux.packets {
    let start = packet.pos.to_int()
    let bytes = data[start:start + packet.size].to_owned()
    let frame = match dec.decode_frame(bytes) {
      Ok(v) => v
      Err(e) => return Err(e)
    }
    for b in frame.pcm_bytes() {
      pcm.push(b)
    }
  }
  Ok(Bytes::from_array(pcm))
}

///|
test "caf: ffmpeg ALAC/LPCM fixtures decode like the references" {
  for fixture in caf_fixtures {
    let (name, b64, codec, channels, bits, rate, count, want_md5) = fixture
    let data = @libavutil.av_base64_decode(b64, 400000).unwrap()
    let demux = match av_caf_open(data) {
      Ok(v) => v
      Err(e) => fail("\{name}: open failed: \{e}")
    }
    assert_eq(demux.format.codec, codec, msg=name)
    assert_eq(demux.format.channels, channels, msg=name)
    assert_eq(demux.format.bits, bits, msg=name)
    assert_eq(demux.format.sample_rate, rate, msg=name)
    assert_eq(demux.sample_count, count.to_int64(), msg=name)
    if codec == "alac" {
      let pcm = match caf_alac_pcm(demux, data) {
        Ok(v) => v
        Err(e) => fail("\{name}: ALAC decode failed: \{e}")
      }
      assert_eq(caf_md5(pcm), want_md5, msg=name)
      let mux = caf_alac_muxer_new(demux.extradata).unwrap()
      for packet in demux.packets {
        let start = packet.pos.to_int()
        mux
        .write_packet(
          data[start:start + packet.size].to_owned(),
          duration=packet.duration,
        )
        .unwrap()
      }
      let out = mux.finish()
      let demux2 = match av_caf_open(out) {
        Ok(v) => v
        Err(e) => fail("\{name}: remuxed open failed: \{e}")
      }
      assert_eq(demux2.format.codec, "alac", msg=name)
      assert_eq(demux2.sample_count, count.to_int64(), msg=name)
      let pcm2 = match caf_alac_pcm(demux2, out) {
        Ok(v) => v
        Err(e) => fail("\{name}: remuxed ALAC decode failed: \{e}")
      }
      assert_eq(caf_md5(pcm2), want_md5, msg=name)
    } else {
      let pcm = caf_pcm_reference(demux, data)
      assert_eq(caf_md5(pcm), want_md5, msg=name)
      let samples : Array[Int32] = []
      let bytes = bits / 8
      let little = codec.has_suffix("le")
      for packet in demux.packets {
        let start = packet.pos.to_int()
        let end = start + packet.size
        let mut off = start
        while off + bytes <= end {
          let mut v : UInt32 = 0
          for i = 0; i < bytes; i = i + 1 {
            if little {
              v = v | (data[off + i].to_uint() << (8 * i))
            } else {
              v = (v << 8) | data[off + i].to_uint()
            }
          }
          off = off + bytes
          let sv = v.reinterpret_as_int() << (32 - bits) >> (32 - bits)
          samples.push(sv)
        }
      }
      let mux = caf_lpcm_muxer_new(rate, channels, bits~, big_endian=!little).unwrap()
      mux.write_samples(samples)
      let out = mux.finish()
      let demux2 = match av_caf_open(out) {
        Ok(v) => v
        Err(e) => fail("\{name}: LPCM remuxed open failed: \{e}")
      }
      assert_eq(demux2.format.codec, codec, msg=name)
      assert_eq(demux2.sample_count, count.to_int64(), msg=name)
      assert_eq(caf_md5(caf_pcm_reference(demux2, out)), want_md5, msg=name)
    }
  }
}

///|
test "caf: rejects malformed files" {
  assert_true(av_caf_open(b"caff") is Err(_))
  assert_true(av_caf_open(b"RIFF\x00\x00\x00\x00WAVE") is Err(_))
}
