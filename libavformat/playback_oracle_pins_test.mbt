///|
test "playback pins: MPEG-TS walk is FFmpeg's packet order" {
  let data = @libavutil.av_base64_decode(pins_av_ts_b64, 1 << 20).unwrap()
  let mf = @libavformat.MediaFile::open(data)
  let rows : Array[String] = []
  while true {
    let p = match mf.next_packet() {
      Some(v) => v
      None => break
    }
    rows.push(
      "\{p.stream_index}:\{p.data.length()}@\{p.pts}\{if p.keyframe { "K" } else { "" }}",
    )
  }
  inspect(
    rows.length(),
    content=(
      #|23
    ),
  )
  inspect(
    rows.join(" "),
    content=(
      #|0:1250@128090K 0:28@137090 1:285@126000K 1:285@128090K 1:181@130179K 1:163@132269K 1:222@134359K 1:230@136449K 1:177@138539K 1:150@140628K 1:223@142718K 1:203@144808K 1:175@146898K 1:208@148988K 1:220@151077K 1:165@153167K 1:204@155257K 1:173@157347K 1:180@159436K 1:240@161526K 1:12@163616K 0:65@146090 0:68@155090
    ),
  )
}

///|
test "playback pins: MP4 AAC decode trims like decode.c" {
  let data = @libavutil.av_base64_decode(pins_aac_m4a_b64, 1 << 20).unwrap()
  let audio = @libavformat.decode_audio_file(data)
  // 0.3 s at 44.1 kHz: the 1024-sample priming packet is discarded (and
  // consumes skip_samples), the tail discard padding cuts the last frame.
  inspect(audio.samples()[0].length(), content="13230")
}

///|
test "playback pins: fMP4 AAC decode applies skip_samples" {
  let data = @libavutil.av_base64_decode(pins_fmp4_seg_b64, 1 << 20).unwrap()
  let audio = @libavformat.decode_audio_file(data)
  inspect(audio.samples()[0].length(), content="12288")
}

///|
test "playback pins: MPEG-TS AAC decode length" {
  let data = @libavutil.av_base64_decode(pins_av_ts_b64, 1 << 20).unwrap()
  let audio = @libavformat.decode_audio_file(data)
  inspect(
    audio.samples()[0].length(),
    content=(
      #|19456
    ),
  )
}

// ---- §332: WAV parser framing (verified against the ffref oracle) ----------

///|
test "playback pins: MP3-in-WAV reframes per MPEG frame with CBR pts" {
  let data = @libavutil.av_base64_decode(pins_mp3_wav_b64, 1 << 20).unwrap()
  let mf = @libavformat.MediaFile::open(data)
  let rows : Array[String] = []
  while true {
    let p = match mf.next_packet() {
      Some(v) => v
      None => break
    }
    rows.push("\{p.data.length()}@\{p.pts / 1152L}")
  }
  // 13 whole frames (header included, 417/418 CBR padding alternation);
  // pts steps by the 1152-sample frame duration.
  inspect(
    rows.join(","),
    content=(
      #|417@0,418@1,418@2,418@3,418@4,418@5,418@6,418@7,418@8,418@9,418@10,418@11,418@12
    ),
  )
}

///|
test "playback pins: ADTS-in-WAV reframes per ADTS frame with NOPTS pts" {
  let data = @libavutil.av_base64_decode(pins_aac_adts_wav_b64, 1 << 20).unwrap()
  let mf = @libavformat.MediaFile::open(data)
  let mut count = 0
  let mut first_pts = 0L
  let sizes : Array[Int32] = []
  while true {
    let p = match mf.next_packet() {
      Some(v) => v
      None => break
    }
    if count == 0 {
      first_pts = p.pts
    }
    sizes.push(p.data.length())
    count = count + 1
  }
  inspect(
    count,
    content=(
      #|14
    ),
  )
  inspect(
    first_pts,
    content=(
      #|-9223372036854775808
    ),
  )
  inspect(
    sizes[0],
    content=(
      #|242
    ),
  )
  // The ASC extradata comes from the first ADTS header, so decode works.
  let audio = @libavformat.decode_audio_file(data)
  inspect(
    audio.samples()[0].length(),
    content=(
      #|14336
    ),
  )
}

///|
test "playback pins: RAW AAC-in-WAV stays one whole-data packet" {
  // ffmpeg's own RAW_AAC1: raw frames, ASC in the fmt cbSize. The C's
  // parser only cuts this at accidental sync words (and its decoder then
  // refuses the multi-frame packets), so there is no upstream decode
  // anchor; ours keeps one packet and the facade loop consumes frames.
  let data = @libavutil.av_base64_decode(pins_aac_wav_b64, 1 << 20).unwrap()
  let mf = @libavformat.MediaFile::open(data)
  let mut count = 0
  while mf.next_packet() is Some(_) {
    count = count + 1
  }
  inspect(count, content="1")
  let audio = @libavformat.decode_audio_file(data)
  // 0.3 s at 44.1 kHz = 13.23 coded frames -> 14 decoded frames.
  inspect(
    audio.samples()[0].length(),
    content=(
      #|14336
    ),
  )
  inspect(
    audio.channels(),
    content=(
      #|2
    ),
  )
}

///|
test "playback pins: MP3-in-WAV decodes through the facade" {
  let data = @libavutil.av_base64_decode(pins_mp3_wav_b64, 1 << 20).unwrap()
  let audio = @libavformat.decode_audio_file(data)
  inspect(
    audio.samples()[0].length(),
    content=(
      #|14976
    ),
  )
  inspect(
    audio.channels(),
    content=(
      #|2
    ),
  )
}
