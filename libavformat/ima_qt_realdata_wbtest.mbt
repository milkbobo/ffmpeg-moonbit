///|
/// IMA QuickTime (`ima4`) in MOV: ffmpeg-encoded mono/stereo files are
/// demuxed by `av_mov_open` and decoded chunk by chunk against FFmpeg's
/// s16le references.

///|
let ima_qt_fixtures : Array[(String, Bytes, Int32, String)] = [
  (
    "mono", b"",
    1, "609afae1fe37262395be41c9bc9f1a16",
  ),
  (
    "stereo", b"",
    2, "2db50b2d8fd489a9ad0e5e009b140377",
  ),
]

///|
fn ima_qt_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "mov: IMA QuickTime tracks decode like FFmpeg" {
  for fixture in ima_qt_fixtures {
    let (name, b64, channels, want_md5) = fixture
    let data = @libavutil.av_base64_decode(b64, 100000).unwrap()
    let movie = match av_mov_open(data) {
      Ok(v) => v
      Err(e) => fail("\{name}: open failed: \{e}")
    }
    assert_eq(movie.tracks.length(), 1)
    let track = movie.tracks[0]
    assert_eq(track.codec, "ima4", msg=name)
    assert_eq(
      mov_codec_name(track.codec, track.codec_id),
      "adpcm_ima_qt",
      msg=name,
    )
    assert_eq(track.channels, channels.reinterpret_as_uint(), msg=name)
    let dec = match
      @libavcodec.adpcm_ima_qt_decoder_new(track.channels.reinterpret_as_int()) {
      Ok(v) => v
      Err(e) => fail("\{name}: decoder init failed: \{e}")
    }
    let pcm : Array[Byte] = []
    for sample in track.samples {
      let start = sample.offset.to_int()
      let end = start + sample.size.reinterpret_as_int()
      let frame = match dec.decode_block(data[start:end].to_owned()) {
        Ok(v) => v
        Err(e) => fail("\{name}: decode failed: \{e}")
      }
      for v in frame {
        pcm.push((v & 0xFF).to_byte())
        pcm.push(((v >> 8) & 0xFF).to_byte())
      }
    }
    assert_eq(pcm.length(), if channels == 1 { 16000 } else { 32000 }, msg=name)
    assert_eq(ima_qt_md5(Bytes::from_array(pcm)), want_md5, msg=name)
  }
}
