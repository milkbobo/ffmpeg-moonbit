///|
/// Hex-render a 16-byte digest (the VP9 MD5 test's inline formatting).
fn cover_hex(digest : FixedArray[Byte]) -> String {
  let digits = "0123456789abcdef"
  let out = StringBuilder()
  for i = 0; i < digest.length(); i = i + 1 {
    let v = digest[i].to_int() & 0xFF
    out.write_char(digits.get_char(v >> 4).unwrap())
    out.write_char(digits.get_char(v & 15).unwrap())
  }
  out.to_string()
}

///|
test "playback: MediaFile::cover reads MKV attachments and MP4 covr" {
  let want = "2e84456f9b9878f9ce3234ee6f6b1971"
  // Matroska: first image/* AttachedFile, bytes verbatim.
  let mkv = @libavutil.av_base64_decode(playback_cover_mkv_b64, 1 << 20).unwrap()
  let mkv_cover = @libavformat.MediaFile::open(mkv).cover()
  assert_true(mkv_cover is Some(_))
  let c1 = mkv_cover.unwrap()
  assert_eq(c1.mime(), "image/jpeg")
  assert_eq(c1.data().length(), 669)
  let digest1 = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest1, c1.data(), c1.data().length())
  assert_eq(cover_hex(digest1), want)
  // MP4: ilst/covr data type 13, same bytes.
  let mp4 = @libavutil.av_base64_decode(playback_cover_mp4_b64, 1 << 20).unwrap()
  let mp4_cover = @libavformat.MediaFile::open(mp4).cover()
  assert_true(mp4_cover is Some(_))
  let c2 = mp4_cover.unwrap()
  assert_eq(c2.mime(), "image/jpeg")
  assert_eq(c2.data().length(), 669)
  let digest2 = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest2, c2.data(), c2.data().length())
  assert_eq(cover_hex(digest2), want)
  // Containers without artwork yield None.
  let ogg = @libavutil.av_base64_decode(playback_ogg_file_b64, 1 << 20).unwrap()
  let none = @libavformat.MediaFile::open(ogg).cover()
  assert_true(none is None)
}
