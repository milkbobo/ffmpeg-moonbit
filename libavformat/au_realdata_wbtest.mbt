///|
/// Real AU fixtures written by ffmpeg 9.0.2 (s16be/s32be, µ-law, A-law and
/// G.726LE) from the deterministic 8 kHz mono source. References are FFmpeg
/// s16le/s32le decodes; the writer round-trip re-emits the PCM fixtures.

///|
let au_fixtures : Array[
  (String, Bytes, String, Int32, Int32, Int32, Int32, String),
] = [
  (
    "s16", b"",
    "pcm_s16be", 3, 1, 16, 8000, "998ae6d7b6361fe5caadfb0a41c9e018",
  ),
  (
    "s32", b"",
    "pcm_s32be", 5, 1, 32, 8000, "b7fc09c52ca0edcc3d632eebfdef1f5c",
  ),
  (
    "mulaw", b"",
    "pcm_mulaw", 1, 1, 8, 8000, "ce3a932600fcb4f9f189c5a95e580bb6",
  ),
  (
    "alaw", b"",
    "pcm_alaw", 27, 1, 8, 8000, "4d9e1303ff45319ef1bdc009e0ab644d",
  ),
  (
    "g726le", b"",
    "adpcm_g726le", 23, 1, 4, 8000, "a0536288e8b15283f62de24ebed4fad1",
  ),
]

///|
fn au_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
fn au_push16(out : Array[Byte], v : Int32) -> Unit {
  out.push((v & 0xFF).to_byte())
  out.push(((v >> 8) & 0xFF).to_byte())
}

///|
test "au: ffmpeg fixtures decode like the references" {
  for fixture in au_fixtures {
    let (name, b64, codec, tag, channels, bits, count, want_md5) = fixture
    let data = @libavutil.av_base64_decode(b64, 100000).unwrap()
    let au = match av_au_open(data) {
      Ok(v) => v
      Err(e) => fail("\{name}: open failed: \{e}")
    }
    assert_eq(au.format.codec, codec, msg=name)
    assert_eq(au.format.codec_tag, tag.reinterpret_as_uint(), msg=name)
    assert_eq(au.format.channels, channels, msg=name)
    assert_eq(au.format.bits, bits, msg=name)
    assert_eq(au.format.sample_rate, 8000, msg=name)
    assert_eq(au.sample_count, count.to_int64(), msg=name)
    let pcm : Array[Byte] = []
    if codec == "pcm_mulaw" || codec == "pcm_alaw" {
      for packet in au.packets {
        let start = packet.pos.to_int()
        let bytes = data[start:start + packet.size].to_owned()
        let samples = if codec == "pcm_mulaw" {
          @libavcodec.pcm_mulaw_decode(bytes)
        } else {
          @libavcodec.pcm_alaw_decode(bytes)
        }
        for v in samples {
          au_push16(pcm, v)
        }
      }
    } else if codec == "adpcm_g726le" {
      let dec = @libavcodec.g726_decoder_new(bits, little_endian=true).unwrap()
      for packet in au.packets {
        let start = packet.pos.to_int()
        let bytes = data[start:start + packet.size].to_owned()
        for v in dec.decode(bytes) {
          au_push16(pcm, v)
        }
      }
    } else {
      let width = bits / 8
      for packet in au.packets {
        let start = packet.pos.to_int()
        let end = start + packet.size
        let mut off = start
        while off + width <= end {
          let mut v : UInt32 = 0
          for i = 0; i < width; i = i + 1 {
            v = (v << 8) | data[off + i].to_uint()
          }
          off = off + width
          let sv = if width == 2 {
            v.reinterpret_as_int() << 16 >> 16
          } else {
            v.reinterpret_as_int()
          }
          if width == 2 {
            au_push16(pcm, sv)
          } else {
            pcm.push((sv & 0xFF).to_byte())
            pcm.push(((sv >> 8) & 0xFF).to_byte())
            pcm.push(((sv >> 16) & 0xFF).to_byte())
            pcm.push(((sv >> 24) & 0xFF).to_byte())
          }
        }
      }
    }
    assert_eq(au_md5(Bytes::from_array(pcm)), want_md5, msg=name)
  }
}

///|
test "au: PCM writer round-trip" {
  for fixture in au_fixtures {
    let (name, b64, codec, _tag, channels, bits, _count, _md5) = fixture
    if codec != "pcm_s16be" && codec != "pcm_s32be" {
      continue
    }
    let data = @libavutil.av_base64_decode(b64, 100000).unwrap()
    let au = av_au_open(data).unwrap()
    let width = bits / 8
    let samples : Array[Int32] = []
    for packet in au.packets {
      let start = packet.pos.to_int()
      let end = start + packet.size
      let mut off = start
      while off + width <= end {
        let mut v : UInt32 = 0
        for i = 0; i < width; i = i + 1 {
          v = (v << 8) | data[off + i].to_uint()
        }
        off = off + width
        let sv = if width == 2 {
          v.reinterpret_as_int() << 16 >> 16
        } else {
          v.reinterpret_as_int()
        }
        samples.push(sv)
      }
    }
    let mux = au_muxer_new(8000, channels, bits~).unwrap()
    mux.write_samples(samples)
    let out = mux.finish()
    let again = av_au_open(out).unwrap()
    assert_eq(again.format.codec, codec, msg=name)
    assert_eq(again.sample_count, 8000L, msg=name)
    let payload = out[24:out.length()]
    let original = data[au.data_offset.to_int():data.length()]
    assert_eq(payload.length(), original.length(), msg=name)
    for i = 0; i < payload.length(); i = i + 1 {
      assert_eq(payload[i], original[i], msg=name)
    }
  }
}
