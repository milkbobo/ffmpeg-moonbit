///|
test "RealMedia: ra144 (ra3_in_rm_file [cut to 24576 bytes]) matches ffprobe" {
  realmedia_test_check(
    "ra144",
    realmedia_ra144_file_b64,
    realmedia_ra144_table_b64,
    realmedia_ra144_extradata_b64,
    [("ra_144", 8000, 1, 0, 0, 8000L, 0L, 0, 0)],
    [
      ("author", "http://www.npr.org/"),
      ("title", "All Things Considered 11/17/98"),
      ("copyright", "National Public Radio 1998"),
    ],
    false,
  )
}

