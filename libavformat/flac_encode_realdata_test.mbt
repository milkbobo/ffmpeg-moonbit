///|
/// FLAC encoder tests: fixed predictors + Rice residuals are encoded into a
/// complete `fLaC` stream and decoded back through `ff_flac_decode`.  Fixtures
/// are FFmpeg 9.0.2 PCM WAVs (16-bit stereo, 24-bit mono, 8-bit mono); the
/// round-trip is sample-exact and the decoded PCM MD5 equals FFmpeg's decode of
/// the source WAV (checked externally for all three bit depths).

///|
fn flacenc_b64_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let flacenc_s16_b64 : Bytes = flacenc_b64_concat([
  b"",
  b"",
  b"",
])

///|
let flacenc_s24_b64 : Bytes = flacenc_b64_concat([
  b"",
  b"",
])

///|
let flacenc_u8_b64 : Bytes = flacenc_b64_concat([
  b"",
])

///|
/// Correlated stereo (identical L/R): exercises left/right/mid-side
/// decorrelation and wasted-bit handling.  FFmpeg's decoded s16le MD5 is
/// `ef9ca189374d29893ea2fb197e464274`.
let flacenc_corr_b64 : Bytes = flacenc_b64_concat([
  b"",
  b"",
])

///|
fn flacenc_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
fn flacenc_pcm_i32(wav : @libavformat.WavDemux, bytes : Bytes) -> Array[Int32] {
  let start = wav.data_offset.to_int()
  let end = start + wav.data_size.to_int()
  let out : Array[Int32] = []
  let bits = wav.format.bits_per_sample
  if bits == 16 {
    let mut i = start
    while i + 1 < end {
      let v = bytes[i].to_int() | (bytes[i + 1].to_int() << 8)
      out.push(if v >= 32768 { v - 65536 } else { v })
      i = i + 2
    }
  } else if bits == 24 {
    let mut i = start
    while i + 2 < end {
      let v = bytes[i].to_int() |
        (bytes[i + 1].to_int() << 8) |
        (bytes[i + 2].to_int() << 16)
      out.push(if v >= 8388608 { v - 16777216 } else { v })
      i = i + 3
    }
  } else {
    for i in start..<end {
      out.push(bytes[i].to_int() - 128)
    }
  }
  out
}

///|
fn flacenc_check(
  wav_b64 : Bytes,
  exp_frames : Int32,
  exp_md5 : String,
) -> Unit raise {
  let bytes = @libavutil.av_base64_decode(wav_b64, 100000).unwrap()
  let wav = @libavformat.av_wav_open(bytes).unwrap()
  let samples = flacenc_pcm_i32(wav, bytes)
  let enc = @libavcodec.flac_encode(
    samples,
    wav.format.channels,
    wav.format.sample_rate,
    wav.format.bits_per_sample,
  ).unwrap()
  assert_eq(enc.streaminfo.length(), 34)
  assert_eq(enc.frames.length(), exp_frames)
  assert_eq(enc.total_samples.to_int(), samples.length() / wav.format.channels)
  let file = enc.file()
  assert_eq(file[0:4].to_owned(), b"fLaC")
  let dec = @libavcodec.ff_flac_decode(file).unwrap()
  assert_eq(dec.channels, wav.format.channels)
  assert_eq(dec.sample_rate, wav.format.sample_rate)
  assert_eq(dec.bits, wav.format.bits_per_sample)
  assert_eq(dec.samples.length(), samples.length())
  let shift = if dec.bits > 16 {
    32 - dec.bits
  } else if dec.bits < 16 {
    16 - dec.bits
  } else {
    0
  }
  for i = 0; i < samples.length(); i = i + 1 {
    assert_eq(dec.samples[i] >> shift, samples[i])
  }
  assert_eq(flacenc_md5(dec.pcm_bytes()), exp_md5)
}

///|
test "flac encoder: 16-bit stereo round-trips" {
  flacenc_check(flacenc_s16_b64, 3, "f3acc310ceb35e6ba4a2709b01cbf5c0")
}

///|
test "flac encoder: 24-bit mono round-trips" {
  flacenc_check(flacenc_s24_b64, 2, "741aa1373545b990376a81f9c652185f")
}

///|
test "flac encoder: 8-bit mono round-trips" {
  flacenc_check(flacenc_u8_b64, 1, "a440ba7615eec663e3e5572a703e4d95")
}

///|
fn flacenc_expect_reject(
  result : Result[@libavcodec.FlacEncoded, String],
) -> Unit raise {
  match result {
    Ok(_) => fail("expected invalid FLAC parameters to be rejected")
    Err(_) => ()
  }
}

///|
test "flac encoder: stereo decorrelation compresses correlated channels" {
  flacenc_check(flacenc_corr_b64, 2, "ef9ca189374d29893ea2fb197e464274")
  let bytes = @libavutil.av_base64_decode(flacenc_corr_b64, 100000).unwrap()
  let wav = @libavformat.av_wav_open(bytes).unwrap()
  let samples = flacenc_pcm_i32(wav, bytes)
  let enc = @libavcodec.flac_encode(
    samples,
    wav.format.channels,
    wav.format.sample_rate,
    wav.format.bits_per_sample,
  ).unwrap()
  // Mid-side / side coding makes the second (difference) subframe tiny.
  assert_true(
    enc.file().length() < 3000,
    msg="stereo decorrelation did not reduce the frame size",
  )
  let ch_code = enc.frames[0][3].to_int() >> 4
  assert_true(ch_code >= 8 && ch_code <= 10, msg="expected a side channel mode")
}

///|
test "flac encoder: invalid parameters are rejected" {
  flacenc_expect_reject(@libavcodec.flac_encode([0, 1], 0, 44100, 16))
  flacenc_expect_reject(@libavcodec.flac_encode([0, 1], 2, 0, 16))
  flacenc_expect_reject(@libavcodec.flac_encode([0, 1], 1, 44100, 32))
  flacenc_expect_reject(@libavcodec.flac_encode([0, 1, 2], 2, 44100, 16))
}
