test "adpcm facade oki_wav: decodes to the reference s16le" {
  adpcm_check(
    adpcm_load(adpcm_oki_wav),
    "wav",
    "adpcm_ima_oki",
    11025,
    1,
    110248,
    "641049800e735b62e975baacc9a011a4",
    "oki_wav",
  )
}

