///|
/// ALAC-in-MP4 demux: real ffmpeg m4a, `alac` sample entry and inner `alac`
/// magic-cookie atom, samples decoded with the libavcodec ALAC decoder.

///|
let mp4_alac_real_b64 = b""

///|
test "mp4: ALAC track reads and decodes like FFmpeg" {
  let data = @libavutil.av_base64_decode(mp4_alac_real_b64, 200000).unwrap()
  let movie = match av_mov_open(data) {
    Ok(v) => v
    Err(e) => fail("open failed: \{e}")
  }
  assert_eq(movie.tracks.length(), 1)
  let track = movie.tracks[0]
  assert_eq(track.codec, "alac")
  assert_eq(mov_codec_name(track.codec, track.codec_id), "alac")
  assert_eq(track.sample_rate, 44100U)
  assert_eq(track.channels, 2U)
  assert_eq(track.samples.length(), 6)
  let cookie = track.extradata.unwrap()
  assert_eq(cookie.length(), 36)
  assert_eq(cookie[0], b'\x00')
  assert_eq(cookie[3], b'\x24')
  assert_eq(cookie[4], b'a')
  assert_eq(cookie[7], b'c')
  let dec = match @libavcodec.alac_decoder_new(cookie) {
    Ok(v) => v
    Err(e) => fail("ALAC init failed: \{e}")
  }
  let pcm : Array[Byte] = []
  let mut total = 0
  for sample in track.samples {
    let start = sample.offset.to_int()
    let end = start + sample.size.reinterpret_as_int()
    let frame = match dec.decode_frame(data[start:end].to_owned()) {
      Ok(v) => v
      Err(e) => fail("ALAC decode failed: \{e}")
    }
    assert_eq(frame.channels, 2)
    assert_eq(frame.bits, 16)
    total = total + frame.nb_samples
    for b in frame.pcm_bytes() {
      pcm.push(b)
    }
  }
  assert_eq(total, 22050)
  let digest = FixedArray::make(16, b'\x00')
  let bytes = Bytes::from_array(pcm)
  @libavutil.av_md5_sum(digest, bytes, bytes.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  assert_eq(text.to_string(), "38fb308079b63baf40e49bd051d22bc8")
}
