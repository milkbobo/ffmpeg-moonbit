///|
/// Raw E-AC-3 demuxer tests: `av_ac3_open` reports `eac3` for `bsid > 10` and
/// splits frames by the header size; 2-block frames carry 512 samples.  The
/// mono 48 kHz stream decodes within one s16 LSB of FFmpeg's PCM.

///|
fn eac3_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
fn eac3_decode(b64 : Bytes) -> Bytes {
  @libavutil.av_base64_decode(b64, 1000000).unwrap()
}

///|
let eac3_mono48_b64 : Bytes = eac3_concat([
  b"",
])

///|
let eac3_mono48_ref_b64 : Bytes = eac3_concat([
  b"",
  b"",
])

///|
let eac3_hi1blk_b64 : Bytes = eac3_concat([
  b"",
  b"",
])

///|
test "raw E-AC-3 demuxer: frame splitting and codec id" {
  let data = eac3_decode(eac3_concat([eac3_mono48_b64]))
  let track = av_ac3_open(data).unwrap()
  assert_eq(track.codec, "eac3")
  assert_eq(track.sample_rate, 48000)
  assert_eq(track.channels, 1)
  assert_eq(track.frame_size, 1536)
  assert_eq(track.bit_rate, 96000)
  assert_eq(track.frames.length(), 4)
  assert_eq(track.total_samples, 6144L)
  for i = 0; i < 4; i = i + 1 {
    assert_eq(track.frames[i].pos, (i * 384).to_int64())
    assert_eq(track.frames[i].size, 384)
    assert_eq(track.frames[i].pts, (i * 1536).to_int64())
    assert_eq(track.frames[i].duration, 1536)
  }
  let two = av_ac3_open(eac3_decode(eac3_concat([eac3_hi1blk_b64]))).unwrap()
  assert_eq(two.codec, "eac3")
  assert_eq(two.channels, 2)
  assert_eq(two.frame_size, 512)
  assert_eq(two.frames.length(), 2)
  assert_eq(two.total_samples, 1024L)
  for frame in two.frames {
    assert_eq(frame.size, 4096)
    assert_eq(frame.duration, 512)
  }
}

///|
test "raw E-AC-3 demuxer: decoded mono matches FFmpeg PCM" {
  let data = eac3_decode(eac3_concat([eac3_mono48_b64]))
  let reference = eac3_decode(eac3_concat([eac3_mono48_ref_b64]))
  let track = av_ac3_open(data).unwrap()
  let dec = @libavcodec.ac3_decoder_new()
  let pcm : Array[Int32] = []
  for frame in track.frames {
    let start = frame.pos.to_int()
    let bytes = data[start:start + frame.size].to_owned()
    let decoded = dec.decode_frame(bytes).unwrap()
    for v in decoded.samples[0] {
      let q = if v >= 1.0 {
        32767
      } else if v <= -1.0 {
        -32768
      } else {
        (v * 32768.0).round().to_int()
      }
      pcm.push(q)
    }
  }
  assert_eq(pcm.length(), 6144)
  let mut max_diff = 0
  for i = 0; i < pcm.length(); i = i + 1 {
    let raw = reference[i * 2].to_int() | (reference[i * 2 + 1].to_int() << 8)
    let want = if raw >= 32768 { raw - 65536 } else { raw }
    let d = if pcm[i] > want { pcm[i] - want } else { want - pcm[i] }
    if d > max_diff {
      max_diff = d
    }
  }
  assert_true(max_diff <= 1, msg="max diff \{max_diff}")
}
