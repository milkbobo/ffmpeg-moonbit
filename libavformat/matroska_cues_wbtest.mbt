///|
test "mkv cues: parse and seek" {
  let bytes = @libavutil.av_base64_decode(cues_mkv_b64, 200000).unwrap()
  let cues = av_matroska_parse_cues(bytes).unwrap()
  assert_eq(cues.cues.length(), 3)
  assert_eq(cues.cues[0].time, 0L)
  assert_eq(cues.cues[1].time, 1000L)
  assert_eq(cues.cues[2].time, 2000L)
  for c in cues.cues {
    assert_eq(c.track, 1L)
    assert_true(c.cluster_position >= 0L)
  }
  // The first cue points at the first Cluster recorded by the demuxer.
  let mkv = av_matroska_open(bytes).unwrap()
  assert_eq(
    cues.segment_data_start + cues.cues[0].cluster_position,
    mkv.first_cluster_pos,
  )
  // Cue-based seek: last cue at or before the target.
  assert_eq(mkv_seek_cue(cues, 0L).unwrap().time, 0L)
  assert_eq(mkv_seek_cue(cues, 1500L).unwrap().time, 1000L)
  assert_eq(mkv_seek_cue(cues, 9999L).unwrap().time, 2000L)
  // Every cue cluster resolves to a later keyframe packet.
  for c in cues.cues {
    let abs = cues.segment_data_start + c.cluster_position
    let mut found = false
    for p in mkv.packets {
      if p.is_keyframe && p.pos >= abs {
        found = true
        break
      }
    }
    assert_true(found)
  }
}
