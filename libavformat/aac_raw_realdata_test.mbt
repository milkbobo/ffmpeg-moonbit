///|
/// Raw AAC access-unit splitting for WAV `WAVE_FORMAT_AAC`: the WAV data chunk
/// stores concatenated raw_data_blocks without ADTS headers.  The splitter
/// advances by the bytes each decoded block consumes (FFmpeg's decode loop) and
/// the 0.2 s fixture decodes to FFmpeg's PCM within 1 LSB.

///|
fn aac_raw_b64_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let aac_raw_wav_b64 : Bytes = aac_raw_b64_concat([
  b"",
])

///|
let aac_raw_ref_b64 : Bytes = aac_raw_b64_concat([
  b"",
  b"",
])

///|
test "raw AAC WAV chunk splits into raw_data_blocks and decodes" {
  let bytes = @libavutil.av_base64_decode(aac_raw_wav_b64, 100000).unwrap()
  let wav = @libavformat.av_wav_open(bytes).unwrap()
  assert_eq(wav.format.codec, "aac")
  assert_eq(wav.format.channels, 1)
  assert_eq(wav.format.sample_rate, 44100)
  assert_eq(wav.format.extradata.length(), 5)
  let start = wav.data_offset.to_int()
  let data = bytes[start:start + wav.data_size.to_int()].to_owned()
  let frames = @libavcodec.aac_decode_raw_stream(wav.format.extradata, data).unwrap()
  assert_eq(frames.length(), 10)
  let mut consumed = 0
  let pcm : Array[Byte] = []
  for frame in frames {
    assert_true(frame.data.length() > 0)
    consumed = consumed + frame.data.length()
    assert_eq(frame.pcm.length(), 1)
    assert_eq(frame.pcm[0].samples.length(), 1024)
    for v in frame.pcm[0].samples {
      let q = if v >= 1.0 {
        32767
      } else if v <= -1.0 {
        -32768
      } else {
        (v * 32768.0).round().to_int()
      }
      pcm.push((q & 0xFF).to_byte())
      pcm.push(((q >> 8) & 0xFF).to_byte())
    }
  }
  assert_eq(consumed, data.length())
  let reference = @libavutil.av_base64_decode(aac_raw_ref_b64, 100000).unwrap()
  assert_eq(pcm.length(), reference.length())
  let mut max_diff = 0
  for i in 0..<(reference.length() / 2) {
    let a = pcm[i * 2].to_int() | (pcm[i * 2 + 1].to_int() << 8)
    let b = reference[i * 2].to_int() | (reference[i * 2 + 1].to_int() << 8)
    let sa = if a >= 32768 { a - 65536 } else { a }
    let sb = if b >= 32768 { b - 65536 } else { b }
    let d = if sa > sb { sa - sb } else { sb - sa }
    if d > max_diff {
      max_diff = d
    }
  }
  assert_true(max_diff <= 1, msg="AAC raw PCM differs by \{max_diff}")
}
