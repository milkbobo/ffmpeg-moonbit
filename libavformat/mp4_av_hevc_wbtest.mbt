///|
/// HEVC + AAC MP4 with B-frames (x265 bf=3) remuxed through
/// `Mp4AvMuxer` with `hevc=true`: the video keeps its CTS via `ctts`,
/// the hvc1 entry round-trips, and both tracks decode like the source.

///|
let mp4_av_hevc_src_b64 : Bytes = b""

///|
test "mp4 A/V: HEVC B-frames and AAC round-trip" {
  let src = @libavutil.av_base64_decode(mp4_av_hevc_src_b64, 100000).unwrap()
  let movie = av_mov_open(src).unwrap()
  assert_eq(movie.tracks.length(), 2)
  let vi = mp4_av_bframes_find(movie, "vide")
  let ai = mp4_av_bframes_find(movie, "soun")
  let vt = movie.tracks[vi]
  let at = movie.tracks[ai]
  let hvcc = vt.extradata.unwrap()
  let mux = mp4_av_muxer_new(
    vt.width,
    vt.height,
    hvcc,
    at.sample_rate.reinterpret_as_int(),
    at.channels.reinterpret_as_int(),
    aac_priming=at.skip_samples,
    hevc=true,
  ).unwrap()
  let src_payloads : Array[Bytes] = []
  let mut reordered = false
  for sample in vt.samples {
    let start = sample.offset.to_int()
    let end = start + sample.size.reinterpret_as_int()
    let payload = src[start:end].to_owned()
    src_payloads.push(payload)
    if sample.pts != sample.dts {
      reordered = true
    }
    let scale : Int64 = 90000L
    let ts : Int64 = vt.timescale.to_int64()
    mux
    .write_video(
      payload,
      duration=(sample.duration.to_int64() * scale / ts).to_int(),
      keyframe=sample.keyframe,
      cts=((sample.pts - sample.dts) * scale / ts).to_int(),
    )
    .unwrap()
  }
  assert_true(reordered, msg="fixture must contain B-frames")
  for sample in at.samples {
    let start = sample.offset.to_int()
    let end = start + sample.size.reinterpret_as_int()
    mux
    .write_audio(
      src[start:end].to_owned(),
      duration=sample.duration.reinterpret_as_int(),
    )
    .unwrap()
  }
  let out = mux.finish()
  let remux = av_mov_open(out).unwrap()
  let rvi = mp4_av_bframes_find(remux, "vide")
  let rai = mp4_av_bframes_find(remux, "soun")
  let rv = remux.tracks[rvi]
  let ra = remux.tracks[rai]
  assert_eq(rv.codec, "hvc1")
  assert_eq(rv.extradata.unwrap(), hvcc)
  assert_eq(rv.samples.length(), vt.samples.length())
  let src_base = vt.samples[0].dts
  let out_base = rv.samples[0].dts
  let scale : Int64 = 90000L
  let ts : Int64 = vt.timescale.to_int64()
  for i in 0..<vt.samples.length() {
    let a = vt.samples[i]
    let b = rv.samples[i]
    assert_eq(b.pts - b.dts, (a.pts - a.dts) * scale / ts, msg="cts \{i}")
    assert_eq(b.dts - out_base, (a.dts - src_base) * scale / ts, msg="dts \{i}")
    assert_eq(b.keyframe, a.keyframe, msg="key \{i}")
  }
  assert_eq(ra.samples.length(), at.samples.length())
  for i in 0..<at.samples.length() {
    assert_eq(
      ra.samples[i].duration,
      at.samples[i].duration,
      msg="audio duration \{i}",
    )
  }
  let src_all : Array[Byte] = []
  for b in mkv_av_hvcc_params(hvcc) {
    src_all.push(b)
  }
  for p in src_payloads {
    for b in p {
      src_all.push(b)
    }
  }
  let out_all : Array[Byte] = []
  for b in mkv_av_hvcc_params(hvcc) {
    out_all.push(b)
  }
  for sample in rv.samples {
    let start = sample.offset.to_int()
    let end = start + sample.size.reinterpret_as_int()
    for b in out[start:end] {
      out_all.push(b)
    }
  }
  let src_frames = match
    @libavcodec.ff_hevc_decode_frames_ex(
      Bytes::from_array(src_all),
      true,
      4,
      true,
    ) {
    Ok(v) => v
    Err(e) => fail("src decode: \{e}")
  }
  let out_frames = match
    @libavcodec.ff_hevc_decode_frames_ex(
      Bytes::from_array(out_all),
      true,
      4,
      true,
    ) {
    Ok(v) => v
    Err(e) => fail("out decode: \{e}")
  }
  let src_sorted = src_frames.copy()
  src_sorted.sort_by((a, b) => a.poc().compare(b.poc()))
  let out_sorted = out_frames.copy()
  out_sorted.sort_by((a, b) => a.poc().compare(b.poc()))
  assert_eq(out_sorted.length(), src_sorted.length())
  for i in 0..<src_sorted.length() {
    assert_eq(
      mkv_hevc_md5(out_sorted[i].yuvp(8)),
      mkv_hevc_md5(src_sorted[i].yuvp(8)),
      msg="frame \{i}",
    )
  }
}
