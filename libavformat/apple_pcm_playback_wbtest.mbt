///|
/// Fixtures generated by FFmpeg 9.0.2 using two distinct 8 kHz tones.
fn check_apple_pcm_fixture(
  encoded : Bytes,
  container : String,
  codec : String,
  expected_md5 : String,
) -> Unit raise {
  let file = @libavutil.av_base64_decode(encoded, 2048).unwrap()
  let audio = decode_audio_file(file)
  assert_eq(audio.format_name, container)
  assert_eq(audio.codec_id, codec)
  assert_eq(audio.sample_rate, 8000)
  assert_eq(audio.channels, 2)
  assert_eq(audio.read_error, "")
  for row in audio.samples {
    assert_eq(row.length(), 32)
  }
  let pcm = if codec.has_prefix("pcm_f") {
    // Compare with FFmpeg's f64le output to preserve floating-point precision.
    let interleaved : Array[Byte] = []
    for i in 0..<32 {
      for row in audio.samples {
        let bits = row[i].reinterpret_as_uint64()
        for byte in 0..<8 {
          interleaved.push((bits >> (8 * byte)).to_byte())
        }
      }
    }
    Bytes::from_array(interleaved)
  } else {
    let wav = audio.to_wav_s16()
    let demux = av_wav_open(wav).unwrap()
    assert_eq(demux.data_size, 128L)
    wav[demux.data_offset.to_int():].to_owned()
  }
  assert_eq(caf_md5(pcm), expected_md5)
}

///|
test "mov pcm_alaw matches FFmpeg" {
  check_apple_pcm_fixture(
    bcat([
      b"AAAAFGZ0eXBxdCAgAAACAHF0ICAAAAAId2lkZQAAAEhtZGF01bCziLp1swrcMDMPOu0ytEaxs4O6EbI3yTEwBjqZMrZ2tr",
      b"CbugSyMf03MBM6gDKxeLSw6LoMvTHlNTB/Ook9sAAAAoltb292AAAAbG12aGQAAAAAAAAAAAAAAAAAAB9AAAAAIAABAAAB",
      b"AAAAAAAAAAAAAAAAAQAAAAAAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      b"AAAAACAAAB9XRyYWsAAABcdGtoZAAAAAMAAAAAAAAAAAAAAAEAAAAAAAAAIAAAAAAAAAAAAAAAAQEAAAAAAQAAAAAAAAAA",
      b"AAAAAAAAAAEAAAAAAAAAAAAAAAAAAEAAAAAAAAAAAAAAAAAAACRlZHRzAAAAHGVsc3QAAAAAAAAAAQAAACAAAAAAAAEAAA",
      b"AAAW1tZGlhAAAAIG1kaGQAAAAAAAAAAAAAAAAAAB9AAAAAIH//AAAAAAAtaGRscgAAAABtaGxyc291bgAAAAAAAAAAAAAA",
      b"AAxTb3VuZEhhbmRsZXIAAAEYbWluZgAAABBzbWhkAAAAAAAAAAAAAAAsaGRscgAAAABkaGxydXJsIAAAAAAAAAAAAAAAAA",
      b"tEYXRhSGFuZGxlcgAAACRkaW5mAAAAHGRyZWYAAAAAAAAAAQAAAAx1cmwgAAAAAQAAALBzdGJsAAAATHN0c2QAAAAAAAAA",
      b"AQAAADxhbGF3AAAAAAAAAAEAAAAAAAAAAAACABAAAAAAH0AAAAAAABhjaGFuAAAAAABlAAIAAAAAAAAAAAAAABhzdHRzAA",
      b"AAAAAAAAEAAAAgAAAAAQAAABxzdHNjAAAAAAAAAAEAAAABAAAAIAAAAAEAAAAUc3RzegAAAAAAAAACAAAAIAAAABRzdGNv",
      b"AAAAAAAAAAEAAAAkAAAAIHVkdGEAAAAYqXN3cgAMVcRMYXZmNjMuMS4xMDI=",
    ]),
    "mov,mp4,m4a,3gp,3g2,mj2",
    "pcm_alaw",
    "da1a20335bba5e4703a45c9c21ac9bb7",
  )
}

