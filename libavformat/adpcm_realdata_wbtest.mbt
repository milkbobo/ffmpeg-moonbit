///|
/// Real ADPCM WAV fixtures encoded by ffmpeg 9.0.2 (`adpcm_ima_wav`,
/// `adpcm_ms`, `adpcm_yamaha`) from a deterministic 8 kHz source. The WAV
/// demuxer's block-aligned packets are decoded block by block and compared
/// with FFmpeg's s16le reference.

///|
let adpcm_fixtures : Array[(String, Bytes, String, Int32, Int32, String)] = [
  // ima_stereo
  (
    "ima_stereo", b"",
    "adpcm_ima_wav", 2, 1024, "f9bdd690572bd3107f7091d5b70a99cb",
  ),
  // ima_mono
  (
    "ima_mono", b"",
    "adpcm_ima_wav", 1, 1024, "5d822f738b343b44f1c22c0dfdd87166",
  ),
  // ms_stereo
  (
    "ms_stereo", b"",
    "adpcm_ms", 2, 1024, "4bc43286fe0b671fac82563f2e396262",
  ),
  // ms_mono
  (
    "ms_mono", b"",
    "adpcm_ms", 1, 1024, "e79bcc0e78ff5e81502c24ea50527c26",
  ),
  // yamaha_stereo
  (
    "yamaha_stereo", b"",
    "adpcm_yamaha", 2, 1024, "cbee695f64a6bb240df6457bf9bd1370",
  ),
  // yamaha_mono
  (
    "yamaha_mono", b"",
    "adpcm_yamaha", 1, 1024, "c742c7fb7a546a1eb68854a1b7aae520",
  ),
]

///|
fn adpcm_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "adpcm: ffmpeg WAV fixtures decode bit-exactly" {
  for fixture in adpcm_fixtures {
    let (name, b64, codec, channels, block_align, want_md5) = fixture
    let data = @libavutil.av_base64_decode(b64, 100000).unwrap()
    let wav = match av_wav_open(data) {
      Ok(v) => v
      Err(e) => fail("\{name}: WAV open failed: \{e}")
    }
    assert_eq(wav.format.codec, codec, msg=name)
    assert_eq(wav.format.channels, channels, msg=name)
    assert_eq(wav.format.block_align, block_align, msg=name)
    let dec = match
      @libavcodec.adpcm_decoder_new(
        wav.format.codec,
        wav.format.channels,
        block_align=wav.format.block_align,
      ) {
      Ok(v) => v
      Err(e) => fail("\{name}: decoder init failed: \{e}")
    }
    let pcm : Array[Byte] = []
    for packet in wav.packets {
      let start = packet.pos.to_int()
      let bytes = data[start:start + packet.size]
      let mut off = 0
      while off + block_align <= bytes.length() {
        let block = bytes[off:off + block_align].to_owned()
        let audio = match dec.decode_block(block) {
          Ok(v) => v
          Err(e) => fail("\{name}: decode failed: \{e}")
        }
        assert_eq(audio.channels, channels, msg=name)
        for b in audio.pcm_bytes() {
          pcm.push(b)
        }
        off = off + block_align
      }
    }
    assert_eq(adpcm_md5(Bytes::from_array(pcm)), want_md5, msg=name)
  }
}
