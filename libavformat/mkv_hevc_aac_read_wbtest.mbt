///|
/// MKV demuxing of a real ffmpeg-made HEVC + AAC file: track parameters,
/// packet table, and a HEVC decode round-trip against FFmpeg 9.0.2
/// framemd5s. The AAC packets are decoded to prove the demuxer feeds the
/// decoder correctly (AAC content coverage lives in the libavcodec suites).

///|
let mkv_av_b64 : Bytes = b""

///|
let mkv_av_hevc_refs : Array[String] = [
  "6254246d64426bf103263c24a881141a", "6fc78df83c4f6768df8b056873755a79", "86295384f2291990f8fd75de969ccded",
  "b6b8c49344b942d1f2264617576d88ee", "490659a01b762afd6971892b843d099d",
]

///|
let mkv_av_hevc_unfiltered_refs : Array[String] = [
  "fae241d476e3376b134872194a1c7919", "7e6647b3ff70a9e3faa95ac8eb35e16f", "7146267c5acae1d5084be0c7998a5ff8",
  "6efd2a0078e2c1f7b61e80a3db03e523", "e442ab3b49648b4639bd215a17e80eab",
]

///|
/// Build a 4-byte length-prefixed Annex B replacement for the VPS/SPS/PPS
/// arrays of an hvcC, so `ff_hevc_decode_frames_ex` can parse the parameter
/// sets before the out-of-band-free Matroska packets.
fn mkv_av_hvcc_params(hvcc : Bytes) -> Bytes {
  let out : Array[Byte] = []
  let num_arrays = hvcc[22].to_int()
  let mut p = 23
  for _a = 0; _a < num_arrays; _a = _a + 1 {
    let nal_type = hvcc[p].to_int() & 0x3F
    let count = (hvcc[p + 1].to_int() << 8) | hvcc[p + 2].to_int()
    p = p + 3
    for _n = 0; _n < count; _n = _n + 1 {
      let len = (hvcc[p].to_int() << 8) | hvcc[p + 1].to_int()
      p = p + 2
      if nal_type >= 32 && nal_type <= 34 {
        out.push(((len >> 24) & 0xFF).to_byte())
        out.push(((len >> 16) & 0xFF).to_byte())
        out.push(((len >> 8) & 0xFF).to_byte())
        out.push((len & 0xFF).to_byte())
        for k = 0; k < len; k = k + 1 {
          out.push(hvcc[p + k])
        }
      }
      p = p + len
    }
  }
  Bytes::from_array(out)
}

///|
fn mkv_av_md5(yuv : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, yuv, yuv.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "mkv demux: HEVC + AAC tracks and HEVC decode round-trip" {
  let data = @libavutil.av_base64_decode(mkv_av_b64, 1000000).unwrap()
  let mkv = match av_matroska_open(data) {
    Ok(v) => v
    Err(e) => fail("open failed: \{e}")
  }
  assert_false(mkv.is_webm)
  assert_eq(mkv.tracks.length(), 2)
  let video = mkv.tracks[0]
  assert_eq(video.codec_id.unwrap(), "V_MPEGH/ISO/HEVC")
  assert_eq(video.video.pixel_width, 64UL)
  assert_eq(video.video.pixel_height, 64UL)
  let audio = mkv.tracks[1]
  assert_eq(audio.codec_id.unwrap(), "A_AAC")
  assert_eq(audio.audio.channels, 1UL)
  assert_true(
    (audio.audio.samplerate - 44100.0).abs() < 0.5,
    msg="AAC sample rate",
  )
  let hvcc = video.codec_priv.unwrap()
  assert_eq((hvcc[21].to_int() & 3) + 1, 4)
  let asc = audio.codec_priv.unwrap()
  assert_true(asc.length() >= 2)
  assert_eq(mkv.packets.length(), 50)
  let video_packets : Array[Bytes] = []
  let audio_packets : Array[Bytes] = []
  let video_pts : Array[Int64] = []
  for packet in mkv.packets {
    if packet.stream_index == 0 {
      video_packets.push(packet.data)
      video_pts.push(packet.pts)
      if video_packets.length() == 1 {
        assert_true(packet.is_keyframe)
      } else {
        assert_false(packet.is_keyframe)
      }
    } else {
      audio_packets.push(packet.data)
    }
  }
  assert_eq(video_packets.length(), 5)
  assert_eq(audio_packets.length(), 45)
  assert_eq(video_pts[0], 0L)
  assert_eq(video_pts[1], 200L)
  assert_eq(video_pts[4], 800L)
  // HEVC: prepend the hvcC parameter sets, then decode in both filter modes.
  let joined : Array[Byte] = []
  for b in mkv_av_hvcc_params(hvcc) {
    joined.push(b)
  }
  for packet in video_packets {
    for b in packet {
      joined.push(b)
    }
  }
  let stream = Bytes::from_array(joined)
  for filtered in [false, true] {
    let frames = match
      @libavcodec.ff_hevc_decode_frames_ex(stream, true, 4, filtered) {
      Ok(v) => v
      Err(e) => fail("HEVC decode failed: \{e}")
    }
    let sorted = frames.copy()
    sorted.sort_by((a, b) => a.poc().compare(b.poc()))
    let expected = if filtered {
      mkv_av_hevc_refs
    } else {
      mkv_av_hevc_unfiltered_refs
    }
    assert_eq(sorted.length(), expected.length())
    for i = 0; i < expected.length(); i = i + 1 {
      let got = mkv_av_md5(sorted[i].yuvp(8))
      assert_eq(got, expected[i], msg="HEVC frame \{i} filtered=\{filtered}")
    }
  }
  // AAC: the demuxed access units feed the decoder without errors.
  let dec = @libavcodec.new_aac_decoder_from_asc(asc).unwrap()
  for packet in audio_packets {
    match dec.decode_frame(packet) {
      Ok(pcm) => assert_eq(pcm.length(), 1)
      Err(e) => fail("AAC decode failed: \{e}")
    }
  }
}
