test "mov MACE3 with 1 channel(s) matches FFmpeg" {
  check_mace_fixture(
    bcat([
      b"AAAAFGZ0eXBxdCAgAAACAHF0ICAAAAAId2lkZQAAArBtZGF04eDgGODg4Bjg4OAY4ODgGODg4Bjg4OAY4ODgGODg4Bjg4O",
