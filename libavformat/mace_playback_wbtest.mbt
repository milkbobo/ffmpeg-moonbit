///|
/// FFmpeg FATE qt-surge-suite audio, trimmed with `-c copy -t 0.04`.
/// AIFC and CAF were stream-copied from the stereo clips.
/// Reference hashes are from FFmpeg 9.0.2 `-f s16le`.
fn check_mace_fixture(
  encoded : Bytes,
  format : String,
  codec : String,
  channels : Int32,
  expected_md5 : String,
) -> Unit raise {
  let file = @libavutil.av_base64_decode(encoded, 4096).unwrap()
  let audio = decode_audio_file(file)
  assert_eq(audio.format_name, format)
  assert_eq(audio.codec_id, codec)
  assert_eq(audio.channels, channels)
  assert_eq(audio.sample_rate, 44100)
  assert_eq(audio.read_error, "")
  if format == "mov,mp4,m4a,3gp,3g2,mj2" {
    let movie = av_mov_open(file).unwrap()
    let track = movie.tracks[0]
    let index = track.samples.length() - 1
    let last = track.samples[index]
    // Model the shorter final chunk of the untrimmed FATE sample.
    track.samples[index] = { ..last, duration: last.duration - 102U, }
    track.duration = last.pts.reinterpret_as_uint64() +
      track.samples[index].duration.to_uint64()
    assert_eq(mov_audio_tail_discard(movie, track), 0)
  }
  let wave = audio.to_wav_s16()
  let demux = av_wav_open(wave).unwrap()
  let start = demux.data_offset.to_int()
  assert_eq(demux.data_size, (2040 * channels * 2).to_int64())
  assert_eq(caf_md5(wave[start:].to_owned()), expected_md5)
}

