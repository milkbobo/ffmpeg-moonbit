///|
/// Ogg FLAC demuxer/writer tests: the fixture is ffmpeg's `-f ogg` muxing of
/// a 24-bit 44.1 kHz mono FLAC; references are FFmpeg's s32le decode.

///|
let ogg_flac_b64 : Bytes = b""

///|
let ogg_flac_pcm_md5 : String = "2d5bb7ccf66e68c7045c4032f947c881"

///|
fn ogg_flac_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
fn ogg_flac_check_decode(demux : OggFlacDemux) -> Unit raise {
  let audio = match @libavcodec.ff_flac_decode(demux.stream) {
    Ok(v) => v
    Err(e) => fail("FLAC decode failed: \{e}")
  }
  assert_eq(ogg_flac_md5(audio.pcm_bytes()), ogg_flac_pcm_md5)
}

///|
test "ogg flac: demux, assemble and decode" {
  let data = @libavutil.av_base64_decode(ogg_flac_b64, 1000000).unwrap()
  let demux = match av_ogg_flac_open(data) {
    Ok(v) => v
    Err(e) => fail("open failed: \{e}")
  }
  assert_eq(demux.sample_rate, 44100)
  assert_eq(demux.channels, 1)
  assert_eq(demux.bits, 24)
  assert_eq(demux.total_samples, 8820L)
  assert_eq(demux.headers.length(), 1)
  assert_eq(demux.frames.length(), 9)
  assert_eq(demux.frames[0].granule, 8820L)
  assert_eq(demux.frames[8].granule, 8820L)
  ogg_flac_check_decode(demux)
  // Round-trip: re-mux the demuxed metadata and frames, then read back.
  let mux = ogg_flac_muxer_new(
    demux.streaminfo,
    demux.headers,
    demux.total_samples,
  ).unwrap()
  for frame in demux.frames {
    mux.write_packet(frame.data).unwrap()
  }
  let bytes = mux.finish()
  let again = match av_ogg_flac_open(bytes) {
    Ok(v) => v
    Err(e) => fail("re-open failed: \{e}")
  }
  assert_eq(again.sample_rate, 44100)
  assert_eq(again.channels, 1)
  assert_eq(again.bits, 24)
  assert_eq(again.headers.length(), 1)
  assert_eq(again.frames.length(), 9)
  ogg_flac_check_decode(again)
}
