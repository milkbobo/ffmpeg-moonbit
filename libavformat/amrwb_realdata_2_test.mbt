///|
test "amrwb2 23k85: decodes to the references" {
  amrwb2_check(
    amrwb2_load(amrwb2_23k85_file),
    "mov,mp4,m4a,3gp,3g2,mj2",
    "amrwb",
    16000,
    1,
    163840,
    amrwb2_ref(amrwb2_23k85_cref_head),
    2,
    amrwb2_ref(amrwb2_23k85_cref_tail),
    2,
    amrwb2_ref(amrwb2_23k85_fate),
    32,
    22,
    "23k85",
  )
}

