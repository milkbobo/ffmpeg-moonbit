///|
/// ALAC encoder tests: mono/stereo SCE/CPE elements with Rice entropy coding,
/// wrapped in the 36-byte ALACSpecificConfig cookie.  The encoded frames are
/// decoded by `alac_decoder_new` and by FFmpeg 9.0.2 (via MP4), both matching
/// the source WAV PCM byte for byte.

///|
fn alacenc_b64_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let alacenc_s16_b64 : Bytes = alacenc_b64_concat([
  b"",
  b"",
  b"",
])

///|
let alacenc_s24_b64 : Bytes = alacenc_b64_concat([
  b"",
  b"",
])

///|
fn alacenc_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
fn alacenc_pcm_i32(wav : @libavformat.WavDemux, bytes : Bytes) -> Array[Int32] {
  let start = wav.data_offset.to_int()
  let end = start + wav.data_size.to_int()
  let out : Array[Int32] = []
  let bits = wav.format.bits_per_sample
  if bits == 16 {
    let mut i = start
    while i + 1 < end {
      let v = bytes[i].to_int() | (bytes[i + 1].to_int() << 8)
      out.push(if v >= 32768 { v - 65536 } else { v })
      i = i + 2
    }
  } else {
    let mut i = start
    while i + 2 < end {
      let v = bytes[i].to_int() |
        (bytes[i + 1].to_int() << 8) |
        (bytes[i + 2].to_int() << 16)
      out.push(if v >= 8388608 { v - 16777216 } else { v })
      i = i + 3
    }
  }
  out
}

///|
fn alacenc_check(
  wav_b64 : Bytes,
  exp_frames : Int32,
  exp_md5 : String,
) -> Unit raise {
  let bytes = @libavutil.av_base64_decode(wav_b64, 100000).unwrap()
  let wav = @libavformat.av_wav_open(bytes).unwrap()
  let samples = alacenc_pcm_i32(wav, bytes)
  let enc = @libavcodec.alac_encode(
    samples,
    wav.format.channels,
    wav.format.sample_rate,
    wav.format.bits_per_sample,
  ).unwrap()
  assert_eq(enc.cookie.length(), 36)
  assert_eq(enc.frames.length(), exp_frames)
  assert_eq(enc.cookie[4:8].to_owned(), b"alac")
  assert_eq(enc.cookie[17].to_int(), wav.format.bits_per_sample)
  assert_eq(enc.cookie[21].to_int(), wav.format.channels)
  let dec = @libavcodec.alac_decoder_new(enc.cookie).unwrap()
  let pcm : Array[Byte] = []
  let decoded : Array[Int32] = []
  for frame in enc.frames {
    let f = dec.decode_frame(frame).unwrap()
    assert_eq(f.channels, wav.format.channels)
    assert_eq(f.sample_rate, wav.format.sample_rate)
    for b in f.pcm_bytes() {
      pcm.push(b)
    }
    for v in f.samples {
      decoded.push(v)
    }
  }
  assert_eq(decoded.length(), samples.length())
  let shift = if wav.format.bits_per_sample > 16 { 8 } else { 0 }
  for i = 0; i < samples.length(); i = i + 1 {
    assert_eq(decoded[i] >> shift, samples[i])
  }
  assert_eq(alacenc_md5(Bytes::from_array(pcm)), exp_md5)
  // MP4 round-trip: the muxer stores the same cookie and frames.
  let mux = @libavformat.mp4_alac_muxer_new(enc.cookie).unwrap()
  let total = samples.length() / wav.format.channels
  let mut pos = 0
  for frame in enc.frames {
    let n = if total - pos < 4096 { total - pos } else { 4096 }
    mux.write_packet(frame, duration=n).unwrap()
    pos = pos + n
  }
  let mp4 = mux.finish()
  let movie = @libavformat.av_mov_open(mp4).unwrap()
  assert_eq(movie.tracks.length(), 1)
  assert_eq(movie.tracks[0].codec, "alac")
  assert_eq(movie.tracks[0].samples.length(), enc.frames.length())
  for i, sample in movie.tracks[0].samples {
    let start = sample.offset.to_int()
    let data = mp4[start:start + sample.size.reinterpret_as_int()].to_owned()
    assert_eq(data, enc.frames[i])
  }
}

///|
test "alac encoder: 16-bit stereo round-trips" {
  alacenc_check(alacenc_s16_b64, 3, "f3acc310ceb35e6ba4a2709b01cbf5c0")
}

///|
test "alac encoder: 24-bit mono round-trips" {
  alacenc_check(alacenc_s24_b64, 2, "741aa1373545b990376a81f9c652185f")
}

///|
fn alacenc_expect_reject(
  result : Result[@libavcodec.AlacEncoded, String],
) -> Unit raise {
  match result {
    Ok(_) => fail("expected invalid ALAC parameters to be rejected")
    Err(_) => ()
  }
}

///|
test "alac encoder: invalid parameters are rejected" {
  alacenc_expect_reject(@libavcodec.alac_encode([0, 1], 3, 44100, 16))
  alacenc_expect_reject(@libavcodec.alac_encode([0, 1], 1, 44100, 8))
  alacenc_expect_reject(@libavcodec.alac_encode([0, 1], 1, 44100, 20))
  alacenc_expect_reject(@libavcodec.alac_encode([0, 1], 1, 0, 16))
  alacenc_expect_reject(@libavcodec.alac_encode([0, 1, 2], 2, 44100, 16))
}
