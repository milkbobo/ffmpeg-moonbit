///|
fn flactags_find(tags : Array[(String, String)], key : String) -> String {
  let mut out = ""
  for pair in tags {
    if pair.0 == key {
      out = pair.1
    }
  }
  out
}

///|
fn flactags_pcm_md5(audio : @libavcodec.FlacAudio) -> String {
  let pcm = audio.pcm_bytes()
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, pcm, pcm.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "flac tags: reads ffmpeg Vorbis comments" {
  let data = @libavutil.av_base64_decode(flactags_b64, 200000).unwrap()
  let tags = @libavformat.flac_read_tags(data).unwrap()
  assert_eq(tags.length(), 4)
  assert_eq(flactags_find(tags, "title"), "Flac Title")
  assert_eq(flactags_find(tags, "artist"), "Flac Artist")
  assert_eq(flactags_find(tags, "album"), "Flac Album")
  assert_eq(flactags_find(tags, "encoder"), "Lavf63.1.102")
  let dec = @libavcodec.ff_flac_decode(data).unwrap()
  assert_eq(dec.samples.length(), 4410)
}

///|
test "flac tags: writer replaces comments and keeps frames" {
  let data = @libavutil.av_base64_decode(flactags_b64, 200000).unwrap()
  let plain = @libavcodec.ff_flac_decode(data).unwrap()
  let out = @libavformat.flac_add_tags(data, [
    ("title", "New"),
    ("ARTIST", "Up"),
    ("TRACKNUMBER", "3"),
  ]).unwrap()
  let tags = @libavformat.flac_read_tags(out).unwrap()
  assert_eq(tags.length(), 3)
  assert_eq(flactags_find(tags, "title"), "New")
  assert_eq(flactags_find(tags, "ARTIST"), "Up")
  // ff_vorbiscomment_metadata_conv maps TRACKNUMBER to the generic key.
  assert_eq(flactags_find(tags, "track"), "3")
  assert_eq(flactags_find(tags, "album"), "")
  let dec = @libavcodec.ff_flac_decode(out).unwrap()
  assert_eq(flactags_pcm_md5(dec), flactags_pcm_md5(plain))
  // An empty list removes the comment block; the file stays decodable.
  let bare = @libavformat.flac_add_tags(out, []).unwrap()
  assert_eq(@libavformat.flac_read_tags(bare).unwrap().length(), 0)
  assert_eq(
    flactags_pcm_md5(@libavcodec.ff_flac_decode(bare).unwrap()),
    flactags_pcm_md5(plain),
  )
}

///|
test "flac tags: invalid input and keys are rejected" {
  match @libavformat.flac_read_tags(b"not a flac file") {
    Ok(_) => fail("expected a non-FLAC file to be rejected")
    Err(_) => ()
  }
  match @libavformat.flac_add_tags(b"not a flac file", [("a", "b")]) {
    Ok(_) => fail("expected a non-FLAC file to be rejected")
    Err(_) => ()
  }
  let data = @libavutil.av_base64_decode(flactags_b64, 200000).unwrap()
  match @libavformat.flac_add_tags(data, [("bad=key", "v")]) {
    Ok(_) => fail("expected an invalid key to be rejected")
    Err(_) => ()
  }
}
