///|
/// Real FFmpeg 9.0.2 FLAC with a `VORBIS_COMMENT` block (lowercase keys, an
/// encoder tag and a trailing PADDING block).

///|
fn flactags_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

