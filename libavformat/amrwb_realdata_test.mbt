///|
test "amrwb1 raw 8k85: decodes to the references" {
  amrwb1_check(
    amrwb1_load(amrwb1_raw_8k85),
    "amr",
    "amrwb",
    16000,
    1,
    163840,
    amrwb1_ref(amrwb1_8k85_cref_head),
    2,
    amrwb1_ref(amrwb1_8k85_cref_tail),
    2,
    amrwb1_ref(amrwb1_8k85_fate),
    32,
    2,
    "raw 8k85",
  )
}

