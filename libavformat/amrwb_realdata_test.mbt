///|
test "amrwb1 15k85: decodes to the references" {
  amrwb1_check(
    amrwb1_load(amrwb1_15k85_file),
    "mov,mp4,m4a,3gp,3g2,mj2",
    "amrwb",
    16000,
    1,
    163840,
    amrwb1_ref(amrwb1_15k85_cref_head),
    2,
    amrwb1_ref(amrwb1_15k85_cref_tail),
    2,
    amrwb1_ref(amrwb1_15k85_fate),
    32,
    2,
    "15k85",
  )
}

