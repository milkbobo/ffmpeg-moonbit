///|
test "amrwb1 6k60: decodes to the references" {
  amrwb1_check(
    amrwb1_load(amrwb1_6k60_file),
    "mov,mp4,m4a,3gp,3g2,mj2",
    "amrwb",
    16000,
    1,
    163840,
    amrwb1_ref(amrwb1_6k60_cref_head),
    2,
    amrwb1_ref(amrwb1_6k60_cref_tail),
    2,
    amrwb1_ref(amrwb1_6k60_fate),
    32,
    11,
    "6k60",
  )
}

