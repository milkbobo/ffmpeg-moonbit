///|
test "amrwb1 12k65: decodes to the references" {
  amrwb1_check(
    amrwb1_load(amrwb1_12k65_file),
    "mov,mp4,m4a,3gp,3g2,mj2",
    "amrwb",
    16000,
    1,
    163840,
    amrwb1_ref(amrwb1_12k65_cref_head),
    2,
    amrwb1_ref(amrwb1_12k65_cref_tail),
    2,
    amrwb1_ref(amrwb1_12k65_fate),
    32,
    2,
    "12k65",
  )
}

