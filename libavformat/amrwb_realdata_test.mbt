///|
test "amrwb1 14k25: decodes to the references" {
  amrwb1_check(
    amrwb1_load(amrwb1_14k25_file),
    "mov,mp4,m4a,3gp,3g2,mj2",
    "amrwb",
    16000,
    1,
    163840,
    amrwb1_ref(amrwb1_14k25_cref_head),
    2,
    amrwb1_ref(amrwb1_14k25_cref_tail),
    2,
    amrwb1_ref(amrwb1_14k25_fate),
    32,
    2,
    "14k25",
  )
}

