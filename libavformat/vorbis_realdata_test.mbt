///|
/// Vorbis I decoder + Ogg demuxer tests on real libvorbis streams encoded by
/// FFmpeg 9.0.2 (`libvorbis` at quality 0/3/4/10, mono/stereo/5.1 and a pink
/// noise transient stream).  Each fixture is parsed by `av_ogg_vorbis_open`,
/// decoded with `vorbis_decoder_new` + `decode_stream[_trimmed]`, and the s16
/// output must keep the FFmpeg reference within 1 LSB with identical length.
///
/// The `noise` stream's granule is shorter than the final block, so FFmpeg
/// keeps the full last frame there; that case compares the untrimmed output.

///|
fn vorbis_b64_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let vorbis_mono_b64 : Bytes = vorbis_b64_concat([
  b"",
])

///|
let vorbis_mono_ref_b64 : Bytes = vorbis_b64_concat([
  b"",
  b"",
])

///|
let vorbis_stereo_b64 : Bytes = vorbis_b64_concat([
  b"",
])

///|
let vorbis_stereo_ref_b64 : Bytes = vorbis_b64_concat([
  b"",
  b"",
  b"",
  b"",
])

///|
let vorbis_noise_b64 : Bytes = vorbis_b64_concat([
  b"",
])

///|
let vorbis_noise_ref_b64 : Bytes = vorbis_b64_concat([
  b"",
  b"",
])

///|
let vorbis_surround_b64 : Bytes = vorbis_b64_concat([
  b"",
])

///|
let vorbis_surround_ref_b64 : Bytes = vorbis_b64_concat([
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
])

///|
fn vorbis_s16(pcm : Array[Double]) -> Bytes {
  let out : Array[Byte] = []
  for v in pcm {
    let q = if v >= 1.0 {
      32767
    } else if v <= -1.0 {
      -32768
    } else {
      (v * 32768.0).round().to_int()
    }
    out.push((q & 0xFF).to_byte())
    out.push(((q >> 8) & 0xFF).to_byte())
  }
  Bytes::from_array(out)
}

///|
fn vorbis_interleave(pcm : Array[Array[Double]]) -> Bytes {
  let chans : Array[Bytes] = []
  for ch in pcm {
    chans.push(vorbis_s16(ch))
  }
  let out : Array[Byte] = []
  let n = chans[0].length() / 2
  for i in 0..<n {
    for ch in chans {
      out.push(ch[i * 2])
      out.push(ch[i * 2 + 1])
    }
  }
  Bytes::from_array(out)
}

///|
fn vorbis_check_pcm(
  pcm : Array[Array[Double]],
  reference : Bytes,
  exp_channels : Int32,
) -> Unit raise {
  assert_eq(pcm.length(), exp_channels)
  let got = vorbis_interleave(pcm)
  assert_eq(got.length(), reference.length())
  let mut max_diff = 0
  for i in 0..<(reference.length() / 2) {
    let a = got[i * 2].to_int() | (got[i * 2 + 1].to_int() << 8)
    let b = reference[i * 2].to_int() | (reference[i * 2 + 1].to_int() << 8)
    let sa = if a >= 32768 { a - 65536 } else { a }
    let sb = if b >= 32768 { b - 65536 } else { b }
    let d = if sa > sb { sa - sb } else { sb - sa }
    if d > max_diff {
      max_diff = d
    }
  }
  assert_true(max_diff <= 1, msg="vorbis PCM differs by \{max_diff}")
}

///|
fn vorbis_open_fixture(
  b64 : Bytes,
  exp_channels : Int32,
  exp_rate : Int32,
  exp_packets : Int32,
  exp_total : Int64,
) -> (@libavformat.OggVorbisDemux, @libavcodec.VorbisDecoder) raise {
  let bytes = @libavutil.av_base64_decode(b64, 400000).unwrap()
  let demux = @libavformat.av_ogg_vorbis_open(bytes).unwrap()
  assert_eq(demux.channels, exp_channels)
  assert_eq(demux.sample_rate, exp_rate)
  assert_eq(demux.packets.length(), exp_packets)
  assert_eq(demux.total_samples, exp_total)
  let dec = @libavcodec.vorbis_decoder_new(demux.id_header, demux.setup_header).unwrap()
  assert_eq(dec.channels, exp_channels)
  assert_eq(dec.sample_rate, exp_rate)
  (demux, dec)
}

///|
fn vorbis_packet_data(demux : @libavformat.OggVorbisDemux) -> Array[Bytes] {
  let pkts : Array[Bytes] = []
  for p in demux.packets {
    pkts.push(p.data)
  }
  pkts
}

///|
test "Vorbis mono: Ogg demux + full decode" {
  let (demux, dec) = vorbis_open_fixture(vorbis_mono_b64, 1, 44100, 15, 13230L)
  let reference = @libavutil.av_base64_decode(vorbis_mono_ref_b64, 200000).unwrap()
  let pcm = dec
    .decode_stream_trimmed(vorbis_packet_data(demux), demux.total_samples)
    .unwrap()
  vorbis_check_pcm(pcm, reference, 1)
}

///|
test "Vorbis stereo: coupling and residue type 2" {
  let (demux, dec) = vorbis_open_fixture(
    vorbis_stereo_b64, 2, 44100, 15, 13230L,
  )
  let reference = @libavutil.av_base64_decode(vorbis_stereo_ref_b64, 200000).unwrap()
  let pcm = dec
    .decode_stream_trimmed(vorbis_packet_data(demux), demux.total_samples)
    .unwrap()
  vorbis_check_pcm(pcm, reference, 2)
}

///|
test "Vorbis noise: short-block transitions" {
  let (demux, dec) = vorbis_open_fixture(vorbis_noise_b64, 1, 44100, 14, 8820L)
  let reference = @libavutil.av_base64_decode(vorbis_noise_ref_b64, 200000).unwrap()
  let pcm = dec.decode_stream(vorbis_packet_data(demux)).unwrap()
  vorbis_check_pcm(pcm, reference, 1)
}

///|
test "Vorbis 5.1: two submaps, four coupling steps, native channel order" {
  let (demux, dec) = vorbis_open_fixture(
    vorbis_surround_b64, 6, 48000, 14, 12000L,
  )
  let reference = @libavutil.av_base64_decode(vorbis_surround_ref_b64, 400000).unwrap()
  let pcm = dec
    .decode_stream_trimmed(vorbis_packet_data(demux), demux.total_samples)
    .unwrap()
  vorbis_check_pcm(pcm, reference, 6)
}

///|
test "Vorbis Ogg: corrupt CRC and wrong codec are rejected" {
  let bytes = @libavutil.av_base64_decode(vorbis_mono_b64, 200000).unwrap()
  let bad = vorbis_b64_concat([
    bytes[0:60].to_owned(),
    b"␀",
    bytes[61:].to_owned(),
  ])
  assert_true(
    match @libavformat.av_ogg_vorbis_open(bad) {
      Ok(_) => false
      Err(_) => true
    },
  )
  assert_true(
    match @libavformat.av_ogg_vorbis_open(b"not an ogg stream") {
      Ok(_) => false
      Err(_) => true
    },
  )
}
