///|
/// Telephony codecs encoded by ffmpeg 9.0.2 into WAV: G.711 A-law/µ-law,
/// G.722 (tag 0x028F) and G.726 at 16/24/32/40 kbit/s. The WAV demuxer's
/// block-aligned packets are decoded and compared with FFmpeg's s16le PCM.

///|
let telephony_fixtures : Array[
  (String, Bytes, String, Int32, Int32, Int32, String),
] = [
  // alaw_stereo
  (
    "alaw_stereo", b"",
    "pcm_alaw", 8000, 2, 8, "defddc476e29af4ed74258b4a1414080",
  ),
  // alaw_mono
  (
    "alaw_mono", b"",
    "pcm_alaw", 8000, 1, 8, "4d9e1303ff45319ef1bdc009e0ab644d",
  ),
  // mulaw_stereo
  (
    "mulaw_stereo", b"",
    "pcm_mulaw", 8000, 2, 8, "cc1562a64d440d57d1d770c6b09a562b",
  ),
  // mulaw_mono
  (
    "mulaw_mono", b"",
    "pcm_mulaw", 8000, 1, 8, "ce3a932600fcb4f9f189c5a95e580bb6",
  ),
  // g722_mono
  (
    "g722_mono", b"",
    "adpcm_g722", 16000, 1, 4, "fa866b5401ad17021dfdf4cda1c93e40",
  ),
  // g726_16k
  (
    "g726_16k", b"",
    "adpcm_g726", 8000, 1, 2, "3c4dd4efa8a5e5f03848abee1735fac1",
  ),
  // g726_24k
  (
    "g726_24k", b"",
    "adpcm_g726", 8000, 1, 3, "859fd29a2c83b0ff860eb74fb548e674",
  ),
  // g726_32k
  (
    "g726_32k", b"",
    "adpcm_g726", 8000, 1, 4, "a0536288e8b15283f62de24ebed4fad1",
  ),
  // g726_40k
  (
    "g726_40k", b"",
    "adpcm_g726", 8000, 1, 5, "75802c10c7d62868e99adf8f78120401",
  ),
]

///|
fn telephony_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
fn telephony_push16(out : Array[Byte], v : Int32) -> Unit {
  out.push((v & 0xFF).to_byte())
  out.push(((v >> 8) & 0xFF).to_byte())
}

///|
test "telephony: ffmpeg WAV fixtures decode bit-exactly" {
  for fixture in telephony_fixtures {
    let (name, b64, codec, rate, channels, bits, want_md5) = fixture
    let data = @libavutil.av_base64_decode(b64, 100000).unwrap()
    let wav = match av_wav_open(data) {
      Ok(v) => v
      Err(e) => fail("\{name}: WAV open failed: \{e}")
    }
    assert_eq(wav.format.codec, codec, msg=name)
    assert_eq(wav.format.sample_rate, rate, msg=name)
    assert_eq(wav.format.channels, channels, msg=name)
    assert_eq(wav.format.bits_per_sample, bits, msg=name)
    let pcm : Array[Byte] = []
    if codec == "pcm_alaw" || codec == "pcm_mulaw" {
      for packet in wav.packets {
        let start = packet.pos.to_int()
        let bytes = data[start:start + packet.size].to_owned()
        let samples = if codec == "pcm_alaw" {
          @libavcodec.pcm_alaw_decode(bytes)
        } else {
          @libavcodec.pcm_mulaw_decode(bytes)
        }
        for v in samples {
          telephony_push16(pcm, v)
        }
      }
    } else if codec == "adpcm_g722" {
      let dec = @libavcodec.g722_decoder_new()
      for packet in wav.packets {
        let start = packet.pos.to_int()
        let bytes = data[start:start + packet.size].to_owned()
        for v in dec.decode(bytes) {
          telephony_push16(pcm, v)
        }
      }
    } else {
      let dec = match @libavcodec.g726_decoder_new(bits) {
        Ok(v) => v
        Err(e) => fail("\{name}: G.726 init failed: \{e}")
      }
      for packet in wav.packets {
        let start = packet.pos.to_int()
        let bytes = data[start:start + packet.size].to_owned()
        for v in dec.decode(bytes) {
          telephony_push16(pcm, v)
        }
      }
    }
    assert_eq(telephony_md5(Bytes::from_array(pcm)), want_md5, msg=name)
  }
}
