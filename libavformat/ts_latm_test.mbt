///|
/// LATM inside MPEG-TS: stream_type 0x11 PES payloads concatenate back into
/// the LOAS stream written by ffmpeg (`-mpegts_flags latm`); the demuxed
/// access units decode to FFmpeg's PCM within 1 LSB.

///|
let ts_latm_stream_b64 : String = ""

///|
let ts_latm_ref_b64 : String = ""

///|
fn ts_latm_bytes(s : String) -> Bytes {
  let out : Array[Byte] = []
  for i in 0..<s.length() {
    out.push((s[i].to_int() & 0xff).to_byte())
  }
  Bytes::from_array(out)
}

///|
fn ts_latm_decode(s : String) -> Bytes {
  @libavutil.av_base64_decode(ts_latm_bytes(s), 100000).unwrap()
}

///|
test "LATM audio in MPEG-TS decodes like ffmpeg" {
  let demux = @libavformat.av_mpegts_open(ts_latm_decode(ts_latm_stream_b64)).unwrap()
  let mut audio_pid = -1
  for stream in demux.streams {
    if stream.codec == "aac_latm" {
      audio_pid = stream.pid
    }
  }
  assert_true(audio_pid >= 0, msg="no aac_latm stream")
  let es : Array[Byte] = []
  let mut pes = 0
  for packet in demux.packets {
    if packet.pid == audio_pid {
      for b in packet.payload {
        es.push(b)
      }
      pes = pes + 1
    }
  }
  assert_true(pes > 0, msg="no LATM PES packets")
  let latm = @libavcodec.latm_parse_stream(Bytes::from_array(es)).unwrap()
  assert_eq(latm.asc.length(), 2)
  assert_eq(latm.frames.length(), 3)
  let decoder = @libavcodec.new_aac_decoder_from_asc(latm.asc).unwrap()
  let pcm : Array[Byte] = []
  for frame in latm.frames {
    let elements = match decoder.decode_frame(frame) {
      Ok(v) => v
      Err(e) => fail("AAC LATM decode failed: " + e)
    }
    for element in elements {
      for v in element.samples {
        let q = if v >= 1.0 {
          32767
        } else if v <= -1.0 {
          -32768
        } else {
          (v * 32768.0).round().to_int()
        }
        pcm.push((q & 0xFF).to_byte())
        pcm.push(((q >> 8) & 0xFF).to_byte())
      }
    }
  }
  let reference = ts_latm_decode(ts_latm_ref_b64)
  assert_eq(pcm.length(), reference.length())
  let mut max_diff = 0
  for i in 0..<(reference.length() / 2) {
    let a = pcm[i * 2].to_int() | (pcm[i * 2 + 1].to_int() << 8)
    let b = reference[i * 2].to_int() | (reference[i * 2 + 1].to_int() << 8)
    let sa = if a >= 32768 { a - 65536 } else { a }
    let sb = if b >= 32768 { b - 65536 } else { b }
    let d = if sa > sb { sa - sb } else { sb - sa }
    if d > max_diff {
      max_diff = d
    }
  }
  assert_true(
    max_diff <= 1,
    msg="TS LATM PCM differs by " + max_diff.to_string(),
  )
}
