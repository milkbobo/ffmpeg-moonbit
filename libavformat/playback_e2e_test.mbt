///|
/// Decode every frame of the first video stream through the facade.
fn e2e_decode_all(data : Bytes) -> Array[@libavformat.VideoFrame] raise {
  let mf = @libavformat.MediaFile::open(data)
  let mut video = -1
  for i = 0; i < mf.streams().length(); i = i + 1 {
    if video < 0 && mf.streams()[i].media_type == @libavformat.MediaType::Video {
      video = i
    }
  }
  assert_true(video >= 0)
  let dec = @libavformat.VideoDecoder::open(mf.streams()[video])
  let frames : Array[@libavformat.VideoFrame] = []
  while true {
    let pkt = match mf.next_packet() {
      Some(p) => p
      None => break
    }
    if pkt.stream_index != video {
      continue
    }
    for f in dec.decode(pkt) {
      frames.push(f)
    }
  }
  for f in dec.finish_video() {
    frames.push(f)
  }
  frames
}

///|
test "playback e2e: HEVC/VP9/AV1 real streams decode 5 frames each" {
  for
    pair in [
      ("hevc", e2e_hevc_mkv_b64),
      ("vp9", e2e_vp9_webm_b64),
      ("av1", e2e_av1_mkv_b64),
    ] {
    let (name, b64) = pair
    let data = @libavutil.av_base64_decode(b64, 1 << 20).unwrap()
    let frames = e2e_decode_all(data) catch {
      @libavformat.DecodeError(m) => fail("\{name}: decode: \{m}")
      @libavformat.UnsupportedCodec(m) => fail("\{name}: unsupported: \{m}")
      e => fail("\{name}: \{e}")
    }
    assert_eq(frames.length(), 5, msg="\{name}: frame count")
    for f in frames {
      assert_eq(f.width(), 64, msg="\{name}: width")
      assert_eq(f.height(), 64, msg="\{name}: height")
      assert_eq(
        f.yuv_bytes().length(),
        64 * 64 * 3 / 2,
        msg="\{name}: yuv size",
      )
    }
  }
}
