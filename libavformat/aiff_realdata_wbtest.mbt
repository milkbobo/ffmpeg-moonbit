///|
/// Real AIFF fixtures written by ffmpeg 9.0.2 (pcm_s8/s16be/s24be/s32be)
/// from deterministic 8 kHz sources, decoded by the same build as s8le or
/// s32le references. The port reads `FORM`/`COMM`/`SSND`, decodes the 80-bit
/// extended sample rate and converts the PCM to the reference layout.

///|
let aiff_fixtures : Array[
  (String, Bytes, String, Int32, Int32, Int32, Int32, String),
] = [
  // s16_stereo
  (
    "s16_stereo", b"",
    "pcm_s16be", 2, 16, 8000, 8000, "c35b7be85585417ff968a890e9d85a8d",
  ),
  // s16_mono
  (
    "s16_mono", b"",
    "pcm_s16be", 1, 16, 8000, 8000, "998ae6d7b6361fe5caadfb0a41c9e018",
  ),
  // s8_stereo
  (
    "s8_stereo", b"",
    "pcm_s8", 2, 8, 8000, 8000, "930a96556d88f2a3845bd33f84daaa2f",
  ),
  // s24_stereo
  (
    "s24_stereo",
    b"" +
    b"" +
    b"",
    "pcm_s24be",
    2,
    24,
    8000,
    20000,
    "322c025b332b30e4de9ab0a987169cea",
  ),
  // s32_stereo
  (
    "s32_stereo",
    b"" +
    b"" +
    b"" +
    b"",
    "pcm_s32be",
    2,
    32,
    8000,
    20000,
    "322c025b332b30e4de9ab0a987169cea",
  ),
]

///|
/// Read the big-endian PCM packets and emit the reference layout: s8 bytes
/// for 8-bit, LE s16 for 16-bit, and LE s32 (left-justified) for 24/32-bit.
fn aiff_pcm_reference(demux : AiffDemux, data : Bytes) -> Bytes {
  let bits = demux.format.bits
  let channels = demux.format.channels
  let bytes = bits / 8
  let out : Array[Byte] = []
  for packet in demux.packets {
    let start = packet.pos.to_int()
    let end = start + packet.size
    let mut off = start
    while off + bytes <= end {
      for _c = 0; _c < channels; _c = _c + 1 {
        let mut v : UInt32 = 0
        for i = 0; i < bytes; i = i + 1 {
          v = (v << 8) | data[off + i].to_uint()
        }
        off = off + bytes
        let sv = v.reinterpret_as_int() << (32 - bits) >> (32 - bits)
        if bits == 8 {
          out.push((sv & 0xFF).to_byte())
        } else if bits == 16 {
          out.push((sv & 0xFF).to_byte())
          out.push(((sv >> 8) & 0xFF).to_byte())
        } else if bits == 24 {
          let wide = (v << 8).reinterpret_as_int()
          out.push((wide & 0xFF).to_byte())
          out.push(((wide >> 8) & 0xFF).to_byte())
          out.push(((wide >> 16) & 0xFF).to_byte())
          out.push(((wide >> 24) & 0xFF).to_byte())
        } else {
          out.push((sv & 0xFF).to_byte())
          out.push(((sv >> 8) & 0xFF).to_byte())
          out.push(((sv >> 16) & 0xFF).to_byte())
          out.push(((sv >> 24) & 0xFF).to_byte())
        }
      }
    }
  }
  Bytes::from_array(out)
}

///|
fn aiff_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "aiff: ffmpeg fixtures decode like the references" {
  for fixture in aiff_fixtures {
    let (name, b64, codec, channels, bits, rate, count, want_md5) = fixture
    let data = @libavutil.av_base64_decode(b64, 400000).unwrap()
    let demux = match av_aiff_open(data) {
      Ok(v) => v
      Err(e) => fail("\{name}: open failed: \{e}")
    }
    assert_eq(demux.format.codec, codec, msg=name)
    assert_eq(demux.format.channels, channels, msg=name)
    assert_eq(demux.format.bits, bits, msg=name)
    assert_eq(demux.format.sample_rate, rate, msg=name)
    assert_eq(demux.sample_count, count.to_int64(), msg=name)
    let pcm = aiff_pcm_reference(demux, data)
    assert_eq(aiff_md5(pcm), want_md5, msg=name)
    let mux = aiff_muxer_new(rate, channels, bits~).unwrap()
    let samples : Array[Int32] = []
    for i = 0
        i <
       pcm.length() / (if bits == 8 { 1 } else if bits == 16 { 2 } else { 4 })
        i = i + 1 {
      let v = if bits == 8 {
        let b = pcm[i].to_int()
        if b >= 0x80 {
          b - 0x100
        } else {
          b
        }
      } else if bits == 16 {
        let b = pcm[2 * i].to_int() | (pcm[2 * i + 1].to_int() << 8)
        if b >= 0x8000 {
          b - 0x10000
        } else {
          b
        }
      } else {
        pcm[4 * i].to_int() |
        (pcm[4 * i + 1].to_int() << 8) |
        (pcm[4 * i + 2].to_int() << 16) |
        (pcm[4 * i + 3].to_int() << 24)
      }
      samples.push(v)
    }
    // 24-bit reference bytes are left-justified s32; the writer stores 24 bits.
    if bits == 24 {
      for i = 0; i < samples.length(); i = i + 1 {
        samples[i] = samples[i] >> 8
      }
    }
    mux.write_samples(samples)
    let out = mux.finish()
    let demux2 = av_aiff_open(out).unwrap()
    assert_eq(demux2.format.codec, codec, msg=name)
    assert_eq(demux2.format.sample_rate, rate, msg=name)
    assert_eq(demux2.sample_count, count.to_int64(), msg=name)
    let roundtrip = aiff_pcm_reference(demux2, out)
    assert_eq(aiff_md5(roundtrip), want_md5, msg=name)
  }
}

///|
test "aiff: rejects malformed files" {
  assert_true(av_aiff_open(b"FORM") is Err(_))
  assert_true(av_aiff_open(b"RIFF\x00\x00\x00\x00WAVE") is Err(_))
}
