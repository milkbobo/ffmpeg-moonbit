///|
test "RealAudio 14.4 FATE stream is bit exact" {
  let data = b"" +
    b"" +
    b"PRhqScF17XkSmmDwtLYiWLjjC8UzoLLaL/J2SMpGMpJlrDqp+/cZVcyLWq4ZKth8duw+jFesYoul//1tHquTaVfLHXzEIEnzc5TCjrwc7Xv3xxPdwwtgfLswVa9zzSpwNgZkgfKAZAy/x2F/7TpBznTNqlBnXOgMhLIUL/CW4mKowA5xtpYyMP/NqItgz3x//ImjLx6s"
  let pcm = b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"8P88ANz/tP9I/+D+GP8M/9j+8P40/2D/xP/8/3T9APdQ9ET2PPdI9xj43Pgo+kT9GAFgA1AEUAXcBgQI3AgcCuAKPAtoC9wKIAqECUwIrAbcBJwCnAAQ/6z9pPwU/GT7+PpI+kz57Pjg+Kj4tPj8+ED5yPm4+vD7NP1g/mz/gACMAWwCBAMkAwQDGAMgA+wCuAKkAkQC"
  let data = @libavutil.av_base64_decode(data, 2400).unwrap()
  let pcm = @libavutil.av_base64_decode(pcm, 38400).unwrap()
  let dec = @libavcodec.Ra144Decoder::new()
  for i = 0; i < 10; i = i + 1 {
    let start = i * 240
    let samples = dec.decode_packet(data[start:start + 240].to_owned()).unwrap()
    assert_eq(samples.length(), 1920)
    for j, actual in samples {
      let offset = (i * 1920 + j) * 2
      let expected = (pcm[offset].to_int() | (pcm[offset + 1].to_int() << 8)) <<
        16 >>
        16
      if actual != expected {
        fail("packet \{i}, sample \{j}: expected \{expected}, got \{actual}")
      }
    }
  }
}

///|
test "RealAudio 28.8 FATE stream matches FFmpeg 9.0.2" {
  let data = b""
  let pcm = b"" +
    b"" +
    b""
  let data = @libavutil.av_base64_decode(data, 380).unwrap()
  let pcm = @libavutil.av_base64_decode(pcm, 3200).unwrap()
  let dec = @libavcodec.Ra288Decoder::new(38).unwrap()
  for i = 0; i < 10; i = i + 1 {
    let start = i * 38
    let samples = dec.decode_packet(data[start:start + 38].to_owned()).unwrap()
    assert_eq(samples.length(), 160)
    for j, sample in samples {
      let offset = (i * 160 + j) * 2
      let expected = (pcm[offset].to_int() | (pcm[offset + 1].to_int() << 8)) <<
        16 >>
        16
      let actual = (sample * 32768.0)
        .round()
        .clamp(min=-32768.0, max=32767.0)
        .to_int()
      if (actual - expected).abs() > 1 {
        fail("packet \{i}, sample \{j}: expected \{expected}, got \{actual}")
      }
    }
  }
}
