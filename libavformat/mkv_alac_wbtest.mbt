///|
/// Matroska ALAC: the ffmpeg-made `alac.mka` is read (A_ALAC + 36-byte
/// CodecPrivate), decoded to the ALAC reference PCM, and remuxed with
/// `MkvAlacMuxer`; the remux is byte-transparent and decodes identically.

///|
let mkv_alac_real_b64 = b""

///|
test "mkv: ALAC read and write round-trip" {
  let want_md5 = "38fb308079b63baf40e49bd051d22bc8"
  let data = @libavutil.av_base64_decode(mkv_alac_real_b64, 200000).unwrap()
  let src = av_matroska_open(data).unwrap()
  assert_eq(src.tracks.length(), 1)
  let track = src.tracks[0]
  assert_eq(track.codec_id.unwrap(), "A_ALAC")
  let cookie = track.codec_priv.unwrap()
  assert_eq(cookie.length(), 36)
  assert_eq(track.audio.samplerate, 44100.0)
  assert_eq(track.audio.channels, 2UL)
  let dec = @libavcodec.alac_decoder_new(cookie).unwrap()
  let pcm : Array[Byte] = []
  let packets : Array[Bytes] = []
  for p in src.packets {
    if p.stream_index == 0 {
      packets.push(p.data)
      let frame = match dec.decode_frame(p.data) {
        Ok(v) => v
        Err(e) => fail("ALAC decode failed: \{e}")
      }
      for b in frame.pcm_bytes() {
        pcm.push(b)
      }
    }
  }
  assert_eq(packets.length(), 6)
  assert_eq(mkv_alac_md5(Bytes::from_array(pcm)), want_md5)
  let mux = mkv_alac_muxer_new(cookie).unwrap()
  let mut pts = 0L
  for p in src.packets {
    if p.stream_index == 0 {
      let dur = if p.duration > 0UL { p.duration.to_int() } else { 93 }
      mux.write_packet(p.data, pts, dur).unwrap()
      pts = pts + dur.to_int64()
    }
  }
  let out = mux.finish()
  let mkv = av_matroska_open(out).unwrap()
  assert_eq(mkv.tracks.length(), 1)
  assert_eq(mkv.tracks[0].codec_id.unwrap(), "A_ALAC")
  assert_eq(mkv.tracks[0].codec_priv.unwrap(), cookie)
  assert_eq(mkv.packets.length(), 6)
  for i, p in mkv.packets {
    assert_eq(p.data, packets[i])
  }
  let dec2 = @libavcodec.alac_decoder_new(mkv.tracks[0].codec_priv.unwrap()).unwrap()
  let pcm2 : Array[Byte] = []
  for p in mkv.packets {
    let frame = match dec2.decode_frame(p.data) {
      Ok(v) => v
      Err(e) => fail("remuxed ALAC decode failed: \{e}")
    }
    for b in frame.pcm_bytes() {
      pcm2.push(b)
    }
  }
  assert_eq(mkv_alac_md5(Bytes::from_array(pcm2)), want_md5)
}

///|
fn mkv_alac_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}
