test "resample realdata: 48k->44.1k mono" {
  swr_resample_case(
    swr_m48_b64,
    swr_m48_to_44k_b64,
    in_rate=48000,
    out_rate=44100,
    channels=1,
    allowed_mismatches=3,
  )
}

