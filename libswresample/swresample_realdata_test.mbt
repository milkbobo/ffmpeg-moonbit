///|
test "resample realdata: 48k->44.1k stereo" {
  swr_resample_case(
    swr_s48_b64,
    swr_s48_to_44k_b64,
    in_rate=48000,
    out_rate=44100,
    channels=2,
    allowed_mismatches=2,
  )
}

