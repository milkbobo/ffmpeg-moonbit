///|
test "resample realdata: 48k->96k mono 2x upsample" {
  swr_resample_case(
    swr_m48_b64,
    swr_m48_to_96k_b64,
    in_rate=48000,
    out_rate=96000,
    channels=1,
    allowed_mismatches=6,
  )
}

