///|
/// Byte-level vectors for the polyphase resampler against FFmpeg
/// 9.0.2 (`aresample`, default swr engine: 32 taps, phase_shift 10,
/// kaiser beta 9, cutoff 0.97, exact rational, FLTP internal).
/// Inputs are deterministic two-tone signals quantized to s16; both
/// sides are embedded.  Reference command (docker ffmpeg 9.0.2):
///   ffmpeg -f s16le -ar <in_rate> -ac <ch> -i in.pcm -ar <out_rate>
///          -f s16le out.pcm

///|
fn swr_vec_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
/// Run one embedded input through the resampler and compare the s16
/// output byte-exactly against the embedded FFmpeg reference.
fn swr_resample_case(
  in_b64 : Bytes,
  ref_b64 : Bytes,
  in_rate~ : Int32,
  out_rate~ : Int32,
  channels~ : Int32,
  allowed_mismatches~ : Int32,
) -> Unit raise {
  let pcm = match @libavutil.av_base64_decode(in_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let ref_pcm = match @libavutil.av_base64_decode(ref_b64, 100000) {
    Ok(v) => v
    Err(e) => fail("base64: \{e}")
  }
  let frames = pcm.length() / 2 / channels
  let planes : Array[Array[Double]] = []
  for ch in 0..<channels {
    let p : Array[Double] = []
    for i in 0..<frames {
      let raw = pcm[(i * channels + ch) * 2].to_int() |
        (pcm[(i * channels + ch) * 2 + 1].to_int() << 8)
      let s = if raw >= 0x8000 { raw - 0x10000 } else { raw }
      p.push(s.to_double() / 32768.0)
    }
    planes.push(p)
  }
  let r = @swr.SwrResampler::new(in_rate~, out_rate~, channels~)
  let out_planes : Array[Array[Double]] = Array::make(channels, [])
  for ci in 0..<channels {
    out_planes[ci] = []
  }
  let calls : Array[Array[Array[Double]]] = [r.process(planes), r.flush()]
  for call in calls {
    for ci in 0..<call.length() {
      for v in call[ci] {
        out_planes[ci].push(v)
      }
    }
  }
  let n_out = out_planes[0].length()
  let ref_n = ref_pcm.length() / 2 / channels
  inspect(n_out, content=ref_n.to_string())
  let mut mismatches = 0
  let mut max_delta = 0
  for i in 0..<n_out {
    for ch in 0..<channels {
      let ours = @swr.swr_f32_to_s16(Float::from_double(out_planes[ch][i]))
      let raw = ref_pcm[(i * channels + ch) * 2].to_int() |
        (ref_pcm[(i * channels + ch) * 2 + 1].to_int() << 8)
      let theirs = if raw >= 0x8000 { raw - 0x10000 } else { raw }
      let delta = ours - theirs
      if delta < 0 {
        if -delta > max_delta {
          max_delta = -delta
        }
      } else if delta > max_delta {
        max_delta = delta
      }
      if ours != theirs {
        mismatches = mismatches + 1
      }
    }
  }
  // Sub-LSB residual: the f64 libm (sin/cos/exp) behind the filter
  // design differs from glibc by ~1 ulp on a few taps, flipping the
  // final rounding of a handful of samples; the 198-tap 48k->8k case
  // is byte-exact.  Counts and values are pinned.
  inspect(mismatches, content=allowed_mismatches.to_string())
  inspect(max_delta, content=if allowed_mismatches > 0 { "1" } else { "0" })
}

