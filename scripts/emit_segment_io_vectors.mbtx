import {
  "moonbitlang/x/fs",
  "moonbitlang/core/encoding/base64",
}

fn main raise {
  let out = StringBuilder()
  out.write_string("///|\n/// Real HLS TS, HLS fMP4 and DASH fMP4 fixtures from FFmpeg 9.0.2.\n/// Source: testsrc2=size=64x48:rate=2, four frames; libx264 baseline,\n/// ultrafast, yuv420p, g=2:keyint_min=2:sc_threshold=0:bf=0, no audio.\n/// HLS: -hls_time 1 -hls_playlist_type vod [-hls_segment_type fmp4].\n/// DASH: -f dash -seg_duration 1 -use_timeline 1.\n/// Reference: ffmpeg -i list.m3u8/list.mpd -f framemd5 reference.md5.\n/// Regenerate embedded bytes: moon run scripts/emit_segment_io_vectors.mbtx\n/// LGPL-2.1-or-later.\n\n")
  for folder in ["segments_ts", "segments_mp4", "segments_dash"] {
    let dir = ".scratch/" + folder
    let manifest = if folder == "segments_dash" { "list.mpd" } else { "list.m3u8" }
    out.write_string("///|\nlet " + folder + "_manifest : String =\n")
    for line in @fs.read_file_to_string(dir + "/" + manifest).split("\n") {
      out.write_string("  #|" + line.trim_end(chars="\r").to_owned() + "\n")
    }
    out.write_string("\n///|\nlet " + folder + "_md5 : Array[String] = [\n")
    for line in @fs.read_file_to_string(dir + "/reference.md5").split("\n") {
      if !line.trim().is_empty() && !line.has_prefix("#") {
        let fields = line.split(",").collect()
        out.write_string("  \"" + fields[fields.length() - 1].trim().to_owned() + "\",\n")
      }
    }
    out.write_string("]\n\n///|\nlet " + folder + "_files : Array[(String, Bytes)] = [\n")
    let files = @fs.read_dir(dir).to_owned()
    files.sort()
    for file in files {
      if file.has_suffix(".ts") || file.has_suffix(".m4s") || file.has_suffix(".mp4") {
        let data = @base64.encode(@fs.read_file_to_bytes(dir + "/" + file))
        out.write_string("  (\"https://example.test/" + folder + "/" + file + "\",\n")
        for i = 0; i < data.length(); i = i + 112 {
          if i > 0 { out.write_string(" +\n") }
          out.write_string("    b\"" + data[i:(i + 112).min(data.length())].to_owned() + "\"")
        }
        out.write_string("),\n")
      }
    }
    out.write_string("]\n\n")
  }
  @fs.write_string_to_file("libavformat/segment_io_realdata_wbtest.mbt", out.to_string())
}
