import { "moonbitlang/x/fs" }

///|
fn mbaff_bit(data : Bytes, pos : Int32) -> Int32 {
  (data[pos / 8].to_int() >> (7 - pos % 8)) & 1
}

///|
fn mbaff_first_mb(data : Bytes) -> Int32 {
  let mut zeros = 0
  while mbaff_bit(data, zeros) == 0 { zeros += 1 }
  let mut value = 1
  for i = 0; i < zeros; i = i + 1 {
    value = value * 2 + mbaff_bit(data, zeros + 1 + i)
  }
  value - 1
}

///|
fn main raise {
  let source = @fs.read_file_to_bytes(".scratch/h264_mbaff_slices.264")
  let starts : Array[(Int32, Int32)] = []
  for i = 0; i + 3 <= source.length(); i = i + 1 {
    if source[i] == 0 && source[i + 1] == 0 && source[i + 2] == 1 {
      starts.push((if i > 0 && source[i - 1] == 0 { i - 1 } else { i }, i + 3))
    }
  }
  starts.push((source.length(), source.length()))
  let out : Array[Byte] = []
  let mut dropped = false
  for i = 0; i + 1 < starts.length(); i = i + 1 {
    let header = starts[i].1
    let kind = source[header].to_int() & 31
    let mut omit = false
    if kind == 1 || kind == 5 {
      let payload = source[header + 1:starts[i + 1].0].to_owned()
      let first_mb = mbaff_first_mb(payload)
      if !dropped && first_mb > 0 {
        omit = true
        dropped = true
        println("dropped nal=\{i} first_mb=\{first_mb}")
      }
    }
    if !omit {
      for j = starts[i].0; j < starts[i + 1].0; j = j + 1 {
        out.push(source[j])
      }
    }
  }
  guard dropped else { fail("no non-first MBAFF slice found") }
  @fs.write_bytes_to_file(
    ".scratch/h264_er_drop_mbaff.264", Bytes::from_array(out[:]),
  )
}
