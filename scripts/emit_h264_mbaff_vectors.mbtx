import { "moonbitlang/x/fs", "moonbitlang/core/encoding/base64" }

fn main raise {
  let out = StringBuilder()
  out.write_string("///|\n/// Original FFmpeg 9.0.2 MBAFF framemd5. Generated by\n/// scripts/emit_h264_mbaff_vectors.mbtx. LGPL-2.1-or-later.\n")
  let names = [
    "h264_mbaff_i_cavlc_nodct", "h264_mbaff_i_cavlc_dct",
    "h264_mbaff_i_cabac_nodct", "h264_mbaff_i_cabac_dct",
    "h264_mbaff_i_cabac_frame", "h264_mbaff_p_cavlc", "h264_mbaff_p_cabac",
    "h264_mbaff_basic", "h264_mbaff_p10", "h264_mbaff_frame_cavlc",
    "h264_mbaff_b_cavlc", "h264_mbaff_b_cabac",
    "h264_mbaff_422", "h264_mbaff_444", "h264_mbaff_b_temporal", "h264_mbaff_slices",
  ]
  for name in names {
    let b64 = @base64.encode(@fs.read_file_to_bytes(".scratch/" + name + ".264"))
    out.write_string("\n///|\nlet " + name + "_b64 : Bytes =\n")
    for start = 0; start < b64.length(); start = start + 112 {
      if start > 0 { out.write_string(" +\n") }
      out.write_string("  b\"" + b64[start:(start + 112).min(b64.length())].to_owned() + "\"")
    }
    out.write_string("\n")
    for suffix in ["", "_unf"] {
      out.write_string("\n///|\nlet " + name + suffix + "_md5 : Array[String] = [\n")
      for line in @fs.read_file_to_string(".scratch/" + name + suffix + ".md5").split("\n") {
        if !line.trim().is_empty() && !line.has_prefix("#") {
          let fields = line.split(",").collect()
          out.write_string("  \"" + fields[fields.length() - 1].trim().to_owned() + "\",\n")
        }
      }
      out.write_string("]\n")
    }
    out.write_string("\n///|\ntest \"h264 MBAFF pixels: " + name + " filtered/unfiltered\" {\n")
    out.write_string("  let data = @libavutil.av_base64_decode(" + name + "_b64, 1000000).unwrap()\n")
    out.write_string("  for skip in [true, false] {\n")
    out.write_string("    let frames = match h264_decode_annexb_display_frames(data, skip) { Ok(value) => value; Err(error) => fail(\"" + name + ": \" + error) }\n")
    out.write_string("    let expected = if skip { " + name + "_unf_md5 } else { " + name + "_md5 }\n")
    out.write_string("    assert_eq(frames.length(), expected.length())\n")
    out.write_string("    for i, frame in frames {\n      let got = h264_yuv_md5(frame)\n      if got != expected[i] { fail(\"" + name + "\" + (if skip { \" unf\" } else { \" filt\" }) + \" frame \" + i.to_string() + \" got \" + got + \" exp \" + expected[i]) }\n    }\n  }\n}\n")
  }
  @fs.write_string_to_file("libavcodec/h264_mbaff_realdata_wbtest.mbt", out.to_string())
}
