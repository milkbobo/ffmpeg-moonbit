import { "moonbitlang/x/fs", "moonbitlang/core/env" }

struct Bits { data : Array[Int] }
fn Bits::new() -> Bits { { data: [] } }
fn Bits::put(self : Bits, value : Int, count : Int) -> Unit {
  for i = count - 1; i >= 0; i = i - 1 { self.data.push((value >> i) & 1) }
}
fn Bits::ue(self : Bits, value : Int) -> Unit {
  let v = value + 1
  let mut n = 0
  let mut x = v
  while x > 1 { n += 1; x = x >> 1 }
  self.put(0, n); self.put(v, n + 1)
}
fn Bits::se(self : Bits, value : Int) -> Unit { self.ue(if value > 0 { 2 * value - 1 } else { -2 * value }) }
fn Bits::align(self : Bits, bit : Int) -> Unit { while self.data.length() % 8 != 0 { self.put(bit, 1) } }
fn Bits::nal(self : Bits, output : Array[Byte], header : Int) -> Unit {
  self.put(1, 1); self.align(0)
  for b in [0, 0, 0, 1, header] { output.push(b.to_byte()) }
  let mut zeros = 0
  for start = 0; start < self.data.length(); start = start + 8 {
    let mut byte = 0
    for i in 0..<8 { byte = (byte << 1) | self.data[start + i] }
    if zeros == 2 && byte <= 3 { output.push(3); zeros = 0 }
    output.push(byte.to_byte())
    zeros = if byte == 0 { zeros + 1 } else { 0 }
  }
}
fn main raise {
  if @env.args().contains("--depth") {
    for depth in [9, 10, 12, 14] {
      let output : Array[Byte] = []
      let sps = Bits::new()
      sps.put(244, 8); sps.put(0, 8); sps.put(30, 8); sps.ue(0)
      sps.ue(1); sps.ue(depth - 8); sps.ue(depth - 8); sps.put(0, 1); sps.put(0, 1)
      sps.ue(0); sps.ue(0); sps.ue(0); sps.ue(1); sps.put(0, 1); sps.ue(0); sps.ue(0)
      sps.put(1, 1); sps.put(1, 1); sps.put(0, 1); sps.put(0, 1); sps.nal(output, 0x67)
      let pps = Bits::new()
      pps.ue(0); pps.ue(0); pps.put(0, 1); pps.put(0, 1); pps.ue(0); pps.ue(0); pps.ue(0)
      pps.put(0, 1); pps.put(0, 2); pps.se(0); pps.se(0); pps.se(0)
      pps.put(1, 1); pps.put(0, 1); pps.put(0, 1); pps.nal(output, 0x68)
      for frame in 0..<2 {
        let slice = Bits::new()
        slice.ue(0); slice.ue(if frame == 0 { 2 } else { 0 }); slice.ue(0); slice.put(frame, 4)
        if frame == 0 { slice.ue(0) }
        slice.put(frame * 2, 4)
        if frame == 0 { slice.put(0, 1); slice.put(0, 1) }
        else { slice.put(0, 1); slice.put(0, 1); slice.put(0, 1) }
        slice.se(0); slice.ue(1)
        if frame == 0 {
          slice.ue(25); slice.align(0)
          for plane in 0..<3 { for i in 0..<(if plane == 0 { 256 } else { 64 }) {
            slice.put((i * 149 + plane * 607) & ((1 << depth) - 1), depth)
          } }
        } else { slice.ue(1) }
        slice.nal(output, if frame == 0 { 0x65 } else { 0x41 })
      }
      @fs.write_bytes_to_file(".scratch/h264_pcm\{depth}.264", Bytes::from_array(output[:]))
    }
    return
  }
  if @env.args().contains("--switching") {
    let output : Array[Byte] = []
    let sps = Bits::new()
    sps.put(88, 8); sps.put(0, 8); sps.put(30, 8); sps.ue(0); sps.ue(0)
    sps.ue(0); sps.ue(0); sps.ue(2); sps.put(0, 1); sps.ue(0); sps.ue(0)
    sps.put(1, 1); sps.put(1, 1); sps.put(0, 1); sps.put(0, 1); sps.nal(output, 0x67)
    let pps = Bits::new()
    pps.ue(0); pps.ue(0); pps.put(0, 1); pps.put(0, 1); pps.ue(0); pps.ue(0); pps.ue(0)
    pps.put(0, 1); pps.put(0, 2); pps.se(0); pps.se(0); pps.se(0)
    pps.put(1, 1); pps.put(0, 1); pps.put(0, 1); pps.nal(output, 0x68)
    for frame in 0..<3 {
      let slice = Bits::new()
      slice.ue(0); slice.ue(if frame == 0 { 2 } else if frame == 1 { 3 } else { 4 })
      slice.ue(0); slice.put(frame, 4)
      if frame == 0 { slice.ue(0) }
      slice.put(2 * frame, 4)
      if frame == 1 { slice.put(0, 1); slice.put(0, 1) } // SP ref override/list modification
      if frame == 0 { slice.put(0, 1); slice.put(0, 1) } else { slice.put(0, 1) }
      slice.se(0)
      if frame == 1 { slice.put(1, 1) } // sp_for_switch
      if frame > 0 { slice.se(0) } // QS delta, as consumed by original C
      slice.ue(1)
      if frame == 1 { slice.ue(1) } else {
        slice.ue(if frame == 2 { 26 } else { 25 }); slice.align(0)
        for plane in 0..<3 { for i in 0..<(if plane == 0 { 256 } else { 64 }) { slice.put(20 + frame * 40 + plane * 30 + i % 8, 8) } }
      }
      slice.nal(output, if frame == 0 { 0x65 } else { 0x41 })
    }
    @fs.write_bytes_to_file(".scratch/h264_switching.264", Bytes::from_array(output[:]))
    return
  }
  if @env.args().contains("--weighted-b") {
    let output : Array[Byte] = []
    let sps = Bits::new()
    sps.put(77, 8); sps.put(0, 8); sps.put(30, 8); sps.ue(0); sps.ue(0)
    sps.ue(0); sps.ue(0); sps.ue(2); sps.put(0, 1); sps.ue(0); sps.ue(0)
    sps.put(1, 1); sps.put(1, 1); sps.put(0, 1); sps.put(0, 1); sps.nal(output, 0x67)
    let pps = Bits::new()
    pps.ue(0); pps.ue(0); pps.put(0, 1); pps.put(0, 1); pps.ue(0); pps.ue(0); pps.ue(0)
    pps.put(0, 1); pps.put(1, 2); pps.se(0); pps.se(0); pps.se(0)
    pps.put(1, 1); pps.put(0, 1); pps.put(0, 1); pps.nal(output, 0x68)
    for frame in 0..<3 {
      let slice = Bits::new()
      slice.ue(0); slice.ue(if frame == 2 { 1 } else { 2 }); slice.ue(0); slice.put(frame, 4)
      if frame == 0 { slice.ue(0) }
      slice.put(if frame == 1 { 4 } else if frame == 2 { 2 } else { 0 }, 4)
      if frame == 0 { slice.put(0, 1); slice.put(0, 1) }
      else if frame == 1 { slice.put(0, 1) }
      else {
        slice.put(1, 1); slice.put(0, 1); slice.put(0, 1); slice.put(0, 1) // spatial, override, list flags
        slice.ue(1); slice.ue(1) // luma/chroma denominators
        slice.put(1, 1); slice.se(3); slice.se(2)
        slice.put(1, 1); slice.se(2); slice.se(1); slice.se(1); slice.se(-1)
        slice.put(1, 1); slice.se(1); slice.se(-2)
        slice.put(1, 1); slice.se(2); slice.se(0); slice.se(3); slice.se(2)
      }
      slice.se(0); slice.ue(1)
      if frame < 2 {
        slice.ue(25); slice.align(0)
        for plane in 0..<3 { for i in 0..<(if plane == 0 { 256 } else { 64 }) { slice.put(20 + frame * 40 + plane * 30 + i % 8, 8) } }
      } else {
        slice.ue(0); slice.ue(3) // non-skip B_Bi_16x16
        for _ in 0..<4 { slice.se(0) } // L0/L1 mvd
        slice.ue(0) // CBP
      }
      slice.nal(output, if frame == 0 { 0x65 } else if frame == 1 { 0x41 } else { 0x01 })
    }
    @fs.write_bytes_to_file(".scratch/h264_b_weighted.264", Bytes::from_array(output[:]))
    return
  }
  if @env.args().contains("--pcm") {
    let output : Array[Byte] = []
    let sps = Bits::new()
    sps.put(77, 8); sps.put(0, 8); sps.put(30, 8); sps.ue(0); sps.ue(0)
    sps.ue(0); sps.ue(0); sps.ue(1); sps.put(0, 1); sps.ue(1); sps.ue(0)
    sps.put(1, 1); sps.put(1, 1); sps.put(0, 1); sps.put(0, 1); sps.nal(output, 0x67)
    let pps = Bits::new()
    pps.ue(0); pps.ue(0); pps.put(1, 1); pps.put(0, 1); pps.ue(0); pps.ue(0); pps.ue(0)
    pps.put(0, 1); pps.put(0, 2); pps.se(0); pps.se(0); pps.se(0)
    pps.put(1, 1); pps.put(0, 1); pps.put(0, 1); pps.nal(output, 0x68)
    let slice = Bits::new()
    slice.ue(0); slice.ue(2); slice.ue(0); slice.put(0, 4); slice.ue(0); slice.put(0, 4)
    slice.put(0, 1); slice.put(0, 1); slice.se(0); slice.ue(1); slice.align(1)
    for byte in @fs.read_file_to_bytes(".scratch/h264_pcm_payload.bin") { slice.put(byte.to_int(), 8) }
    slice.nal(output, 0x65)
    @fs.write_bytes_to_file(".scratch/h264_pcm_escape.264", Bytes::from_array(output[:]))
    return
  }
  for poc_type in [0, 1, 2] {
    let output : Array[Byte] = []
    let sps = Bits::new()
    sps.put(66, 8); sps.put(0, 8); sps.put(30, 8); sps.ue(0); sps.ue(0)
    sps.ue(poc_type)
    if poc_type == 0 { sps.ue(0) }
    if poc_type == 1 { sps.put(0, 1); sps.se(-1); sps.se(1); sps.ue(2); sps.se(2); sps.se(3) }
    sps.ue(4); sps.put(0, 1); sps.ue(0); sps.ue(0)
    sps.put(1, 1); sps.put(1, 1); sps.put(0, 1); sps.put(0, 1)
    sps.nal(output, 0x67)
    let pps = Bits::new()
    pps.ue(0); pps.ue(0); pps.put(0, 1); pps.put(if poc_type == 1 { 1 } else { 0 }, 1)
    pps.ue(0); pps.ue(0); pps.ue(0); pps.put(0, 1); pps.put(0, 2)
    pps.se(0); pps.se(0); pps.se(0); pps.put(1, 1); pps.put(0, 1); pps.put(0, 1)
    pps.nal(output, 0x68)
    let count = if poc_type == 2 { 36 } else { 11 }
    for frame in 0..<count {
      let idr = frame == 0
      let intra = idr || frame == 1 || frame == 2 || frame == 8
      let frame_num = if frame <= 6 || poc_type == 2 { frame & 15 } else { frame - 6 }
      let slice = Bits::new()
      slice.ue(0); slice.ue(if intra { 2 } else { 0 }); slice.ue(0); slice.put(frame_num, 4)
      if idr { slice.ue(0) }
      if poc_type == 0 { slice.put((6 * frame_num) & 15, 4) }
      if poc_type == 1 { slice.se(if idr { 0 } else { 1 }); slice.se(-1) }
      if !intra {
        slice.put(0, 1) // ref override
        let reorder = if poc_type == 2 { -1 } else { match frame { 3 => 0; 4 => 2; 5 => 1; 9 => 0; _ => -1 } }
        slice.put(if reorder >= 0 || frame == 10 { 1 } else { 0 }, 1)
        if reorder >= 0 { slice.ue(2); slice.ue(reorder); slice.ue(3) }
        else if frame == 10 { slice.ue(0); slice.ue(1); slice.ue(3) }
      }
      if idr { slice.put(0, 1); slice.put(if poc_type == 2 { 0 } else { 1 }, 1) }
      else if poc_type == 2 { slice.put(0, 1) }
      else {
        slice.put(if frame == 10 { 0 } else { 1 }, 1)
        match frame {
          1 => { slice.ue(6); slice.ue(2) }
          2 => { slice.ue(4); slice.ue(3) }
          3 => { slice.ue(3); slice.ue(0); slice.ue(1) }
          4 => { slice.ue(2); slice.ue(0) }
          5 => { slice.ue(1); slice.ue(1); slice.ue(4); slice.ue(2) }
          6 => slice.ue(5)
          7 => { slice.ue(6); slice.ue(0) }
          8 => { slice.ue(1); slice.ue(1) }
          9 => { slice.ue(2); slice.ue(0) }
          _ => ()
        }
        if frame != 10 { slice.ue(0) }
      }
      slice.se(0); slice.ue(1) // QP and disable deblock
      if intra {
        slice.ue(25); slice.align(0)
        for plane in 0..<3 { for i in 0..<(if plane == 0 { 256 } else { 64 }) {
          slice.put((20 * (frame + 1) + i % 16 + plane * 37) & 255, 8)
        } }
      } else { slice.ue(1) } // one skipped MB
      slice.nal(output, if idr { 0x65 } else { 0x41 })
    }
    let name = "h264_marking_poc\{poc_type}"
    @fs.write_bytes_to_file(".scratch/" + name + ".264", Bytes::from_array(output[:]))
    println(name)
  }
}
