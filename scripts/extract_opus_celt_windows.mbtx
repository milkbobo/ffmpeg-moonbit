import { "moonbitlang/x/fs", "moonbitlang/core/env" }

fn main raise {
  let source = @fs.read_file_to_string("../libavcodec/opus/tab.c")
  let out = StringBuilder()
  out.write_string("// FFmpeg 9.0.2 opus/tab.c CELT synthesis windows. LGPL-2.1-or-later.\n// Generated by scripts/extract_opus_celt_windows.mbtx [--check].\n")
  for (name, length) in [("window_padded", 136), ("window2", 120)] {
    let body = source.split(" ff_celt_" + name).collect()[1].split("= {").collect()[1].split("};").collect()[0]
    let values : Array[String] = []
    for token in body.split(",") {
      let value = token.trim().to_owned()
      if value != "" { values.push(value.strip_suffix("f").unwrap().to_owned()) }
    }
    guard values.length() == length else { fail("bad window length") }
    out.write_string("\n///|\nlet opus_celt_" + name + " : FixedArray[Float] = [\n")
    for i, value in values {
      if i % 6 == 0 { out.write_string("  ") }
      out.write_string(value + ",")
      out.write_string(if i % 6 == 5 || i == length - 1 { "\n" } else { " " })
    }
    out.write_string("]\n")
  }
  let path = "libavcodec/opus_celt_windows.mbt"
  if @env.args().contains("--check") {
    guard @fs.read_file_to_string(path) == out.to_string() else { fail("CELT windows differ from C") }
    println("two CELT synthesis windows match original C")
  } else { @fs.write_string_to_file(path, out.to_string()) }
}
