///|
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/core/encoding/base64",
}

///|
fn rdpcm_source(depth : Int32, chroma : Int32) -> Bytes {
  let out : Array[Byte] = []
  for frame in 0..<5 {
    for plane in 0..<(if chroma == 400 { 1 } else { 3 }) {
      let hs = if plane != 0 && chroma != 444 { 1 } else { 0 }
      let vs = if plane != 0 && chroma == 420 { 1 } else { 0 }
      for y in 0..<(64 >> vs) {
        for x in 0..<(64 >> hs) {
          let xx = x << hs
          let yy = y << vs
          let vertical = xx < 32
          let major = if vertical { xx } else { yy }
          let minor = if vertical { yy } else { xx }
          // Directionally correlated texture, a slow spatial drift and
          // piecewise temporal changes encourage both RDPCM directions.
          let value = (
              (
                major * 37 +
                major / 3 * 19 +
                minor * 2 +
                frame * (17 + ((minor / 8) & 3)) +
                plane * 29
              ) &
              255
            ) <<
            (depth - 8)
          out.push((value & 255).to_byte())
          if depth > 8 {
            out.push((value >> 8).to_byte())
          }
        }
      }
    }
  }
  Bytes::from_array(out)
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 2 else {
    fail("expected absolute .scratch/hevc_rdpcm directory")
  }
  // HM 16.8, pinned source mirror commit; only -Werror is removed to build
  // with modern GCC. No encoder algorithms or decisions are patched.
  let hm = "HM-382e0a040c7f0189670c4aad9716d45db977b319"
  let common = ["run", "--rm", "--network", "none", "-v", args[1] + ":/work"]
  let cases = [
    ("rdpcm_implicit8", 8, 444, true, 1, 0, 0, 0),
    ("rdpcm_implicit10", 10, 422, false, 1, 0, 1, 1),
    ("rdpcm_explicit8", 8, 420, true, 0, 1, 0, 1),
    ("rdpcm_explicit12", 12, 444, false, 0, 1, 0, 1),
    ("rdpcm_both12", 12, 444, true, 1, 1, 1, 1),
    ("rdpcm_mono10", 10, 400, true, 1, 0, 0, 0),
  ]
  for item in cases {
    let (stem, depth, chroma, bypass, implicit, explicit, rotation, sigmap) = item
    println("Encoding " + stem)
    @fs.write_bytes_to_file(
      ".scratch/hevc_rdpcm/" + stem + ".yuv",
      rdpcm_source(depth, chroma),
    )
    let lines : Array[String] = []
    let encoded = @shell.Cmd(
      "docker",
      common +
      [
        "--entrypoint",
        "/work/" + hm + "/bin/TAppEncoderStatic",
        "vpxdev-img",
        "-c",
        "/work/" + hm + "/cfg/encoder_lowdelay_main_rext.cfg",
        "--InputFile=/work/" + stem + ".yuv",
        "--BitstreamFile=/work/" + stem + ".265",
        "--ReconFile=/work/" + stem + "_hm.yuv",
        "--SourceWidth=64",
        "--SourceHeight=64",
        "--Level=3.1",
        "--FrameRate=5",
        "--FramesToBeEncoded=5",
        "--InputBitDepth=\{depth}",
        "--InternalBitDepth=\{depth}",
        "--InputChromaFormat=\{chroma}",
        "--ChromaFormatIDC=\{chroma}",
        "--MaxCUWidth=32",
        "--MaxCUHeight=32",
        "--MaxPartitionDepth=3",
        "--QP=4",
        "--TransformSkip=1",
        "--TransformSkipFast=0",
        "--TransformSkipLog2MaxSize=2",
        "--TransquantBypassEnableFlag=" + (if bypass { "1" } else { "0" }),
        "--CUTransquantBypassFlagForce=" + (if bypass { "1" } else { "0" }),
        "--ImplicitResidualDPCM=\{implicit}",
        "--ExplicitResidualDPCM=\{explicit}",
        "--ResidualRotation=\{rotation}",
        "--SingleSignificanceMapContext=\{sigmap}",
        "--GolombRiceParameterAdaptation=0",
        "--HighPrecisionPredictionWeighting=0",
        "--CrossComponentPrediction=0",
        "--ExtendedPrecision=0",
        "--ScalingList=0",
      ],
    ).each_line(line => lines.push(line))
    guard encoded == 0 else {
      for line in lines {
        println(line)
      }
      fail("HM encode failed: " + stem)
    }
    let output = StringBuilder()
    output.write_string(
      "///|\n// HM 16.8 pinned commit 382e0a040c7f0189670c4aad9716d45db977b319.\n// Generated by scripts/generate_hevc_rdpcm_vectors.mbtx; FFmpeg 9.0.2 references.\nlet \{stem}_b64 : Bytes =\n",
    )
    let b64 = @base64.encode(
      @fs.read_file_to_bytes(".scratch/hevc_rdpcm/" + stem + ".265"),
    )
    for i = 0; i < b64.length(); i = i + 40000 {
      if i > 0 {
        output.write_string(" +\n")
      }
      output.write_string(
        "  b\"" + b64[i:(i + 40000).min(b64.length())].to_owned() + "\"",
      )
    }
    output.write_string("\n")
    for filtered in [true, false] {
      let suffix = if filtered { "" } else { "_unfiltered" }
      let status = @shell.Cmd(
        "docker",
        common +
        [
          "--entrypoint", "ffmpeg", "linuxserver/ffmpeg:9.0.2", "-hide_banner", "-loglevel",
          "error", "-xerror", "-threads", "1",
        ] +
        (if filtered { [] } else { ["-skip_loop_filter", "all"] }) +
        [
          "-i",
          "/work/" + stem + ".265",
          "-fps_mode",
          "passthrough",
          "-f",
          "framemd5",
          "-y",
          "/work/" + stem + suffix + ".md5",
        ],
      ).each_line(line => println(line))
      guard status == 0 else { fail("reference decode failed") }
      output.write_string(
        "\n///|\nlet \{stem}\{suffix}_refs : Array[String] = [\n",
      )
      for
        line in @fs.read_file_to_string(
          ".scratch/hevc_rdpcm/" + stem + suffix + ".md5",
        ).split("\n") {
        if line.trim().is_empty() || line.has_prefix("#") {
          continue
        }
        let fields = line.split(",").collect()
        guard fields.length() == 6 else { fail("bad framemd5") }
        output.write_string("  \"" + fields[5].trim().to_owned() + "\",\n")
      }
      output.write_string("]\n")
    }
    @fs.write_string_to_file(
      "libavcodec/hevc_" + stem + "_realdata_wbtest.mbt",
      output.to_string(),
    )
  }
}
