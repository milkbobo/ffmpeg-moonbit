///|
import {
  "moonbitlang/x@0.5.7/fs",
}

///|
fn main raise {
  let source = @fs.read_file_to_string("../libavcodec/sbcdec_data.h")
  let out = StringBuilder()
  out.write_string(
    "///|\n/// Fixed-point SBC weights from FFmpeg libavcodec/sbcdec_data.h.\n/// Generated by scripts/gen_sbc_tables.mbtx. LGPL-2.1-or-later.\n",
  )
  for
    (name, shift, count) in [
      ("sbc_proto_4_40m0", 12, 20),
      ("sbc_proto_4_40m1", 12, 20),
      ("sbc_proto_8_80m0", 14, 40),
      ("sbc_proto_8_80m1", 14, 40),
      ("synmatrix4", 14, 32),
      ("synmatrix8", 14, 128),
    ] {
    let body = source.split(name).collect()[1].split("};").collect()[0]
    let words = body.split("(0x").collect()
    if words.length() != count + 1 {
      fail("unexpected SBC coefficient count for \{name}")
    }
    out.write_string("\n///|\nlet \{name} : FixedArray[Int32] = [\n")
    for word in words[1:] {
      let hex = word.split(")").collect()[0]
      out.write_string("  0x\{hex}U.reinterpret_as_int() >> \{shift},\n")
    }
    out.write_string("]\n")
  }
  @fs.write_string_to_file("libavcodec/sbc_tables.mbt", out.to_string())
}
