import { "moonbitlang/x/fs", "moonbitlang/core/encoding/base64" }

fn main raise {
  let out = StringBuilder()
  out.write_string("///|\n/// H.264 regression streams with original FFmpeg 9.0.2 framemd5 reference.\n/// CAVLC8: testsrc2 96x64@5, six frames, high qp22, bframes=0:cabac=0:\n/// 8x8dct=1:ref=3:weightp=0:keyint=999:scenecut=0.\n/// cabac_pcm: random geq 32x48@2, three frames, qp1, CABAC, ref1, weightp0;\n/// this high-entropy real stream supplements the forced PCM escape below.\n/// slices0/1: testsrc2 96x80@5, six frames, CABAC off/on, qp22, ref3,\n/// weightp1, 8x8dct1, slices3. irregular0/1: same, slice-max-mbs5 and\n/// constrained-intra1. All real streams disable B/scenecut, keyint999.\n/// marking_poc0/1/2: generate_h264_marking_vectors.mbtx, MMCO1..6, long\n/// reorder, POC0 wrap/reset, POC1 cycle/deltas and POC2 frame_num wrap.\n/// pcm_escape: original tests/cabac.c encoder, two PCM escapes/restarts,\n/// generated by h264_pcm_reference.c then the same .mbtx script --pcm.\n/// References: ffmpeg [-skip_loop_filter all] -i NAME.264 -f framemd5.\n/// Generated by scripts/emit_h264_completion_vectors.mbtx. LGPL-2.1-or-later.\n")
  for name in ["h264_cavlc8", "h264_cabac_pcm", "h264_marking_poc0", "h264_marking_poc1", "h264_marking_poc2", "h264_slices0", "h264_slices1", "h264_pcm_escape", "h264_irregular0", "h264_irregular1"] {
    let b64 = @base64.encode(@fs.read_file_to_bytes(".scratch/" + name + ".264"))
    out.write_string("\n///|\nlet " + name + "_b64 : Bytes =\n")
    for start = 0; start < b64.length(); start = start + 112 {
      if start > 0 { out.write_string(" +\n") }
      out.write_string("  b\"" + b64[start:(start + 112).min(b64.length())].to_owned() + "\"")
    }
    out.write_string("\n")
    for suffix in ["", "_unf"] {
      out.write_string("\n///|\nlet " + name + suffix + "_md5 : Array[String] = [\n")
      for line in @fs.read_file_to_string(".scratch/" + name + suffix + ".md5").split("\n") {
        if !line.trim().is_empty() && !line.has_prefix("#") {
          let fields = line.split(",").collect()
          out.write_string("  \"" + fields[fields.length() - 1].trim().to_owned() + "\",\n")
        }
      }
      out.write_string("]\n")
    }
    out.write_string("\n///|\ntest \"h264 completion: " + name + " filtered/unfiltered real frames\" {\n")
    out.write_string("  let data = @libavutil.av_base64_decode(" + name + "_b64, 1000000).unwrap()\n")
    out.write_string("  for skip in [true, false] {\n    let frames = match h264_decode_annexb_frames(data, skip) { Ok(value) => value; Err(error) => fail(\"" + name + ": \" + error) }\n")
    out.write_string("    let expected = if skip { " + name + "_unf_md5 } else { " + name + "_md5 }\n")
    out.write_string("    assert_eq(frames.length(), expected.length())\n    for i in 0..<frames.length() {\n      let got = h264_yuv_md5(frames[i])\n      if got != expected[i] { fail(\"" + name + " skip=\\{skip} frame=\\{i}: \\{got} != \\{expected[i]}\") }\n    }\n  }\n}\n")
  }
  for name in ["h264_b_header", "h264_b_weighted"] {
    let b64 = @base64.encode(@fs.read_file_to_bytes(".scratch/" + name + ".264"))
    out.write_string("\n///|\nlet " + name + "_b64 : Bytes =\n")
    for start = 0; start < b64.length(); start = start + 112 {
      if start > 0 { out.write_string(" +\n") }
      out.write_string("  b\"" + b64[start:(start + 112).min(b64.length())].to_owned() + "\"")
    }
    out.write_string("\n")
  }
  @fs.write_string_to_file("libavcodec/h264_completion_realdata_wbtest.mbt", out.to_string())
}
