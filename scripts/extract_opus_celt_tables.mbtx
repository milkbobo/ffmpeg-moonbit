import { "moonbitlang/x/fs", "moonbitlang/core/env" }

fn celt_numbers(source : StringView) -> Array[String] {
  let values : Array[String] = []
  let mut p = 0
  while p < source.length() {
    if p + 1 < source.length() && source[p] == '/' && source[p + 1] == '*' {
      p += 2
      while p + 1 < source.length() && !(source[p] == '*' && source[p + 1] == '/') { p += 1 }
      p += 2
    } else if p + 1 < source.length() && source[p] == '/' && source[p + 1] == '/' {
      while p < source.length() && source[p] != '\n' { p += 1 }
    } else if source[p] is '0'..='9' || source[p] == '-' {
      let start = p
      p += 1
      while p < source.length() && (source[p] is '0'..='9' || source[p] is 'a'..='f' ||
        source[p] is 'A'..='F' || source[p] == 'x') { p += 1 }
      values.push(source[start:p].to_owned())
    } else { p += 1 }
  }
  values
}

fn main raise {
  let source = @fs.read_file_to_string("../libavcodec/opus/tab.c")
  let tables = [
    ("model_tapset",4), ("model_spread",5), ("model_alloc_trim",12),
    ("freq_bands",22), ("freq_range",21), ("log_freq_range",21),
    ("tf_select",32), ("coarse_energy_dist",336), ("static_alloc",231),
    ("static_caps",168), ("log2_frac",24),
    ("cache_bits",392), ("cache_index",105), ("bit_interleave",16),
    ("bit_deinterleave",16), ("hadamard_order",46), ("qn_exp2",8),
  ]
  let out = StringBuilder()
  out.write_string("// FFmpeg 9.0.2 opus/tab.c integer CELT tables, flattened in C row order.\n// Copyright (c) 2012 Andrew D'Addesio, 2013-2014 Mozilla Corporation,\n// 2016 Rostislav Pehlivanov. LGPL-2.1-or-later.\n// Generated by scripts/extract_opus_celt_tables.mbtx [--check].\n")
  for (name, length) in tables {
    let declaration = source.split(" ff_celt_" + name).collect()[1]
    let body = declaration.split("= {").collect()[1].split("};").collect()[0]
    let values = celt_numbers(body)
    guard values.length() == length else { fail("wrong length for " + name + ": \{values.length()}") }
    out.write_string("\n///|\nlet opus_celt_" + name + " : FixedArray[Int32] = [\n")
    for i, value in values {
      if i % 12 == 0 { out.write_string("  ") }
      out.write_string(value + ",")
      out.write_string(if i % 12 == 11 || i == length - 1 { "\n" } else { " " })
    }
    out.write_string("]\n")
  }
  let path = "libavcodec/opus_celt_tables.mbt"
  if @env.args().contains("--check") {
    guard @fs.read_file_to_string(path) == out.to_string() else { fail("CELT tables differ from original C") }
    println("17 CELT tables match original C")
  } else { @fs.write_string_to_file(path, out.to_string()) }
}
