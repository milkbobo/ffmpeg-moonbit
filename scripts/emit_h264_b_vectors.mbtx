import { "moonbitlang/x/fs", "moonbitlang/core/encoding/base64" }
fn main raise {
  let out = StringBuilder()
  out.write_string("///|\n/// Original FFmpeg 9.0.2 default / -skip_loop_filter all framemd5.\n/// B-GOP outputs sorted by POC before comparison to display-order reference.\n/// Generated by scripts/emit_h264_b_vectors.mbtx. LGPL-2.1-or-later.\n")
  let names = ["h264_b_header", "h264_b_weighted", "h264_b_cavlc_spatial", "h264_b_cabac_temporal", "h264_b_cavlc_temporal", "h264_b_cabac_spatial", "h264_b_slices_cavlc", "h264_b_slices_cabac", "h264_b_motion", "h264_b_cqm_cabac", "h264_b_cqm_cavlc", "h264_b_multigop", "h264_switching", "h264_depth10_0", "h264_depth10_1"]
  for depth in [9, 10, 12, 14] { names.push("h264_pcm\{depth}") }
  for cabac in [0, 1] { names.push("h264_depth10_dense\{cabac}") }
  for name in names {
    if name != "h264_b_header" && name != "h264_b_weighted" {
      let b64 = @base64.encode(@fs.read_file_to_bytes(".scratch/" + name + ".264"))
      out.write_string("\n///|\nlet " + name + "_b64 : Bytes =\n")
      for start = 0; start < b64.length(); start = start + 112 {
        if start > 0 { out.write_string(" +\n") }
        out.write_string("  b\"" + b64[start:(start + 112).min(b64.length())].to_owned() + "\"")
      }
      out.write_string("\n")
    }
    for suffix in ["", "_unf"] {
      out.write_string("\n///|\nlet " + name + suffix + "_md5 : Array[String] = [\n")
      for line in @fs.read_file_to_string(".scratch/" + name + suffix + ".md5").split("\n") {
        if !line.trim().is_empty() && !line.has_prefix("#") {
          let fields = line.split(",").collect()
          out.write_string("  \"" + fields[fields.length() - 1].trim().to_owned() + "\",\n")
        }
      }
      out.write_string("]\n")
    }
    out.write_string("\n///|\ntest \"h264 B pixels: " + name + " filtered/unfiltered\" {\n")
    out.write_string("  let data = @libavutil.av_base64_decode(" + name + "_b64, 1000000).unwrap()\n")
    out.write_string("  for skip in [true, false] {\n    let frames = match h264_decode_annexb_display_frames(data, skip) { Ok(value) => value; Err(error) => fail(\"" + name + ": \" + error) }\n")
    out.write_string("    let expected = if skip { " + name + "_unf_md5 } else { " + name + "_md5 }\n")
    out.write_string("    assert_eq(frames.length(), expected.length())\n    for i, frame in frames {\n      let got = h264_yuv_md5(frame)\n      if got != expected[i] { fail(\"" + name + " skip=\\{skip} frame=\\{i} poc=\\{frame.poc}: \\{got} != \\{expected[i]}\") }\n    }\n  }\n}\n")
  }
  @fs.write_string_to_file("libavcodec/h264_b_realdata_wbtest.mbt", out.to_string())
}
