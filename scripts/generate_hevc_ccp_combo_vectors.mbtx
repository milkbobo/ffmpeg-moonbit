///|
/// Generate the HEVC CCP combination matrix: cross-component prediction
/// combined with dependent slice segments (8/10-bit 4:4:4) and with PCM
/// (forced-bypass high-noise 8/10-bit 4:4:4, the last case also using
/// dependent segments). Emits a black-box fixture file; references come from
/// FFmpeg 9.0.2 single-thread decode.
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/core/encoding/base64",
}

///|
fn combo_structured_source(depth : Int32, style : Int32) -> Bytes {
  let out : Array[Byte] = []
  let mask = (1 << depth) - 1
  for frame in 0..<5 {
    for plane in 0..<3 {
      for y = 0; y < 64; y = y + 1 {
        for x = 0; x < 64; x = x + 1 {
          let luma = (x * 151 + y * 37 + x * y * 3 + frame * (29 + x / 8 * 13)) &
            mask
          let value = if plane == 0 {
            luma
          } else if style == 1 {
            if plane == 1 {
              (luma >> 1) + (1 << (depth - 2))
            } else {
              ((mask - luma) >> 2) + (3 << (depth - 3))
            }
          } else if plane == 1 {
            luma
          } else {
            mask - luma
          }
          out.push((value & 255).to_byte())
          if depth > 8 {
            out.push((value >> 8).to_byte())
          }
        }
      }
    }
  }
  Bytes::from_array(out)
}

///|
/// Deterministic full-range per-sample noise: losslessly coded noise costs
/// more than raw samples, which makes HM choose PCM blocks.
fn combo_noise_source(depth : Int32) -> Bytes {
  let out : Array[Byte] = []
  let mask = (1U << depth) - 1U
  let mut rng = 0x9E3779B9U
  for _frame in 0..<5 {
    for _sample in 0..<(3 * 64 * 64) {
      rng = rng ^ (rng << 13)
      rng = rng ^ (rng >> 17)
      rng = rng ^ (rng << 5)
      let value = (rng & mask).reinterpret_as_int()
      out.push((value & 255).to_byte())
      if depth > 8 {
        out.push((value >> 8).to_byte())
      }
    }
  }
  Bytes::from_array(out)
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail(
      "expected absolute .scratch/hevc_ccp directory and HM source directory",
    )
  }
  let hm = "/hm/HM-382e0a040c7f0189670c4aad9716d45db977b319"
  let common = [
    "run",
    "--rm",
    "--network",
    "none",
    "-v",
    args[1] + ":/work",
    "-v",
    args[2] + ":/hm:ro",
  ]
  // stem, bit depth, source style (0/1 structured, 2 noise), QP, forced
  // transquant bypass, PCM, dependent slice segments.
  let cases : Array[(String, Int32, Int32, Int32, Bool, Bool, Bool)] = [
    ("ccp_dep8", 8, 0, 22, false, false, true),
    ("ccp_dep10", 10, 1, 20, false, false, true),
    ("ccp_pcm8", 8, 2, 4, true, true, false),
    ("ccp_dep_pcm10", 10, 2, 4, true, true, true),
  ]
  let fixture = StringBuilder()
  fixture.write_string(
    "///|\n// HM 16.8 pinned commit 382e0a040c7f0189670c4aad9716d45db977b319.\n// Generated by scripts/generate_hevc_ccp_combo_vectors.mbtx;\n// FFmpeg 9.0.2 single-thread references. Cross-component prediction combined\n// with dependent slice segments and with PCM (forced-bypass noise sources).\n",
  )
  for item in cases {
    let (stem, depth, style, qp, bypass, pcm, segments) = item
    println("Encoding " + stem)
    @fs.write_bytes_to_file(
      ".scratch/hevc_ccp/" + stem + ".yuv",
      if style == 2 {
        combo_noise_source(depth)
      } else {
        combo_structured_source(depth, style)
      },
    )
    let lines : Array[String] = []
    let on_off = if bypass { "1" } else { "0" }
    let encoded = @shell.Cmd(
      "docker",
      common +
      [
        "--entrypoint",
        hm + "/bin/TAppEncoderStatic",
        "vpxdev-img",
        "-c",
        hm + "/cfg/encoder_lowdelay_main_rext.cfg",
        "--InputFile=/work/" + stem + ".yuv",
        "--BitstreamFile=/work/" + stem + ".265",
        "--ReconFile=/work/" + stem + "_hm.yuv",
        "--SourceWidth=64",
        "--SourceHeight=64",
        "--Level=3.1",
        "--FrameRate=5",
        "--FramesToBeEncoded=5",
        "--InputBitDepth=\{depth}",
        "--InternalBitDepth=\{depth}",
        "--InputChromaFormat=444",
        "--ChromaFormatIDC=444",
        "--MaxCUWidth=32",
        "--MaxCUHeight=32",
        "--MaxPartitionDepth=3",
        "--IntraPeriod=-1",
        "--QP=\{qp}",
        "--TransformSkip=0",
        "--TransformSkipFast=0",
        "--TransformSkipLog2MaxSize=2",
        "--TransquantBypassEnableFlag=" + on_off,
        "--CUTransquantBypassFlagForce=" + on_off,
        "--ImplicitResidualDPCM=0",
        "--ExplicitResidualDPCM=0",
        "--ResidualRotation=0",
        "--SingleSignificanceMapContext=0",
        "--GolombRiceParameterAdaptation=0",
        "--HighPrecisionPredictionWeighting=0",
        "--CrossComponentPrediction=1",
        "--ReconBasedCrossCPredictionEstimate=1",
        "--ExtendedPrecision=0",
        "--ScalingList=0",
        "--PCMEnabledFlag=" + (if pcm { "1" } else { "0" }),
        "--SliceSegmentMode=" + (if segments { "1" } else { "0" }),
        "--SliceSegmentArgument=1",
      ],
    ).each_line(line => lines.push(line))
    guard encoded == 0 else {
      for line in lines {
        println(line)
      }
      fail("HM encode failed: " + stem)
    }
    let b64 = @base64.encode(
      @fs.read_file_to_bytes(".scratch/hevc_ccp/" + stem + ".265"),
    )
    fixture.write_string("\n///|\nlet \{stem}_b64 : Bytes =\n")
    for i = 0; i < b64.length(); i = i + 40000 {
      if i > 0 {
        fixture.write_string(" +\n")
      }
      fixture.write_string(
        "  b\"" + b64[i:(i + 40000).min(b64.length())].to_owned() + "\"",
      )
    }
    fixture.write_string("\n")
    for filtered in [true, false] {
      let suffix = if filtered { "" } else { "_unfiltered" }
      let status = @shell.Cmd(
        "docker",
        common +
        [
          "--entrypoint", "ffmpeg", "linuxserver/ffmpeg:9.0.2", "-hide_banner", "-loglevel",
          "error", "-xerror", "-threads", "1",
        ] +
        (if filtered { [] } else { ["-skip_loop_filter", "all"] }) +
        [
          "-i",
          "/work/" + stem + ".265",
          "-fps_mode",
          "passthrough",
          "-f",
          "framemd5",
          "-y",
          "/work/" + stem + suffix + ".md5",
        ],
      ).each_line(line => println(line))
      guard status == 0 else { fail("reference decode failed: " + stem) }
      fixture.write_string(
        "\n///|\nlet \{stem}\{suffix}_refs : Array[String] = [\n",
      )
      let mut count = 0
      for
        line in @fs.read_file_to_string(
          ".scratch/hevc_ccp/" + stem + suffix + ".md5",
        ).split("\n") {
        if line.trim().is_empty() || line.has_prefix("#") {
          continue
        }
        let fields = line.split(",").collect()
        guard fields.length() == 6 else { fail("bad framemd5") }
        fixture.write_string("  \"" + fields[5].trim().to_owned() + "\",\n")
        count += 1
      }
      guard count == 5 else { fail("expected five reference frames") }
      fixture.write_string("]\n")
    }
  }
  @fs.write_string_to_file(
    "libavcodec/hevc_ccp_combo_vectors_test.mbt",
    fixture.to_string(),
  )
}
