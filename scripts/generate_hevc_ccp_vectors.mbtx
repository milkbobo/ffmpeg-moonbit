///|
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/core/encoding/base64",
}

///|
fn ccp_source(depth : Int32, style : Int32) -> Bytes {
  let out : Array[Byte] = []
  let mask = (1 << depth) - 1
  for frame in 0..<5 {
    for plane in 0..<3 {
      for y in 0..<64 {
        for x in 0..<64 {
          let major = if x < 32 { x } else { y }
          let minor = if x < 32 { y } else { x }
          let luma = (if style == 2 {
              (
                major * 37 +
                major / 3 * 19 +
                minor * 2 +
                frame * (17 + ((minor / 8) & 3))
              ) <<
              (depth - 8)
            } else {
              x * 151 + y * 37 + x * y * 3 + frame * (29 + x / 8 * 13)
            }) &
            mask
          let value = if plane == 0 {
            luma
          } else if style == 3 && x < 32 {
            1 << (depth - 1)
          } else if style == 1 {
            if plane == 1 {
              (luma >> 1) + (1 << (depth - 2))
            } else {
              ((mask - luma) >> 2) + (3 << (depth - 3))
            }
          } else if plane == 1 {
            luma
          } else {
            mask - luma
          }
          out.push((value & 255).to_byte())
          if depth > 8 {
            out.push((value >> 8).to_byte())
          }
        }
      }
    }
  }
  Bytes::from_array(out)
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail(
      "expected absolute .scratch/hevc_ccp and .scratch/hevc_rdpcm directories",
    )
  }
  let hm = "/hm/HM-382e0a040c7f0189670c4aad9716d45db977b319"
  let common = [
    "run",
    "--rm",
    "--network",
    "none",
    "-v",
    args[1] + ":/work",
    "-v",
    args[2] + ":/hm:ro",
  ]
  // stem, bit depth, source, intra period, QP, forced bypass, skip/RDPCM tools.
  let cases = [
    ("ccp8", 8, 0, -1, 22, false, false),
    ("ccp10_intra", 10, 1, 1, 20, false, false),
    ("ccp12_skip", 12, 2, -1, 4, false, true),
    ("ccp12_bypass", 12, 0, -1, 4, true, false),
    ("ccp8_zero", 8, 3, -1, 22, false, false),
    ("ccp10_split", 10, 0, 1, 12, false, false),
  ]
  for item in cases {
    let (stem, depth, style, intra, qp, bypass, skip) = item
    println("Encoding " + stem)
    @fs.write_bytes_to_file(
      ".scratch/hevc_ccp/" + stem + ".yuv",
      ccp_source(depth, style),
    )
    let lines : Array[String] = []
    let flag = if skip { "1" } else { "0" }
    let bypass_flag = if bypass { "1" } else { "0" }
    let encoded = @shell.Cmd(
      "docker",
      common +
      [
        "--entrypoint",
        hm + "/bin/TAppEncoderStatic",
        "vpxdev-img",
        "-c",
        hm +
        "/cfg/" +
        (if intra == 1 {
          "encoder_intra_main_rext.cfg"
        } else {
          "encoder_lowdelay_main_rext.cfg"
        }),
        "--InputFile=/work/" + stem + ".yuv",
        "--BitstreamFile=/work/" + stem + ".265",
        "--ReconFile=/work/" + stem + "_hm.yuv",
        "--SourceWidth=64",
        "--SourceHeight=64",
        "--Level=3.1",
        "--FrameRate=5",
        "--FramesToBeEncoded=5",
        "--InputBitDepth=\{depth}",
        "--InternalBitDepth=\{depth}",
        "--InputChromaFormat=444",
        "--ChromaFormatIDC=444",
        "--MaxCUWidth=32",
        "--MaxCUHeight=32",
        "--MaxPartitionDepth=3",
        "--IntraPeriod=\{intra}",
        "--QP=\{qp}",
        "--TransformSkip=" + flag,
        "--TransformSkipFast=0",
        "--TransformSkipLog2MaxSize=2",
        "--TransquantBypassEnableFlag=" + bypass_flag,
        "--CUTransquantBypassFlagForce=" + bypass_flag,
        "--ImplicitResidualDPCM=" + flag,
        "--ExplicitResidualDPCM=" + flag,
        "--ResidualRotation=" + flag,
        "--SingleSignificanceMapContext=" + flag,
        "--GolombRiceParameterAdaptation=0",
        "--HighPrecisionPredictionWeighting=0",
        "--CrossComponentPrediction=1",
        "--ReconBasedCrossCPredictionEstimate=1",
        "--ExtendedPrecision=0",
        "--ScalingList=0",
      ],
    ).each_line(line => lines.push(line))
    guard encoded == 0 else {
      for line in lines {
        println(line)
      }
      fail("HM encode failed: " + stem)
    }
    let output = StringBuilder()
    output.write_string(
      "///|\n// HM 16.8 pinned commit 382e0a040c7f0189670c4aad9716d45db977b319.\n// Generated by scripts/generate_hevc_ccp_vectors.mbtx; FFmpeg 9.0.2 single-thread references.\nlet \{stem}_b64 : Bytes =\n",
    )
    let b64 = @base64.encode(
      @fs.read_file_to_bytes(".scratch/hevc_ccp/" + stem + ".265"),
    )
    for i = 0; i < b64.length(); i = i + 40000 {
      if i > 0 {
        output.write_string(" +\n")
      }
      output.write_string(
        "  b\"" + b64[i:(i + 40000).min(b64.length())].to_owned() + "\"",
      )
    }
    output.write_string("\n")
    for filtered in [true, false] {
      let suffix = if filtered { "" } else { "_unfiltered" }
      let status = @shell.Cmd(
        "docker",
        common +
        [
          "--entrypoint", "ffmpeg", "linuxserver/ffmpeg:9.0.2", "-hide_banner", "-loglevel",
          "error", "-xerror", "-threads", "1",
        ] +
        (if filtered { [] } else { ["-skip_loop_filter", "all"] }) +
        [
          "-i",
          "/work/" + stem + ".265",
          "-fps_mode",
          "passthrough",
          "-f",
          "framemd5",
          "-y",
          "/work/" + stem + suffix + ".md5",
        ],
      ).each_line(line => println(line))
      guard status == 0 else { fail("reference decode failed") }
      output.write_string(
        "\n///|\nlet \{stem}\{suffix}_refs : Array[String] = [\n",
      )
      let mut count = 0
      for
        line in @fs.read_file_to_string(
          ".scratch/hevc_ccp/" + stem + suffix + ".md5",
        ).split("\n") {
        if line.trim().is_empty() || line.has_prefix("#") {
          continue
        }
        let fields = line.split(",").collect()
        guard fields.length() == 6 else { fail("bad framemd5") }
        output.write_string("  \"" + fields[5].trim().to_owned() + "\",\n")
        count += 1
      }
      guard count == 5 else { fail("expected five reference frames") }
      output.write_string("]\n")
    }
    @fs.write_string_to_file(
      "libavcodec/hevc_" + stem + "_realdata_wbtest.mbt",
      output.to_string(),
    )
  }
}
