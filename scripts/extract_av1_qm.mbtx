///|
import {
  "moonbitlang/x/fs",
  "moonbitlang/core/env",
  "moonbitlang/core/string",
}

///|
/// Extract only decimal byte initializers, excluding declarations/comments.
fn extract(
  source : String,
  marker : String,
  count : Int32,
) -> Array[Int32] raise {
  let start = source.find(marker).unwrap()
  let tail = source[start:].to_owned()
  let body_start = tail.find("= {").unwrap() + 3
  let body = tail[body_start:].to_owned()
  let end = body.find("};").unwrap()
  let values : Array[Int32] = []
  let digits = StringBuilder()
  for ch in body[:end] {
    if ch >= '0' && ch <= '9' {
      digits.write_char(ch)
    } else if !digits.to_string().is_empty() {
      values.push(@string.parse_int(digits.to_string()))
      digits.reset()
    }
  }
  guard values.length() == count else {
    fail("\{marker}: expected \{count} values, got \{values.length()}")
  }
  values
}

///|
fn emit(
  out : StringBuilder,
  name : String,
  values : Array[Int32],
) -> Unit raise {
  out.write_string("\n///|\nlet \{name} : Bytes =\n")
  let hex = "0123456789abcdef"
  for i = 0; i < values.length(); i = i + 32 {
    if i != 0 {
      out.write_string(" +\n")
    }
    out.write_string("  b\"")
    for j in i..<(i + 32).min(values.length()) {
      let v = values[j]
      guard v >= 0 && v <= 255 else { fail("invalid matrix weight") }
      out.write_string("\\x")
      out.write_char(hex.get_char(v >> 4).unwrap())
      out.write_char(hex.get_char(v & 15).unwrap())
    }
    out.write_string("\"")
  }
  out.write_string("\n")
}

///|
fn main raise {
  let args = @env.args()
  guard args.length() == 2 else {
    fail("usage: extract_av1_qm.mbtx path/to/dav1d/src/qm.c")
  }
  let source = @fs.read_file_to_string(args[1])
  let out = StringBuilder()
  // Retain upstream's complete BSD license with the extracted data.
  for line in source[:source.find("#include").unwrap()].split("\n") {
    out.write_string("// " + line.to_owned() + "\n")
  }
  out.write_string(
    "\n// dav1d 1.5.1 src/qm.c, generated by scripts/extract_av1_qm.mbtx.\n// Layout: [15 levels][2 planes][512 rectangular / 528 triangular weights].\n",
  )
  emit(
    out,
    "av1_qm_rect",
    extract(source, "static const uint8_t qm_tbl_32x16", 15 * 2 * 512),
  )
  emit(
    out,
    "av1_qm_square",
    extract(source, "static const uint8_t qm_tbl_32x32_t", 15 * 2 * 528),
  )
  @fs.write_string_to_file("libavcodec/av1_qm_tables.mbt", out.to_string())
}
