import { "moonbitlang/x/fs" }

fn main raise {
  let names = ["opus_51", "opus_celt_120_mono", "opus_celt_120_stereo",
    "opus_celt_240_mono", "opus_celt_240_stereo", "opus_celt_480_mono",
    "opus_celt_480_stereo", "opus_celt_960_mono", "opus_celt_960_stereo"]
  let out = StringBuilder()
  out.write_string("///|\n/// Original FFmpeg ff_celt_decode_frame on the nine spectral corpora.\n/// Generated by scripts/emit_opus_celt_pcm_vectors.mbtx.\n/// P fields: packet stream phase samples channels range value bits frac,\n/// then channel-major PCM Float32 bits. LGPL-2.1-or-later.\nlet opus_celt_pcm_reference : Array[Array[String]] = [\n")
  let mut total = 0
  let tails : Array[Array[String]] = []
  for name in names {
    out.write_string("  [ // " + name + "\n")
    let mut count = 0
    let tail : Array[String] = []
    for line in @fs.read_file_to_string(".scratch/" + name + "_pcm_reference.txt").split("\n") {
      if line.has_prefix("P ") {
        out.write_string("    \"" + line.trim().to_owned() + "\",\n")
        count += 1
      }
      if line.has_prefix("Q ") { tail.push(line.trim().to_owned()) }
    }
    guard count > 0 else { fail("missing PCM reference: " + name) }
    total += count
    guard tail.length() > 0 else { fail("missing synthesis tail: " + name) }
    tails.push(tail)
    out.write_string("  ],\n")
  }
  guard total == 168 else { fail("incomplete CELT PCM corpus") }
  out.write_string("]\n")
  out.write_string("\n///|\n/// Q: stream phase step samples channels entropy[4], then PCM bits.\n/// Canonical silence after sound, switching 120/960/240/480/120/960.\nlet opus_celt_pcm_tail_reference : Array[Array[String]] = [\n")
  for tail in tails {
    out.write_string("  [\n")
    for line in tail { out.write_string("    \"" + line + "\",\n") }
    out.write_string("  ],\n")
  }
  out.write_string("]\n")
  @fs.write_string_to_file("libavcodec/opus_celt_pcm_realdata_wbtest.mbt", out.to_string())
  println("embedded 168 continuous PCM frames from original C decoder")
}
