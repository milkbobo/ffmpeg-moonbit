///|
import {
  "moonbitlang/x/fs",
}

///|
fn main raise {
  let source = @fs.read_file_to_string("libavcodec/av1_cdf.mbt")
  let out = StringBuilder()
  out.write_string(
    "///|\n/// Deep snapshot of dav1d's CdfContext. Every adaptive table is owned by\n/// the snapshot so tiles and reference slots cannot mutate one another.\n/// Generated by scripts/emit_av1_cdf_copy.mbtx from Av1CdfCtx.\npub fn Av1CdfCtx::copy(self : Av1CdfCtx) -> Av1CdfCtx {\n  {\n",
  )
  let mut in_struct = false
  let mut count = 0
  let tests = StringBuilder()
  tests.write_string(
    "///|\n/// Every adaptive table must be isolated between reference slots and tiles.\n/// Generated by scripts/emit_av1_cdf_copy.mbtx.\ntest \"CDF snapshots isolate all adaptive tables\" {\n  let source = @libavcodec.av1_cdf_copy_defaults(80)\n  let snapshot = source.copy()\n  let tile = snapshot.copy()\n",
  )
  for line in source.split("\n") {
    let s = line.trim().to_owned()
    if s == "pub struct Av1CdfCtx {" {
      in_struct = true
    } else if in_struct && s == "}" {
      break
    } else if in_struct &&
      !s.has_prefix("//") &&
      s.contains(" : FixedArray[UInt16]") {
      let field = s.split(" : ").collect()[0].to_owned()
      out.write_string("    \{field}: self.\{field}.copy(),\n")
      tests.write_string(
        "  for i in 0..<source.\{field}.length() {\n    let saved = snapshot.\{field}[i]\n    source.\{field}[i] = (saved.to_uint() ^ 1U).to_uint16()\n    assert_eq(snapshot.\{field}[i], saved)\n    assert_eq(tile.\{field}[i], saved)\n    snapshot.\{field}[i] = (saved.to_uint() ^ 2U).to_uint16()\n    assert_eq(tile.\{field}[i], saved)\n  }\n",
      )
      count += 1
    }
  }
  guard count > 80 else { fail("Av1CdfCtx field discovery failed") }
  out.write_string("  }\n}\n")
  @fs.write_string_to_file("libavcodec/av1_cdf_copy.mbt", out.to_string())
  tests.write_string("}\n")
  @fs.write_string_to_file(
    "libavcodec/av1_segment_vectors/cdf_copy_test.mbt",
    tests.to_string(),
  )
}
