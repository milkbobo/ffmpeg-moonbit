///|
import {
  "moonbitlang/x/fs",
  "moonbitlang/core/encoding/base64",
}

///|
fn main raise {
  let out = StringBuilder()
  out.write_string(
    "///|\n/// Original FFmpeg 9.0.2 PAFF field-picture framemd5. Generated by\n/// scripts/emit_h264_paff_vectors.mbtx from JM 19.0 encodes. LGPL-2.1-or-later.\n",
  )
  let names = [
    "jm_paff_p_cavlc", "jm_paff_p_cabac", "jm_paff_b_cavlc", "jm_paff_b_cabac", "jm_paff_p_long",
    "jm_paff_b_temporal_cavlc", "jm_paff_b_temporal_cabac", "jm_paff_b_slices",
  ]
  for name in names {
    let b64 = @base64.encode(
      @fs.read_file_to_bytes(".scratch/JM/bin/" + name + ".264"),
    )
    out.write_string("\n///|\nlet " + name + "_b64 : Bytes =\n")
    for start = 0; start < b64.length(); start = start + 112 {
      if start > 0 {
        out.write_string(" +\n")
      }
      out.write_string(
        "  b\"" + b64[start:(start + 112).min(b64.length())].to_owned() + "\"",
      )
    }
    out.write_string("\n")
    for suffix in ["", "_unf"] {
      out.write_string(
        "\n///|\nlet " + name + suffix + "_md5 : Array[String] = [\n",
      )
      for
        line in @fs.read_file_to_string(
          ".scratch/JM/bin/" + name + suffix + ".md5",
        ).split("\n") {
        if !line.trim().is_empty() && !line.has_prefix("#") {
          let fields = line.split(",").collect()
          out.write_string(
            "  \"" + fields[fields.length() - 1].trim().to_owned() + "\",\n",
          )
        }
      }
      out.write_string("]\n")
    }
    out.write_string(
      "\n///|\ntest \"h264 PAFF pixels: " + name + " filtered/unfiltered\" {\n",
    )
    out.write_string(
      "  let data = @libavutil.av_base64_decode(" +
      name +
      "_b64, 1000000).unwrap()\n",
    )
    out.write_string("  for skip in [false, true] {\n")
    out.write_string(
      "    let frames = match h264_decode_annexb_display_frames(data, skip) { Ok(value) => value; Err(error) => fail(\"" +
      name +
      ": \" + error) }\n",
    )
    out.write_string(
      "    let expected = if skip { " +
      name +
      "_unf_md5 } else { " +
      name +
      "_md5 }\n",
    )
    out.write_string("    assert_eq(frames.length(), expected.length())\n")
    out.write_string(
      "    for i, frame in frames {\n      let got = h264_yuv_md5(frame)\n      if got != expected[i] { fail(\"" +
      name +
      "\" + (if skip { \" unf\" } else { \" filt\" }) + \" frame \" + i.to_string() + \" got \" + got + \" exp \" + expected[i]) }\n    }\n  }\n}\n",
    )
  }
  @fs.write_string_to_file(
    "libavcodec/h264_paff_realdata_wbtest.mbt",
    out.to_string(),
  )
}
