///|
import {
  "moonbitlang/x/fs",
  "moonbitlang/core/encoding/base64",
  "moonbitlang/core/string",
}

///|
fn main raise {
  let out = StringBuilder()
  out.write_string(
    "///|\n/// FFmpeg 9.0.2 frame_num-gap reference pixels, filtered and unfiltered.\n/// Generated by gen_h264_gap_vectors.mbtx / run_h264_gap_reference.mbtx /\n/// emit_h264_gap_vectors.mbtx. Synthetic CAVLC I_PCM/P_SKIP plus real\n/// encoder streams with complete pictures removed. No synthesized picture\n/// is displayed. Non-IDR gray starts use FFmpeg -flags2 +showall.\n/// Copyright (c) 2003 Michael Niedermayer. LGPL-2.1-or-later.\n",
  )
  for
    line in @fs.read_file_to_string(".scratch/h264_gaps/manifest.tsv").split(
      "\n",
    ) {
    if line.trim().is_empty() {
      continue
    }
    let fields = line.split("\t").collect()
    let name = fields[0].to_owned()
    println("Embedding " + name)
    let count = @string.parse_int(fields[1])
    let b64 = @base64.encode(
      @fs.read_file_to_bytes(".scratch/h264_gaps/" + name + ".264"),
    )
    out.write_string("\n///|\nfn " + name + "_b64() -> Bytes {\n")
    for start = 0; start < b64.length(); start = start + 112 {
      if start > 0 {
        out.write_string(" +\n")
      }
      out.write_string(
        "  b\"" + b64[start:(start + 112).min(b64.length())].to_owned() + "\"",
      )
    }
    out.write_string("\n}\n")
    for suffix in ["", "_unf"] {
      out.write_string(
        "\n///|\nlet " + name + suffix + "_md5 : Array[String] = [\n",
      )
      let mut actual = 0
      for
        row in @fs.read_file_to_string(
          ".scratch/h264_gaps/" + name + suffix + ".md5",
        ).split("\n") {
        if row.trim().is_empty() || row.has_prefix("#") {
          continue
        }
        let columns = row.split(",").collect()
        out.write_string(
          "  \"" + columns[columns.length() - 1].trim().to_owned() + "\",\n",
        )
        actual += 1
      }
      guard actual == count else {
        println(
          "unexpected reference frame count " +
          name +
          suffix +
          ": " +
          actual.to_string() +
          " != " +
          count.to_string(),
        )
        fail("reference count mismatch")
      }
      out.write_string("]\n")
    }
    out.write_string(
      "\n///|\ntest \"h264 frame_num gap: " +
      name +
      " filtered/unfiltered\" {\n",
    )
    out.write_string(
      "  let data = @libavutil.av_base64_decode(" +
      name +
      "_b64(), 1000000).unwrap()\n",
    )
    out.write_string(
      "  for skip in [false, true] {\n    let frames = match h264_decode_annexb_display_frames(data, skip) { Ok(value) => value; Err(error) => fail(\"" +
      name +
      ": \" + error) }\n",
    )
    out.write_string(
      "    let expected = if skip { " +
      name +
      "_unf_md5 } else { " +
      name +
      "_md5 }\n    assert_eq(frames.length(), " +
      count.to_string() +
      ")\n",
    )
    out.write_string(
      "    for i, frame in frames {\n      let got = h264_yuv_md5(frame)\n      if got != expected[i] { fail(\"" +
      name +
      " skip=\\{skip} frame=\\{i}: \\{got} != \\{expected[i]}\") }\n    }\n  }\n}\n",
    )
  }
  @fs.write_string_to_file(
    "libavcodec/h264_gap_realdata_wbtest.mbt",
    out.to_string(),
  )
}
