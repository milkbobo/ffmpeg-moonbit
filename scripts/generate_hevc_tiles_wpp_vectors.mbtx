///|
/// Generate the HEVC tiles + WPP matrix. The combination is only encodable
/// in the High Throughput Intra 4:4:4 profile, so all streams are all-intra
/// and carry cabac_bypass_alignment_enabled_flag = 1. FFmpeg 9.0.2 cannot
/// decode this combination (its single-thread cabac_init uses the tile-scan
/// index modulo the picture CTB width), so per-frame references come from
/// the HM 16.8 decoder; FFmpeg is used only to hash its raw YUV output.
import {
  "moonbitlang/async",
  "moonbitlang/async/shell",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/core/encoding/base64",
}

///|
fn tiles_source(
  depth : Int32,
  style : Int32,
  width : Int32,
  height : Int32,
) -> Bytes {
  let out : Array[Byte] = []
  let mask = (1 << depth) - 1
  for frame in 0..<5 {
    for plane in 0..<3 {
      for y = 0; y < height; y = y + 1 {
        for x = 0; x < width; x = x + 1 {
          let luma = (x * 151 + y * 37 + x * y * 3 + frame * (29 + x / 8 * 13)) &
            mask
          let value = if plane == 0 {
            luma
          } else if style == 1 {
            if plane == 1 {
              (luma >> 1) + (1 << (depth - 2))
            } else {
              ((mask - luma) >> 2) + (3 << (depth - 3))
            }
          } else if plane == 1 {
            luma
          } else {
            mask - luma
          }
          out.push((value & 255).to_byte())
          if depth > 8 {
            out.push((value >> 8).to_byte())
          }
        }
      }
    }
  }
  Bytes::from_array(out)
}

///|
async fn main {
  let args = @env.args()
  guard args.length() == 3 else {
    fail(
      "expected absolute .scratch/hevc_ccp directory and HM source directory",
    )
  }
  let hm = "/hm/HM-382e0a040c7f0189670c4aad9716d45db977b319"
  let common = [
    "run",
    "--rm",
    "--network",
    "none",
    "-v",
    args[1] + ":/work",
    "-v",
    args[2] + ":/hm:ro",
  ]
  // stem, depth, style, width, height, CTU size, tile columns, tile rows,
  // QP, dependent slice segments.
  let cases : Array[
    (String, Int32, Int32, Int32, Int32, Int32, Int32, Int32, Int32, Bool),
  ] = [
    ("htw8", 8, 0, 64, 64, 32, 2, 2, 22, false),
    ("htw10", 10, 1, 64, 64, 32, 2, 2, 20, false),
    ("htw_wide8", 8, 0, 192, 128, 64, 2, 2, 22, false),
    ("htw_dep8", 8, 0, 64, 64, 32, 2, 2, 22, true),
    ("htw_dep_wide8", 8, 0, 128, 128, 32, 2, 2, 22, true),
  ]
  let fixture = StringBuilder()
  fixture.write_string(
    "///|\n// HM 16.8 pinned commit 382e0a040c7f0189670c4aad9716d45db977b319.\n// Generated by scripts/generate_hevc_tiles_wpp_vectors.mbtx;\n// references are HM decoder output (FFmpeg 9.0.2 cannot decode tiles+WPP).\n// High Throughput Intra 4:4:4 tiles+WPP with cabac_bypass_alignment.\n",
  )
  for item in cases {
    let (stem, depth, style, width, height, ctu, cols, rows, qp, segments) = item
    println("Encoding " + stem)
    @fs.write_bytes_to_file(
      ".scratch/hevc_ccp/" + stem + ".yuv",
      tiles_source(depth, style, width, height),
    )
    let lines : Array[String] = []
    let encoded = @shell.Cmd(
      "docker",
      common +
      [
        "--entrypoint",
        hm + "/bin/TAppEncoderStatic",
        "vpxdev-img",
        "-c",
        hm + "/cfg/encoder_intra_high_throughput_rext.cfg",
        "--InputFile=/work/" + stem + ".yuv",
        "--BitstreamFile=/work/" + stem + ".265",
        "--ReconFile=/work/" + stem + "_hm.yuv",
        "--SourceWidth=\{width}",
        "--SourceHeight=\{height}",
        "--Level=5.1",
        "--FrameRate=5",
        "--FramesToBeEncoded=5",
        "--InputBitDepth=\{depth}",
        "--InternalBitDepth=\{depth}",
        "--InputChromaFormat=444",
        "--ChromaFormatIDC=444",
        "--MaxCUWidth=\{ctu}",
        "--MaxCUHeight=\{ctu}",
        "--MaxPartitionDepth=3",
        "--QP=\{qp}",
        "--TileUniformSpacing=1",
        "--NumTileColumnsMinus1=\{cols - 1}",
        "--NumTileRowsMinus1=\{rows - 1}",
        "--WaveFrontSynchro=1",
        "--ScalingList=0",
        "--SliceSegmentMode=" + (if segments { "1" } else { "0" }),
        "--SliceSegmentArgument=1",
      ],
    ).each_line(line => lines.push(line))
    guard encoded == 0 else {
      for line in lines {
        println(line)
      }
      fail("HM encode failed: " + stem)
    }
    let b64 = @base64.encode(
      @fs.read_file_to_bytes(".scratch/hevc_ccp/" + stem + ".265"),
    )
    fixture.write_string("\n///|\nlet \{stem}_b64 : Bytes =\n")
    for i = 0; i < b64.length(); i = i + 40000 {
      if i > 0 {
        fixture.write_string(" +\n")
      }
      fixture.write_string(
        "  b\"" + b64[i:(i + 40000).min(b64.length())].to_owned() + "\"",
      )
    }
    fixture.write_string("\n")
    // FFmpeg 9.0.2 cannot decode tiles+WPP (its single-thread cabac_init
    // uses the tile-scan index modulo the picture CTB width), so decode with
    // HM and use FFmpeg only as a raw-YUV hasher.
    let decoded = @shell.Cmd(
      "docker",
      common +
      [
        "--entrypoint",
        hm + "/bin/TAppDecoderStatic",
        "vpxdev-img",
        "-b",
        "/work/" + stem + ".265",
        "-o",
        "/work/" + stem + "_hmdec.yuv",
      ],
    ).each_line(line => println(line))
    guard decoded == 0 else { fail("HM decode failed: " + stem) }
    let pix_fmt = if depth == 8 { "yuv444p" } else { "yuv444p10le" }
    let status = @shell.Cmd(
      "docker",
      common +
      [
        "--entrypoint",
        "ffmpeg",
        "linuxserver/ffmpeg:9.0.2",
        "-hide_banner",
        "-loglevel",
        "error",
        "-f",
        "rawvideo",
        "-pix_fmt",
        pix_fmt,
        "-s",
        "\{width}x\{height}",
        "-i",
        "/work/" + stem + "_hmdec.yuv",
        "-f",
        "framemd5",
        "-y",
        "/work/" + stem + ".md5",
      ],
    ).each_line(line => println(line))
    guard status == 0 else { fail("reference hash failed: " + stem) }
    fixture.write_string("\n///|\nlet \{stem}_refs : Array[String] = [\n")
    let mut count = 0
    for
      line in @fs.read_file_to_string(".scratch/hevc_ccp/" + stem + ".md5").split(
        "\n",
      ) {
      if line.trim().is_empty() || line.has_prefix("#") {
        continue
      }
      let fields = line.split(",").collect()
      guard fields.length() == 6 else { fail("bad framemd5") }
      fixture.write_string("  \"" + fields[5].trim().to_owned() + "\",\n")
      count += 1
    }
    guard count == 5 else { fail("expected five reference frames") }
    fixture.write_string("]\n")
  }
  @fs.write_string_to_file(
    "libavcodec/hevc_tiles_wpp_vectors_test.mbt",
    fixture.to_string(),
  )
}
