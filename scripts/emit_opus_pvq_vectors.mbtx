import { "moonbitlang/x/fs", "moonbitlang/core/string" }

fn main raise {
  let sizes = StringBuilder()
  let bands = StringBuilder()
  let metadata = StringBuilder()
  let mut size_count = 0
  let mut band_count = 0
  for line in @fs.read_file_to_string(".scratch/opus_pvq_reference.txt").split("\n") {
    let fields = line.trim().split(" ").collect()
    match fields[0] {
      "S" => { sizes.write_string("  \"" + line.trim().to_owned() + "\",\n"); size_count += 1 }
      "B" => { bands.write_string("  \"" + line.trim().to_owned() + "\",\n"); band_count += 1 }
      "D" => {
        guard fields.length() == 3 && fields[2].length() == 32 else { fail("bad vector digest") }
        metadata.write_string("///|\nlet opus_pvq_vector_count : Int32 = \{fields[1]}\n\n///|\nlet opus_pvq_vector_md5 : String = \"\{fields[2]}\"\n")
      }
      "" => ()
      _ => fail("unknown reference line")
    }
  }
  guard size_count == 2000 && band_count == 416 && !metadata.to_string().is_empty() else { fail("incomplete C reference") }
  let out = StringBuilder()
  out.write_string("///|\n/// Golden values from original FFmpeg 9.0.2 opus/pvq.c via\n/// scripts/opus_pvq_reference.c; regenerated by scripts/emit_opus_pvq_vectors.mbtx.\n/// S: N K cardinality. B: seed spread N K mask range value bits tell_frac,\n/// followed by Float32 coefficient bits. Digest covers all enumerated vectors\n/// as LE N/K/index/norm64/coefficients32, not MoonBit-generated expectations.\n/// LGPL-2.1-or-later.\nlet opus_pvq_sizes_reference : Array[String] = [\n")
  out.write_string(sizes.to_string())
  out.write_string("]\n\n///|\nlet opus_pvq_bands_reference : Array[String] = [\n")
  out.write_string(bands.to_string())
  out.write_string("]\n\n")
  out.write_string(metadata.to_string())
  @fs.write_string_to_file("libavcodec/opus_pvq_realdata_wbtest.mbt", out.to_string())
  println("embedded \{size_count} codebook sizes and \{band_count} bands")
}
