import { "moonbitlang/x/fs" }

///|
fn bit(data : Bytes, pos : Int32) -> Int32 {
  (data[pos / 8].to_int() >> (7 - pos % 8)) & 1
}

///|
fn ue(data : Bytes, pos : Int32) -> (Int32, Int32) {
  let mut p = pos
  let mut zeros = 0
  while bit(data, p) == 0 {
    p += 1
    zeros += 1
  }
  p += 1
  let mut value = 1
  for k = 0; k < zeros; k = k + 1 {
    value = value * 2 + bit(data, p)
    p += 1
  }
  (value - 1, p)
}

///|
fn main raise {
  let source = @fs.read_file_to_bytes(".scratch/h264_b_slices_cabac.264")
  let starts : Array[(Int32, Int32)] = []
  for i = 0; i + 3 <= source.length(); i = i + 1 {
    if source[i] == 0 && source[i + 1] == 0 && source[i + 2] == 1 {
      starts.push((if i > 0 && source[i - 1] == 0 { i - 1 } else { i }, i + 3))
    }
  }
  starts.push((source.length(), source.length()))
  let out : Array[Byte] = []
  let mut found_b = false
  let mut dropped = false
  for i = 0; i + 1 < starts.length(); i = i + 1 {
    let start = starts[i].0
    let header = starts[i].1
    let nal_type = source[header].to_int() & 31
    let mut omit = false
    if nal_type == 1 || nal_type == 5 {
      let payload = source[header + 1:starts[i + 1].0].to_owned()
      let (first_mb, p) = ue(payload, 0)
      let (slice_type, _) = ue(payload, p)
      if slice_type % 5 == 1 && !found_b { found_b = true }
      if found_b && slice_type % 5 == 1 && first_mb > 0 && !dropped {
        omit = true
        dropped = true
        println("dropped nal=\{i} first_mb=\{first_mb}")
      }
    }
    if !omit {
      for j = start; j < starts[i + 1].0; j = j + 1 { out.push(source[j]) }
    }
  }
  guard dropped else { fail("no second B slice found") }
  @fs.write_bytes_to_file(
    ".scratch/h264_er_drop_b_middle.264", Bytes::from_array(out[:]),
  )
}
