# MoonBit build output and caches (convention from `moon new`)
.DS_Store
_build/
target/
target
.mooncakes/
.moonagent/

# `moon info` public-interface snapshots (regenerate with `moon info`)
*.generated.mbti

# Local tooling / scratch directories
.trash/
.workbuddy/
.codebuddy/
.worktrees/
# Scratch vectors / trace dumps (generation commands live in the test file headers)
_tmp_sei/
.scratch/
scratch/
_ref/

# WebAssembly 构建产物
*.wasm
*.wasm.gz
*.wasm.br

# scripts/amr_c_ref、scripts/adpcm_c_ref 的本地 C 参照程序（各自的 build.cmd 生成）
scripts/*_c_ref/*.exe
# Python 字节码缓存
__pycache__/

# ZCode 本地会话状态
.zcode/
