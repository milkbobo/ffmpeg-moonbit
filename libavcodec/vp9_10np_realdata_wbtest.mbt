///|
/// 10-bit non-parallel stream (counts-driven adaptation), generated with docker `linuxserver/ffmpeg:9.0.2`.  Expected
/// values are the reference decoder's per-frame yuv420p{depth}le MD5s
/// (little-endian 16-bit samples).
///
/// Reproduce with:
/// ```text
/// ffmpeg -f lavfi -i testsrc2=size=160x120:rate=30 -t 0.7 -c:v libvpx-vp9 -profile 2 -pix_fmt yuv420p10le -b:v 250k -g 12 -keyint_min 6 -frame-parallel 0 -an -y vp9_10np.ivf
/// ffmpeg -threads 1 -i vp9_10np.ivf -f framemd5 vp9_10np.md5
/// ```
///
/// Original FFmpeg code is LGPL-2.1-or-later; the vectors are libre test data.

///|
/// base64 of the reference `vp9_10np.ivf` ({nbytes} bytes). */
let vp9_10np_ivf_b64 : Bytes = b""

///|
fn vp9_10np_ivf_bytes() -> Bytes {
  @libavutil.av_base64_decode(vp9_10np_ivf_b64, 1000000).unwrap()
}

///|
/// Split an IVF file into per-frame VP9 payloads (12-byte frame headers).
fn vp9_10np_ivf_frames(ivf : Bytes) -> Array[Bytes] {
  let frames : Array[Bytes] = []
  let mut pos = 32
  while pos < ivf.length() {
    let size = (ivf[pos].to_int() | (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16)) |
      (ivf[pos + 3].to_int() << 24)
    frames.push(ivf[pos + 12:pos + 12 + size].to_owned())
    pos = pos + 12 + size
  }
  frames
}

///|
let vp9_10np_md5 : Array[String] = [
  "e71d702b56a1c81cf76638406f5f754e", "e8c8f8dcfcbcec6b3996a5fdbca44761", "3a547637cf4251fde2e0f0ddcdb791f3",
  "7240e48d663fa9cbccbe845a4fd8d929", "a1bea8589a384f2657b85ba952cd58b7", "99f46d18e063d03b930c13462649107e",
  "b3f5f904918b1a95df130c6f4b84028b", "19f8b4a92bbdbe8ca6ebb79866f99732", "1dfb5d93a658e2429e5128ffa354db27",
  "84d5a0b0114dd5af72be75bbf87b491a", "4b7fa076c4abee0201915b13e5c9bdb8", "adbb7c0941d0ec8f1232ae3fdcec30b6",
  "24a0187348c5c18fb6126c3a71a50993", "99d819abbaede2f351f62c78b93b5e50", "73d1090379ae924661847a45bc9a010b",
  "fa3a579467e94da1f7e16714d1c72ad9", "ffd10c1100f3b54537ceb4cc1c7011f3", "6398535c3af6d1a512a2393e8502ed51",
  "cf2e7732060ded63d3b23d865b1039c8", "2a265ceeb581f270d34ecb3e4682331b", "fe6f2013c5a86e10ad71b645ccc58681",
]

///|
test "vp9 10np: profile-2 adaptation stream matches FFmpeg YUV" {
  let dec = vp9_decoder_new()
  let frames = vp9_10np_ivf_frames(vp9_10np_ivf_bytes())
  assert_eq(frames.length(), vp9_10np_md5.length())
  for i in 0..<frames.length() {
    let out = match dec.decode_packet(frames[i]) {
      Ok(fs) => fs
      Err(e) => fail("frame \{i}: \{e}")
    }
    assert_eq(out.length(), 1)
    inspect(vp9_kf_frame_md5(dec), content=vp9_10np_md5[i])
  }
}
