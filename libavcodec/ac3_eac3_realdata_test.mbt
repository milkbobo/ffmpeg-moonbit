///|
/// Real-data E-AC-3 decoding tests.  Fixtures encoded with FFmpeg 9.0.2's
/// native `eac3` encoder (independent frames; the encoder never emits SPX,
/// AHT or enhanced coupling):
///   ffmpeg -f lavfi -i "<lavfi>:s=48000:d=0.128" -c:a eac3 -b:a <rate> \
///          -f eac3 <name>.eac3
/// `mid3blk`/`hi1blk` use 1536/3072 kbit/s, which selects 3- and 2-block
/// frames.  Reference PCM is FFmpeg's `-f s16le` decode with `-f eac3` (the
/// raw eac3 probe is unreliable for short files).  The port stays within one
/// s16 LSB.

///|
fn eac3_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let eac3_mono48_b64 : Bytes = eac3_concat([
  b"",
])

///|
let eac3_mono48_ref_b64 : Bytes = eac3_concat([
  b"",
  b"",
])

///|
let eac3_stereo48_b64 : Bytes = eac3_concat([
  b"",
])

///|
let eac3_stereo48_ref_b64 : Bytes = eac3_concat([
  b"",
  b"",
  b"",
  b"",
])

///|
let eac3_surround51_b64 : Bytes = eac3_concat([
  b"",
])

///|
let eac3_surround51_ref_b64 : Bytes = eac3_concat([
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
])

///|
let eac3_mono44_b64 : Bytes = eac3_concat([
  b"",
])

///|
let eac3_mono44_ref_b64 : Bytes = eac3_concat([
  b"",
  b"",
])

///|
let eac3_mono32_b64 : Bytes = eac3_concat([
  b"",
])

///|
let eac3_mono32_ref_b64 : Bytes = eac3_concat([
  b"",
  b"",
])

///|
let eac3_mid3blk_b64 : Bytes = eac3_concat([
  b"",
])

///|
let eac3_mid3blk_ref_b64 : Bytes = eac3_concat([
  b"",
])

///|
let eac3_hi1blk_b64 : Bytes = eac3_concat([
  b"",
  b"",
])

///|
let eac3_hi1blk_ref_b64 : Bytes = eac3_concat([
  b"",
])

///|
fn eac3_check_fixture(
  name : String,
  rate : Int32,
  channels : Int32,
  mode : Int32,
  lfe : Bool,
  blocks : Int32,
  frames_expected : Int32,
  fixture_b64 : Bytes,
  ref_b64 : Bytes,
) -> Unit raise {
  let data = @libavutil.av_base64_decode(fixture_b64, 10000000).unwrap()
  let reference = @libavutil.av_base64_decode(ref_b64, 10000000).unwrap()
  let dec = @libavcodec.ac3_decoder_new()
  let pcm : Array[Array[Int32]] = []
  let mut pos = 0
  let mut frames = 0
  while pos + 8 <= data.length() {
    let hdr = match @libavcodec.ac3_parse_header(data[pos:].to_owned()) {
      Ok(h) => h
      Err(e) => fail("\{name}: header at \{pos}: \{e}")
    }
    assert_eq(hdr.bitstream_id, 16, msg=name)
    assert_eq(hdr.sample_rate, rate, msg=name)
    assert_eq(hdr.channels, channels, msg=name)
    assert_eq(hdr.channel_mode, mode, msg=name)
    assert_eq(hdr.lfe_on, lfe, msg=name)
    assert_eq(hdr.num_blocks, blocks, msg=name)
    if pos + hdr.frame_size > data.length() {
      break
    }
    let frame = match
      dec.decode_frame(data[pos:pos + hdr.frame_size].to_owned()) {
      Ok(v) => v
      Err(e) => fail("\{name}: frame \{frames}: \{e}")
    }
    if frames == 0 {
      assert_eq(frame.num_blocks, blocks, msg=name)
      for _c = 0; _c < channels; _c = _c + 1 {
        pcm.push([])
      }
    }
    for ch = 0; ch < channels; ch = ch + 1 {
      assert_eq(frame.samples[ch].length(), blocks * 256, msg=name)
      for v in frame.samples[ch] {
        let q = if v >= 1.0 {
          32767
        } else if v <= -1.0 {
          -32768
        } else {
          (v * 32768.0).round().to_int()
        }
        pcm[ch].push(q)
      }
    }
    frames = frames + 1
    pos = pos + hdr.frame_size
  }
  assert_eq(frames, frames_expected, msg=name)
  assert_eq(
    reference.length(),
    frames_expected * blocks * 256 * channels * 2,
    msg=name,
  )
  let mut max_diff = 0
  for ch = 0; ch < channels; ch = ch + 1 {
    for i = 0; i < pcm[ch].length(); i = i + 1 {
      let idx = (i * channels + ch) * 2
      let raw = reference[idx].to_int() | (reference[idx + 1].to_int() << 8)
      let want = if raw >= 32768 { raw - 65536 } else { raw }
      let d = if pcm[ch][i] > want {
        pcm[ch][i] - want
      } else {
        want - pcm[ch][i]
      }
      if d > max_diff {
        max_diff = d
      }
    }
  }
  assert_true(max_diff <= 1, msg="\{name}: max diff \{max_diff}")
}

///|
test "E-AC-3: real streams match FFmpeg PCM" {
  eac3_check_fixture(
    "mono48", 48000, 1, 1, false, 6, 4, eac3_mono48_b64, eac3_mono48_ref_b64,
  )
  eac3_check_fixture(
    "stereo48", 48000, 2, 2, false, 6, 4, eac3_stereo48_b64, eac3_stereo48_ref_b64,
  )
  eac3_check_fixture(
    "surround51", 48000, 6, 7, true, 6, 4, eac3_surround51_b64, eac3_surround51_ref_b64,
  )
  eac3_check_fixture(
    "mono44", 44100, 1, 1, false, 6, 4, eac3_mono44_b64, eac3_mono44_ref_b64,
  )
  eac3_check_fixture(
    "mono32", 32000, 1, 1, false, 6, 3, eac3_mono32_b64, eac3_mono32_ref_b64,
  )
  eac3_check_fixture(
    "mid3blk", 48000, 2, 2, false, 3, 2, eac3_mid3blk_b64, eac3_mid3blk_ref_b64,
  )
  eac3_check_fixture(
    "hi1blk", 48000, 2, 2, false, 2, 2, eac3_hi1blk_b64, eac3_hi1blk_ref_b64,
  )
}
