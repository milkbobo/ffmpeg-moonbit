///|
/// Lossy key frames in the formats not covered by `av1_lossy_vectors`:
/// 8-bit 4:4:4, 8-bit 4:2:2 and 10-bit 4:2:0 (libaom crf30, CDEF and loop
/// restoration disabled so only the deblocking filter runs). 128x96,
/// 4 key frames each.
///
/// Expected MD5s are libdav1d's framemd5 over the matching packed format
/// (yuv444p / yuv422p / yuv420p10le).
let av1_lossy444_b64 : Bytes = b""

///|
let av1_lossy444_md5 : Array[String] = [
  "34da08799c23b8dfd008ce93e1ab927d", "0f8aad07a71f53ea9aef8a22d00b8d2f", "1739d79f41991a5adc4b3bdb453a708a",
  "a31de1f8aab78dd88384e86387626ad1",
]

