///|
/// Lossy key frames in the formats not covered by `av1_lossy_vectors`:
/// 8-bit 4:4:4, 8-bit 4:2:2 and 10-bit 4:2:0 (libaom crf30, CDEF and loop
/// restoration disabled so only the deblocking filter runs). 128x96,
/// 4 key frames each.
///
/// Expected MD5s are libdav1d's framemd5 over the matching packed format
/// (yuv444p / yuv422p / yuv420p10le).
let av1_lossy444_b64 : Bytes = b""

///|
let av1_lossy444_md5 : Array[String] = ["34da08799c23b8dfd008ce93e1ab927d", "0f8aad07a71f53ea9aef8a22d00b8d2f", "1739d79f41991a5adc4b3bdb453a708a", "a31de1f8aab78dd88384e86387626ad1"]

///|
let av1_lossy422_b64 : Bytes = b""

///|
let av1_lossy422_md5 : Array[String] = ["40cd0684c0ae3a3eec4ad213bae08075", "2ae728b18aa2a7e42f76b91d154cf200", "c5b397de0a0bc9273587956a4cbc9b5b", "5264e72e34c20a47e65d268077885402"]

///|
let av1_lossy10_b64 : Bytes = b""

///|
let av1_lossy10_md5 : Array[String] = ["a0c18b8563fd5d8f3cb2c39f255a9ed9", "06249eb054b7151ba1df1df019675e9c", "341b9cc1512d90a09ec3bdbaf20d25a5", "1f22322a207dad8414361c47514d19b1"]

///|
let av1_le_l444_10_b64 : Bytes = b""

///|
let av1_le_l444_10_md5 : Array[String] = ["82ca513c74789e1c696dd42122fb6988", "2242a5c2432386cd49fb1ae65a947e6a", "af058af1c9ef58ee7a73491190bd6fa1", "59874527294167dd3820e1cc74a8dfe8"]

///|
let av1_le_l422_10_b64 : Bytes = b""

///|
let av1_le_l422_10_md5 : Array[String] = ["f951fb924db2df26f0fbc30318e491ff", "8f359265a8b6c5c0ddfe1af62b398c94", "f651bd283f658bf193cea1adb91da51e", "a51fe2ecef7c444edb1780bc048eec28"]

///|
let av1_le_l444_12_b64 : Bytes = b""

///|
let av1_le_l444_12_md5 : Array[String] = ["831de0d5b502970275c80c364735c1a4", "4b5988552afa595c63cdc20dbb948d71", "e463c3315b5cdba01148715f39893c15", "b20cacc2cd4e2d05b887d353d9ee1d0d"]

///|
fn av1_le_frames(ivf : Bytes) -> Array[Bytes] {
  let frames : Array[Bytes] = []
  let mut pos = 32
  while pos + 12 <= ivf.length() {
    let size = (ivf[pos].to_int() | (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16)) |
      (ivf[pos + 3].to_int() << 24)
    frames.push(ivf[pos + 12:pos + 12 + size].to_owned())
    pos = pos + 12 + size
  }
  frames
}

///|
fn av1_le_hex(digest : FixedArray[Byte]) -> String {
  let digits : Bytes = b"0123456789abcdef"
  let chars : Array[Char] = []
  for i in 0..<16 {
    let v = digest[i].to_uint().reinterpret_as_int()
    chars.push(digits[v >> 4].to_char())
    chars.push(digits[v & 15].to_char())
  }
  String::from_array(chars[:])
}

///|
fn av1_le_md5(packed : Bytes) -> String {
  let digest : FixedArray[Byte] = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, packed, packed.length())
  av1_le_hex(digest)
}

///|
fn av1_le_decode(b64 : Bytes) -> Array[String] raise {
  let ivf = @libavutil.av_base64_decode(b64, 1048576).unwrap()
  let frames = av1_le_frames(ivf)
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  let md5s : Array[String] = []
  for obus in frames {
    if seq is None {
      match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(s) => seq = Some(s)
        Err(e) => fail(e)
      }
    }
    let s = match seq {
      Some(s) => s
      None => fail("no sequence header")
    }
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(h) => h
      Err(e) => fail(e)
    }
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(t) => t
      Err(e) => fail(e)
    }
    let out = match @libavcodec.av1_decode_keyframe(s, hdr, tiles[0].data()) {
      Ok(f) => f
      Err(e) => fail(e)
    }
    md5s.push(av1_le_md5(out.packed()))
  }
  md5s
}

///|
fn av1_le_check(name : String, got : Array[String], want : Array[String]) -> Unit raise {
  if got.length() != want.length() {
    fail(name + ": frame count mismatch")
  }
  for i in 0..<want.length() {
    if got[i] != want[i] {
      fail(
        name + " frame " + i.to_string() + ": got " + got[i] + " want " + want[i],
      )
    }
  }
}

///|
test "av1 lossy 4:4:4 / 4:2:2 / 10-bit keyframes match libdav1d" {
  av1_le_check("lossy444", av1_le_decode(av1_lossy444_b64), av1_lossy444_md5)
  av1_le_check("lossy422", av1_le_decode(av1_lossy422_b64), av1_lossy422_md5)
  av1_le_check("lossy10", av1_le_decode(av1_lossy10_b64), av1_lossy10_md5)
  av1_le_check("l444_10", av1_le_decode(av1_le_l444_10_b64), av1_le_l444_10_md5)
  av1_le_check("l422_10", av1_le_decode(av1_le_l422_10_b64), av1_le_l422_10_md5)
  av1_le_check("l444_12", av1_le_decode(av1_le_l444_12_b64), av1_le_l444_12_md5)
}
