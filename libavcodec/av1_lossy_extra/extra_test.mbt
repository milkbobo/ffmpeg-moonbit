]

///|
/// 320x240 crf30 lossy key frames with per-SB delta-q **and delta-lf**
/// (single-plane deltas, `delta_lf_multi=false`; aomenc `--enable-tpl-model=1
/// --deltaq-mode=3 --delta-lf-mode=1`, bookworm aom-tools).
let av1_le_dlfm3_b64 : Bytes = b""

///|
let av1_le_dlfm3_md5 : Array[String] = [
  "3efab0d5d12d951c23c92b3f3d811807", "3d68159bef9789486e59ef6674551789", "f9266ae32230af38e26c95405abb0eb6",
  "719a7d7464f6986b6d0e91ea1e10378b",
]

///|
/// Same flags from trixie aom-tools (different LF levels): a second
/// independent delta-lf cross-check.
let av1_le_dlft3_b64 : Bytes = b""

///|
let av1_le_dlft3_md5 : Array[String] = [
  "351779fdb16e1921f17b2dbea05f8f71", "6d99d27e67bd7db5f9bd075c3ef02456", "644d9c62466b316ea8f58d8699cc239a",
  "4919959a93cb35fca7e0e3881913892e",
]

///|
fn av1_le_frames(ivf : Bytes) -> Array[Bytes] {
  let frames : Array[Bytes] = []
  let mut pos = 32
  while pos + 12 <= ivf.length() {
    let size = ivf[pos].to_int() |
      (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16) |
      (ivf[pos + 3].to_int() << 24)
    frames.push(ivf[pos + 12:pos + 12 + size].to_owned())
    pos = pos + 12 + size
  }
  frames
}

///|
fn av1_le_hex(digest : FixedArray[Byte]) -> String {
  let digits : Bytes = b"0123456789abcdef"
  let chars : Array[Char] = []
  for i in 0..<16 {
    let v = digest[i].to_uint().reinterpret_as_int()
    chars.push(digits[v >> 4].to_char())
    chars.push(digits[v & 15].to_char())
  }
  String::from_array(chars[:])
}

///|
fn av1_le_md5(packed : Bytes) -> String {
  let digest : FixedArray[Byte] = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, packed, packed.length())
  av1_le_hex(digest)
}

///|
fn av1_le_decode(b64 : Bytes) -> Array[String] raise {
  let ivf = @libavutil.av_base64_decode(b64, 1048576).unwrap()
  let frames = av1_le_frames(ivf)
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  let md5s : Array[String] = []
  for obus in frames {
    if seq is None {
      match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(s) => seq = Some(s)
        Err(e) => fail(e)
      }
    }
    let s = match seq {
      Some(s) => s
      None => fail("no sequence header")
    }
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(h) => h
      Err(e) => fail(e)
    }
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(t) => t
      Err(e) => fail(e)
    }
    let out = match @libavcodec.av1_decode_keyframe(s, hdr, tiles[0].data()) {
      Ok(f) => f
      Err(e) => fail(e)
    }
    md5s.push(av1_le_md5(out.packed()))
  }
  md5s
}

///|
fn av1_le_decode_tiles(b64 : Bytes) -> Array[String] raise {
  let ivf = @libavutil.av_base64_decode(b64, 1048576).unwrap()
  let frames = av1_le_frames(ivf)
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  let md5s : Array[String] = []
  for obus in frames {
    if seq is None {
      match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(s) => seq = Some(s)
        Err(e) => fail(e)
      }
    }
    let s = match seq {
      Some(s) => s
      None => fail("no sequence header")
    }
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(h) => h
      Err(e) => fail(e)
    }
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(t) => t
      Err(e) => fail(e)
    }
    let out = match @libavcodec.av1_decode_keyframe_tiles(s, hdr, tiles) {
      Ok(f) => f
      Err(e) => fail(e)
    }
    md5s.push(av1_le_md5(out.packed()))
  }
  md5s
}

///|
fn av1_le_check(
  name : String,
  got : Array[String],
  want : Array[String],
) -> Unit raise {
  if got.length() != want.length() {
    fail(name + ": frame count mismatch")
  }
  for i in 0..<want.length() {
    if got[i] != want[i] {
      fail(
        name +
        " frame " +
        i.to_string() +
        ": got " +
        got[i] +
        " want " +
        want[i],
      )
    }
  }
}

///|
test "av1 lossy 4:4:4 / 4:2:2 / 10-bit keyframes match libdav1d" {
  av1_le_check("lossy444", av1_le_decode(av1_lossy444_b64), av1_lossy444_md5)
  av1_le_check("lossy422", av1_le_decode(av1_lossy422_b64), av1_lossy422_md5)
  av1_le_check("lossy10", av1_le_decode(av1_lossy10_b64), av1_lossy10_md5)
  av1_le_check("mt8", av1_le_decode_tiles(av1_le_mt8_b64), av1_le_mt8_md5)
  av1_le_check("mt444", av1_le_decode_tiles(av1_le_mt444_b64), av1_le_mt444_md5)
  av1_le_check(
    "mtsb128",
    av1_le_decode_tiles(av1_le_mtsb128_b64),
    av1_le_mtsb128_md5,
  )
  av1_le_check("dlfm3", av1_le_decode(av1_le_dlfm3_b64), av1_le_dlfm3_md5)
  av1_le_check("dlft3", av1_le_decode(av1_le_dlft3_b64), av1_le_dlft3_md5)
  av1_le_check("l444_10", av1_le_decode(av1_le_l444_10_b64), av1_le_l444_10_md5)
  av1_le_check("l422_10", av1_le_decode(av1_le_l422_10_b64), av1_le_l422_10_md5)
  av1_le_check("l444_12", av1_le_decode(av1_le_l444_12_b64), av1_le_l444_12_md5)
}
