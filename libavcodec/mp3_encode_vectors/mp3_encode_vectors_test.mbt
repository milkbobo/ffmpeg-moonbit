/// MPEG audio Layer III encoder (shine 3.1.1 port) tests.
///
/// The fixtures (`fixtures.mbt`, generated by `scripts/gen_mp3_enc_vectors.py`)
/// hold the int16le interleaved PCM and the byte-exact MP3 output of the
/// compiled shine 3.1.1 reference (`_ref/shine/harness.exe`, itself
/// byte-identical to `shineenc`). The reference patches shine's `calc_scfsi`
/// with a platform-independent `ln` (`mp3enc_ln` / `shine_ref_log`) because
/// libm `log` and wasm `Math.log` differ by ulps and the truncation to `Int`
/// flips scfsi decisions near integer boundaries; everything else is
/// upstream-exact. The reference MP3s decode cleanly with FFmpeg 9.0.2
/// (`ffprobe`: `mp3` at the expected rate/channels, `ffmpeg -v error` silent).
///
/// Vector configs:
///   v1: 44100 Hz stereo 128 kbps (MPEG-1, two granules, scfsi, padding)
///   v2: 48000 Hz mono 192 kbps (MPEG-1 mono)
///   v3: 22050 Hz mono 64 kbps (MPEG-2 LSF, single granule per frame)

///|
/// Abort on an unexpected encoder/decoder error instead of propagating it.
fn[T] mp3_test_ok(r : Result[T, String]) -> T {
  match r {
    Ok(v) => v
    Err(e) => {
      println("MP3 test error: \{e}")
      abort("MP3 test: unexpected error")
    }
  }
}

///|
/// Unpack base64 int16le interleaved PCM.
fn mp3_test_pcm(b64 : Bytes) -> Array[Int32] {
  let raw = @libavutil.av_base64_decode(b64, 1 << 24).unwrap()
  let samples : Array[Int32] = []
  for i in 0..<(raw.length() / 2) {
    let v = raw[2 * i].to_int() + (raw[2 * i + 1].to_int() << 8)
    samples.push(if v >= 32768 { v - 65536 } else { v })
  }
  samples
}

///|
/// Encode the whole fixture and return (frames, concatenated stream).
fn mp3_test_encode(
  pcm : Array[Int32],
  channels : Int32,
  rate : Int32,
  bit_rate : Int32,
) -> (Int32, Bytes) {
  let config : @libavcodec.Mp3EncodeConfig = @libavcodec.mp3_encode_config(
    rate, channels, bit_rate,
  )
  let enc = mp3_test_ok(@libavcodec.mp3_encoder_new(config))
  let per_frame = enc.samples_per_pass() * channels
  let frames = pcm.length() / per_frame
  let parts : Array[Bytes] = []
  for f = 0; f < frames; f = f + 1 {
    let input : Array[Int32] = []
    for i in 0..<per_frame {
      input.push(pcm[f * per_frame + i])
    }
    parts.push(mp3_test_ok(enc.encode_frame(input)))
  }
  let all : Array[Byte] = []
  for f in 0..<parts.length() {
    for i in 0..<parts[f].length() {
      all.push(parts[f][i])
    }
  }
  (frames, Bytes::from_array(all))
}

///|
/// Decode with the local MPEG audio decoder and unpack interleaved s16.
fn mp3_test_decode(stream : Bytes) -> Array[Int32] {
  let pcm = mp3_test_ok(@libavcodec.decode_mp3_stream(stream))
  let bytes = pcm.pcm_bytes()
  let samples : Array[Int32] = []
  for i in 0..<(bytes.length() / 2) {
    let v = bytes[2 * i].to_int() + (bytes[2 * i + 1].to_int() << 8)
    samples.push(if v >= 32768 { v - 65536 } else { v })
  }
  samples
}

///|
/// Find the round-trip delay and measure the SNR of channel 0 on the aligned
/// overlap (encoder analysis delay + decoder synthesis delay).
fn mp3_test_snr(
  pcm : Array[Int32],
  channels : Int32,
  decoded : Array[Int32],
) -> Double {
  let n = pcm.length() / channels
  let dlen = decoded.length() / channels
  let mut best_lag = 0
  let mut best_err = -1.0
  for lag = 0; lag < 1500; lag = lag + 1 {
    let mut err = 0.0
    for i = 576; i < 1728; i = i + 1 {
      if lag + i < dlen && i < n {
        let diff = decoded[(lag + i) * channels] - pcm[i * channels]
        err += (diff * diff).to_double()
      }
    }
    if best_err < 0.0 || err < best_err {
      best_err = err
      best_lag = lag
    }
  }
  let mut sig = 0.0
  let mut noise = 0.0
  for i = 1728; i < n; i = i + 1 {
    let j = best_lag + i
    if j < dlen {
      let want = pcm[i * channels].to_double()
      let diff = decoded[j * channels].to_double() - want
      sig += want * want
      noise += diff * diff
    }
  }
  if noise > 0.0 {
    10.0 * @math.log10(sig / noise)
  } else {
    999.0
  }
}

///|
/// Shared assertions for one vector: byte-exactness against the shine
/// reference, a decodable frame header, and a decode round trip SNR.
fn mp3_test_vector(
  name : String,
  pcm_b64 : Bytes,
  expected : Bytes,
  channels : Int32,
  rate : Int32,
  bit_rate : Int32,
  min_snr : Double,
) -> Unit raise {
  let pcm = mp3_test_pcm(pcm_b64)
  let want = @libavutil.av_base64_decode(expected, 1 << 20).unwrap()
  let (frames, stream) = mp3_test_encode(pcm, channels, rate, bit_rate)
  // byte-exact against the C reference
  inspect(stream.length(), content="\{want.length()}")
  let mut identical = stream.length() == want.length()
  if identical {
    for i in 0..<stream.length() {
      if stream[i] != want[i] {
        identical = false
        println("\{name}: first diff at byte \{i}")
        break
      }
    }
  }
  inspect(identical, content="true")
  // frame header: sync + Layer III
  inspect(
    stream[0] == b'\xff' && (stream[1] & b'\xe0') == b'\xe0',
    content="true",
  )
  // decode round trip with the local decoder
  let decoded = mp3_test_decode(stream)
  let snr = mp3_test_snr(pcm, channels, decoded)
  inspect(frames > 0, content="true")
  if snr < min_snr {
    fail("\{name}: SNR too low: \{snr}")
  }
}

///|
test "mp3_encode_byte_exact_vs_shine_v1" {
  mp3_test_vector(
    "v1", @mp3_encode_vectors.mp3_vec1_pcm, @mp3_encode_vectors.mp3_vec1_mp3, 2,
    44100, 128000, 15.0,
  )
}

///|
test "mp3_encode_byte_exact_vs_shine_v2" {
  mp3_test_vector(
    "v2", @mp3_encode_vectors.mp3_vec2_pcm, @mp3_encode_vectors.mp3_vec2_mp3, 1,
    48000, 192000, 15.0,
  )
}

///|
test "mp3_encode_byte_exact_vs_shine_v3_mpeg2" {
  mp3_test_vector(
    "v3", @mp3_encode_vectors.mp3_vec3_pcm, @mp3_encode_vectors.mp3_vec3_mp3, 1,
    22050, 64000, 15.0,
  )
}

///|
test "mp3_encode_config_validation" {
  // unsupported sample rate
  match
    @libavcodec.mp3_encoder_new(@libavcodec.mp3_encode_config(44101, 1, 128000)) {
    Err(_) => inspect("rejected", content="rejected")
    Ok(_) => fail("expected rejection")
  }
  // bitrate not in the MPEG-1 table
  match
    @libavcodec.mp3_encoder_new(@libavcodec.mp3_encode_config(44100, 1, 1000)) {
    Err(_) => inspect("rejected", content="rejected")
    Ok(_) => fail("expected rejection")
  }
  // unsupported channel count
  match
    @libavcodec.mp3_encoder_new(@libavcodec.mp3_encode_config(44100, 3, 128000)) {
    Err(_) => inspect("rejected", content="rejected")
    Ok(_) => fail("expected rejection")
  }
  // too few samples
  let enc = mp3_test_ok(
    @libavcodec.mp3_encoder_new(@libavcodec.mp3_encode_config(44100, 1, 128000)),
  )
  match enc.encode_frame(Array::make(100, 0)) {
    Err(_) => inspect("rejected", content="rejected")
    Ok(_) => fail("expected rejection")
  }
}
