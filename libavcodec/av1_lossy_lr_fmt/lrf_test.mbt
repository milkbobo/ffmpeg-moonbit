///|
/// Loop restoration beyond 4:2:0 8-bit: 4:2:2/4:4:4 layouts, 10-bit, and an
/// SVT SGR+Wiener mix. All are 320x240 crf30..35 key-frame streams whose
/// per-frame MD5s match libdav1d framemd5 (docker `linuxserver/ffmpeg:9.0.2`).
///
/// Generation notes: libaom refuses restoration on mandelbrot content but
/// enables chroma Wiener on `testsrc2` (with `-aom-params
/// enable-restoration=1`); SVT (ffmpeg wrapper, yuv420p10 only) emits an
/// SGR/Wiener mix with delta-q on the same content.

///|
let lrf_svt42010_b64 : Bytes = b""
///|
let lrf_svt42010_md5 : Array[String] = ["3408d1dc751d6dbbb4af6c4d32d9c624", "436e64be57e69119f95bb6a401ced926", "b64ad60228dec92b769bcffa9c418935", "046b2236f5726de44414ca65340594a7"]
///|
let lrf_ts4448_b64 : Bytes = b""
///|
let lrf_ts4448_md5 : Array[String] = ["9d96a2fb3abaed92c08c2dc28852369a", "73c2955fa134781f7b8af14441dceba3"]
///|
let lrf_ts44410_b64 : Bytes = b""
///|
let lrf_ts44410_md5 : Array[String] = ["9a023885732438fc3fe04ade9c5b232c", "0f94bc5aa8c8cef2177ac17188bc899a", "5eca901c30359fed3d872015178d6e20", "6d016f3ef207e300026845313ff99256"]
///|
let lrf_ts422_b64 : Bytes = b""
///|
let lrf_ts422_md5 : Array[String] = ["5730e2fb81456704e11e3eeb1841806d", "49ac4110108402c10696c4282e25301b", "fb26987317d80a23c9136d1fc85e3012", "703256fb991e5a8e244b21b0eebdc5b8"]
///|
let lrf_ts42210_b64 : Bytes = b""
///|
let lrf_ts42210_md5 : Array[String] = ["50b2d2de695123b3933314bba372c35f", "f3c3df1ca2293499e057a82268ca7605", "4a5a2642cab67a60601e963d88f83ca6", "611d1221bb336b9b867d67cb3651f4be"]

///|
fn lrf_frames(ivf : Bytes) -> Array[Bytes] {
  let frames : Array[Bytes] = []
  let mut pos = 32
  while pos + 12 <= ivf.length() {
    let size = (ivf[pos].to_int() | (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16)) |
      (ivf[pos + 3].to_int() << 24)
    frames.push(ivf[pos + 12:pos + 12 + size].to_owned())
    pos = pos + 12 + size
  }
  frames
}

///|
fn lrf_md5(packed : Bytes) -> String {
  let digest : FixedArray[Byte] = FixedArray::make(16, b' ')
  @libavutil.av_md5_sum(digest, packed, packed.length())
  let digits : Bytes = b"0123456789abcdef"
  let chars : Array[Char] = []
  for i in 0..<16 {
    let v = digest[i].to_uint().reinterpret_as_int()
    chars.push(digits[v >> 4].to_char())
    chars.push(digits[v & 15].to_char())
  }
  String::from_array(chars[:])
}

///|
fn lrf_decode(b64 : Bytes) -> Array[String] raise {
  let ivf = @libavutil.av_base64_decode(b64, 1048576).unwrap()
  let frames = lrf_frames(ivf)
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  let md5s : Array[String] = []
  for obus in frames {
    if seq is None {
      match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(s) => seq = Some(s)
        Err(e) => fail(e)
      }
    }
    let s = match seq {
      Some(s) => s
      None => fail("no sequence header")
    }
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(h) => h
      Err(e) => fail(e)
    }
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(t) => t
      Err(e) => fail(e)
    }
    let out = match @libavcodec.av1_decode_keyframe(s, hdr, tiles[0].data()) {
      Ok(f) => f
      Err(e) => fail(e)
    }
    md5s.push(lrf_md5(out.packed()))
  }
  md5s
}

///|
fn lrf_check(name : String, got : Array[String], want : Array[String]) -> Unit raise {
  if got.length() != want.length() {
    fail(name + ": frame count mismatch")
  }
  for i in 0..<want.length() {
    if got[i] != want[i] {
      fail(name + ": frame " + i.to_string() + " md5 " + got[i] + " != " + want[i])
    }
  }
}

test "av1 loop restoration across 422/444 and 10-bit matches libdav1d" {
  lrf_check("svt42010", lrf_decode(lrf_svt42010_b64), lrf_svt42010_md5)
  lrf_check("ts4448", lrf_decode(lrf_ts4448_b64), lrf_ts4448_md5)
  lrf_check("ts44410", lrf_decode(lrf_ts44410_b64), lrf_ts44410_md5)
  lrf_check("ts422", lrf_decode(lrf_ts422_b64), lrf_ts422_md5)
  lrf_check("ts42210", lrf_decode(lrf_ts42210_b64), lrf_ts42210_md5)
}
