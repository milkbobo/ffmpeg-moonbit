///|
/// Real x265 Main10/Main12 Annex B streams and FFmpeg 9.0.2 per-frame MD5
/// references for the bit-depth-aware HEVC decoder.
///
/// Generation (docker `linuxserver/ffmpeg:9.0.2`, cwd = this directory):
///
/// ```
/// docker run --rm -v "$PWD:/w" -w /w linuxserver/ffmpeg:9.0.2 -v error \
///   -f lavfi -i "testsrc2=duration=0.7:size=64x48:rate=10" -frames:v 7 \
///   -pix_fmt yuv420p10le -c:v libx265 \
///   -x265-params "keyint=7:min-keyint=7:bframes=2:scenecut=0:weightp=1:weightb=1" \
///   -f hevc -y m10b.265
/// docker run --rm -v "$PWD:/w" -w /w linuxserver/ffmpeg:9.0.2 -v error \
///   -f lavfi -i "testsrc2=duration=0.7:size=64x48:rate=10" -frames:v 7 \
///   -pix_fmt yuv420p12le -c:v libx265 \
///   -x265-params "keyint=7:min-keyint=7:bframes=0:scenecut=0:max-tu-size=32" \
///   -f hevc -y m12p.265
/// # filtered references:
/// docker run --rm -v "$PWD:/w" -w /w linuxserver/ffmpeg:9.0.2 \
///   -v error -i /w/m10b.265 -f framemd5 -
/// # unfiltered (`-skip_loop_filter all`) references likewise.
/// ```
///
/// The Main10 stream signals weighted_pred_flag/weighted_bipred_flag and
/// per-slice weight tables, so the weighted uni/bi motion-compensation paths
/// run at 10-bit. The Main12 stream uses 32x32 transform units, which exercise
/// the negative dequant shift (`15 - 12 - 5 < 0`).
///
/// Original FFmpeg code is LGPL-2.1-or-later; this port keeps the same license.
///|
let hevc_m10b_b64 : Bytes = b""

///|
let hevc_m12p_b64 : Bytes = b""

///|
/// The IDR access unit (VPS/SPS/PPS/SEI + first slice) extracted from the
/// Main10 stream above, for the standalone intra-frame entry points.
let hevc_m10b_idr_b64 : Bytes = b""

///|
/// FFmpeg default-decode frame MD5s in presentation order. */
let hevc_m10b_filtered_refs : Array[String] = [
