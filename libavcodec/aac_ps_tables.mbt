///|
/// Parametric Stereo tables, generated by scripts/extract_ps_tables.py
/// from the FFmpeg 9.0.2 tablegen float tables (bit-exact transcription
/// of the instrumented `ps_tableinit` dump: each float32 value widened
/// to an exact double, packed little-endian f64 and base64'd) and the
/// Huffman data tables of libavcodec/aacpsdata.c (canonical codes
/// assigned in table order, the `huff_offset` baked into the symbols,
/// as `ff_vlc_init_from_lengths`). The byte-string form keeps the wasm
/// init function's local count flat; `ps_unpack_*` decode at startup.
/// LGPL-2.1-or-later.

///|
/// `pd_re_smooth` (512 values).
let ps_pd_re_smooth : Array[Double] = ps_unpack_f64(
  b"",
)

///|
/// `pd_im_smooth` (512 values).
let ps_pd_im_smooth : Array[Double] = ps_unpack_f64(
  b"",
)

///|
/// `HA` (1472 values).
let ps_ha : Array[Double] = ps_unpack_f64(
  b"" +
  b"",
)

///|
/// `HB` (1472 values).
let ps_hb : Array[Double] = ps_unpack_f64(
  b"" +
  b"",
)

///|
/// `f20_0_8` (112 values).
let ps_f20_0_8 : Array[Double] = ps_unpack_f64(
  b"",
)

///|
/// `f34_0_12` (168 values).
let ps_f34_0_12 : Array[Double] = ps_unpack_f64(
  b"",
)

///|
/// `f34_1_8` (112 values).
let ps_f34_1_8 : Array[Double] = ps_unpack_f64(
  b"",
)

///|
/// `f34_2_4` (56 values).
let ps_f34_2_4 : Array[Double] = ps_unpack_f64(
  b"",
)

///|
/// `Q_fract_allpass` (600 values).
let ps_q_fract_allpass : Array[Double] = ps_unpack_f64(
  b"",
)

///|
/// `phi_fract` (200 values).
let ps_phi_fract : Array[Double] = ps_unpack_f64(
  b"",
)

///|
/// `g1_Q2` (7 values).
let ps_g1_q2 : Array[Double] = ps_unpack_f64(
  b"AAAAAAAAAAAAAACAZHOTPwAAAAAAAAAAAAAAwKGrsr8AAAAAAAAAAAAAAMDzlNM/AAAAAAAA4D8=",
)

///|
