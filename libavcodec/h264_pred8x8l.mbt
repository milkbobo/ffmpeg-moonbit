///|
/// H.264 8x8 luma intra prediction (`pred8x8l_*` in `h264pred_template.c`),
/// used when High-profile `transform_8x8_mode` replaces four 4x4 transforms
/// by one 8x8 transform. The reference row/column is 3-tap filtered, then one
/// of the nine 4x4-style modes predicts the whole block.
///
/// Original FFmpeg code is LGPL-2.1-or-later; this port keeps the same license.

///|
/// `pred8x8l`. `top`/`left` describe the samples directly above and to the
/// left of the block; `topright` the eight samples above-right.
fn h264_pred8x8l(
  plane : Array[Int32],
  base : Int32,
  stride : Int32,
  mode : Int32,
  top : Bool,
  left : Bool,
  topright : Bool,
) -> Result[Unit, String] {
  let top_raw : Array[Int32] = Array::make(16, 128)
  let left_raw : Array[Int32] = Array::make(8, 128)
  let has_topleft = top && left
  let has_topright = top && topright
  let lt = if has_topleft { plane[base - stride - 1] } else { 128 }
  if top {
    for i = 0; i < 8; i = i + 1 {
      top_raw[i] = plane[base - stride + i]
    }
    for i = 8; i < 16; i = i + 1 {
      top_raw[i] = if has_topright {
        plane[base - stride + i]
      } else {
        top_raw[7]
      }
    }
  }
  if left {
    for i = 0; i < 8; i = i + 1 {
      left_raw[i] = plane[base - 1 + i * stride]
    }
  }
  let t : Array[Int32] = Array::make(16, 0)
  let l : Array[Int32] = Array::make(8, 0)
  t[0] = ((if has_topleft { lt } else { top_raw[0] }) + 2 * top_raw[0] +
    top_raw[1] + 2) >> 2
  for i = 1; i < 7; i = i + 1 {
    t[i] = (top_raw[i - 1] + 2 * top_raw[i] + top_raw[i + 1] + 2) >> 2
  }
  t[7] = ((if has_topright { top_raw[8] } else { top_raw[7] }) + 2 * top_raw[7] +
    top_raw[6] + 2) >> 2
  l[0] = ((if has_topleft { lt } else { left_raw[0] }) + 2 * left_raw[0] +
    left_raw[1] + 2) >> 2
  for i = 1; i < 7; i = i + 1 {
    l[i] = (left_raw[i - 1] + 2 * left_raw[i] + left_raw[i + 1] + 2) >> 2
  }
  l[7] = (left_raw[6] + 3 * left_raw[7] + 2) >> 2
  // `PREDICT_8x8_LOAD_TOPLEFT`: the filtered top-left sample used by
  // `pred8x8l_down_right` / `_vertical_right` / `_horizontal_down`.
  let ltf = (left_raw[0] + 2 * lt + top_raw[0] + 2) >> 2
  if mode == 3 || mode == 7 {
    if has_topright {
      for i = 8; i < 15; i = i + 1 {
        t[i] = (top_raw[i - 1] + 2 * top_raw[i] + top_raw[i + 1] + 2) >> 2
      }
      t[15] = (top_raw[14] + 3 * top_raw[15] + 2) >> 2
    } else {
      for i = 8; i < 16; i = i + 1 {
        t[i] = top_raw[7]
      }
    }
  }
  let put = fn(x : Int32, y : Int32, v : Int32) {
    plane[base + y * stride + x] = v
  }
  if mode == 0 {
    if !top {
      return Err("8x8 vertical prediction without top samples")
    }
    for j = 0; j < 8; j = j + 1 {
      for i = 0; i < 8; i = i + 1 {
        put(i, j, t[i])
      }
    }
  } else if mode == 1 {
    if !left {
      return Err("8x8 horizontal prediction without left samples")
    }
    for j = 0; j < 8; j = j + 1 {
      for i = 0; i < 8; i = i + 1 {
        put(i, j, l[j])
      }
    }
  } else if mode == 2 {
    let mut sum_t = 0
    let mut sum_l = 0
    for i = 0; i < 8; i = i + 1 {
      sum_t = sum_t + t[i]
      sum_l = sum_l + l[i]
    }
    let dc = if top && left {
      (sum_t + sum_l + 8) >> 4
    } else if top {
      (sum_t + 4) >> 3
    } else if left {
      (sum_l + 4) >> 3
    } else {
      128
    }
    for j = 0; j < 8; j = j + 1 {
      for i = 0; i < 8; i = i + 1 {
        put(i, j, dc)
      }
    }
  } else if mode == 9 || mode == 10 || mode == 11 {
    // `pred8x8l_left_dc` / `pred8x8l_top_dc` / `pred8x8l_128_dc`: the DC-edge
    // modes `ff_h264_check_intra4x4_pred_mode` remaps to when the top or left
    // samples are unavailable.
    let mut sum = 0
    if mode == 9 {
      for i = 0; i < 8; i = i + 1 {
        sum = sum + l[i]
      }
    } else if mode == 10 {
      for i = 0; i < 8; i = i + 1 {
        sum = sum + t[i]
      }
    }
    let dc = if mode == 11 {
      128
    } else {
      (sum + 4) >> 3
    }
    for j = 0; j < 8; j = j + 1 {
      for i = 0; i < 8; i = i + 1 {
        put(i, j, dc)
      }
    }

  } else if mode == 3 {
    put(0, 0, (t[0]+2*t[1]+t[2]+2)>>2)
    put(0, 1, (t[1]+2*t[2]+t[3]+2)>>2)
    put(1, 0, (t[1]+2*t[2]+t[3]+2)>>2)
    put(0, 2, (t[2]+2*t[3]+t[4]+2)>>2)
    put(1, 1, (t[2]+2*t[3]+t[4]+2)>>2)
    put(2, 0, (t[2]+2*t[3]+t[4]+2)>>2)
    put(0, 3, (t[3]+2*t[4]+t[5]+2)>>2)
    put(1, 2, (t[3]+2*t[4]+t[5]+2)>>2)
    put(2, 1, (t[3]+2*t[4]+t[5]+2)>>2)
    put(3, 0, (t[3]+2*t[4]+t[5]+2)>>2)
    put(0, 4, (t[4]+2*t[5]+t[6]+2)>>2)
    put(1, 3, (t[4]+2*t[5]+t[6]+2)>>2)
    put(2, 2, (t[4]+2*t[5]+t[6]+2)>>2)
    put(3, 1, (t[4]+2*t[5]+t[6]+2)>>2)
    put(4, 0, (t[4]+2*t[5]+t[6]+2)>>2)
    put(0, 5, (t[5]+2*t[6]+t[7]+2)>>2)
    put(1, 4, (t[5]+2*t[6]+t[7]+2)>>2)
    put(2, 3, (t[5]+2*t[6]+t[7]+2)>>2)
    put(3, 2, (t[5]+2*t[6]+t[7]+2)>>2)
    put(4, 1, (t[5]+2*t[6]+t[7]+2)>>2)
    put(5, 0, (t[5]+2*t[6]+t[7]+2)>>2)
    put(0, 6, (t[6]+2*t[7]+t[8]+2)>>2)
    put(1, 5, (t[6]+2*t[7]+t[8]+2)>>2)
    put(2, 4, (t[6]+2*t[7]+t[8]+2)>>2)
    put(3, 3, (t[6]+2*t[7]+t[8]+2)>>2)
    put(4, 2, (t[6]+2*t[7]+t[8]+2)>>2)
    put(5, 1, (t[6]+2*t[7]+t[8]+2)>>2)
    put(6, 0, (t[6]+2*t[7]+t[8]+2)>>2)
    put(0, 7, (t[7]+2*t[8]+t[9]+2)>>2)
    put(1, 6, (t[7]+2*t[8]+t[9]+2)>>2)
    put(2, 5, (t[7]+2*t[8]+t[9]+2)>>2)
    put(3, 4, (t[7]+2*t[8]+t[9]+2)>>2)
    put(4, 3, (t[7]+2*t[8]+t[9]+2)>>2)
    put(5, 2, (t[7]+2*t[8]+t[9]+2)>>2)
    put(6, 1, (t[7]+2*t[8]+t[9]+2)>>2)
    put(7, 0, (t[7]+2*t[8]+t[9]+2)>>2)
    put(1, 7, (t[8]+2*t[9]+t[10]+2)>>2)
    put(2, 6, (t[8]+2*t[9]+t[10]+2)>>2)
    put(3, 5, (t[8]+2*t[9]+t[10]+2)>>2)
    put(4, 4, (t[8]+2*t[9]+t[10]+2)>>2)
    put(5, 3, (t[8]+2*t[9]+t[10]+2)>>2)
    put(6, 2, (t[8]+2*t[9]+t[10]+2)>>2)
    put(7, 1, (t[8]+2*t[9]+t[10]+2)>>2)
    put(2, 7, (t[9]+2*t[10]+t[11]+2)>>2)
    put(3, 6, (t[9]+2*t[10]+t[11]+2)>>2)
    put(4, 5, (t[9]+2*t[10]+t[11]+2)>>2)
    put(5, 4, (t[9]+2*t[10]+t[11]+2)>>2)
    put(6, 3, (t[9]+2*t[10]+t[11]+2)>>2)
    put(7, 2, (t[9]+2*t[10]+t[11]+2)>>2)
    put(3, 7, (t[10]+2*t[11]+t[12]+2)>>2)
    put(4, 6, (t[10]+2*t[11]+t[12]+2)>>2)
    put(5, 5, (t[10]+2*t[11]+t[12]+2)>>2)
    put(6, 4, (t[10]+2*t[11]+t[12]+2)>>2)
    put(7, 3, (t[10]+2*t[11]+t[12]+2)>>2)
    put(4, 7, (t[11]+2*t[12]+t[13]+2)>>2)
    put(5, 6, (t[11]+2*t[12]+t[13]+2)>>2)
    put(6, 5, (t[11]+2*t[12]+t[13]+2)>>2)
    put(7, 4, (t[11]+2*t[12]+t[13]+2)>>2)
    put(5, 7, (t[12]+2*t[13]+t[14]+2)>>2)
    put(6, 6, (t[12]+2*t[13]+t[14]+2)>>2)
    put(7, 5, (t[12]+2*t[13]+t[14]+2)>>2)
    put(6, 7, (t[13]+2*t[14]+t[15]+2)>>2)
    put(7, 6, (t[13]+2*t[14]+t[15]+2)>>2)
    put(7, 7, (t[14]+3*t[15]+2)>>2)
  } else if mode == 4 {
    put(0, 7, (l[7]+2*l[6]+l[5]+2)>>2)
    put(0, 6, (l[6]+2*l[5]+l[4]+2)>>2)
    put(1, 7, (l[6]+2*l[5]+l[4]+2)>>2)
    put(0, 5, (l[5]+2*l[4]+l[3]+2)>>2)
    put(1, 6, (l[5]+2*l[4]+l[3]+2)>>2)
    put(2, 7, (l[5]+2*l[4]+l[3]+2)>>2)
    put(0, 4, (l[4]+2*l[3]+l[2]+2)>>2)
    put(1, 5, (l[4]+2*l[3]+l[2]+2)>>2)
    put(2, 6, (l[4]+2*l[3]+l[2]+2)>>2)
    put(3, 7, (l[4]+2*l[3]+l[2]+2)>>2)
    put(0, 3, (l[3]+2*l[2]+l[1]+2)>>2)
    put(1, 4, (l[3]+2*l[2]+l[1]+2)>>2)
    put(2, 5, (l[3]+2*l[2]+l[1]+2)>>2)
    put(3, 6, (l[3]+2*l[2]+l[1]+2)>>2)
    put(4, 7, (l[3]+2*l[2]+l[1]+2)>>2)
    put(0, 2, (l[2]+2*l[1]+l[0]+2)>>2)
    put(1, 3, (l[2]+2*l[1]+l[0]+2)>>2)
    put(2, 4, (l[2]+2*l[1]+l[0]+2)>>2)
    put(3, 5, (l[2]+2*l[1]+l[0]+2)>>2)
    put(4, 6, (l[2]+2*l[1]+l[0]+2)>>2)
    put(5, 7, (l[2]+2*l[1]+l[0]+2)>>2)
    put(0, 1, (l[1]+2*l[0]+ltf+2)>>2)
    put(1, 2, (l[1]+2*l[0]+ltf+2)>>2)
    put(2, 3, (l[1]+2*l[0]+ltf+2)>>2)
    put(3, 4, (l[1]+2*l[0]+ltf+2)>>2)
    put(4, 5, (l[1]+2*l[0]+ltf+2)>>2)
    put(5, 6, (l[1]+2*l[0]+ltf+2)>>2)
    put(6, 7, (l[1]+2*l[0]+ltf+2)>>2)
    put(0, 0, (l[0]+2*ltf+t[0]+2)>>2)
    put(1, 1, (l[0]+2*ltf+t[0]+2)>>2)
    put(2, 2, (l[0]+2*ltf+t[0]+2)>>2)
    put(3, 3, (l[0]+2*ltf+t[0]+2)>>2)
    put(4, 4, (l[0]+2*ltf+t[0]+2)>>2)
    put(5, 5, (l[0]+2*ltf+t[0]+2)>>2)
    put(6, 6, (l[0]+2*ltf+t[0]+2)>>2)
    put(7, 7, (l[0]+2*ltf+t[0]+2)>>2)
    put(1, 0, (ltf+2*t[0]+t[1]+2)>>2)
    put(2, 1, (ltf+2*t[0]+t[1]+2)>>2)
    put(3, 2, (ltf+2*t[0]+t[1]+2)>>2)
    put(4, 3, (ltf+2*t[0]+t[1]+2)>>2)
    put(5, 4, (ltf+2*t[0]+t[1]+2)>>2)
    put(6, 5, (ltf+2*t[0]+t[1]+2)>>2)
    put(7, 6, (ltf+2*t[0]+t[1]+2)>>2)
    put(2, 0, (t[0]+2*t[1]+t[2]+2)>>2)
    put(3, 1, (t[0]+2*t[1]+t[2]+2)>>2)
    put(4, 2, (t[0]+2*t[1]+t[2]+2)>>2)
    put(5, 3, (t[0]+2*t[1]+t[2]+2)>>2)
    put(6, 4, (t[0]+2*t[1]+t[2]+2)>>2)
    put(7, 5, (t[0]+2*t[1]+t[2]+2)>>2)
    put(3, 0, (t[1]+2*t[2]+t[3]+2)>>2)
    put(4, 1, (t[1]+2*t[2]+t[3]+2)>>2)
    put(5, 2, (t[1]+2*t[2]+t[3]+2)>>2)
    put(6, 3, (t[1]+2*t[2]+t[3]+2)>>2)
    put(7, 4, (t[1]+2*t[2]+t[3]+2)>>2)
    put(4, 0, (t[2]+2*t[3]+t[4]+2)>>2)
    put(5, 1, (t[2]+2*t[3]+t[4]+2)>>2)
    put(6, 2, (t[2]+2*t[3]+t[4]+2)>>2)
    put(7, 3, (t[2]+2*t[3]+t[4]+2)>>2)
    put(5, 0, (t[3]+2*t[4]+t[5]+2)>>2)
    put(6, 1, (t[3]+2*t[4]+t[5]+2)>>2)
    put(7, 2, (t[3]+2*t[4]+t[5]+2)>>2)
    put(6, 0, (t[4]+2*t[5]+t[6]+2)>>2)
    put(7, 1, (t[4]+2*t[5]+t[6]+2)>>2)
    put(7, 0, (t[5]+2*t[6]+t[7]+2)>>2)
  } else if mode == 5 {
    put(0, 6, (l[5]+2*l[4]+l[3]+2)>>2)
    put(0, 7, (l[6]+2*l[5]+l[4]+2)>>2)
    put(0, 4, (l[3]+2*l[2]+l[1]+2)>>2)
    put(1, 6, (l[3]+2*l[2]+l[1]+2)>>2)
    put(0, 5, (l[4]+2*l[3]+l[2]+2)>>2)
    put(1, 7, (l[4]+2*l[3]+l[2]+2)>>2)
    put(0, 2, (l[1]+2*l[0]+ltf+2)>>2)
    put(1, 4, (l[1]+2*l[0]+ltf+2)>>2)
    put(2, 6, (l[1]+2*l[0]+ltf+2)>>2)
    put(0, 3, (l[2]+2*l[1]+l[0]+2)>>2)
    put(1, 5, (l[2]+2*l[1]+l[0]+2)>>2)
    put(2, 7, (l[2]+2*l[1]+l[0]+2)>>2)
    put(0, 1, (l[0]+2*ltf+t[0]+2)>>2)
    put(1, 3, (l[0]+2*ltf+t[0]+2)>>2)
    put(2, 5, (l[0]+2*ltf+t[0]+2)>>2)
    put(3, 7, (l[0]+2*ltf+t[0]+2)>>2)
    put(0, 0, (ltf+t[0]+1)>>1)
    put(1, 2, (ltf+t[0]+1)>>1)
    put(2, 4, (ltf+t[0]+1)>>1)
    put(3, 6, (ltf+t[0]+1)>>1)
    put(1, 1, (ltf+2*t[0]+t[1]+2)>>2)
    put(2, 3, (ltf+2*t[0]+t[1]+2)>>2)
    put(3, 5, (ltf+2*t[0]+t[1]+2)>>2)
    put(4, 7, (ltf+2*t[0]+t[1]+2)>>2)
    put(1, 0, (t[0]+t[1]+1)>>1)
    put(2, 2, (t[0]+t[1]+1)>>1)
    put(3, 4, (t[0]+t[1]+1)>>1)
    put(4, 6, (t[0]+t[1]+1)>>1)
    put(2, 1, (t[0]+2*t[1]+t[2]+2)>>2)
    put(3, 3, (t[0]+2*t[1]+t[2]+2)>>2)
    put(4, 5, (t[0]+2*t[1]+t[2]+2)>>2)
    put(5, 7, (t[0]+2*t[1]+t[2]+2)>>2)
    put(2, 0, (t[1]+t[2]+1)>>1)
    put(3, 2, (t[1]+t[2]+1)>>1)
    put(4, 4, (t[1]+t[2]+1)>>1)
    put(5, 6, (t[1]+t[2]+1)>>1)
    put(3, 1, (t[1]+2*t[2]+t[3]+2)>>2)
    put(4, 3, (t[1]+2*t[2]+t[3]+2)>>2)
    put(5, 5, (t[1]+2*t[2]+t[3]+2)>>2)
    put(6, 7, (t[1]+2*t[2]+t[3]+2)>>2)
    put(3, 0, (t[2]+t[3]+1)>>1)
    put(4, 2, (t[2]+t[3]+1)>>1)
    put(5, 4, (t[2]+t[3]+1)>>1)
    put(6, 6, (t[2]+t[3]+1)>>1)
    put(4, 1, (t[2]+2*t[3]+t[4]+2)>>2)
    put(5, 3, (t[2]+2*t[3]+t[4]+2)>>2)
    put(6, 5, (t[2]+2*t[3]+t[4]+2)>>2)
    put(7, 7, (t[2]+2*t[3]+t[4]+2)>>2)
    put(4, 0, (t[3]+t[4]+1)>>1)
    put(5, 2, (t[3]+t[4]+1)>>1)
    put(6, 4, (t[3]+t[4]+1)>>1)
    put(7, 6, (t[3]+t[4]+1)>>1)
    put(5, 1, (t[3]+2*t[4]+t[5]+2)>>2)
    put(6, 3, (t[3]+2*t[4]+t[5]+2)>>2)
    put(7, 5, (t[3]+2*t[4]+t[5]+2)>>2)
    put(5, 0, (t[4]+t[5]+1)>>1)
    put(6, 2, (t[4]+t[5]+1)>>1)
    put(7, 4, (t[4]+t[5]+1)>>1)
    put(6, 1, (t[4]+2*t[5]+t[6]+2)>>2)
    put(7, 3, (t[4]+2*t[5]+t[6]+2)>>2)
    put(6, 0, (t[5]+t[6]+1)>>1)
    put(7, 2, (t[5]+t[6]+1)>>1)
    put(7, 1, (t[5]+2*t[6]+t[7]+2)>>2)
    put(7, 0, (t[6]+t[7]+1)>>1)
  } else if mode == 6 {
    put(0, 7, (l[6]+l[7]+1)>>1)
    put(1, 7, (l[5]+2*l[6]+l[7]+2)>>2)
    put(0, 6, (l[5]+l[6]+1)>>1)
    put(2, 7, (l[5]+l[6]+1)>>1)
    put(1, 6, (l[4]+2*l[5]+l[6]+2)>>2)
    put(3, 7, (l[4]+2*l[5]+l[6]+2)>>2)
    put(0, 5, (l[4]+l[5]+1)>>1)
    put(2, 6, (l[4]+l[5]+1)>>1)
    put(4, 7, (l[4]+l[5]+1)>>1)
    put(1, 5, (l[3]+2*l[4]+l[5]+2)>>2)
    put(3, 6, (l[3]+2*l[4]+l[5]+2)>>2)
    put(5, 7, (l[3]+2*l[4]+l[5]+2)>>2)
    put(0, 4, (l[3]+l[4]+1)>>1)
    put(2, 5, (l[3]+l[4]+1)>>1)
    put(4, 6, (l[3]+l[4]+1)>>1)
    put(6, 7, (l[3]+l[4]+1)>>1)
    put(1, 4, (l[2]+2*l[3]+l[4]+2)>>2)
    put(3, 5, (l[2]+2*l[3]+l[4]+2)>>2)
    put(5, 6, (l[2]+2*l[3]+l[4]+2)>>2)
    put(7, 7, (l[2]+2*l[3]+l[4]+2)>>2)
    put(0, 3, (l[2]+l[3]+1)>>1)
    put(2, 4, (l[2]+l[3]+1)>>1)
    put(4, 5, (l[2]+l[3]+1)>>1)
    put(6, 6, (l[2]+l[3]+1)>>1)
    put(1, 3, (l[1]+2*l[2]+l[3]+2)>>2)
    put(3, 4, (l[1]+2*l[2]+l[3]+2)>>2)
    put(5, 5, (l[1]+2*l[2]+l[3]+2)>>2)
    put(7, 6, (l[1]+2*l[2]+l[3]+2)>>2)
    put(0, 2, (l[1]+l[2]+1)>>1)
    put(2, 3, (l[1]+l[2]+1)>>1)
    put(4, 4, (l[1]+l[2]+1)>>1)
    put(6, 5, (l[1]+l[2]+1)>>1)
    put(1, 2, (l[0]+2*l[1]+l[2]+2)>>2)
    put(3, 3, (l[0]+2*l[1]+l[2]+2)>>2)
    put(5, 4, (l[0]+2*l[1]+l[2]+2)>>2)
    put(7, 5, (l[0]+2*l[1]+l[2]+2)>>2)
    put(0, 1, (l[0]+l[1]+1)>>1)
    put(2, 2, (l[0]+l[1]+1)>>1)
    put(4, 3, (l[0]+l[1]+1)>>1)
    put(6, 4, (l[0]+l[1]+1)>>1)
    put(1, 1, (ltf+2*l[0]+l[1]+2)>>2)
    put(3, 2, (ltf+2*l[0]+l[1]+2)>>2)
    put(5, 3, (ltf+2*l[0]+l[1]+2)>>2)
    put(7, 4, (ltf+2*l[0]+l[1]+2)>>2)
    put(0, 0, (ltf+l[0]+1)>>1)
    put(2, 1, (ltf+l[0]+1)>>1)
    put(4, 2, (ltf+l[0]+1)>>1)
    put(6, 3, (ltf+l[0]+1)>>1)
    put(1, 0, (l[0]+2*ltf+t[0]+2)>>2)
    put(3, 1, (l[0]+2*ltf+t[0]+2)>>2)
    put(5, 2, (l[0]+2*ltf+t[0]+2)>>2)
    put(7, 3, (l[0]+2*ltf+t[0]+2)>>2)
    put(2, 0, (t[1]+2*t[0]+ltf+2)>>2)
    put(4, 1, (t[1]+2*t[0]+ltf+2)>>2)
    put(6, 2, (t[1]+2*t[0]+ltf+2)>>2)
    put(3, 0, (t[2]+2*t[1]+t[0]+2)>>2)
    put(5, 1, (t[2]+2*t[1]+t[0]+2)>>2)
    put(7, 2, (t[2]+2*t[1]+t[0]+2)>>2)
    put(4, 0, (t[3]+2*t[2]+t[1]+2)>>2)
    put(6, 1, (t[3]+2*t[2]+t[1]+2)>>2)
    put(5, 0, (t[4]+2*t[3]+t[2]+2)>>2)
    put(7, 1, (t[4]+2*t[3]+t[2]+2)>>2)
    put(6, 0, (t[5]+2*t[4]+t[3]+2)>>2)
    put(7, 0, (t[6]+2*t[5]+t[4]+2)>>2)
  } else if mode == 7 {
    put(0, 0, (t[0]+t[1]+1)>>1)
    put(0, 1, (t[0]+2*t[1]+t[2]+2)>>2)
    put(0, 2, (t[1]+t[2]+1)>>1)
    put(1, 0, (t[1]+t[2]+1)>>1)
    put(0, 3, (t[1]+2*t[2]+t[3]+2)>>2)
    put(1, 1, (t[1]+2*t[2]+t[3]+2)>>2)
    put(0, 4, (t[2]+t[3]+1)>>1)
    put(1, 2, (t[2]+t[3]+1)>>1)
    put(2, 0, (t[2]+t[3]+1)>>1)
    put(0, 5, (t[2]+2*t[3]+t[4]+2)>>2)
    put(1, 3, (t[2]+2*t[3]+t[4]+2)>>2)
    put(2, 1, (t[2]+2*t[3]+t[4]+2)>>2)
    put(0, 6, (t[3]+t[4]+1)>>1)
    put(1, 4, (t[3]+t[4]+1)>>1)
    put(2, 2, (t[3]+t[4]+1)>>1)
    put(3, 0, (t[3]+t[4]+1)>>1)
    put(0, 7, (t[3]+2*t[4]+t[5]+2)>>2)
    put(1, 5, (t[3]+2*t[4]+t[5]+2)>>2)
    put(2, 3, (t[3]+2*t[4]+t[5]+2)>>2)
    put(3, 1, (t[3]+2*t[4]+t[5]+2)>>2)
    put(1, 6, (t[4]+t[5]+1)>>1)
    put(2, 4, (t[4]+t[5]+1)>>1)
    put(3, 2, (t[4]+t[5]+1)>>1)
    put(4, 0, (t[4]+t[5]+1)>>1)
    put(1, 7, (t[4]+2*t[5]+t[6]+2)>>2)
    put(2, 5, (t[4]+2*t[5]+t[6]+2)>>2)
    put(3, 3, (t[4]+2*t[5]+t[6]+2)>>2)
    put(4, 1, (t[4]+2*t[5]+t[6]+2)>>2)
    put(2, 6, (t[5]+t[6]+1)>>1)
    put(3, 4, (t[5]+t[6]+1)>>1)
    put(4, 2, (t[5]+t[6]+1)>>1)
    put(5, 0, (t[5]+t[6]+1)>>1)
    put(2, 7, (t[5]+2*t[6]+t[7]+2)>>2)
    put(3, 5, (t[5]+2*t[6]+t[7]+2)>>2)
    put(4, 3, (t[5]+2*t[6]+t[7]+2)>>2)
    put(5, 1, (t[5]+2*t[6]+t[7]+2)>>2)
    put(3, 6, (t[6]+t[7]+1)>>1)
    put(4, 4, (t[6]+t[7]+1)>>1)
    put(5, 2, (t[6]+t[7]+1)>>1)
    put(6, 0, (t[6]+t[7]+1)>>1)
    put(3, 7, (t[6]+2*t[7]+t[8]+2)>>2)
    put(4, 5, (t[6]+2*t[7]+t[8]+2)>>2)
    put(5, 3, (t[6]+2*t[7]+t[8]+2)>>2)
    put(6, 1, (t[6]+2*t[7]+t[8]+2)>>2)
    put(4, 6, (t[7]+t[8]+1)>>1)
    put(5, 4, (t[7]+t[8]+1)>>1)
    put(6, 2, (t[7]+t[8]+1)>>1)
    put(7, 0, (t[7]+t[8]+1)>>1)
    put(4, 7, (t[7]+2*t[8]+t[9]+2)>>2)
    put(5, 5, (t[7]+2*t[8]+t[9]+2)>>2)
    put(6, 3, (t[7]+2*t[8]+t[9]+2)>>2)
    put(7, 1, (t[7]+2*t[8]+t[9]+2)>>2)
    put(5, 6, (t[8]+t[9]+1)>>1)
    put(6, 4, (t[8]+t[9]+1)>>1)
    put(7, 2, (t[8]+t[9]+1)>>1)
    put(5, 7, (t[8]+2*t[9]+t[10]+2)>>2)
    put(6, 5, (t[8]+2*t[9]+t[10]+2)>>2)
    put(7, 3, (t[8]+2*t[9]+t[10]+2)>>2)
    put(6, 6, (t[9]+t[10]+1)>>1)
    put(7, 4, (t[9]+t[10]+1)>>1)
    put(6, 7, (t[9]+2*t[10]+t[11]+2)>>2)
    put(7, 5, (t[9]+2*t[10]+t[11]+2)>>2)
    put(7, 6, (t[10]+t[11]+1)>>1)
    put(7, 7, (t[10]+2*t[11]+t[12]+2)>>2)
  } else if mode == 8 {
    put(0, 0, (l[0]+l[1]+1)>>1)
    put(1, 0, (l[0]+2*l[1]+l[2]+2)>>2)
    put(0, 1, (l[1]+l[2]+1)>>1)
    put(2, 0, (l[1]+l[2]+1)>>1)
    put(1, 1, (l[1]+2*l[2]+l[3]+2)>>2)
    put(3, 0, (l[1]+2*l[2]+l[3]+2)>>2)
    put(0, 2, (l[2]+l[3]+1)>>1)
    put(2, 1, (l[2]+l[3]+1)>>1)
    put(4, 0, (l[2]+l[3]+1)>>1)
    put(1, 2, (l[2]+2*l[3]+l[4]+2)>>2)
    put(3, 1, (l[2]+2*l[3]+l[4]+2)>>2)
    put(5, 0, (l[2]+2*l[3]+l[4]+2)>>2)
    put(0, 3, (l[3]+l[4]+1)>>1)
    put(2, 2, (l[3]+l[4]+1)>>1)
    put(4, 1, (l[3]+l[4]+1)>>1)
    put(6, 0, (l[3]+l[4]+1)>>1)
    put(1, 3, (l[3]+2*l[4]+l[5]+2)>>2)
    put(3, 2, (l[3]+2*l[4]+l[5]+2)>>2)
    put(5, 1, (l[3]+2*l[4]+l[5]+2)>>2)
    put(7, 0, (l[3]+2*l[4]+l[5]+2)>>2)
    put(0, 4, (l[4]+l[5]+1)>>1)
    put(2, 3, (l[4]+l[5]+1)>>1)
    put(4, 2, (l[4]+l[5]+1)>>1)
    put(6, 1, (l[4]+l[5]+1)>>1)
    put(1, 4, (l[4]+2*l[5]+l[6]+2)>>2)
    put(3, 3, (l[4]+2*l[5]+l[6]+2)>>2)
    put(5, 2, (l[4]+2*l[5]+l[6]+2)>>2)
    put(7, 1, (l[4]+2*l[5]+l[6]+2)>>2)
    put(0, 5, (l[5]+l[6]+1)>>1)
    put(2, 4, (l[5]+l[6]+1)>>1)
    put(4, 3, (l[5]+l[6]+1)>>1)
    put(6, 2, (l[5]+l[6]+1)>>1)
    put(1, 5, (l[5]+2*l[6]+l[7]+2)>>2)
    put(3, 4, (l[5]+2*l[6]+l[7]+2)>>2)
    put(5, 3, (l[5]+2*l[6]+l[7]+2)>>2)
    put(7, 2, (l[5]+2*l[6]+l[7]+2)>>2)
    put(0, 6, (l[6]+l[7]+1)>>1)
    put(2, 5, (l[6]+l[7]+1)>>1)
    put(4, 4, (l[6]+l[7]+1)>>1)
    put(6, 3, (l[6]+l[7]+1)>>1)
    put(1, 6, (l[6]+3*l[7]+2)>>2)
    put(3, 5, (l[6]+3*l[7]+2)>>2)
    put(5, 4, (l[6]+3*l[7]+2)>>2)
    put(7, 3, (l[6]+3*l[7]+2)>>2)
    put(0, 7, l[7])
    put(1, 7, l[7])
    put(2, 6, l[7])
    put(2, 7, l[7])
    put(3, 6, l[7])
    put(3, 7, l[7])
    put(4, 5, l[7])
    put(4, 6, l[7])
    put(4, 7, l[7])
    put(5, 5, l[7])
    put(5, 6, l[7])
    put(5, 7, l[7])
    put(6, 4, l[7])
    put(6, 5, l[7])
    put(6, 6, l[7])
    put(6, 7, l[7])
    put(7, 4, l[7])
    put(7, 5, l[7])
    put(7, 6, l[7])
    put(7, 7, l[7])
  } else {
    return Err("invalid 8x8 intra mode")
  }
  Ok(())
}
