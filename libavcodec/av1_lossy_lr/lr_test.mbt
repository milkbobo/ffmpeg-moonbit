///|
/// Loop-restoration key-frame regression:
/// - `wt1.ivf` (320x240, 4 frames): libaom + mandelbrot content, Wiener filter
/// - `t5.ivf` (160x120, 6 frames): SVT-AV1, SGR (3x3/5x5/mix) filters
/// Expected MD5s are libdav1d framemd5 (yuv420p, full loop filter + CDEF + LR).

///|
let av1_lr_wt1_b64 : Bytes = b""

///|
let av1_lr_wt1_md5 : Array[String] = ["04e5d07ad8edbc5eccdb02516a1cff70", "ed5c481bd1f02cd32e9793147768db0f", "ac7ab65cead910d627a2b875c963bf7d", "e6a1501946396d0889b7bf9ed76ff846"]

///|
let av1_lr_t5_b64 : Bytes = b""

///|
let av1_lr_t5_md5 : Array[String] = ["3e54f57b1478b61603caf29b946ec8e8", "43593361905f7d2bfa7c3157db4e9e53", "d1ac4cf73669b28d1e6c3f0dbc044aa6", "3a34712d1e02b4ddf95020f5b024a296", "72cfa51c88e563b020a1b9897067e62a", "60155d7b1cece7eed8ddfcb42375dea6"]


///|
let av1_lr_lr10_b64 : Bytes = b""

///|
let av1_lr_lr10_md5 : Array[String] = ["2a372ce14a1e67cc0cd64c4fdc0ea4c2", "3129d945e768ab7adf5fc9628a0b014b", "b872661315a140b7972e61db7f4b83ab", "e4d56aa79e1fe215898299112fab70be"]

///|
let av1_lr_lr12_b64 : Bytes = b""

///|
let av1_lr_lr12_md5 : Array[String] = ["815148171e131ab4a77ed80095cb06ef", "d01b9cfd6767e80c54842589a4dfd597", "fc3acf2bf9706b964f230260d95e7c95", "71bd96dec8d6bc68c9e66650414aa1c6"]

///|
let av1_lr_lr10nc_b64 : Bytes = b""

///|
let av1_lr_lr10nc_md5 : Array[String] = ["aee14e2a0ae4e1865c9d399338ba5084", "2c418dc56d186633e1a1a18b7d089083", "421ddb7466a9b4c0f02b8bc84da67894", "82c14671cf9aab4287ccdff4aca8fa52"]

///|
fn av1_lr_frames(ivf : Bytes) -> Array[Bytes] {
  let frames : Array[Bytes] = []
  let mut pos = 32
  while pos + 12 <= ivf.length() {
    let size = (ivf[pos].to_int() | (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16)) |
      (ivf[pos + 3].to_int() << 24)
    frames.push(ivf[pos + 12:pos + 12 + size].to_owned())
    pos = pos + 12 + size
  }
  frames
}

///|
fn av1_lr_hex(digest : FixedArray[Byte]) -> String {
  let digits : Bytes = b"0123456789abcdef"
  let chars : Array[Char] = []
  for i in 0..<16 {
    let v = digest[i].to_uint().reinterpret_as_int()
    chars.push(digits[v >> 4].to_char())
    chars.push(digits[v & 15].to_char())
  }
  String::from_array(chars[:])
}

///|
fn av1_lr_md5(packed : Bytes) -> String {
  let digest : FixedArray[Byte] = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, packed, packed.length())
  av1_lr_hex(digest)
}

///|
fn av1_lr_decode(b64 : Bytes) -> Array[String] raise {
  let ivf = @libavutil.av_base64_decode(b64, 1048576).unwrap()
  let frames = av1_lr_frames(ivf)
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  let md5s : Array[String] = []
  for obus in frames {
    if seq is None {
      match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(s) => seq = Some(s)
        Err(e) => fail(e)
      }
    }
    let s = match seq {
      Some(s) => s
      None => fail("no sequence header")
    }
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(h) => h
      Err(e) => fail(e)
    }
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(t) => t
      Err(e) => fail(e)
    }
    let out = match @libavcodec.av1_decode_keyframe(s, hdr, tiles[0].data()) {
      Ok(f) => f
      Err(e) => fail(e)
    }
    md5s.push(av1_lr_md5(out.packed()))
  }
  md5s
}

///|
fn av1_lr_check(name : String, got : Array[String], want : Array[String]) -> Unit raise {
  if got.length() != want.length() {
    fail(name + ": frame count mismatch")
  }
  for i in 0..<want.length() {
    if got[i] != want[i] {
      fail(
        name + " frame " + i.to_string() + ": got " + got[i] + " want " + want[i],
      )
    }
  }
}

///|
test "av1 loop restoration matches libdav1d" {
  av1_lr_check("wt1", av1_lr_decode(av1_lr_wt1_b64), av1_lr_wt1_md5)
  av1_lr_check("t5", av1_lr_decode(av1_lr_t5_b64), av1_lr_t5_md5)
  av1_lr_check("lr10nc", av1_lr_decode(av1_lr_lr10nc_b64), av1_lr_lr10nc_md5)
  av1_lr_check("lr10", av1_lr_decode(av1_lr_lr10_b64), av1_lr_lr10_md5)
  av1_lr_check("lr12", av1_lr_decode(av1_lr_lr12_b64), av1_lr_lr12_md5)
}
