///|
/// Real AV1 intra block copy: SVT-AV1 v4.2 streams (`-svtav1-params
/// enable-intrabc=1`, with and without screen-content-mode=2, 8/10-bit,
/// 64x48 and 128x96 2x2-tile variants) whose key frames carry
/// `allow_intrabc=1` and intrabc blocks. Frame MD5s match dav1d 1.5.1's
/// `-fps_mode passthrough -f framemd5` output.

///|
let av1_intrabc_cases : Array[(String, Bytes, Array[String])] = [
  (
    "testsrc2, intrabc",
    @libavutil.av_base64_decode(
      b"",
      8192,
    ).unwrap(),
    [
      "a8e4db41b9c5ecc2eb461b90188a6a73", "ad93113ecf812b16a5158b7f2c4e3892", "81f80d179ac15b2353769ed34953d34d",
      "81f80d179ac15b2353769ed34953d34d",
    ],
  ),
  (
    "smptebars, intrabc",
    @libavutil.av_base64_decode(
      b"",
      8192,
    ).unwrap(),
    [
      "9f7229b841a757f2c721e698bee33d7c", "9f7229b841a757f2c721e698bee33d7c", "9f7229b841a757f2c721e698bee33d7c",
      "9f7229b841a757f2c721e698bee33d7c",
    ],
  ),
  (
    "testsrc2, screen-content-mode=2",
    @libavutil.av_base64_decode(
      b"",
      8192,
    ).unwrap(),
    [
      "a8e4db41b9c5ecc2eb461b90188a6a73", "ad93113ecf812b16a5158b7f2c4e3892", "81f80d179ac15b2353769ed34953d34d",
      "81f80d179ac15b2353769ed34953d34d",
    ],
  ),
  (
    "smptebars, screen-content-mode=2",
    @libavutil.av_base64_decode(
      b"",
      8192,
    ).unwrap(),
    [
      "9f7229b841a757f2c721e698bee33d7c", "9f7229b841a757f2c721e698bee33d7c", "9f7229b841a757f2c721e698bee33d7c",
      "9f7229b841a757f2c721e698bee33d7c",
    ],
  ),
  (
    "testsrc2, 10-bit",
    @libavutil.av_base64_decode(
      b"",
      8192,
    ).unwrap(),
    [
      "93676209c125b8b4231e0a07244c9c9e", "df8caa90e9928e082e86974526208ed6", "d9534ae2b3ff87ca1ca29a9c6a4126f2",
      "d9534ae2b3ff87ca1ca29a9c6a4126f2",
    ],
  ),
  (
    "testsrc2 128x96 (4 SBs)",
    @libavutil.av_base64_decode(
      b"",
      8192,
    ).unwrap(),
    [
      "ba7edeb0742ccaf99825128a371a77a1", "840317e05db787d49c89602e16c9dc06", "1d1806b4efdc861a9610d8e8a9543eef",
      "7bcd4a9aed5698dd6eebf56e731cc8c1",
    ],
  ),
  (
    "testsrc2 128x96, 2x2 tiles",
    @libavutil.av_base64_decode(
      b"",
      8192,
    ).unwrap(),
    [
      "c6c74f315ac72a6dca1206c658eaf0ff", "e7d3dfb6d8e8c4fc9a0fe2729b6c2e65", "f7006b28d65fba8aff8da33ffc537519",
      "4f12570c695e114c697ed3f5d253ef45",
    ],
  ),
  (
    "testsrc2 128x96, 2x2 tiles + 10-bit",
    @libavutil.av_base64_decode(
      b"",
      8192,
    ).unwrap(),
    [
      "e6849090f86b1141f931ab1367e9abf0", "a0717fd64a49074b54bc1d526203f04f", "9ed463c5ea6024cbeab56ee5ee199efb",
      "435c53dd2f0bd8a7b7eb2ceb1dd26c01",
    ],
  ),
]

///|
fn av1_intrabc_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "av1: intrabc blocks decode like dav1d" {
  for entry in av1_intrabc_cases {
    let (name, data, refs) = entry
    let dec = @libavcodec.Av1Decoder::new()
    let mut pos = 32
    let mut index = 0
    while pos + 12 <= data.length() {
      let size = data[pos].to_int() |
        (data[pos + 1].to_int() << 8) |
        (data[pos + 2].to_int() << 16) |
        (data[pos + 3].to_int() << 24)
      match dec.decode_packet(data[pos + 12:pos + 12 + size].to_owned()) {
        Ok(Some(picture)) => {
          assert_true(index < refs.length(), msg=name)
          assert_eq(
            av1_intrabc_md5(picture.packed()),
            refs[index],
            msg="\{name} frame \{index}",
          )
          index = index + 1
        }
        Ok(None) => ()
        Err(e) => fail("\{name} packet \{index}: \{e}")
      }
      pos = pos + 12 + size
    }
    assert_eq(index, refs.length(), msg=name)
  }
}
