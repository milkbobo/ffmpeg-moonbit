///|
/// 10/12-bit lossless AV1 key frames (yuv420p10le / yuv420p12le),
/// generated with docker FFmpeg 9.0.2 (libaom `-crf 0`, testsrc2 128x96,
/// 3 key frames each).  Expected MD5s come from libdav1d framemd5 over
/// the packed 16-bit little-endian planes.

///|
let av1_hbd10_stream_b64 : Bytes = b""

///|
let av1_hbd10_md5 : Array[String] = [
  "7dc7c5cc9a687d4366ef5afae40330bb", "d4544f5e6cad72407560f56cde914453", "ba5c9e7d247ec3b04f8a48674dbe6be1",
]

///|
let av1_hbd12_stream_b64 : Bytes = b""

///|
let av1_hbd12_md5 : Array[String] = [
  "5d9e385db8620fca047dfd9b05433e6c", "d41201884cbe651024ddf8ea7a1007ba", "0a085ec3bfaab9b5f32b76765033f1fc",
]

///|
test "av1 hbd: 10-bit and 12-bit lossless keyframes match dav1d" {
  let d10 = av1_kf_decode_stream(
    @libavutil.av_base64_decode(av1_hbd10_stream_b64, 1000000).unwrap(),
  )
  assert_eq(d10.length(), 3)
  for i in 0..<3 {
    assert_eq(d10[i], av1_hbd10_md5[i])
  }
  let d12 = av1_kf_decode_stream(
    @libavutil.av_base64_decode(av1_hbd12_stream_b64, 1000000).unwrap(),
  )
  assert_eq(d12.length(), 3)
  for i in 0..<3 {
    assert_eq(d12[i], av1_hbd12_md5[i])
  }
}
