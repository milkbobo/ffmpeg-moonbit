///|
/// SBR end-to-end PCM vectors: `sbr_3ch.aac` (docker linuxserver/ffmpeg:9.0.2,
/// libfdk_aac -profile:a aac_he) decoded against FFmpeg's native float AAC
/// decoder output. Per-sample s16 comparison after interleaving the decoder's
/// per-channel output. LGPL-2.1-or-later.
let sbr_3ch_pcmtest_adts_b64 : Bytes = b""

///|
let sbr_3ch_pcm_b64 : Bytes = b""

///|
test "sbr_3ch: SBR output PCM matches FFmpeg" {
  let data = @libavutil.av_base64_decode(sbr_3ch_pcmtest_adts_b64, 16384).unwrap()
  let pcm = @libavutil.av_base64_decode(sbr_3ch_pcm_b64, 1 << 20).unwrap()
  let header = ff_adts_header_parse_buf(data).unwrap()
  let config = new_mpeg4_audio_config()
  config.object_type = 2
  config.sampling_index = header.sampling_index
  config.sample_rate = header.sample_rate
  config.chan_config = header.chan_config
  config.channels = header.chan_config
  config.frame_length = 1024
  config.sbr = -1
  config.ps = -1
  let dec = new_aac_decoder(config, 3)
  let mut pos = 0
  let mut frames = 0
  let mut max_diff = 0
  let mut exact = 0
  let mut samples = 0
  while pos < data.length() {
    let hdr = ff_adts_header_parse_buf(
      data.clamped_view(start=pos, end=pos + av_aac_adts_header_size).to_owned(),
    ).unwrap()
    let end = pos + hdr.frame_length
    let payload_start = pos +
      av_aac_adts_header_size +
      (if hdr.crc_absent == 0 { 2 } else { 0 })
    let payload = data.clamped_view(start=payload_start, end~).to_owned()
    let out = dec.decode_frame(payload).unwrap()
    let nch = out.length()
    for ch in 0..<nch {
      assert_eq(out[ch].samples.length(), 2048)
    }
    for i in 0..<2048 {
      for ch in 0..<nch {
        let idx = (samples + i) * nch + ch
        assert_true(idx * 2 + 1 < pcm.length())
        let value = pcm[idx * 2].to_int() | (pcm[idx * 2 + 1].to_int() << 8)
        let want = if value >= 32768 { value - 65536 } else { value }
        let got = aac_s16p(out[ch].samples[i])
        let diff = if got > want { got - want } else { want - got }
        if diff > max_diff {
          max_diff = diff
        }
        if diff == 0 {
          exact = exact + 1
        }
      }
    }
    samples = samples + 2048
    frames = frames + 1
    pos = end
  }
  assert_true(max_diff <= 1)
  assert_true(exact * 1000 >= samples * 3 * 999 / 1000)
  println(
    "frames=\{frames} samples=\{samples} max_diff=\{max_diff} exact=\{exact * 100 / (samples * 3)}%",
  )
}
