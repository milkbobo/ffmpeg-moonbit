///|
/// Inter residual coefficient walk verified against dav1d 1.5.1
/// `read_coef_tree` plus the chroma `uvtx` loops over LCG byte streams.
/// The coefficient reader is a deterministic 1-bit stand-in so this
/// checks walk order, context updates and `txtp_map` only
/// (`scripts/_emit_av1_inter_residual_vectors.py`).

///|
fn av1_res_lcg_bytes(seed : UInt, n : Int) -> Bytes {
  let mut state = seed
  let out : Array[Byte] = []
  for _ in 0..<n {
    state = state * 1664525 + 1013904223
    out.push(((state >> 16) & 0xff).reinterpret_as_int().to_byte())
  }
  Bytes::from_array(out)
}

///|
fn av1_res_slice(src : Bytes, start : Int) -> Bytes {
  let out : Array[Byte] = []
  for i in start..<src.length() {
    out.push(src[i])
  }
  Bytes::from_array(out)
}

