    16, 19, 22, 25, 28, 31, 34, 37, 40, 43, 46, 49, 52, 55, 58, 61,
    64, 64, 70, 73, 76, 79, 82, 85, 88, 91, 94, 97, 100, 103, 106, 109,
    112, 115, 118, 121, 124, 127, 2, 5, 8, 11, 14, 17, 20, 23, 26, 29,
    65, 65, 38, 41, 44, 47, 50, 53, 56, 59, 62, 65, 68, 71, 74, 77,
    64, 64, 64, 64, 64, 64, 64, 64, 56, 63, 70, 77, 84, 91, 98, 105,
    112, 119, 126, 5, 12, 19, 26, 33, 40, 47, 54, 61, 68, 75, 82, 89,
    65, 65, 65, 65, 65, 65, 65, 65, 24, 31, 38, 45, 52, 59, 66, 73,
    80, 87, 94, 101, 108, 115, 122, 1, 8, 15, 22, 29, 36, 43, 50, 57,
  ]
  let exp_maphash : Array[UInt] = [
    0x27510800U, 0x1b7f3c9cU, 0xcac66540U, 0xcf7d2100U, 0x3f5a5200U, 0x2d44b9a8U, 0x9d3751c0U, 0x00069380U, 0x8e4c6000U, 0x8e4c6000U, 0x45a83b00U, 0x00000009U, 0x27510800U, 0x9e8accbfU, 0x3af98c00U, 0x46c2d600U,
    0x00000023U, 0x8e4c6000U, 0x27510800U, 0x00000000U, 0x88f04ca8U, 0x932bb180U, 0x3af98c00U, 0x000000a0U, 0x00007840U, 0x2f7d6800U, 0x26ffc2b0U, 0xa5235a00U, 0x13a88400U, 0x000000e0U, 0x00000001U, 0x9cc7e197U,
    0x8e4c6000U, 0x6e776300U, 0x00000020U, 0x8e4c6000U, 0x00000001U, 0x1059cb00U, 0x6e077940U, 0x0000783fU, 0xdf651610U, 0xd83dac00U, 0x00007840U, 0xbfc8c600U, 0x00000000U, 0x6d751b94U, 0x0000928eU, 0xc53dca00U,
    0x00007997U, 0x00000001U, 0xf4568400U, 0x00007840U, 0x2f7d6800U, 0x6b636e00U, 0x29f29400U, 0xac6be700U, 0x04bcb700U, 0x00000000U, 0x000349a0U, 0x4ea21000U, 0x148ad600U, 0xa7884000U, 0x8e4c6000U, 0x68364308U,
    0xf5529fe0U, 0x000003c2U, 0xa5235a00U, 0x261d5480U, 0xf04bb300U, 0x39abefa3U, 0x9efa4200U, 0x3ceeb1f0U, 0x55cbb380U, 0x000003e1U, 0x00000000U, 0x000349c0U, 0x3af98c00U, 0x0000f080U, 0x00000001U, 0x15a4feb0U,
    0x3f5a5200U, 0x000000a0U, 0x00000001U, 0x29f29400U, 0x27510800U, 0x1238f900U, 0x00000000U, 0x1845db9cU, 0x6fb35a00U, 0x0000f080U, 0x3e37b180U, 0x9efa4200U, 0x2f7d6800U, 0x147f04c0U, 0x00000000U, 0x3c17601cU,
    0x9e8a5c01U, 0x29f29400U, 0xcf7d2100U, 0x00000020U, 0x000000c0U, 0xe67a7b36U, 0x0002d120U, 0x8e4c6000U, 0xcdc7d402U, 0x2854ef00U, 0xf52b0400U, 0x0000001fU, 0xc42b605cU, 0x00000001U, 0x29f29400U, 0x65fef3f0U,
    0x6f775a00U, 0xf4568400U, 0x000000a0U, 0x2f7d6800U, 0x55cbb380U, 0x85b53fa2U, 0x7c131800U, 0x9efa4200U, 0x00000000U, 0x7a7ee380U, 0x47655580U, 0x9efa4200U, 0x9efa4200U, 0x31006821U, 0xf6edf8e0U, 0x4af6b780U,
  ]
  for s in 0..<2 {
    let stream = av1_res_lcg_bytes(seeds[s], 8192)
    for i in 0..<64 {
      let k = s * 64 + i
      let bs = cfg[k * 13]
      let bd0 = cfg[k * 13 + 1]
      let bd1 = cfg[k * 13 + 2]
      let abx = cfg[k * 13 + 3]
      let aby = cfg[k * 13 + 4]
      let bw = cfg[k * 13 + 5]
      let bh = cfg[k * 13 + 6]
      let a_lcoef : FixedArray[Int32] = FixedArray::make(32, 0)
      let l_lcoef : FixedArray[Int32] = FixedArray::make(32, 0)
      let a_ccoef : FixedArray[Int32] = FixedArray::make(64, 0)
      let l_ccoef : FixedArray[Int32] = FixedArray::make(64, 0)
      let txtp_map : FixedArray[Byte] = FixedArray::make(1024, 0)
      for j in 0..<32 {
        a_lcoef[j] = (j * 5 + bs) & 0x7f
        l_lcoef[j] = (j * 11 + (i % 8)) & 0x7f
      }
      for j in 0..<64 {
        a_ccoef[j] = (j * 3 + abx) & 0x7f
        l_ccoef[j] = (j * 7 + aby) & 0x7f
      }
      for j in 0..<1024 {
        txtp_map[j] = ((j * 7 + bs) & 0x0f).to_byte()
      }
      let msac = @libavcodec.Av1Msac::init(av1_res_slice(stream, i * 19), false)
      let reader : @libavcodec.Av1CoefReader = {
        decode: (_, _, _, _, tx, _, _, _) => {
          let bit = msac.decode_bool_equi().reinterpret_as_int()
          (bit, (tx + bit) & 15, 0x40 | bit)
        },
      }
      let leaves = Ref(0)
      let hash = Ref(0U)
      let record = (rx : Int, ry : Int, tx : Int, txtp : Int, eob : Int) => {
        leaves.val = leaves.val + 1
        hash.val = hash.val * 31U + (rx & 0x3f).reinterpret_as_uint()
        hash.val = hash.val * 31U + (ry & 0x3f).reinterpret_as_uint()
        hash.val = hash.val * 31U + tx.reinterpret_as_uint()
        hash.val = hash.val * 31U + txtp.reinterpret_as_uint()
        hash.val = hash.val * 31U + eob.reinterpret_as_uint()
      }
      let w4 = if bd0 < bw - abx { bd0 } else { bw - abx }
      let h4 = if bd1 < bh - aby { bd1 } else { bh - aby }
      let cw4 = (w4 + cfg[k * 13 + 11]) >> cfg[k * 13 + 11]
      let ch4 = (h4 + cfg[k * 13 + 12]) >> cfg[k * 13 + 12]
      @libavcodec.av1_read_inter_residual(
        reader, bs, cfg[k * 13 + 7], cfg[k * 13 + 8].reinterpret_as_uint(),
        cfg[k * 13 + 9].reinterpret_as_uint(), cfg[k * 13 + 10], w4, h4, cw4,
        ch4, cfg[k * 13 + 11], cfg[k * 13 + 12], true, abx, aby, bw, bh,
        a_lcoef, l_lcoef, a_ccoef, l_ccoef, txtp_map,
        Some((rx, ry, tx, txtp, eob) => record(rx, ry, tx, txtp, eob)),
        Some((_, cx, cy, tx, txtp, eob) => record(cx, cy, tx, txtp, eob)),
      )
      if leaves.val != exp_leaves[k] || hash.val != exp_hash[k] {
        fail("residual k " + k.to_string() + " leaves/hash " + leaves.val.to_string() + "/" + hash.val.to_string() + " != " + exp_leaves[k].to_string() + "/" + exp_hash[k].to_string())
      }
      assert_eq(msac.rng.reinterpret_as_int(), exp_rng[k])
      assert_eq((msac.dif >> 32).reinterpret_as_int64(), exp_dif[k])
      let mut maphash = 0U
      for r in 0..<bd1 {
        for c in 0..<bd0 {
          maphash = maphash * 31U +
            (txtp_map[((aby & 31) + r) * 32 + (abx & 31) + c].to_int() & 0x0f).reinterpret_as_uint()
        }
      }
      if maphash != exp_maphash[k] {
        fail("residual k " + k.to_string() + " maphash " + maphash.to_string() + " != " + exp_maphash[k].to_string())
      }
      for j in 0..<32 {
        if a_lcoef[j] != exp_ctx[k * 192 + j] || l_lcoef[j] != exp_ctx[k * 192 + 32 + j] {
          fail("residual lcoef k " + k.to_string() + " j " + j.to_string())
        }
      }
      for j in 0..<64 {
        if a_ccoef[j] != exp_ctx[k * 192 + 64 + j] || l_ccoef[j] != exp_ctx[k * 192 + 128 + j] {
          fail("residual ccoef k " + k.to_string() + " j " + j.to_string())
        }
      }
    }
  }
}
