///|
/// Real x265 Annex B streams and FFmpeg 9.0.2 default-decode per-frame YUV420P
/// MD5 references for the HEVC P/B slice decoder, plus bit-patched variants
/// that exercise the decoder's rejected paths.
///
/// Generation (docker `linuxserver/ffmpeg:9.0.2`, cwd = this directory):
///
/// ```
/// docker run --rm -i linuxserver/ffmpeg:9.0.2 -v error \
///   -f lavfi -i "color=c=gray:s=64x48:rate=10" -frames:v 7 \
///   -c:v libx265 -x265-params "keyint=7:min-keyint=7:bframes=0:scenecut=0" \
///   -f hevc pipe:1 > hevc_p_static.265
/// docker run --rm -i linuxserver/ffmpeg:9.0.2 -v error \
///   -f lavfi -i "testsrc2=duration=1:size=64x48:rate=10" -frames:v 7 \
///   -c:v libx265 -x265-params "keyint=7:min-keyint=7:bframes=0:scenecut=0" \
///   -f hevc pipe:1 > hevc_p_mov.265
/// docker run --rm -i linuxserver/ffmpeg:9.0.2 -v error \
///   -f lavfi -i "testsrc2=duration=1:size=64x48:rate=10" -frames:v 7 \
///   -c:v libx265 -x265-params "keyint=7:min-keyint=7:bframes=2:scenecut=0" \
///   -f hevc pipe:1 > hevc_p_movb.265
/// # four independent slices per picture (320x240; x265 requires WPP here):
/// docker run --rm -i linuxserver/ffmpeg:9.0.2 -v error \
///   -f lavfi -i "testsrc2=duration=0.3:size=320x240:rate=10" -frames:v 3 \
///   -c:v libx265 -x265-params "keyint=7:min-keyint=7:slices=4:bframes=0" \
///   -f hevc pipe:1 > hevc_pb_slices.265
/// # references:
/// docker run --rm -i -v "$PWD:/s" linuxserver/ffmpeg:9.0.2 \
///   -v error -i /s/hevc_p_mov.265 -f framemd5 -
/// ```
///
/// The `*_neg_*` variants are produced by this script from `hevc_p_static.265`:
/// the SPS/PPS RBSP is walked field-by-field,
/// `pcm_enabled_flag` is set and the parameter set is
/// re-serialized (all other fields keep their values, the SPS VUI is dropped).
/// The historical `neg_pcm` fixture now verifies that a PCM-capable SPS can
/// still carry ordinary coded blocks: FFmpeg 9.0.2 produces the same gray
/// frame MD5s as the original stream, and the PCM rejection was removed.
///
/// Original FFmpeg code is LGPL-2.1-or-later; this port keeps the same license.

///|
let hevc_pb_static_b64 : Bytes = b""

///|
let hevc_pb_mov_b64 : Bytes = b""

///|
let hevc_pb_movb_b64 : Bytes = b""

///|
let hevc_pb_neg_pcm_b64 : Bytes = b""

///|
let hevc_pb_slices_b64 : Bytes = b""

///|
/// Per-frame YUV420P MD5 of the FFmpeg default decode.

///|
/// FFmpeg 9.0.2 default-decode frame MD5s of the four-slice stream, in
/// presentation order (filtered and `-skip_loop_filter all`).
let hevc_pb_slices_refs : Array[String] = [
  "348236c86d7dc361f99355769bec2bb6", "6f88ca02fc3a6c0d4071d5750ee07b5b", "f6714a1b1d6fce893f8b45c7cc00b642",
]

///|
let hevc_pb_slices_unfiltered_refs : Array[String] = [
  "c0d068ddf53ef96e64e8d52a42672abe", "b28eed7826e94b8fe7aee1f84913d576", "99545e19324f3f0b793dd16a295c005e",
]

///|
let hevc_pb_refs : Array[Array[String]] = [
