    0x2ebcc42dL, 0x2ebcc42dL, 0x2ebcc42dL, 0x2ebcc42dL, 0x2ebcc42dL, 0x2ebcc42dL,
    0x2ebcc42dL, 0x2ebcc42dL, 0x2ebcc42dL, 0x2ebcc42dL, 0xbaf310b7L, 0xbaf310b7L,
    0xbaf310b7L, 0x390042deL, 0x390042deL, 0x390042deL, 0x390042deL, 0x390042deL,
    0x390042deL, 0x390042deL, 0x33842de7L, 0x33842de7L, 0x33842de7L, 0x33842de7L,
    0x33842de7L, 0x33842de7L, 0x2fc8b79dL, 0x2fc8b79dL, 0x2fc8b79dL, 0x5f916f3aL,
    0x5f916f3aL, 0x5f916f3aL, 0x5f916f3aL, 0x5f916f3aL, 0x13a8de74L, 0x13a8de74L,
    0x13a8de74L, 0x13a8de74L, 0x13a8de74L, 0x13a8de74L, 0x13a8de74L, 0x4ea379d0L,
    0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L,
    0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L,
    0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L,
    0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L,
    0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L, 0x4ea379d0L,
    0x4ea379d0L, 0x4ea379d0L,
  ]
  // The C probe adapts one CdfContext across both LCG seeds.
  let cdf = @libavcodec.av1_cdf_copy_defaults(0)
  for s in 0..<2 {
    let msac = @libavcodec.Av1Msac::init(
      av1_txtp_lcg_bytes(seeds[s], 8192),
      false,
    )
    for i in 0..<256 {
      let k = s * 256 + i
      let txtp = @libavcodec.av1_decode_txtp(
        msac,
        cdf,
        cfg[k * 9] != 0,
        cfg[k * 9 + 1],
        cfg[k * 9 + 2],
        cfg[k * 9 + 3] != 0,
        cfg[k * 9 + 4] != 0,
        cfg[k * 9 + 5],
        cfg[k * 9 + 6],
        cfg[k * 9 + 7],
        cfg[k * 9 + 8],
      )
      if txtp != exp_txtp[k] {
        fail(
          "txtp case " +
          k.to_string() +
          ": " +
          txtp.to_string() +
          " != " +
          exp_txtp[k].to_string(),
        )
      }
      assert_eq(msac.rng.reinterpret_as_int(), exp_rng[k])
      assert_eq((msac.dif >> 32).reinterpret_as_int64(), exp_difhi[k])
    }
  }
}
