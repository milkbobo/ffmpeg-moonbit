///|
/// Transform-type selection verified against dav1d 1.5.1
/// `decode_coefs` over LCG byte streams: intra/inter luma CDF paths and
/// chroma `get_uv_inter_txtp` derivation
/// (`scripts/_emit_av1_txtp_vectors.py`).

///|
fn av1_txtp_lcg_bytes(seed : UInt32, n : Int32) -> Bytes {
  let mut state = seed
  let out : Array[Byte] = []
  for _ in 0..<n {
    state = state * 1664525 + 1013904223
    out.push(((state >> 16) & 0xff).reinterpret_as_int().to_byte())
  }
  Bytes::from_array(out)
}

