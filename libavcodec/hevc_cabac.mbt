///|
/// MoonBit port of the HEVC CABAC context initialization from FFmpeg 9.0.2
/// `libavcodec/hevc/cabac.c` (`init_values`, `cabac_init_state`), using the
/// shared arithmetic decoder in `cabac.mbt`.
///
/// Original FFmpeg code is LGPL-2.1-or-later; this port keeps the same license.
///
/// `init_values[3][199]` is copied verbatim from the C (CNU = 154). The
/// derived state is the 7-bit `pre` value consumed by `get_cabac`.
///
/// Out of scope: the HEVC syntax tree (CTU/CU/quadtree) and tile/WPP state
/// save/restore.

///|
/// HEVC_CONTEXTS. */
pub let hevc_cabac_contexts : Int32 = 199

///|
/// `init_values[init_type][ctx]`. */
