///|
/// `cabac_init_state`: derive the 199 context states for a slice.
/// `slice_type`: 0 B, 1 P, 2 I (HEVC order). `cabac_init_flag` is ignored
/// for I slices, as in the C.
pub fn ff_hevc_init_cabac_states(
  slice_qp : Int32,
  slice_type : Int32,
  cabac_init_flag : Bool,
) -> Array[Int32] {
  let mut init_type = 2 - slice_type
  if cabac_init_flag && slice_type != 2 {
    init_type = init_type ^ 3
  }
  let qp = if slice_qp < 0 { 0 } else if slice_qp > 51 { 51 } else { slice_qp }
  let states : Array[Int32] = []
  let row = hevc_cabac_init_values[init_type]
  for i in 0..<hevc_cabac_contexts {
    let init_value = row[i]
    let m = (init_value >> 4) * 5 - 45
    let n = ((init_value & 15) << 3) - 16
    let mut pre = 2 * (((m * qp) >> 4) + n) - 127
    pre = pre ^ (pre >> 31)
    if pre > 124 {
      pre = 124 + (pre & 1)
    }
    states.push(pre)
  }
  states
}
