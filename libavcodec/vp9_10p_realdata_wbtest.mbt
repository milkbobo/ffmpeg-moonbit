///|
/// 10-bit keyframe + inter frames, generated with docker `linuxserver/ffmpeg:9.0.2`.  Expected
/// values are the reference decoder's per-frame yuv420p{depth}le MD5s
/// (little-endian 16-bit samples).
///
/// Reproduce with:
/// ```text
/// ffmpeg -f lavfi -i testsrc2=size=160x120:rate=30 -t 0.5 -c:v libvpx-vp9 -profile 2 -pix_fmt yuv420p10le -b:v 250k -an -y vp9_10p.ivf
/// ffmpeg -threads 1 -i vp9_10p.ivf -f framemd5 vp9_10p.md5
/// ```
///
/// Original FFmpeg code is LGPL-2.1-or-later; the vectors are libre test data.

///|
/// base64 of the reference `vp9_10p.ivf` ({nbytes} bytes). */
let vp9_10p_ivf_b64 : Bytes = b""

///|
fn vp9_10p_ivf_bytes() -> Bytes {
  @libavutil.av_base64_decode(vp9_10p_ivf_b64, 1000000).unwrap()
}

///|
/// Split an IVF file into per-frame VP9 payloads (12-byte frame headers).
fn vp9_10p_ivf_frames(ivf : Bytes) -> Array[Bytes] {
  let frames : Array[Bytes] = []
  let mut pos = 32
  while pos < ivf.length() {
    let size = ivf[pos].to_int() |
      (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16) |
      (ivf[pos + 3].to_int() << 24)
    frames.push(ivf[pos + 12:pos + 12 + size].to_owned())
    pos = pos + 12 + size
  }
  frames
}

///|
let vp9_10p_md5 : Array[String] = [
  "e71d702b56a1c81cf76638406f5f754e", "4a76af8d95935fad459e699666dd475a", "ce0bfda7e7e9d37c163a0b94c5941caa",
  "1df5fd81a54ce271118b7ef8db0a2b7f", "d28c794338f2715175a3ad0321997b44", "33154de4c13ecf25832df287d72fcdf8",
  "f7982484567588bef86dbbe62f31be5a", "b945e796397290498ff8256b8127a9d4", "6f7e009db9bd229edafec50c9c3ead81",
  "1b4fc93ebf59c451d5ecee856b50fab9", "3739af979d99c04d525c25feac64c100", "f20730afb54683067434426b1a56361b",
  "df66cb922182b1e180a53b9baf02d59c", "0fd558ce50ed41fdb5262502cac213f4", "2068dbffedbcaca88fa37820791df5ac",
]

///|
test "vp9 10p: profile-2 keyframe + 14 P frames match FFmpeg YUV" {
  let dec = vp9_decoder_new()
  let frames = vp9_10p_ivf_frames(vp9_10p_ivf_bytes())
  assert_eq(frames.length(), vp9_10p_md5.length())
  for i in 0..<frames.length() {
    let out = match dec.decode_packet(frames[i]) {
      Ok(fs) => fs
      Err(e) => fail("frame \{i}: \{e}")
    }
    assert_eq(out.length(), 1)
    inspect(vp9_kf_frame_md5(dec), content=vp9_10p_md5[i])
  }
}
