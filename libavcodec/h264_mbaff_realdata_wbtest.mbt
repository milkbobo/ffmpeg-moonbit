    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] { fail("h264_mbaff_i_cabac_nodct" + (if skip { " unf" } else { " filt" }) + " frame " + i.to_string() + " got " + got + " exp " + expected[i]) }
    }
  }
}

