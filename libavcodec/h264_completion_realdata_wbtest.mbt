///|
let h264_slices1_md5 : Array[String] = [
  "b4fb3105bb8ab58dc1205e07761b4c15", "52b6386452e88777133231e07e8aafc7", "fa74980dd77806e15dbe5511f57b8233",
  "49ddd6496c3f9f6450a4655cc3ab4ed5", "ff557103d86f5b3aa51e9e28c1be8f07", "ef7e2c35e4f42c8a3ed74821026fab74",
]

///|
let h264_slices1_unf_md5 : Array[String] = [
  "d93049cc5dd366fd84991668f521df31", "035c23bc2d0e9d6ff04683b57d99cc5a", "7ae3a606182d3061fee4bc997f85ef1b",
  "338fff312736536d14d7260875e83be1", "86e8848bd0a254f7932073dc54b8f4b8", "719d3fb92dbde4ae984ecb9173beed9c",
]

///|
test "h264 completion: h264_slices1 filtered/unfiltered real frames" {
  let data = @libavutil.av_base64_decode(h264_slices1_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("h264_slices1: " + error)
    }
    let expected = if skip { h264_slices1_unf_md5 } else { h264_slices1_md5 }
    assert_eq(frames.length(), expected.length())
    for i in 0..<frames.length() {
      let got = h264_yuv_md5(frames[i])
      if got != expected[i] {
        fail("h264_slices1 skip=\{skip} frame=\{i}: \{got} != \{expected[i]}")
      }
    }
  }
}

