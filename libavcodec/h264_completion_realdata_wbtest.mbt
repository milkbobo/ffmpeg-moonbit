let h264_cabac_pcm_md5 : Array[String] = [
  "341a4079e0602688df7d64b6b36fe231", "ffc18760731bf4eb8e65ae6235ea565c", "389cf0d277c1319aa0dddd1f1e436325",
]

///|
let h264_cabac_pcm_unf_md5 : Array[String] = [
  "341a4079e0602688df7d64b6b36fe231", "ffc18760731bf4eb8e65ae6235ea565c", "389cf0d277c1319aa0dddd1f1e436325",
]

///|
test "h264 completion: h264_cabac_pcm filtered/unfiltered real frames" {
  let data = @libavutil.av_base64_decode(h264_cabac_pcm_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("h264_cabac_pcm: " + error)
    }
    let expected = if skip {
      h264_cabac_pcm_unf_md5
    } else {
      h264_cabac_pcm_md5
    }
    assert_eq(frames.length(), expected.length())
    for i in 0..<frames.length() {
      let got = h264_yuv_md5(frames[i])
      if got != expected[i] {
        fail("h264_cabac_pcm skip=\{skip} frame=\{i}: \{got} != \{expected[i]}")
      }
    }
  }
}

