///|
let h264_irregular0_md5 : Array[String] = [
  "d5ed8425d1b019eb193e16660becfab2", "c5749f998b8a331785f7a23e9fd18a1a", "eb584d08c0c1e206d538ea920a9237bf",
  "3107572f5c394cf6174f1877f9b1f600", "da1586a4aea4ddb292f9f441c06dc6c1", "910ccc1a9c9d63b1b74cb91be6ce9017",
]

///|
let h264_irregular0_unf_md5 : Array[String] = [
  "5473aebbe87f9699a8b03bd5701c7b23", "0c076e49228fede63adb6d746b292447", "8b6a38f22cf176323d71ce96851c60f5",
  "417c969953ec2b8184c974f42e9a0414", "d519537ee6d09eed8a7349a625750366", "b72dd7ea4492f7e624d08939ad6e1d9c",
]

///|
test "h264 completion: h264_irregular0 filtered/unfiltered real frames" {
  let data = @libavutil.av_base64_decode(h264_irregular0_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("h264_irregular0: " + error)
    }
    let expected = if skip {
      h264_irregular0_unf_md5
    } else {
      h264_irregular0_md5
    }
    assert_eq(frames.length(), expected.length())
    for i in 0..<frames.length() {
      let got = h264_yuv_md5(frames[i])
      if got != expected[i] {
        fail(
          "h264_irregular0 skip=\{skip} frame=\{i}: \{got} != \{expected[i]}",
        )
      }
    }
  }
}

