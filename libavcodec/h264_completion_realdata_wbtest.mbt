///|
let h264_irregular1_md5 : Array[String] = [
  "e13446eac2e31a556fb79e114489ce60", "97cb192d9473d3cc6fb6e2e5b8ad7797", "6938b6cc7e77e9e75825563fbfc5cc4e",
  "9aa7667ba803cf2868f76f183908339c", "8d1daf07fe15320f58e434e930cbd147", "11878d5b4671bfc525a75da17bd3ba94",
]

///|
let h264_irregular1_unf_md5 : Array[String] = [
  "c79107ec9ccf4152c43e910acc5ad6d1", "d3bed8593fe56d8bc5ff81992a96f244", "762bf50ec1f103541abb7747ec436bee",
  "e449d978b326d868e19ff5eaed89bbd9", "b0bef82edefd90fd3b4f5fe666209af3", "8bda20c5460d36abab6c75eaa2d669bb",
]

///|
test "h264 completion: h264_irregular1 filtered/unfiltered real frames" {
  let data = @libavutil.av_base64_decode(h264_irregular1_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("h264_irregular1: " + error)
    }
    let expected = if skip {
      h264_irregular1_unf_md5
    } else {
      h264_irregular1_md5
    }
    assert_eq(frames.length(), expected.length())
    for i in 0..<frames.length() {
      let got = h264_yuv_md5(frames[i])
      if got != expected[i] {
        fail(
          "h264_irregular1 skip=\{skip} frame=\{i}: \{got} != \{expected[i]}",
        )
      }
    }
  }
}

