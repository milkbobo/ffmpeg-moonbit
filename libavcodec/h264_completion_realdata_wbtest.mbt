]

///|
let h264_cavlc8_unf_md5 : Array[String] = [
  "37eb72598874530466f32b7b169d1c66", "31007f3d7cf1c3c7687c9de29ab37fbd", "463c3d2658cb911ae08d40e0ad80074b",
  "c0ef578ded102f6a91de7901f24fb895", "71da40f7fc20d5d2573e71e85537df63", "a813ca85a42676b05afb0203cdfcfbf7",
]

///|
test "h264 completion: h264_cavlc8 filtered/unfiltered real frames" {
  let data = @libavutil.av_base64_decode(h264_cavlc8_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("h264_cavlc8: " + error)
    }
    let expected = if skip { h264_cavlc8_unf_md5 } else { h264_cavlc8_md5 }
    assert_eq(frames.length(), expected.length())
    for i in 0..<frames.length() {
      let got = h264_yuv_md5(frames[i])
      if got != expected[i] {
        fail("h264_cavlc8 skip=\{skip} frame=\{i}: \{got} != \{expected[i]}")
      }
    }
  }
}

