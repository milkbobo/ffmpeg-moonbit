///|
let h264_slices0_md5 : Array[String] = [
  "70ff7d4c88451a219200ef43d004c23f", "1c875ec163eb11841f77c24dcb104d83", "f5d5438fe2a4f6c4c96c500980c5849a",
  "ead8e7655127f6ea553d58e621eeaf20", "e1d6eb36392d006f1c7b8a0be2801cd1", "b1f026901b1ba2b8ad725e88d7cbd2a9",
]

///|
let h264_slices0_unf_md5 : Array[String] = [
  "7c12f20a569b90edd5897c0c69d158d8", "ca6ed4a5ad76963b96579e0436010ffa", "61a55cc44cda16da48d8599c7d846da8",
  "25aa3cc830fa978d1bea48ef8891add5", "428b531d27e048cd0cb6ab5d88298b99", "1eab0b8e2154b05b455fb68e99480202",
]

///|
test "h264 completion: h264_slices0 filtered/unfiltered real frames" {
  let data = @libavutil.av_base64_decode(h264_slices0_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("h264_slices0: " + error)
    }
    let expected = if skip { h264_slices0_unf_md5 } else { h264_slices0_md5 }
    assert_eq(frames.length(), expected.length())
    for i in 0..<frames.length() {
      let got = h264_yuv_md5(frames[i])
      if got != expected[i] {
        fail("h264_slices0 skip=\{skip} frame=\{i}: \{got} != \{expected[i]}")
      }
    }
  }
}

