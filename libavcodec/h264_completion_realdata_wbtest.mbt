///|
let h264_pcm_escape_unf_md5 : Array[String] = [
  "cb97fda33bf5ac12b2e348613a76eeef",
]

///|
test "h264 completion: h264_pcm_escape filtered/unfiltered real frames" {
  let data = @libavutil.av_base64_decode(h264_pcm_escape_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("h264_pcm_escape: " + error)
    }
    let expected = if skip {
      h264_pcm_escape_unf_md5
    } else {
      h264_pcm_escape_md5
    }
    assert_eq(frames.length(), expected.length())
    for i in 0..<frames.length() {
      let got = h264_yuv_md5(frames[i])
      if got != expected[i] {
        fail(
          "h264_pcm_escape skip=\{skip} frame=\{i}: \{got} != \{expected[i]}",
        )
      }
    }
  }
}

