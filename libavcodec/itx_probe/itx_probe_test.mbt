///|
/// Inverse-transform regression against dav1d 1.5.1's `inv_txfm_add_c` /
/// `itx_1d.c`. The expected checksums were produced by compiling dav1d's
/// real DSP (`dav1d_itx_dsp_init_8bpc`) and feeding every supported
/// (RectTxfmSize, TxfmType) pair the same deterministic coefficients.
/// Checksums are `(sum, sum(pixel * (i + 1)))` over the reconstructed
/// residual block.
test "itx kernels match dav1d" {
  // Supported transform types per RectTxfmSize (dav1d itx_tmpl macros).
  let mask_of = (tx : Int32) => {
    match tx {
      0 | 1 | 5 | 6 | 7 | 8 | 13 | 14 => 0xFFFF
      2 => 0xFFF
      3 | 9 | 10 | 15 | 16 => 0x201
      _ => 0x1
    }
  }
  let sums : FixedArray[Int64] = [
    2073, 2002, 2030, 2094, 2024, 2084, 2016, 2081, 2091, 2081, 2007, 1984, 2015,
    1983, 1998, 2131, 8260, 8099, 8234, 8229, 8144, 8264, 8171, 8118, 8086, 8096,
    8256, 8273, 8140, 8184, 8256, 8246, 32934, 32682, 32874, 32538, 32852, 32892,
    32688, 32883, 32558, 32939, 32822, 32994, 131883, 131143, 527949, 4187, 4102,
    4120, 4061, 4096, 4024, 4070, 4152, 4034, 4122, 4046, 4063, 4050, 4151, 4057,
    4107, 4020, 4103, 4168, 4072, 4133, 3988, 4084, 4157, 4100, 4124, 4136, 4042,
    4182, 4027, 4096, 4160, 16249, 16386, 16511, 16299, 16461, 16330, 16452, 16581,
    16394, 16415, 16400, 16603, 16551, 16326, 16433, 16421, 16279, 16463, 16165,
    16473, 16484, 16377, 16371, 16242, 16346, 16316, 16421, 16478, 16208, 16327,
    16500, 16362, 65193, 65267, 65273, 65871, 261555, 261866, 8200, 8304, 8136, 8270,
    8132, 8192, 8352, 8124, 8266, 8273, 8153, 8214, 8100, 8232, 8084, 8194, 8210,
    8337, 8164, 8253, 8100, 8196, 8085, 8167, 8258, 8148, 8275, 8144, 8256, 8231,
    8127, 8205, 32837, 32737, 32873, 32568, 131625, 131738,
  ]
  let wsums : FixedArray[Int64] = [
    17464, 16908, 16997, 17940, 17133, 17778, 17258, 17672, 17905, 17706, 17188,
    16953, 17209, 16797, 17212, 18134, 270363, 263187, 268267, 268539, 264101, 266756,
    267152, 265830, 261815, 263017, 269154, 269783, 264973, 265848, 268195, 268560,
    4236891, 4191422, 4212624, 4167887, 4236972, 4237275, 4197128, 4238215, 4192987,
    4238474, 4210110, 4243736, 67431943, 67198546, 1085169388, 68932, 67263, 67641,
    66705, 67057, 67188, 67043, 68526, 66775, 68150, 66815, 66770, 66749, 68749,
    66702, 68682, 65880, 67340, 69309, 67126, 67907, 65681, 67145, 68254, 68127,
    67728, 67830, 66161, 68638, 65970, 68215, 69111, 1052338, 1058571, 1069106, 1050163,
    1060527, 1047746, 1060766, 1073903, 1059525, 1058387, 1058568, 1072469, 1064328,
    1051215, 1056707, 1057686, 1049111, 1058723, 1041907, 1058840, 1059732, 1061994,
    1055560, 1048039, 1053184, 1052166, 1051953, 1065078, 1045548, 1052065, 1064571,
    1057698, 16626999, 16738486, 16806053, 16863125, 267397488, 266688938, 267328,
    269773, 263892, 268846, 266220, 268357, 271119, 265368, 267324, 270990, 266212,
    266488, 264684, 269037, 260779, 268281, 265891, 269841, 262550, 270296, 262240,
    266138, 263605, 264746, 268041, 264692, 268236, 266617, 269256, 265142, 264198,
    263904, 4235248, 4230092, 4226496, 4187890, 67257081, 67726285,
  ]
  let mut n = 0
  for tx in 0..<19 {
    let w = ws[tx]
    let h = hs[tx]
    let rw = if w < 32 { w } else { 32 }
    let rh = if h < 32 { h } else { 32 }
    for txtp in 0..<16 {
      if (mask_of(tx) & (1 << txtp)) == 0 {
        continue
      }
      let coeff = FixedArray::make(w * h, 0)
      let mut s : UInt32 = (12345 + tx * 97 + txtp * 13).reinterpret_as_uint()
      for i in 0..<(w * h) {
        s = s * 1103515245U + 12345U
        coeff[i] = ((s >> 16) % 255U).reinterpret_as_int() - 127
      }
      let dst = FixedArray::make(w * h, 128)
      @libavcodec.av1_itxfm_add(dst, 0, w, coeff, rw * rh - 1, tx, txtp, 255)
      let mut sum : Int64 = 0L
      let mut wsum : Int64 = 0L
      for i in 0..<(w * h) {
        sum = sum + dst[i].to_int64()
        wsum = wsum + dst[i].to_int64() * (i + 1).to_int64()
      }
      if sum != sums[n] || wsum != wsums[n] {
        fail(
          "tx " +
          tx.to_string() +
          " txtp " +
          txtp.to_string() +
          ": got (" +
          sum.to_string() +
          ", " +
          wsum.to_string() +
          ") want (" +
          sums[n].to_string() +
          ", " +
          wsums[n].to_string() +
          ")",
        )
      }
      n = n + 1
    }
  }
  assert_eq(n, 155)
}

///|
/// RectTxfmSize dimensions for tx 0..18.
let ws : FixedArray[Int32] = [
  4, 8, 16, 32, 64, 4, 8, 8, 16, 16, 32, 32, 64, 4, 16, 8, 32, 16, 64,
]

///|
let hs : FixedArray[Int32] = [
  4, 8, 16, 32, 64, 8, 4, 16, 8, 32, 16, 64, 32, 16, 4, 32, 8, 64, 16,
]
