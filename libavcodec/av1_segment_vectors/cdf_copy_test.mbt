///|
/// Every adaptive table must be isolated between reference slots and tiles.
/// Generated by scripts/emit_av1_cdf_copy.mbtx.
test "CDF snapshots isolate all adaptive tables" {
  let source = @libavcodec.av1_cdf_copy_defaults(80)
  let snapshot = source.copy()
  let tile = snapshot.copy()
  for i in 0..<source.eob_bin_16.length() {
    let saved = snapshot.eob_bin_16[i]
    source.eob_bin_16[i] = (saved.to_uint() ^ 1U).to_uint16()
    assert_eq(snapshot.eob_bin_16[i], saved)
    assert_eq(tile.eob_bin_16[i], saved)
    snapshot.eob_bin_16[i] = (saved.to_uint() ^ 2U).to_uint16()
    assert_eq(tile.eob_bin_16[i], saved)
  }
  for i in 0..<source.eob_bin_32.length() {
    let saved = snapshot.eob_bin_32[i]
    source.eob_bin_32[i] = (saved.to_uint() ^ 1U).to_uint16()
    assert_eq(snapshot.eob_bin_32[i], saved)
    assert_eq(tile.eob_bin_32[i], saved)
    snapshot.eob_bin_32[i] = (saved.to_uint() ^ 2U).to_uint16()
    assert_eq(tile.eob_bin_32[i], saved)
  }
  for i in 0..<source.eob_bin_64.length() {
    let saved = snapshot.eob_bin_64[i]
    source.eob_bin_64[i] = (saved.to_uint() ^ 1U).to_uint16()
