///|
/// Fixed pixel and mask outputs from dav1d 1.5.1 `mask_c`, `blend_c`,
/// and `w_mask_c` in a standalone C reference program.
test "av1 compound masks match dav1d C reference across chroma layouts" {
  let cases : Array[Array[Int32]] = [
    [8, 8, 8, 0, 0, 0],
    [10, 8, 4, 1, 0, 1],
    [12, 8, 8, 1, 1, 0],
    [8, 8, 8, 1, 1, 1],
  ]
  let expected : Array[Array[Int32]] = [
    [
      108, 75, 111, 154, 163, 167, 104, 87, 97, 145, 145, 227,
      191, 85, 101, 92, 139, 207, 191, 100, 110, 80, 138, 192,
      215, 168, 58, 53, 92, 119, 144, 243, 103, 116, 92, 138,
      153, 206, 182, 99, 90, 96, 188, 180, 71, 97, 102, 99,
      168, 178, 156, 84, 71, 47, 97, 190, 119, 225, 98, 81,
      118, 125, 207, 168,
    ],
    [
      43, 44, 38, 43, 40, 39, 41, 41, 39, 43, 42, 46,
      39, 46, 39, 39, 41, 46, 43, 43, 43, 45, 40, 46,
      44, 41, 44, 45, 41, 39, 38, 46, 42, 39, 39, 41,
      39, 43, 42, 42, 39, 38, 46, 42, 45, 41, 38, 39,
      44, 43, 39, 43, 43, 41, 41, 46, 39, 42, 44, 40,
      42, 42, 47, 40,
    ],
    [
      166, 124, 109, 149, 171, 153, 128, 100, 105, 117, 136, 231,
      198, 166, 109, 90, 117, 174, 192, 81, 162, 129, 134, 188,
      189, 167, 45, 139, 118, 122, 145, 255, 109, 120, 100, 112,
      146, 196, 189, 77, 88, 100, 108, 152, 97, 94, 107, 109,
      183, 126, 147, 103, 74, 35, 67, 128, 108, 187, 131, 83,
      126, 150, 124, 157,
    ],
    [
      79, 64, 111, 131, 144, 175, 95, 90, 93, 144, 129, 158,
      179, 66, 100, 89, 144, 178, 159, 149, 87, 78, 135, 139,
      204, 151, 108, 17, 83, 120, 142, 163, 118, 106, 79, 150,
      154, 184, 153, 143, 98, 90, 212, 184, 97, 115, 94, 93,
      115, 202, 159, 93, 96, 74, 112, 196, 135, 239, 104, 90,
      90, 77, 221, 168,
    ],
    [
      446, 295, 416, 635, 684, 665, 441, 360, 367, 567, 629, 901,
      752, 357, 408, 349, 579, 843, 726, 402, 439, 294, 517, 782,
      835, 697, 260, 219, 388, 491, 615, 957,
    ],
    [
      43, 40, 40, 40, 41, 44, 42, 38, 44, 42, 44, 42,
      42, 44, 39, 42,
    ],
    [
      666, 494, 417, 613, 721, 613, 519, 408, 413, 460, 581, 918,
      776, 667, 437, 347, 476, 698, 736, 326, 650, 505, 507, 765,
      743, 688, 204, 557, 480, 499, 616, 1015,
    ],
    [
      339, 250, 416, 536, 586, 698, 409, 369, 343, 562, 546, 631,
      714, 281, 403, 342, 596, 716, 620, 597, 351, 287, 510, 564,
      800, 618, 437, 82, 358, 492, 590, 652,
    ],
    [
      1726, 1192, 1776, 2459, 2609, 2667, 1659, 1394, 1552, 2322, 2313, 3624,
      3052, 1361, 1621, 1466, 2227, 3316, 3057, 1602, 1752, 1275, 2216, 3070,
      3437, 2687, 929, 841, 1466, 1900, 2308, 3887, 1651, 1851, 1469, 2216,
      2454, 3300, 2904, 1588, 1440, 1533, 3006, 2878, 1140, 1553, 1633, 1579,
      2683, 2855, 2488, 1339, 1141, 746, 1548, 3039, 1898, 3601, 1563, 1296,
      1884, 2007, 3312, 2686,
    ],
    [
      42, 42, 41, 40, 43, 44, 42, 43, 40, 42, 42, 40,
      42, 42, 42, 44,
    ],
    [
      2663, 1979, 1745, 2379, 2737, 2454, 2045, 1602, 1673, 1866, 2178, 3695,
      3168, 2657, 1740, 1447, 1873, 2778, 3080, 1296, 2598, 2059, 2141, 3005,
      3020, 2672, 712, 2227, 1889, 1953, 2313, 4095, 1749, 1914, 1600, 1794,
      2333, 3134, 3021, 1240, 1401, 1592, 1729, 2432, 1546, 1501, 1710, 1751,
      2930, 2015, 2348, 1646, 1181, 562, 1070, 2049, 1733, 2997, 2088, 1329,
      2012, 2404, 1980, 2513,
    ],
    [
      1269, 1015, 1776, 2100, 2309, 2804, 1521, 1436, 1486, 2300, 2061, 2523,
      2862, 1045, 1601, 1417, 2304, 2850, 2540, 2389, 1396, 1246, 2158, 2230,
      3266, 2425, 1728, 274, 1324, 1909, 2271, 2607, 1879, 1698, 1258, 2394,
      2469, 2945, 2456, 2285, 1570, 1440, 3389, 2936, 1546, 1840, 1509, 1481,
      1842, 3244, 2546, 1483, 1541, 1185, 1805, 3134, 2159, 3816, 1668, 1440,
      1435, 1231, 3535, 2686,
    ],
    [
      108, 75, 111, 154, 163, 167, 104, 87, 97, 145, 145, 227,
      191, 85, 101, 92, 139, 207, 191, 100, 110, 80, 138, 192,
      215, 168, 58, 53, 92, 119, 144, 243, 103, 116, 92, 138,
      153, 206, 182, 99, 90, 96, 188, 180, 71, 97, 102, 99,
      168, 178, 156, 84, 71, 47, 97, 190, 119, 225, 98, 81,
      118, 125, 207, 168,
    ],
    [
      42, 42, 41, 40, 43, 44, 42, 42, 39, 42, 42, 40,
      42, 41, 42, 43,
    ],
    [
      166, 124, 109, 149, 171, 153, 128, 100, 105, 117, 136, 231,
      198, 166, 109, 90, 117, 174, 192, 81, 162, 129, 134, 188,
      189, 167, 45, 139, 118, 122, 145, 255, 109, 120, 100, 112,
      146, 196, 189, 77, 88, 100, 108, 152, 97, 94, 107, 109,
      183, 126, 147, 103, 74, 35, 67, 128, 108, 187, 131, 83,
      126, 150, 124, 157,
    ],
    [
      79, 64, 111, 131, 144, 175, 95, 90, 93, 144, 129, 158,
      179, 66, 100, 89, 144, 178, 159, 149, 87, 78, 135, 139,
      204, 151, 108, 17, 83, 120, 142, 163, 118, 106, 79, 150,
      154, 184, 153, 143, 98, 90, 212, 184, 97, 115, 94, 93,
      115, 202, 159, 93, 96, 74, 112, 196, 135, 239, 104, 90,
      90, 77, 221, 168,
    ],
  ]
  for c in 0..<cases.length() {
    let p = cases[c]
    let depth = p[0]
    let w = p[1]
    let h = p[2]
    let src = FixedArray::make(24 * 24, 0)
    let scale = 1 << (depth - 8)
    for y in 0..<24 {
      for x in 0..<24 {
        src[y * 24 + x] = ((x * 37 + y * 61 + x * y * 11 % 97) *
          scale) & ((1 << depth) - 1)
      }
    }
    let a = @av1_mc_core.av1_mc_prep_unscaled(
      src, 24, 24, 24, 4, 5, w, h, 5, 11, 2, depth,
    )
    let b = @av1_mc_core.av1_mc_prep_unscaled(
      src, 24, 24, 24, 6, 7, w, h, 13, 3, 7, depth,
    )
    let pa = @av1_mc_core.av1_mc_put_unscaled(
      src, 24, 24, 24, 4, 5, w, h, 5, 11, 2, depth,
    )
    let pb = @av1_mc_core.av1_mc_put_unscaled(
      src, 24, 24, 24, 6, 7, w, h, 13, 3, 7, depth,
    )
    let fixed_mask = FixedArray::make(w * h, 0)
    for y in 0..<h {
      for x in 0..<w {
        fixed_mask[y * w + x] = (x * 13 + y * 9) % 65
      }
    }
    let (diff_pixels, diff_mask) = @av1_mc_core.av1_mc_diffwtd_mask(
      a, b, w, h, p[5], p[3], p[4], depth,
    )
    let mask_pixels = @av1_mc_core.av1_mc_mask(a, b, fixed_mask, depth)
    let blend_pixels = @av1_mc_core.av1_mc_blend_pixels(
      pa, pb, fixed_mask,
    )
    for i in 0..<(w * h) {
      assert_eq(diff_pixels[i], expected[c * 4][i])
      assert_eq(mask_pixels[i], expected[c * 4 + 2][i])
      assert_eq(blend_pixels[i], expected[c * 4 + 3][i])
    }
    for i in 0..<diff_mask.length() {
      assert_eq(diff_mask[i], expected[c * 4 + 1][i])
    }
  }
}
