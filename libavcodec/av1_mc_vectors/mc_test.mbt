///|
/// Expected blocks from a standalone C port of dav1d 1.5.1 `put_8tap_c`
/// and `put_bilin_c`, using the exact `src/tables.c` filter coefficients.
/// Cases cover 8/10/12-bit, all filter families, 1D/2D phases, 4-pixel
/// filters and frame-edge extension.
test "av1 unscaled motion compensation matches dav1d C reference" {
  let cases : Array[Array[Int32]] = [
    [8, 0, 0, 8, 8, 8, 8, 0],
    [8, 0, 5, 8, 8, 8, 8, 7],
    [8, 1, 8, 8, 8, 8, 8, 7],
    [8, 2, 0, 8, 8, 8, 8, 7],
    [8, 5, 7, 13, 4, 4, 0, 0],
    [8, 8, 15, 15, 4, 4, 20, 20],
    [10, 0, 3, 9, 8, 8, 8, 8],
    [10, 4, 11, 5, 4, 4, 8, 8],
    [12, 7, 14, 2, 8, 8, 8, 8],
    [12, 9, 9, 3, 4, 4, 22, 22],
  ]
  let expected : Array[Array[Int32]] = [
    [
      106, 100, 169, 211, 99, 141, 61, 105, 249, 196, 98, 152,
      63, 112, 159, 195, 137, 107, 19, 82, 124, 214, 76, 233,
      39, 18, 117, 202, 184, 119, 0, 173, 119, 105, 215, 253,
      150, 25, 89, 108, 163, 192, 135, 128, 35, 108, 163, 174,
      243, 103, 68, 71, 99, 190, 191, 110, 143, 14, 113, 189,
      209, 97, 121, 47,
    ],
    [
      102, 25, 143, 209, 173, 99, 100, 50, 64, 103, 150, 255,
      193, 0, 59, 107, 148, 215, 197, 123, 139, 92, 138, 148,
      72, 127, 126, 63, 136, 194, 167, 80, 28, 18, 104, 208,
      156, 126, 181, 19, 117, 123, 226, 204, 40, 35, 144, 71,
      172, 146, 128, 65, 12, 75, 93, 164, 255, 167, 0, 55,
      80, 135, 200, 255,
    ],
    [
      103, 69, 139, 198, 145, 101, 101, 74, 97, 120, 168, 229,
      138, 51, 92, 109, 113, 170, 156, 161, 133, 99, 121, 127,
      80, 134, 130, 129, 134, 164, 138, 93, 58, 89, 148, 169,
      101, 149, 133, 63, 104, 113, 175, 153, 45, 98, 122, 98,
      181, 133, 118, 85, 40, 95, 138, 178, 217, 114, 54, 89,
      93, 151, 182, 207,
    ],
    [
      148, 14, 133, 189, 196, 97, 128, 47, 25, 101, 98, 240,
      255, 3, 29, 94, 155, 188, 246, 115, 159, 86, 145, 141,
      84, 99, 159, 58, 110, 168, 197, 75, 44, 2, 55, 176,
      223, 75, 231, 17, 134, 121, 216, 227, 96, 0, 171, 69,
      147, 136, 124, 102, 1, 80, 76, 120, 252, 255, 0, 45,
      74, 122, 173, 255,
    ],
    [
      62, 110, 166, 241, 128, 218, 173, 91, 222, 200, 43, 44,
      182, 99, 117, 145,
    ],
    [
      35, 76, 131, 152, 124, 164, 186, 187, 179, 169, 96, 55,
      181, 167, 90, 46,
    ],
    [
      248, 425, 561, 1023, 906, 0, 221, 417, 578, 836, 857, 419,
      568, 383, 573, 581, 266, 409, 522, 273, 548, 732, 728, 269,
      173, 84, 394, 804, 696, 374, 840, 67, 492, 459, 880, 841,
      220, 50, 595, 256, 696, 596, 458, 289, 39, 320, 362, 651,
      1023, 811, 0, 250, 312, 524, 778, 1023, 556, 489, 222, 724,
      686, 822, 975, 366,
    ],
    [
      355, 462, 709, 950, 485, 690, 625, 743, 385, 625, 485, 538,
      212, 402, 571, 661,
    ],
    [
      1505, 2021, 2859, 2880, 1853, 1329, 1430, 1744, 2067, 2515, 2757, 2588,
      1823, 1552, 1838, 2318, 2077, 2303, 2141, 2101, 2190, 2246, 2065, 2223,
      1323, 1726, 2147, 2230, 2244, 2314, 1759, 1547, 1501, 2055, 2516, 2051,
      1579, 1838, 1677, 1621, 2216, 2246, 2036, 1332, 1091, 1605, 2040, 2224,
      2619, 1726, 1251, 1202, 1565, 2228, 2806, 2748, 2386, 1579, 1604, 2077,
      2556, 2953, 2899, 2571,
    ],
    [
      2782, 2504, 2504, 2504, 1856, 736, 736, 736, 1856, 736, 736, 736,
      1856, 736, 736, 736,
    ],
  ]
  for c in 0..<cases.length() {
    let p = cases[c]
    let bitdepth = p[0]
    let scale = 1 << (bitdepth - 8)
    let src = FixedArray::make(24 * 24, 0)
    for y in 0..<24 {
      for x in 0..<24 {
        src[y * 24 + x] = ((x * 37 + y * 61 + x * y * 11 % 97) *
          scale) & ((1 << bitdepth) - 1)
      }
    }
    let got = @av1_mc_core.av1_mc_put_unscaled(
      src, 24, 24, 24, p[6], p[7], p[4], p[5], p[2], p[3], p[1],
      bitdepth,
    )
    for i in 0..<expected[c].length() {
      assert_eq(got[i], expected[c][i])
    }
  }
}
