///|
test "av1 inter-intra masks match dav1d C reference" {
  let bs_list : FixedArray[Int] = [7, 8, 11, 12, 13, 16, 17]
  let expected : FixedArray[Int32] = [
    -1389371963, -6256699, 1028140485, 1484966621, 1831222725, 1826894789, 783443397, 412252265, 1831222725, -952298811, -994579003, -1116277655,
    -324964923, -1484675899, 1652601797, -2055621513, -1807809083, -430407483, 2109909189, 1731689571, -1807809083, -1115610811, -967538747, 794276067,
    -2113547835, -1171353851, 1799878597, 72772274, 1831222725, -952298811, -994579003, -1116277655, -324964923, -1484675899, 1652601797, -2055621513,
    -324964923, -1863026619, 1342126533, 1266874711, -1807809083, -1115610811, -967538747, 794276067, -2113547835, -1171353851, 1799878597, 72772274,
    -2113547835, -1920222587, -1954398523, -683420244, -211339323, -918902171, 716521797, -172195421, -324964923, -1484675899, 1652601797, -2055621513,
    -1807809083, -430407483, 2109909189, 1731689571, -1807809083, -1115610811, -967538747, 794276067, -2113547835, -1171353851, 1799878597, 72772274,
    -211339323, 767054405, -457356603, 2046023203, -211339323, -918902171, 716521797, -172195421, 1161259717, 1493472293, 2027672965, -1630552850,
  ]
  let mut k = 0
  for layout in 0..<3 {
    for slot in 0..<7 {
      for mode in 0..<4 {
        let m = @av1_mc_core.av1_ii_mask(layout, bs_list[slot], mode)
        av1_wedge_test_expect(
          "ii layout=\{layout} bs=\{bs_list[slot]} mode=\{mode}",
          av1_wedge_test_fnv32(m), expected[k],
        )
        if mode == 0 {
          // DC masks are uniformly 32.
          for i in 0..<m.length() {
            if m[i] != 32 {
              fail("ii dc mask not constant 32")
            }
          }
        }
        k = k + 1
      }
    }
  }
}

