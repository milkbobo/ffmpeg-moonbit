///|
/// Wedge and inter-intra compound masks and wedge blends, verified
/// against dav1d 1.5.1 `src/wedge.c` and `mc_tmpl.c` `mask_c` via a
/// standalone C dumper (`scripts/_emit_av1_wedge_vectors.py`).

///|
fn av1_wedge_test_fnv32(values : FixedArray[Int32]) -> Int32 {
  let mut h : UInt = 0x811c9dc5
  for v in values {
    for b in 0..<4 {
      h = (h ^ (((v >> (8 * b)) & 0xff).reinterpret_as_uint())) * 0x01000193
    }
  }
  h.reinterpret_as_int()
}

///|
fn av1_wedge_test_expect(what : String, got : Int32, want : Int32) -> Unit raise {
  if got != want {
    fail("\{what}: got \{got}, want \{want}")
  }
}

