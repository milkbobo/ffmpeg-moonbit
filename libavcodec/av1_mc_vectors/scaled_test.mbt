///|
/// Scaled-reference MC and superres resize kernels verified against
/// dav1d 1.5.1 `mc_tmpl.c` scaled functions via a standalone C dumper
/// (`scripts/_emit_av1_scaled_vectors.py`). Source planes are rebuilt
/// with the dumper LCG and anchored by FNV-32.

///|
fn av1_scaled_test_fnv32(values : FixedArray[Int32]) -> Int32 {
  let mut h : UInt32 = 0x811c9dc5
  for v in values {
    for b in 0..<4 {
      h = (h ^ ((v >> (8 * b)) & 0xff).reinterpret_as_uint()) * 0x01000193
    }
  }
  h.reinterpret_as_int()
}

///|
fn av1_scaled_test_lcg(
  seed : UInt32,
  n : Int32,
  maxv : Int32,
) -> FixedArray[Int32] {
  let mut state = seed
  let out = FixedArray::make(n, 0)
  for i in 0..<n {
    state = state * 1664525 + 1013904223
    out[i] = (state >> 8).reinterpret_as_int() % (maxv + 1)
  }
  out
}

///|
fn av1_scaled_test_expect(
  what : String,
  got : Int32,
  want : Int32,
) -> Unit raise {
  if got != want {
    fail("\{what}: got \{got}, want \{want}")
  }
}

///|
fn av1_scaled_test_px(
  what : String,
  got : FixedArray[Int32],
  want : Array[Int32],
) -> Unit raise {
  if got.length() != want.length() {
    fail("\{what}: length \{got.length()} != \{want.length()}")
  }
  for i in 0..<want.length() {
    if got[i] != want[i] {
      fail("\{what} px \{i}: got \{got[i]}, want \{want[i]}")
    }
  }
}

///|
test "av1 scaled MC matches dav1d C reference" {
  let plane8 = av1_scaled_test_lcg(0x1a2b3c4d, 112 * 80, 255)
  let plane10 = av1_scaled_test_lcg(0xfeedface, 112 * 80, 1023)
