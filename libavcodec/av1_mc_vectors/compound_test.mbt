///|
test "av1 compound average and weighted average match dav1d C reference" {
  let pairs : Array[Array[Int32]] = [
    [8, 0, 8, 8, 5, 8, 4, 12],
    [10, 2, 6, 8, 3, 9, 12, 4],
    [12, 7, 9, 4, 14, 2, 9, 3],
  ]
  let expected : Array[Array[Int32]] = [
    [
      147, 68, 85, 130, 155, 184, 148, 94, 70, 91, 117, 183, 186, 151, 120, 70, 139,
      197, 199, 168, 142, 70, 126, 172, 207, 190, 77, 33, 78, 108, 149, 226, 136,
      107, 58, 97, 133, 196, 175, 126, 86, 93, 168, 186, 137, 142, 94, 54, 135, 144,
      165, 112, 53, 31, 77, 147, 155, 243, 163, 103, 91, 97, 166, 178,
    ],
    [
      162, 82, 80, 111, 149, 186, 152, 93, 69, 71, 100, 157, 179, 178, 140, 69, 134,
      179, 191, 184, 157, 87, 120, 158, 198, 181, 80, 46, 83, 110, 148, 205, 141,
      97, 56, 84, 128, 188, 167, 127, 96, 91, 152, 179, 162, 148, 81, 51, 118, 130,
      157, 118, 62, 36, 66, 124, 163, 239, 195, 127, 82, 87, 144, 168,
    ],
    [
      630, 395, 380, 543, 610, 711, 541, 460, 278, 383, 421, 730, 838, 559, 354,
      247, 443, 683, 808, 580, 594, 384, 527, 607, 837, 758, 437, 309, 313, 391,
      526, 883, 518, 462, 186, 385, 563, 765, 777, 506, 305, 322, 618, 761, 498,
      498, 430, 333, 565, 598, 665, 491, 344, 148, 247, 549, 494, 926, 564, 255,
      333, 359, 661, 718,
    ],
    [
      702, 492, 376, 477, 600, 695, 573, 488, 281, 289, 361, 629, 811, 664, 381,
      220, 392, 595, 735, 637, 648, 492, 506, 523, 796, 718, 503, 429, 356, 381,
      538, 806, 563, 417, 156, 315, 534, 729, 731, 547, 323, 312, 540, 701, 596,
      533, 391, 363, 480, 549, 635, 546, 419, 191, 213, 442, 533, 871, 631, 293,
      252, 295, 555, 669,
    ],
    [
      2521, 2301, 1719, 1693, 1699, 1337, 1864, 2180, 1768, 2145, 2349, 2505, 2903,
      2548, 2032, 2228,
    ],
    [
      2778, 2629, 1677, 1495, 1653, 1061, 1571, 1949, 1476, 1897, 2223, 2567, 2876,
      2538, 2134, 2521,
    ],
  ]
  for c in 0..<pairs.length() {
    let p = pairs[c]
    let src = mc_compound_source(p[0])
    let a = @av1_mc_core.av1_mc_prep_unscaled(
      src,
      24,
      24,
      24,
      4,
      5,
      p[3],
      p[3],
      p[4],
      p[5],
      p[1],
      p[0],
    )
    let b = @av1_mc_core.av1_mc_prep_unscaled(
      src,
      24,
      24,
      24,
      6,
      7,
      p[3],
      p[3],
      p[6],
      p[7],
      p[2],
      p[0],
    )
    let avg = @av1_mc_core.av1_mc_avg(a, b, p[0])
    let weighted = @av1_mc_core.av1_mc_w_avg(a, b, 5, p[0])
    for i in 0..<(p[3] * p[3]) {
      assert_eq(avg[i], expected[c * 2][i])
      assert_eq(weighted[i], expected[c * 2 + 1][i])
    }
  }
}
