///|
/// Fixed outputs from the dav1d 1.5.1 `prep_8tap_c` / `prep_bilin_c` /
/// `avg_c` / `w_avg_c` integer paths in a standalone C reference program.
fn mc_compound_source(depth : Int32) -> FixedArray[Int32] {
  let src = FixedArray::make(24 * 24, 0)
  let scale = 1 << (depth - 8)
  for y in 0..<24 {
    for x in 0..<24 {
      src[y * 24 + x] = ((x * 37 + y * 61 + x * y * 11 % 97) * scale) &
        ((1 << depth) - 1)
    }
  }
  src
}

