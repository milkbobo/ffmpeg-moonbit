///|
/// Lossless JPEG (SOF3) decoder tests on FFmpeg 9.0.2 `ljpeg` encodings:
/// 4:2:0 with predictors 1/2, 4:2:2 and 4:4:4 (vertical sampling).  The
/// decoded planar samples must match `ffmpeg -f rawvideo` byte for byte.

///|
fn ljpeg_b64_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let ljpeg_yuv420_b64 : Bytes = ljpeg_b64_concat([
  b"",
])

///|
let ljpeg_yuv420p2_b64 : Bytes = ljpeg_b64_concat([
  b"",
])

///|
let ljpeg_yuv422_b64 : Bytes = ljpeg_b64_concat([
  b"",
])

///|
let ljpeg_yuv444_b64 : Bytes = ljpeg_b64_concat([
  b"",
])

///|
fn ljpeg_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
fn ljpeg_check(b64 : Bytes, pix_fmt : String, reference : String) -> Unit raise {
  let bytes = @libavutil.av_base64_decode(b64, 100000).unwrap()
  let img = @libavcodec.av_mjpeg_decode(bytes).unwrap()
  assert_eq(img.width, 64)
  assert_eq(img.height, 48)
  assert_eq(img.pix_fmt, pix_fmt)
  let planes : Array[Byte] = []
  for p in img.planes {
    for b in p {
      planes.push(b)
    }
  }
  assert_eq(ljpeg_md5(Bytes::from_array(planes)), reference)
}

///|
test "lossless JPEG 4:2:0 predictor 1 and 2" {
  ljpeg_check(ljpeg_yuv420_b64, "yuvj420p", "ef1174208f178e1daf99b1d445e92b68")
  ljpeg_check(
    ljpeg_yuv420p2_b64, "yuvj420p", "ef1174208f178e1daf99b1d445e92b68",
  )
}

///|
test "lossless JPEG 4:2:2 and 4:4:4" {
  ljpeg_check(ljpeg_yuv422_b64, "yuvj422p", "7e9feadf310c2cdd32d06c09f4c86228")
  ljpeg_check(ljpeg_yuv444_b64, "yuvj444p", "4cbccb31efa5c3a77a6be586207969e2")
}

///|
let ljpeg_rgb3_b64 : Bytes = ljpeg_b64_concat([
  b"",
])

///|
let ljpeg_gray9_b64 : Bytes = ljpeg_b64_concat([
  b"",
])

///|
test "lossless JPEG unsupported variants are rejected" {
  let rgb = @libavutil.av_base64_decode(ljpeg_rgb3_b64, 100000).unwrap()
  match @libavcodec.av_mjpeg_decode(rgb) {
    Ok(_) => fail("1x1 3-component lossless JPEG must be rejected")
    Err(e) => assert_true(e.has_prefix("PATCHWELCOME"), msg=e)
  }
  let gray = @libavutil.av_base64_decode(ljpeg_gray9_b64, 100000).unwrap()
  match @libavcodec.av_mjpeg_decode(gray) {
    Ok(_) => fail("9-bit lossless JPEG must be rejected")
    Err(e) => assert_true(e.has_prefix("PATCHWELCOME"), msg=e)
  }
}
