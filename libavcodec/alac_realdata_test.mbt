///|
/// ALAC fixtures encoded by ffmpeg 9.0.2 (`-c:a alac`, s16p for 16-bit,
/// s32p for 24-bit) from deterministic WAV sources (sine / silence / noise /
/// impulses), decoded with the same build to s16le/s32le as references.
/// Each fixture is the magic cookie plus the six raw ALAC packets that
/// `av_mov_open` extracts from the m4a; the port must match bit-exactly.

///|
let alac_fixtures : Array[(String, Bytes, Array[Bytes], Int32, Int32, String)] = [
  // stereo 16-bit
  (
    "s16",
    b"AAAAJGFsYWMAAAAAAAAQAAAQKAoOAgAAAABABAAViIAAAKxE",
    [
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
    ],
    16,
    2,
    "38fb308079b63baf40e49bd051d22bc8",
  ),
  // mono 16-bit
  (
    "mono16",
    b"AAAAJGFsYWMAAAAAAAAQAAAQKAoOAQAAAAAgBAAKxEAAAKxE",
    [
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
    ],
    16,
    1,
    "509cc1b01befed5df86a6e9b786706b2",
  ),
  // stereo 24-bit (8 extra bits)
  (
    "s24",
    b"AAAAJGFsYWMAAAAAAAAQAAAYKAoOAgAAAABgBAAgTMAAAKxE",
    [
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
    ],
    24,
    2,
    "3b28ea391a3fa982fb50f6a071ab64a0",
  ),
  // 5.1 16-bit
  (
    "c51",
    b"AAAAJGFsYWMAAAAAAAAQAAAQKAoOBgAAAADABABAmYAAAKxE",
    [
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
    ],
    16,
    6,
    "68f06c91a09a8c13a14f3ccc2d930cf2",
  ),
]

///|
fn alac_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "alac: ffmpeg fixtures decode bit-exactly" {
  for fixture in alac_fixtures {
    let (name, cookie_b64, packets, bits, channels, want_md5) = fixture
    let cookie = @libavutil.av_base64_decode(cookie_b64, 1024).unwrap()
    let dec = match @libavcodec.alac_decoder_new(cookie) {
      Ok(v) => v
      Err(e) => fail("\{name}: init failed: \{e}")
    }
    let pcm : Array[Byte] = []
    let mut total = 0
    for packet in packets {
      let bytes = @libavutil.av_base64_decode(packet, 200000).unwrap()
      let frame = match dec.decode_frame(bytes) {
        Ok(v) => v
        Err(e) => fail("\{name}: decode failed: \{e}")
      }
      assert_eq(frame.sample_rate, 44100)
      assert_eq(frame.channels, channels)
      assert_eq(frame.bits, bits)
      total = total + frame.nb_samples
      for b in frame.pcm_bytes() {
        pcm.push(b)
      }
    }
    assert_eq(total, 22050)
    assert_eq(alac_md5(Bytes::from_array(pcm)), want_md5, msg=name)
  }
}
