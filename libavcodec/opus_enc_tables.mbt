///|
/// Table self-check used by the encoder tests (keeps every table alive and
/// lets the tests verify a few spot values against the C dump).
pub fn opus_enc_tables_probe() -> Int32 {
  let a = opus_enc_celt_window[0].to_int()
  let b = opus_enc_psy_window_0[0].to_int()
  let c = opus_enc_psy_window_1[0].to_int()
  let d = opus_enc_psy_window_2[0].to_int()
  let sum = a + b + c + d
  ignore(sum)
  sum
}
