///|
/// 32-bit stereo FLAC fixtures whose side channel needs the 33-bit path
/// (FFmpeg `decoded_33bps`). Generated with ffmpeg 9.0.2
/// (`-sample_fmt s32 -bits_per_raw_sample 32 -strict experimental`) and
/// decoded with the same build to s32le; the port must match bit-exactly.

///|
let flac_33bps_fixtures : Array[(String, Bytes, String)] = [
  (
    "noise LPC", b"",
    "eac0717f87541c652bd240094ca7f897",
  ),
  (
    "correlated mid-side", b"",
    "8d5e77cec2693e162acbc1f9c168be96",
  ),
  (
    "right-heavy side", b"",
    "2883edaa5d7ea2fb74bfcdf8a105c279",
  ),
  (
    "fixed predictors", b"",
    "eac0717f87541c652bd240094ca7f897",
  ),
]

///|
fn flac_33bps_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "flac: 32-bit stereo 33-bit side channel decodes like FFmpeg" {
  for entry in flac_33bps_fixtures {
    let (name, b64, want) = entry
    let data = @libavutil.av_base64_decode(b64, 100000).unwrap()
    let audio = match @libavcodec.ff_flac_decode(data) {
      Ok(v) => v
      Err(e) => fail("\{name}: \{e}")
    }
    assert_eq(audio.bits, 32)
    assert_eq(audio.channels, 2)
    assert_eq(flac_33bps_md5(audio.pcm_bytes()), want, msg=name)
  }
}
