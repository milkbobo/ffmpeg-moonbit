import {
  "moonbitlang/core/math",
  "moonbitlang/core/v128",
  "milkbobo/ffmpeg-moonbit/libavutil",
  "milkbobo/ffmpeg-moonbit/libavcodec/av1_mc_core",
  "milkbobo/ffmpeg-moonbit/libavcodec/aac_mdct_tx",
}

warnings = "-alert_experimental"

// SIMD implementations are gated to native and WebAssembly backends.

options(
  targets: {
    "idct_v128_wbtest.mbt": [ "native", "wasm" ],
    // Debug tool: per-MB syntax shadow parse over the encoder's own
    // stream. Native only - the wasm whitebox executable sits at V8's
    // init local-count limit and any extra file pushes it over.
    "h264_shadow_wbtest.mbt": [ "native" ],
  },
)
