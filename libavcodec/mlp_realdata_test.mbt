///|
/// Real MLP / TrueHD fixtures encoded by FFmpeg 9.0.2 (docker
/// reference build, native mlp / truehd encoders from deterministic lavfi
/// sources). The references are FFmpeg decodes to s16le / s32le, matched
/// by MD5 of the interleaved PCM.
///|
let mlp_fixtures : Array[(String, Array[Bytes], Bool, Int32, Int32, Int32, Int32, String)] = [
  // thd_stereo_48k_s24 — 300 access units
  (
    "thd_stereo_48k_s24",
    [
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
    ],
    true,
    48000,
    2,
    24,
    12000,
    "0b8504a0eb9cb9cd97cf95b00573d1bb",
  ),
  // thd_51_48k_s24 — 240 access units
  (
    "thd_51_48k_s24",
    [
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
    ],
    true,
    48000,
    6,
    24,
    9600,
    "48c77119d5dcf45db7fd3711dfbbb379",
  ),
  // mlp_stereo_44k_s16 — 276 access units
  (
    "mlp_stereo_44k_s16",
    [
      b"",
      b"",
      b"",
    ],
    false,
    44100,
    2,
    16,
    11040,
    "48af58485b13fe11dfd12a9c03df6363",
  ),
  // mlp_stereo_96k_s24 — 180 access units
  (
    "mlp_stereo_96k_s24",
    [
      b"",
      b"",
      b"",
      b"",
      b"",
      b"",
    ],
    false,
    96000,
    2,
    24,
    14400,
    "7a9536af29fbe372813bfe56020f4114",
  ),
]

///|
fn mlp_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
fn mlp_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
test "mlp/truehd: ffmpeg fixtures decode bit-exactly" {
  for fixture in mlp_fixtures {
    let (name, b64parts, truehd, rate, channels, bits, count, want_md5) = fixture
    let data = @libavutil.av_base64_decode(mlp_concat(b64parts), 600000).unwrap()
    let audio = if truehd {
      match @libavcodec.ff_truehd_decode_stream(data) {
        Ok(v) => v
        Err(e) => fail("\{name}: decode failed: \{e}")
      }
    } else {
      match @libavcodec.ff_mlp_decode_stream(data) {
        Ok(v) => v
        Err(e) => fail("\{name}: decode failed: \{e}")
      }
    }
    assert_eq(audio.sample_rate, rate, msg=name)
    assert_eq(audio.channels, channels, msg=name)
    assert_eq(audio.bits, bits, msg=name)
    assert_eq(audio.samples.length(), count * channels, msg=name)
    assert_eq(mlp_md5(audio.pcm_bytes()), want_md5, msg=name)
  }
}
