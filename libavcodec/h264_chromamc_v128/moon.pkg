import {
  "moonbitlang/core/simd",
}

warnings = "-alert_experimental"

// Keep SIMD tests on the same backends as their implementations.
// Subpackage (like me_cmp_v128 / h264_idct_v128) so the tests stay
// clear of the giant libavcodec whitebox unit, which cannot run on
// wasm-gc (@v128 is unavailable there) and whose moonrun command line
// exceeds the Windows limit on long checkouts.

options(
  "allow-experimental-packages": [ "moonbitlang/core/simd" ],
  targets: { "h264_chromamc_v128_wbtest.mbt": [ "native", "wasm" ] },
)
