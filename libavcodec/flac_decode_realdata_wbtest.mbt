///|
/// Real FLAC files and FFmpeg 9.0.2 PCM MD5 references for the FLAC decoder.
///
/// Generation (docker `linuxserver/ffmpeg:9.0.2`, cwd = this directory):
///
/// ```
/// # 16-bit mono LPC, 44.1 kHz
/// ffmpeg -f lavfi -i "sine=frequency=440:duration=0.3:sample_rate=44100" \
///   -af volume=0.5 -c:a flac -compression_level 8 -sample_fmt s16 mono16.flac
/// # 16-bit independent stereo (tone + pink noise), 48 kHz
/// ffmpeg -f lavfi -i "sine=frequency=440:duration=0.2:sample_rate=48000" \
///   -f lavfi -i "anoisesrc=color=pink:duration=0.2:sample_rate=48000" \
///   -filter_complex "[0:a][1:a]amerge=inputs=2,volume=0.4[a]" -map "[a]" \
///   -c:a flac -compression_level 5 -sample_fmt s16 stereo16.flac
/// # 24-bit mono
/// ffmpeg -f lavfi -i "sine=frequency=660:duration=0.2:sample_rate=44100" \
///   -af volume=0.25 -c:a flac -compression_level 8 -sample_fmt s32 mono24.flac
/// # constant subframes, fixed-order noise, verbatim noise
/// ffmpeg -f lavfi -i "anullsrc=r=44100:cl=mono" -t 0.1 -c:a flac \
///   -sample_fmt s16 silence.flac
/// ffmpeg -f lavfi -i "anoisesrc=color=white:duration=0.1:sample_rate=44100" \
///   -af volume=0.3 -c:a flac -compression_level 0 -sample_fmt s16 noise0.flac
/// ffmpeg -f lavfi -i "anoisesrc=color=white:amplitude=1:duration=0.05:sample_rate=44100" \
///   -c:a flac -lpc_type none -min_prediction_order 0 -max_prediction_order 0 \
///   -min_partition_order 0 -max_partition_order 0 -sample_fmt s16 verb.flac
/// # stereo decorrelation modes
/// ... (tone + pink noise) -c:a flac -ch_mode mid_side  -sample_fmt s16 mside.flac
/// ... (tone + pink noise) -c:a flac -ch_mode right_side -sample_fmt s16 rside.flac
/// ffmpeg -f lavfi -i "sine=frequency=330:duration=0.2:sample_rate=44100" \
///   -af "pan=stereo|c0=c0|c1=c0,volume=0.4" -c:a flac -compression_level 8 \
///   -sample_fmt s16 ms.flac
/// ffmpeg -f lavfi -i "sine=frequency=550:duration=0.2:sample_rate=44100" \
///   -af "pan=stereo|c0=c0|c1=0*c0,volume=0.4" -c:a flac -compression_level 8 \
///   -sample_fmt s16 ls.flac
/// # references: ffmpeg -i <file>.flac -f s16le - | md5sum
/// # (mono24 uses -f s32le)
/// ```
///
/// The set covers constant/verbatim/fixed/LPC subframes, 16- and 24-bit
/// streams, independent/left-side/right-side/mid-side stereo and 44.1/48 kHz.
///
/// Original FFmpeg code is LGPL-2.1-or-later; this port keeps the same license.

///|
