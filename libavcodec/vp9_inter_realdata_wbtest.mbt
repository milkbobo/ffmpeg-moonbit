///|
/// VP9 inter-frame decoder real-world vector: one keyframe + 14 inter
/// frames (libvpx-vp9, 160x120, single reference, no alt-ref), generated
/// with docker `linuxserver/ffmpeg:9.0.2`.  Expected values are the
/// reference decoder's per-frame yuv420p MD5s over the same bytes.
///
/// Reproduce with:
/// ```text
/// ffmpeg -f lavfi -i testsrc2=size=160x120:rate=30 -t 0.5 \
///        -c:v libvpx-vp9 -speed 4 -lag-in-frames 0 -auto-alt-ref 0 \
///        -arnr-maxframes 0 -b:v 250k -g 6 -keyint_min 6 vp9_p.ivf
/// ffmpeg -threads 1 -i vp9_p.ivf -f framemd5 vp9_p.md5
/// ```
///
/// Original FFmpeg code is LGPL-2.1-or-later; the vectors are libre test data.

///|
/// base64 of the reference `vp9_p.ivf` (16418 bytes). */
let vp9_inter_p_ivf_b64 : Bytes = b""

///|
fn vp9_inter_p_ivf() -> Bytes {
  @libavutil.av_base64_decode(vp9_inter_p_ivf_b64, 1000000).unwrap()
}

///|
/// Split an IVF file into per-frame VP9 payloads (12-byte frame headers).
fn vp9_ivf_frames(ivf : Bytes) -> Array[Bytes] {
  let frames : Array[Bytes] = []
  let mut pos = 32
  while pos < ivf.length() {
    let size = (ivf[pos].to_int() | (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16)) |
      (ivf[pos + 3].to_int() << 24)
    frames.push(ivf[pos + 12:pos + 12 + size].to_owned())
    pos = pos + 12 + size
  }
  frames
}

///|
let vp9_inter_p_md5 : Array[String] = [
  "da087eb6e453f1d0e6f7c692bda0a218", "1afead67cbe40f211c2e2df58a01fd37", "732bc33e472684fce620a9955bfa65a6",
  "d070ee2321ee3e45224d3bdb2ab67d81", "5c50092b94c30e73d7f306d1e879b6f0", "7aab4217c03665e49c9a44b49e5200bc",
  "0d0a112f1f53388c95ef14e6f6a0ed32", "80bf3e2dee054c516f2bc6aa6b4c87c6", "d9e00981bb86646da8a30603929db135",
  "4ee4fba34459ee3ed02cdcaaae976045", "46aab7b9b346365b55c62dda16272319", "2dd9fcb18c2876d1b30c658666d6e113",
  "62c01bc4f6129d91e8ac57cfce157f57", "e7467b0582eaa36068a8297393370374", "1150cc39ed9de615244b0746fac94e7a",
]

///|
/// Decode the inter stream and compare every frame's YUV MD5 with the
/// reference decoder.  Exercises keyframe + inter blocks: single reference,
/// NEARESTMV/NEARMV/ZEROMV/NEWMV, fixed interpolation filter and the
/// inter-frame probability back-adaptation path.
test "vp9 inter: keyframe + 14 P frames match FFmpeg YUV" {
  let dec = vp9_decoder_new()
  let frames = vp9_ivf_frames(vp9_inter_p_ivf())
  assert_eq(frames.length(), vp9_inter_p_md5.length())
  for i in 0..<frames.length() {
    let out = match dec.decode_packet(frames[i]) {
      Ok(fs) => fs
      Err(e) => fail("frame \{i}: \{e}")
    }
    assert_eq(out.length(), 1)
    inspect(vp9_kf_frame_md5(dec), content=vp9_inter_p_md5[i])
  }
}
