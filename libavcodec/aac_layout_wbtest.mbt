///|
/// Indexed/PCE multichannel PCM references from FFmpeg 9.0.2; includes
/// real encoder output and explicitly reordered tagged channel elements.
/// Generated by scripts/generate_aac_layout_vectors.py. LGPL-2.1-or-later.
fn aac_check_layout(
  encoded : Bytes,
  reference : Bytes,
  positions : Array[Int32],
) -> Int32 raise {
  let data = @libavutil.av_base64_decode(encoded, 16384).unwrap()
  let pcm = @libavutil.av_base64_decode(reference, 196608).unwrap()
  let header = ff_adts_header_parse_buf(data).unwrap()
  let config = new_mpeg4_audio_config()
  config.object_type = 2
  config.sampling_index = header.sampling_index
  config.sample_rate = header.sample_rate
  config.chan_config = header.chan_config
  config.channels = positions.length()
  config.frame_length = 1024
  let dec = new_aac_decoder(config, positions.length())
  let mut pos = 0
  let mut frames = 0
  let mut max_diff = 0
  let mut exact = 0
  while pos < data.length() {
    let hdr = ff_adts_header_parse_buf(
      data.clamped_view(start=pos, end=pos + av_aac_adts_header_size).to_owned(),
    ).unwrap()
    let end = pos + hdr.frame_length
    assert_true(end <= data.length())
    let start = pos +
      av_aac_adts_header_size +
      (if hdr.crc_absent == 0 { 2 } else { 0 })
    let out = match
      dec.decode_frame(data.clamped_view(start~, end~).to_owned()) {
      Ok(v) => v
      Err(e) => fail("layout frame \{frames}: \{e}")
    }
    assert_eq(out.length(), positions.length())
    assert_eq(dec.layout.length(), positions.length())
    for channel = 0; channel < positions.length(); channel = channel + 1 {
      assert_eq(dec.layout[channel].position, positions[channel])
      assert_eq(out[channel].samples.length(), 1024)
      for i = 0; i < 1024; i = i + 1 {
        let byte = ((frames * 1024 + i) * positions.length() + channel) * 2
        assert_true(byte + 1 < pcm.length())
        let value = pcm[byte].to_int() | (pcm[byte + 1].to_int() << 8)
        let want = if value >= 32768 { value - 65536 } else { value }
        let got = aac_s16p(out[channel].samples[i])
        let diff = if got > want { got - want } else { want - got }
        if diff > max_diff {
          max_diff = diff
        }
        if diff == 0 {
          exact = exact + 1
        }
      }
    }
    frames = frames + 1
    pos = end
  }
  let samples = frames * 1024 * positions.length()
  assert_eq(samples * 2, pcm.length())
  assert_true(max_diff <= 1)
  assert_true(exact * 1000 >= samples * 999)
  frames
}

///|
test "aac: indexed 5.1 SCE CPE LFE output order matches FFmpeg" {
  assert_eq(
    aac_check_layout(aac_layout_native51_b64, aac_layout_native51_pcm_b64, [
      0, 1, 2, 3, 4, 5,
    ]),
    5,
  )
}

///|
test "aac: real PCE 7.1 output order matches FFmpeg" {
  assert_eq(
    aac_check_layout(aac_layout_native71_b64, aac_layout_native71_pcm_b64, [
      0, 1, 2, 3, 4, 5, 9, 10,
    ]),
    5,
  )
}

///|
test "aac: real PCE 5.1 persists across frames without PCE" {
  assert_eq(
    aac_check_layout(aac_layout_pce51_b64, aac_layout_pce51_pcm_b64, [
      0, 1, 2, 3, 4, 5,
    ]),
    5,
  )
}

///|
test "aac: tagged dual mono preserves histories across reversed arrival order and DSE" {
  assert_eq(
    aac_check_layout(
      aac_layout_tagged_dual_b64,
      aac_layout_tagged_dual_pcm_b64,
      [0, 1],
    ),
    4,
  )
}

///|
test "aac: shuffled PCE 5.1 element order preserves every channel history" {
  assert_eq(
    aac_check_layout(aac_layout_shuffled51_b64, aac_layout_shuffled51_pcm_b64, [
      0, 1, 2, 3, 4, 5,
    ]),
    4,
  )
}
