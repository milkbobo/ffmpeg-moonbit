  "6788e3dd401efcdc081a7d065946bbc0",
  "36e31783c9e7a2be6cfaeb5f47c62893",
  "7081d2eeef66caa4b55e6c9732ded61c",
  "f2d4dad2a9e5c6f358a8d447afe0b47f",
  "8057a3a688c0c08b2daa4a77242c4b57",
  "be889c09266ef00087a0fb13af17bb50",
]

///|
test "h264 chroma pixels: h264_c42210_cabac filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(h264_c42210_cabac_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_display_frames(data, skip) { Ok(value) => value; Err(error) => fail("h264_c42210_cabac: " + error) }
    let expected = if skip { h264_c42210_cabac_unf_md5 } else { h264_c42210_cabac_md5 }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] { fail("h264_c42210_cabac skip=\{skip} frame=\{i} poc=\{frame.poc}: \{got} != \{expected[i]}") }
    }
  }
}

