let h264_c444_cavlc_unf_md5 : Array[String] = [
  "cdeb495c372a6ec5355e25b8b40c3804",
  "d3e8a92fd73f4e5d5c6bb9090d951a30",
  "430cf4b68a490048554f898c215e2057",
  "c69f83a14ca29ddf33ca375b3723b1f4",
  "6431fe30dde56369a3a4c3922ef65122",
  "b2565741cb0677505a25a5a1700c40f2",
  "a223fd22fdde51f389194035890f69f9",
]

///|
test "h264 chroma pixels: h264_c444_cavlc filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(h264_c444_cavlc_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_display_frames(data, skip) { Ok(value) => value; Err(error) => fail("h264_c444_cavlc: " + error) }
    let expected = if skip { h264_c444_cavlc_unf_md5 } else { h264_c444_cavlc_md5 }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] { fail("h264_c444_cavlc skip=\{skip} frame=\{i} poc=\{frame.poc}: \{got} != \{expected[i]}") }
    }
  }
}

