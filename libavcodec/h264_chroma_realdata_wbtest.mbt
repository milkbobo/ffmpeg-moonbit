let h264_c422_cabac_unf_md5 : Array[String] = [
  "35f5402c73d3ce1f8eb4379cc5ff13f3",
  "5786cf6a63e8ed307ffcb0f39f48930a",
  "34c6d4015ce93b576d4cf3f8b7696e08",
  "b263f3f897c503cbef55da956fecc427",
  "eedb37b6370aebf5cf763fb0baf86287",
  "2cc23e5b32c109e07524cc07db051cec",
  "c6803efe6f4b868958f0968563e1ebf9",
]

///|
test "h264 chroma pixels: h264_c422_cabac filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(h264_c422_cabac_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_display_frames(data, skip) { Ok(value) => value; Err(error) => fail("h264_c422_cabac: " + error) }
    let expected = if skip { h264_c422_cabac_unf_md5 } else { h264_c422_cabac_md5 }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] { fail("h264_c422_cabac skip=\{skip} frame=\{i} poc=\{frame.poc}: \{got} != \{expected[i]}") }
    }
  }
}

