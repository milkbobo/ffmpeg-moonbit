///|
test "h264 chroma pixels: h264_c422_cavlc filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(h264_c422_cavlc_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_display_frames(data, skip) { Ok(value) => value; Err(error) => fail("h264_c422_cavlc: " + error) }
    let expected = if skip { h264_c422_cavlc_unf_md5 } else { h264_c422_cavlc_md5 }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] { fail("h264_c422_cavlc skip=\{skip} frame=\{i} poc=\{frame.poc}: \{got} != \{expected[i]}") }
    }
  }
}

