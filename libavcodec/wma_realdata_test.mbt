///|
/// Real-data WMA v1/v2 decoder tests.  Fixtures encoded with FFmpeg 9.0.2's
/// native `wmav1`/`wmav2` encoders into ASF, then remuxed to raw packets with
/// `ffmpeg -map 0:a:0 -c copy -f data` (one `block_align` packet per WMA
/// frame; the encoder writes `flags2 = 1`, i.e. exp-VLC, no reservoir).
/// Reference PCM is FFmpeg's own decode.  FFmpeg's API trims the decoder
/// delay of two frames, so the tests skip the first two decoded frames and
/// append the overlap flush frame.  The port stays within one s16 LSB.
///
/// Fixtures: 44.1 kHz mono at 96/32 kb/s (noise coding off/on), 44.1 kHz
/// stereo 128 kb/s (MS stereo), 32 kHz mono 64 kb/s, and 44.1 kHz WMA v1.

///|
fn wma_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let wma_mono44h_packets_b64 : Bytes = wma_concat([
  b"",
])

///|
let wma_mono44h_ref_b64 : Bytes = wma_concat([
  b"",
  b"",
  b"",
])

///|
let wma_mono44l_packets_b64 : Bytes = wma_concat([
  b"",
])

///|
let wma_mono44l_ref_b64 : Bytes = wma_concat([
  b"",
  b"",
  b"",
])

///|
let wma_stereo44_packets_b64 : Bytes = wma_concat([
  b"",
])

///|
let wma_stereo44_ref_b64 : Bytes = wma_concat([
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
])

///|
let wma_mono32_packets_b64 : Bytes = wma_concat([
  b"",
])

///|
let wma_mono32_ref_b64 : Bytes = wma_concat([
  b"",
  b"",
])

///|
let wma_mono44v1_packets_b64 : Bytes = wma_concat([
  b"",
])

///|
let wma_mono44v1_ref_b64 : Bytes = wma_concat([
  b"",
  b"",
  b"",
])

///|
fn wma_check_fixture(
  name : String,
  version : Int32,
  rate : Int32,
  channels : Int32,
  bit_rate : Int32,
  block_align : Int32,
  packets_b64 : Bytes,
  ref_b64 : Bytes,
) -> Unit raise {
  let data = @libavutil.av_base64_decode(packets_b64, 1000000).unwrap()
  let reference = @libavutil.av_base64_decode(ref_b64, 1000000).unwrap()
  let dec = @libavcodec.wma_decoder_new(
    version, rate, channels, bit_rate, block_align, 1,
  ).unwrap()
  let frames : Array[Array[Array[Double]]] = []
  let mut pos = 0
  while pos + block_align <= data.length() {
    let frame = match
      dec.decode_packet(data[pos:pos + block_align].to_owned()) {
      Ok(f) => f
      Err(e) => fail("\{name}: packet at \{pos}: \{e}")
    }
    frames.push(frame)
    pos = pos + block_align
  }
  frames.push(dec.decode_flush().unwrap())
  let pcm : Array[Array[Int32]] = []
  for _c = 0; _c < channels; _c = _c + 1 {
    pcm.push([])
  }
  // Skip the two-frame decoder delay; the flush frame supplies the tail.
  for fi = 2; fi < frames.length(); fi = fi + 1 {
    for c = 0; c < channels; c = c + 1 {
      for v in frames[fi][c] {
        let q = if v >= 1.0 {
          32767
        } else if v <= -1.0 {
          -32768
        } else {
          (v * 32768.0).round().to_int()
        }
        pcm[c].push(q)
      }
    }
  }
  assert_eq(reference.length(), pcm[0].length() * channels * 2, msg=name)
  let mut max_diff = 0
  for c = 0; c < channels; c = c + 1 {
    for i = 0; i < pcm[c].length(); i = i + 1 {
      let idx = (i * channels + c) * 2
      let raw = reference[idx].to_int() | (reference[idx + 1].to_int() << 8)
      let want = if raw >= 32768 { raw - 65536 } else { raw }
      let d = if pcm[c][i] > want { pcm[c][i] - want } else { want - pcm[c][i] }
      if d > max_diff {
        max_diff = d
      }
    }
  }
  assert_true(max_diff <= 1, msg="\{name}: max diff \{max_diff}")
}

///|
test "WMA: v1/v2 real packets match FFmpeg PCM" {
  wma_check_fixture(
    "mono44h", 2, 44100, 1, 96000, 557, wma_mono44h_packets_b64, wma_mono44h_ref_b64,
  )
  wma_check_fixture(
    "mono44l", 2, 44100, 1, 32000, 185, wma_mono44l_packets_b64, wma_mono44l_ref_b64,
  )
  wma_check_fixture(
    "stereo44", 2, 44100, 2, 128000, 743, wma_stereo44_packets_b64, wma_stereo44_ref_b64,
  )
  wma_check_fixture(
    "mono32", 2, 32000, 1, 64000, 512, wma_mono32_packets_b64, wma_mono32_ref_b64,
  )
  wma_check_fixture(
    "mono44v1", 1, 44100, 1, 96000, 557, wma_mono44v1_packets_b64, wma_mono44v1_ref_b64,
  )
}

///|
test "WMA: invalid parameters are rejected" {
  match @libavcodec.wma_decoder_new(3, 44100, 2, 128000, 743, 1) {
    Ok(_) => fail("WMA version 3 must be rejected")
    Err(_) => ()
  }
  match @libavcodec.wma_decoder_new(2, 44100, 3, 128000, 743, 1) {
    Ok(_) => fail("more than two channels must be rejected")
    Err(_) => ()
  }
  match @libavcodec.wma_decoder_new(2, 44100, 2, 128000, 0, 1) {
    Ok(_) => fail("zero block_align must be rejected")
    Err(_) => ()
  }
  let dec = @libavcodec.wma_decoder_new(2, 44100, 1, 96000, 557, 1).unwrap()
  match dec.decode_packet(b"\x00\x01") {
    Ok(_) => fail("short packet must be rejected")
    Err(_) => ()
  }
}
