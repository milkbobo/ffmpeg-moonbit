///|
/// 8-bit 4:2:0 lossy key frames with CDEF enabled (libaom `-crf 30
/// -deadline good -cpu-used 8 -g 1 -enable-restoration 0`, testsrc2
/// 128x96, 8 frames). The encoder picks per-frame CDEF strengths; the
/// luma path uses secondary-only filtering on some frames and the chroma
/// path primary+secondary, covering both CDEF branches.
///
/// Expected MD5s are libdav1d's framemd5 over packed `yuv420p` planes
/// (docker `linuxserver/ffmpeg:9.0.2`, `-c:v libdav1d -f framemd5`).
let av1_cdef8_stream_b64 : Bytes = b""

///|
let av1_cdef8_md5 : Array[String] = [
  "e4d418f6dfab080ff49aedef91c14eee", "080613e8f19e7dbaacac0100b08f2de0", "9a4e5741706d38afb59c2b692f3c2e11",
  "e831b591a0d05a81840ffd41e4244f4e", "174c673b1db90422aa9e6b304ff6e108", "ec856bc11baf68ee2fa1f7518a79e363",
  "5504baf3d1dfddf101360d0a9d7565a5", "781c6a544e58367e5f88e0e34cdfc6f3",
]

///|
test "av1 cdef: 8-bit 4:2:0 keyframes match libdav1d framemd5" {
  let ivf = @libavutil.av_base64_decode(av1_cdef8_stream_b64, 1048576).unwrap()
  let frames = av1_lossy_ivf_frames(ivf)
  assert_eq(frames.length(), av1_cdef8_md5.length())
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  let md5s : Array[String] = []
  for obus in frames {
    if seq is None {
      match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(s) => seq = Some(s)
        Err(e) => fail(e)
      }
    }
    let s = match seq {
      Some(s) => s
      None => fail("no sequence header")
    }
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(h) => h
      Err(e) => fail(e)
    }
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(t) => t
      Err(e) => fail(e)
    }
    let out = match @libavcodec.av1_decode_keyframe(s, hdr, tiles[0].data()) {
      Ok(f) => f
      Err(e) => fail(e)
    }
    md5s.push(av1_lossy_frame_md5(out.packed()))
  }
  for i in 0..<md5s.length() {
    if md5s[i] != av1_cdef8_md5[i] {
      fail(
        "cdef8 frame " +
        i.to_string() +
        ": got " +
        md5s[i] +
        " want " +
        av1_cdef8_md5[i],
      )
    }
  }
}
