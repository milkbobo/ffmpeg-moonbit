///|
/// 8-bit 4:2:0 lossy key frames from SVT-AV1 v4.2 with per-superblock
/// delta-q enabled (`-crf 35 -preset 3`, `enable-restoration=0`,
/// `enable-intrabc=0`, 160x120, 6 frames). Exercises `decode_b`'s delta-q
/// symbols and the per-SB dequant table switch.
///
/// Expected MD5s are libdav1d's framemd5 over packed `yuv420p` planes
/// (docker `linuxserver/ffmpeg:9.0.2`, `-c:v libdav1d -f framemd5`).
let av1_deltaq6_stream_b64 : Bytes = b""

///|
let av1_deltaq6_md5 : Array[String] = [
  "f57b4819a1ed8aba814407ba538c2508",
  "cd36c4f94c06f547ae18d8dd269bbf5b",
  "b1ff33b9fcb0031735f85dfc8323a066",
  "b36c4aba3f00695f992a422c2f40b9c6",
  "0332ea6c22a5dfeac07b4868e06cfd51",
  "fe137ab7d6893107abb9c3e8432d34ff",]

///|
test "av1 delta-q: 8-bit 4:2:0 keyframes match libdav1d framemd5" {
  let ivf = @libavutil.av_base64_decode(av1_deltaq6_stream_b64, 1048576).unwrap()
  let frames = av1_lossy_ivf_frames(ivf)
  assert_eq(frames.length(), av1_deltaq6_md5.length())
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  let md5s : Array[String] = []
  for obus in frames {
    if seq is None {
      match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(s) => seq = Some(s)
        Err(e) => fail(e)
      }
    }
    let s = match seq {
      Some(s) => s
      None => fail("no sequence header")
    }
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(h) => h
      Err(e) => fail(e)
    }
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(t) => t
      Err(e) => fail(e)
    }
    let out = match @libavcodec.av1_decode_keyframe(s, hdr, tiles[0].data()) {
      Ok(f) => f
      Err(e) => fail(e)
    }
    md5s.push(av1_lossy_frame_md5(out.packed()))
  }
  for i in 0..<md5s.length() {
    if md5s[i] != av1_deltaq6_md5[i] {
      fail(
        "deltaq6 frame " +
        i.to_string() +
        ": got " +
        md5s[i] +
        " want " +
        av1_deltaq6_md5[i],
      )
    }
  }
}
