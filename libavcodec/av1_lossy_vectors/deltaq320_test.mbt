///|
/// 320x240 SVT-AV1 key frames with delta-q (`-crf 38 -preset 4`,
/// `enable-restoration=0`, `enable-intrabc=0`). Taller than 128 luma rows,
/// so it covers the per-SB-row ipred edge backup and multi-row filter loops.
///
/// Expected MD5s are libdav1d's framemd5 over packed `yuv420p` planes
/// (docker `linuxserver/ffmpeg:9.0.2`).
let av1_deltaq320_stream_b64 : Bytes = b""

///|
let av1_deltaq320_md5 : Array[String] = [
  "c9b93d4e4c32949142d347221863b6f9",
  "c09f2110d3df604abeca9f2b098a3b95",
  "a87590a14793aeaa6bd32b09e65b37d5",
  "8635ac7d98416e60ec5407c2fbc7571c",
  "92196cf26bc2f4d0806ae65d3ed5b907",
  "b5582b9d1eb358210383e5b8403a0640",]

///|
test "av1 delta-q 320x240: keyframes match libdav1d framemd5" {
  let ivf = @libavutil.av_base64_decode(av1_deltaq320_stream_b64, 1048576).unwrap()
  let frames = av1_lossy_ivf_frames(ivf)
  assert_eq(frames.length(), av1_deltaq320_md5.length())
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  let md5s : Array[String] = []
  for obus in frames {
    if seq is None {
      match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(s) => seq = Some(s)
        Err(e) => fail(e)
      }
    }
    let s = match seq {
      Some(s) => s
      None => fail("no sequence header")
    }
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(h) => h
      Err(e) => fail(e)
    }
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(t) => t
      Err(e) => fail(e)
    }
    let out = match @libavcodec.av1_decode_keyframe(s, hdr, tiles[0].data()) {
      Ok(f) => f
      Err(e) => fail(e)
    }
    md5s.push(av1_lossy_frame_md5(out.packed()))
  }
  for i in 0..<md5s.length() {
    if md5s[i] != av1_deltaq320_md5[i] {
      fail(
        "deltaq320 frame " +
        i.to_string() +
        ": got " +
        md5s[i] +
        " want " +
        av1_deltaq320_md5[i],
      )
    }
  }
}
