///|
/// 12-bit keyframe + inter frames, generated with docker `linuxserver/ffmpeg:9.0.2`.  Expected
/// values are the reference decoder's per-frame yuv420p{depth}le MD5s
/// (little-endian 16-bit samples).
///
/// Reproduce with:
/// ```text
/// ffmpeg -f lavfi -i testsrc2=size=160x120:rate=30 -t 0.3 -c:v libvpx-vp9 -profile 2 -pix_fmt yuv420p12le -b:v 250k -g 6 -an -y vp9_12p.ivf
/// ffmpeg -threads 1 -i vp9_12p.ivf -f framemd5 vp9_12p.md5
/// ```
///
/// Original FFmpeg code is LGPL-2.1-or-later; the vectors are libre test data.

///|
/// base64 of the reference `vp9_12p.ivf` ({nbytes} bytes). */
let vp9_12p_ivf_b64 : Bytes = b""

///|
fn vp9_12p_ivf_bytes() -> Bytes {
  @libavutil.av_base64_decode(vp9_12p_ivf_b64, 1000000).unwrap()
}

///|
/// Split an IVF file into per-frame VP9 payloads (12-byte frame headers).
fn vp9_12p_ivf_frames(ivf : Bytes) -> Array[Bytes] {
  let frames : Array[Bytes] = []
  let mut pos = 32
  while pos < ivf.length() {
    let size = ivf[pos].to_int() |
      (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16) |
      (ivf[pos + 3].to_int() << 24)
    frames.push(ivf[pos + 12:pos + 12 + size].to_owned())
    pos = pos + 12 + size
  }
  frames
}

///|
let vp9_12p_md5 : Array[String] = [
  "19434979ffbdd05b87915fc52f7aaf95", "bf6c2331ac31f1e75593c1702210a00d", "9b2f56c60d7dc0980bb1f7cf4354c711",
  "258631e713111d19ea6be086fae1d143", "1da195789fbe36ab192993bbbe39a24a", "57ef289185582fb7a2e41cc83e076587",
  "bb512ddb2ca5cfbf709ff5ed154c45e0", "95eb0bd25e34c450959dd599ec0f2907", "b68e91d66e92fb5a23b40eb8eb046168",
]

///|
test "vp9 12p: profile-2 12-bit keyframe + P frames match FFmpeg YUV" {
  let dec = vp9_decoder_new()
  let frames = vp9_12p_ivf_frames(vp9_12p_ivf_bytes())
  assert_eq(frames.length(), vp9_12p_md5.length())
  for i in 0..<frames.length() {
    let out = match dec.decode_packet(frames[i]) {
      Ok(fs) => fs
      Err(e) => fail("frame \{i}: \{e}")
    }
    assert_eq(out.length(), 1)
    inspect(vp9_kf_frame_md5(dec), content=vp9_12p_md5[i])
  }
}
