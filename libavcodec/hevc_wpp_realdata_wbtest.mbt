///|
/// Real x265 Annex B single-slice WPP stream and FFmpeg 9.0.2 per-frame MD5
/// references. A 320x240 picture has four CTB rows; x265 inserts three WPP
/// entry points and syncs the CABAC state after the second CTB of each row.
///
/// Generation (docker `linuxserver/ffmpeg:9.0.2`, cwd = this directory):
///
/// ```
/// docker run --rm -v "$PWD:/w" -w /w linuxserver/ffmpeg:9.0.2 -v error ///   -f lavfi -i "testsrc2=duration=0.3:size=320x240:rate=10" -frames:v 3 ///   -c:v libx265 -x265-params "keyint=7:min-keyint=7:bframes=0" ///   -f hevc -y /w/wpp1.265
/// docker run --rm -v "$PWD:/w" -w /w linuxserver/ffmpeg:9.0.2 ///   -v error -i /w/wpp1.265 -f framemd5 -
/// # unfiltered (`-skip_loop_filter all`) references likewise.
/// ```
///
/// Original FFmpeg code is LGPL-2.1-or-later; this port keeps the same license.
///|
let hevc_wpp1_b64 : Bytes = b""

///|
let hevc_wpp1_filtered_refs : Array[String] = [
  "a15c95a53b0602cfb5e64cec9dfbfaaf",
  "2904880bde498d89ce45c120231f3ca1",
  "b09fe20848dd67d685e5e1857b678ac9",
]

///|
let hevc_wpp1_unfiltered_refs : Array[String] = [
  "aae93aa904365928b444f1ef967ccaef",
  "9df8f323f2e5ab52a8c4219e4821eda8",
  "2c0ceff66c6cd25816c80aaef050ec92",
]
