///|
/// AV1 lossless keyframe real streams for 4:4:4 and 4:2:2, generated with
/// docker `linuxserver/ffmpeg:9.0.2`.  Expected values are libdav1d's
/// per-frame framemd5 hashes.
///
/// - `av1_444`: 8-bit 4:4:4 lossless keyframes (yuv444p, 23216 bytes)
/// - `av1_422`: 8-bit 4:2:2 lossless keyframes (yuv422p, 12553 bytes)
/// - `av1_gray`: 8-bit monochrome lossless keyframes (gray, 689 bytes)
/// - `av1_420_noedge`: 8-bit 4:2:0 lossless, intra edge filter off (yuv420p, 4751 bytes)
///
/// Reproduce each stream from its `testsrc2` pipeline in the stream list
/// above, then run `ffmpeg -threads 1 -i <stem>.ivf -f framemd5 <stem>.md5`.
///
/// Original FFmpeg code is LGPL-2.1-or-later; the vectors are libre test data.

///|
/// base64 of the concatenated IVF files (41209 bytes total). */
let av1_444_vectors_b64 : Bytes = b""

///|
/// IVF byte lengths of `av1_444_vectors_b64`, in stream order. */
let av1_444_sizes : Array[Int32] = [23216, 12553, 689, 4751]

///|
fn av1_444_vectors() -> Bytes {
  @libavutil.av_base64_decode(av1_444_vectors_b64, 1000000).unwrap()
}

///|
fn av1_444_streams() -> Array[Bytes] {
  let all = av1_444_vectors()
  let out : Array[Bytes] = []
  let mut off = 0
  for n in av1_444_sizes {
    out.push(all[off:off + n].to_owned())
    off = off + n
  }
  out
}

///|
/// IVF: 32-byte header, then per frame a 12-byte header and the OBU payload.
fn av1_444_ivf_frames(ivf : Bytes) -> Array[Bytes] {
  let frames : Array[Bytes] = []
  let mut pos = 32
  while pos + 12 <= ivf.length() {
    let size = ivf[pos].to_int() |
      (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16) |
      (ivf[pos + 3].to_int() << 24)
    frames.push(ivf[pos + 12:pos + 12 + size].to_owned())
    pos = pos + 12 + size
  }
  frames
}

///|
fn av1_444_hex(digest : FixedArray[Byte]) -> String {
  let digits : Bytes = b"0123456789abcdef"
  let chars : Array[Char] = []
  for i in 0..<16 {
    let v = digest[i].to_uint().reinterpret_as_int()
    chars.push(digits[v >> 4].to_char())
    chars.push(digits[v & 15].to_char())
  }
  String::from_array(chars[:])
}

///|
fn av1_444_frame_md5(packed : Bytes) -> String {
  let digest : FixedArray[Byte] = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, packed, packed.length())
  av1_444_hex(digest)
}

///|
let av1_444_md5 : Array[String] = [
  "ec27ceb72d4aa148375ac66d6da42f58", "ec27ceb72d4aa148375ac66d6da42f58", "ec27ceb72d4aa148375ac66d6da42f58",
  "d03bef7527142e543ba5e1c2890b3c70", "ba53c3a2a5ce32611b2d8d2742357834", "ba53c3a2a5ce32611b2d8d2742357834",
  "ba53c3a2a5ce32611b2d8d2742357834", "55365fee5becdbc39bad328427c7f577", "a1d6d88ace6eb4493662c2864d0c8aac",
]

///|
let av1_422_md5 : Array[String] = [
  "906d3bc4f30f319d0a96eea810ebfdb8", "906d3bc4f30f319d0a96eea810ebfdb8", "906d3bc4f30f319d0a96eea810ebfdb8",
  "02c90cca9e629430cd9d2b341b7d068c", "c79b4807b5c811c9f06eda343a835e47", "c79b4807b5c811c9f06eda343a835e47",
  "c79b4807b5c811c9f06eda343a835e47", "c7f18d920bb6198bf18d274df44144b3", "b4bf6117519fb56b5543171ecdb83967",
]

///|
let av1_gray_md5 : Array[String] = [
  "b18330f111130cb0b947ebbb0a029c68", "b18330f111130cb0b947ebbb0a029c68", "b18330f111130cb0b947ebbb0a029c68",
]

///|
let av1_420_noedge_md5 : Array[String] = [
  "3615caf157cebbaea8cf271708402b75", "3615caf157cebbaea8cf271708402b75", "3615caf157cebbaea8cf271708402b75",
]

///|
test "av1_444: 8-bit 4:4:4 lossless keyframes match libdav1d framemd5" {
  let frames = av1_444_ivf_frames(av1_444_streams()[0])
  assert_eq(frames.length(), av1_444_md5.length())
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  for i in 0..<frames.length() {
    let obus = frames[i]
    if seq is None {
      let parsed = match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(v) => v
        Err(e) => fail("frame \{i}: sequence header: \{e}")
      }
      seq = Some(parsed)
    }
    let s = seq.unwrap()
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(v) => v
      Err(e) => fail("frame \{i}: frame header: \{e}")
    }
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(v) => v
      Err(e) => fail("frame \{i}: tiles: \{e}")
    }
    let out = match @libavcodec.av1_decode_keyframe(s, hdr, tiles[0].data()) {
      Ok(v) => v
      Err(e) => fail("frame \{i}: decode: \{e}")
    }
    inspect(av1_444_frame_md5(out.packed()), content=av1_444_md5[i])
  }
}

