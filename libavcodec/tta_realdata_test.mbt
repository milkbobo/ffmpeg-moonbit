///|
/// TTA fixtures encoded by ffmpeg 9.0.2 from deterministic 8 kHz WAV sources
/// (sine / silence / noise / impulses). `stereo16`, `stereo24` and `stereo8`
/// hold 2.5 s (two full frames plus a partial last frame); `mono16` holds
/// exactly two full frames. Reference PCM comes from the same ffmpeg build.

///|
let tta_fixtures : Array[(String, Bytes, Int32, Int32, Int32, Int32, String)] = [
  // stereo16
  (
    "stereo16",
    b"" +
    b"",
    8000,
    2,
    16,
    20000,
    "a7e2b29654ceeba8f06a3c71151c6f33",
  ),
  // mono16
  (
    "mono16", b"",
    8000, 1, 16, 16718, "793c16dbb267f097863dfb4ed31af572",
  ),
  // stereo24
  (
    "stereo24",
    b"" +
    b"" +
    b"",
    8000,
    2,
    24,
    20000,
    "322c025b332b30e4de9ab0a987169cea",
  ),
  // stereo8
  (
    "stereo8", b"",
    8000, 2, 8, 20000, "b53c7498bc828e985589fdc18d745e36",
  ),
]

///|
fn tta_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'␀')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "tta: ffmpeg fixtures decode bit-exactly" {
  for fixture in tta_fixtures {
    let (name, b64, sample_rate, channels, bits, nb_samples, want_md5) = fixture
    let data = @libavutil.av_base64_decode(b64, 200000).unwrap()
    let audio = match @libavcodec.ff_tta_decode(data) {
      Ok(v) => v
      Err(e) => fail("\{name}: decode failed: \{e}")
    }
    assert_eq(audio.sample_rate, sample_rate, msg=name)
    assert_eq(audio.channels, channels, msg=name)
    assert_eq(audio.bits, bits, msg=name)
    assert_eq(audio.samples.length(), nb_samples * channels, msg=name)
    assert_eq(tta_md5(audio.pcm_bytes()), want_md5, msg=name)
  }
}
