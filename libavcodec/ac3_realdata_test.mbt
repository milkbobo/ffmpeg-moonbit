///|
/// Real-data AC-3 decoding tests.  Fixtures encoded with FFmpeg 9.0.2:
///   ffmpeg -f lavfi -i "sine=frequency=440:sample_rate=48000:duration=0.128" \
///          -c:a ac3 -b:a 96k -f ac3 mono48.ac3
///   ffmpeg -f lavfi -i "aevalsrc=<two tones + bursts>:s=48000:d=0.128" \
///          -c:a ac3 -b:a 192k -f ac3 stereo48.ac3
///   ffmpeg -f lavfi -i "aevalsrc=<six tones>:s=48000:d=0.128:c=5.1" \
///          -c:a ac3 -b:a 384k -f ac3 surround51.ac3
///   ffmpeg -f lavfi -i "aevalsrc=<two tones>:s=48000:d=0.128" -c:a ac3 \
///          -b:a 96k -channel_coupling 1 -cpl_start_band 8 -f ac3 stereo48_cpl.ac3
///   ffmpeg -f lavfi -i "sine=frequency=440:sample_rate=44100:duration=0.128" \
///          -c:a ac3 -b:a 96k -f ac3 mono44.ac3
///   ffmpeg -f lavfi -i "sine=frequency=300:sample_rate=32000:duration=0.128" \
///          -c:a ac3 -b:a 64k -f ac3 mono32.ac3
///
/// The reference PCM is FFmpeg's `-f s16le` decode of the same fixtures.  The
/// port matches it within one s16 LSB; the mono streams are exact.

///|
fn ac3_b64_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let ac3_mono48_b64 : Bytes = ac3_b64_concat([
  b"",
])

///|
let ac3_mono48_ref_b64 : Bytes = ac3_b64_concat([
  b"",
  b"",
])

///|
let ac3_stereo48_b64 : Bytes = ac3_b64_concat([
  b"",
])

///|
let ac3_stereo48_ref_b64 : Bytes = ac3_b64_concat([
  b"",
  b"",
  b"",
  b"",
])

///|
let ac3_surround51_b64 : Bytes = ac3_b64_concat([
  b"",
])

///|
let ac3_surround51_ref_b64 : Bytes = ac3_b64_concat([
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
])

///|
let ac3_stereo48_cpl_b64 : Bytes = ac3_b64_concat([
  b"",
])

///|
let ac3_stereo48_cpl_ref_b64 : Bytes = ac3_b64_concat([
  b"",
  b"",
  b"",
  b"",
])

///|
let ac3_mono44_b64 : Bytes = ac3_b64_concat([
  b"",
])

///|
let ac3_mono44_ref_b64 : Bytes = ac3_b64_concat([
  b"",
  b"",
])

///|
let ac3_mono32_b64 : Bytes = ac3_b64_concat([
  b"",
])

///|
let ac3_mono32_ref_b64 : Bytes = ac3_b64_concat([
  b"",
  b"",
])

///|
/// Decode one fixture frame by frame and compare the s16-quantised output
/// against FFmpeg's reference (interleaved s16le).  Returns the sample count.
fn ac3_check_fixture(
  name : String,
  rate : Int32,
  channels : Int32,
  mode : Int32,
  lfe : Bool,
  frames_expected : Int32,
  frame_size0 : Int32,
  fixture_b64 : Bytes,
  ref_b64 : Bytes,
) -> Unit raise {
  let data = @libavutil.av_base64_decode(fixture_b64, 10000000).unwrap()
  let reference = @libavutil.av_base64_decode(ref_b64, 10000000).unwrap()
  let dec = @libavcodec.ac3_decoder_new()
  let pcm : Array[Array[Int32]] = []
  let mut pos = 0
  let mut frames = 0
  while pos + 8 <= data.length() {
    let hdr = match @libavcodec.ac3_parse_header(data[pos:].to_owned()) {
      Ok(h) => h
      Err(e) => fail("\{name}: header at \{pos}: \{e}")
    }
    assert_eq(hdr.sample_rate, rate, msg=name)
    assert_eq(hdr.channels, channels, msg=name)
    assert_eq(hdr.channel_mode, mode, msg=name)
    assert_eq(hdr.lfe_on, lfe, msg=name)
    assert_eq(hdr.num_blocks, 6, msg=name)
    if frames == 0 {
      assert_eq(hdr.frame_size, frame_size0, msg=name)
    }
    if pos + hdr.frame_size > data.length() {
      break
    }
    let frame = match
      dec.decode_frame(data[pos:pos + hdr.frame_size].to_owned()) {
      Ok(v) => v
      Err(e) => fail("\{name}: frame \{frames}: \{e}")
    }
    if frames == 0 {
      assert_eq(frame.sample_rate, rate, msg=name)
      assert_eq(frame.channels, channels, msg=name)
      for _c = 0; _c < channels; _c = _c + 1 {
        pcm.push([])
      }
    }
    for ch = 0; ch < channels; ch = ch + 1 {
      assert_eq(frame.samples[ch].length(), 1536, msg=name)
      for v in frame.samples[ch] {
        let q = if v >= 1.0 {
          32767
        } else if v <= -1.0 {
          -32768
        } else {
          (v * 32768.0).round().to_int()
        }
        pcm[ch].push(q)
      }
    }
    frames = frames + 1
    pos = pos + hdr.frame_size
  }
  assert_eq(frames, frames_expected, msg=name)
  assert_eq(reference.length(), frames_expected * 1536 * channels * 2, msg=name)
  assert_eq(pcm.length(), channels, msg=name)
  let mut max_diff = 0
  for ch = 0; ch < channels; ch = ch + 1 {
    for i = 0; i < pcm[ch].length(); i = i + 1 {
      let idx = (i * channels + ch) * 2
      let raw = reference[idx].to_int() | (reference[idx + 1].to_int() << 8)
      let want = if raw >= 32768 { raw - 65536 } else { raw }
      let d = if pcm[ch][i] > want {
        pcm[ch][i] - want
      } else {
        want - pcm[ch][i]
      }
      if d > max_diff {
        max_diff = d
      }
    }
  }
  assert_true(max_diff <= 1, msg="\{name}: max diff \{max_diff}")
}

///|
test "AC-3: real streams match FFmpeg PCM" {
  ac3_check_fixture(
    "mono48", 48000, 1, 1, false, 4, 384, ac3_mono48_b64, ac3_mono48_ref_b64,
  )
  ac3_check_fixture(
    "stereo48", 48000, 2, 2, false, 4, 768, ac3_stereo48_b64, ac3_stereo48_ref_b64,
  )
  ac3_check_fixture(
    "surround51", 48000, 6, 7, true, 4, 1536, ac3_surround51_b64, ac3_surround51_ref_b64,
  )
  ac3_check_fixture(
    "stereo48_cpl", 48000, 2, 2, false, 4, 384, ac3_stereo48_cpl_b64, ac3_stereo48_cpl_ref_b64,
  )
  ac3_check_fixture(
    "mono44", 44100, 1, 1, false, 4, 416, ac3_mono44_b64, ac3_mono44_ref_b64,
  )
  ac3_check_fixture(
    "mono32", 32000, 1, 1, false, 3, 384, ac3_mono32_b64, ac3_mono32_ref_b64,
  )
}

///|
test "AC-3: sync search, E-AC-3 rejection and invalid headers" {
  let data = @libavutil.av_base64_decode(ac3_mono48_b64, 1000000).unwrap()
  let hdr = @libavcodec.ac3_parse_header(data).unwrap()
  assert_eq(hdr.bitstream_id, 8)
  assert_eq(hdr.bit_rate, 96000)
  // A leading junk byte is skipped by the sync search (offset must be <= 10).
  let padded : Array[Byte] = [b'\x00', b'\xFF']
  for b in data {
    padded.push(b)
  }
  let dec = @libavcodec.ac3_decoder_new()
  let frame = dec.decode_frame(Bytes::from_array(padded)).unwrap()
  assert_eq(frame.channels, 1)
  assert_eq(frame.samples[0].length(), 1536)
  // Byte-swapped / broken sync is rejected.
  match @libavcodec.ac3_parse_header(b"\x77\x0B\x00\x00\x00\x00\x00\x00") {
    Ok(_) => fail("byte-swapped sync must fail")
    Err(_) => ()
  }
  // bsid 16 flags E-AC-3, which this decoder does not implement.
  let eac3 : Array[Byte] = []
  for i = 0; i < 8; i = i + 1 {
    eac3.push(data[i])
  }
  eac3[5] = ((16 << 3) | (eac3[5].to_int() & 7)).to_byte()
  match @libavcodec.ac3_parse_header(Bytes::from_array(eac3)) {
    Ok(_) => fail("E-AC-3 must be rejected")
    Err(_) => ()
  }
}
