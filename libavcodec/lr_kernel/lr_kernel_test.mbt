  let ws : FixedArray[Int] = [4, 8, 13, 64, 128, 256]
  let hs : FixedArray[Int] = [1, 2, 3, 7, 56, 64]
  let edg : FixedArray[Int] = [0, 4, 8, 12, 3, 15, 6, 9, 2, 7, 11]
  let sgr_params : FixedArray[Int] = [
    140, 3236, 112, 2158, 93, 1618, 80, 1438, 70, 1295, 58, 1177, 47, 1079, 37,
    996, 30, 925, 25, 863, 0, 2589, 0, 1618, 0, 1177, 0, 925, 56, 0, 22, 0,
  ]
  let stride = 512
  let p_off = 10 * stride + 20
  let mut caseid = 0
  let mut first_fail = -1
  for kind in 0..<=4 {
    for wi in 0..<6 {
      for hi in 0..<6 {
        for ei in 0..<11 {
          let w = ws[wi]
          let hh = hs[hi]
          let edges = edg[ei]
          let plane : FixedArray[Int32] = FixedArray::make(512 * 256, 0)
          let left : FixedArray[Int32] = FixedArray::make(256 * 4, 0)
          let lpf : FixedArray[Int32] = FixedArray::make(12 * 512, 0)
          let mut rs : UInt = 0x12345678U +
            (caseid.reinterpret_as_uint() * 2654435761U)
          let rnd = fn() {
            rs = rs * 1103515245U + 12345U
            ((rs >> 16) & 255U).reinterpret_as_int()
          }
          for i in 0..<(512 * 256) {
            plane[i] = rnd()
          }
          for i in 0..<(256 * 4) {
            left[i] = rnd()
          }
          for i in 0..<(12 * 512) {
            lpf[i] = rnd()
          }
          let mut p0 = 0
          let mut p1 = 0
          let mut p2 = 0
          let mut q0 = 0
          let mut q1 = 0
          if kind <= 1 {
            p0 = rnd() % 21 - 5
            p1 = rnd() % 21 - 5
            p2 = rnd() % 21 - 5
            if kind == 1 {
              p0 = 0
              p1 = 0
              p2 = 0
            }
          } else {
            let idx = rnd() % 16
            p0 = sgr_params[idx * 2]
            p1 = sgr_params[idx * 2 + 1]
            if kind == 2 && p1 == 0 {
              p1 = 1618
            }
            if (kind == 3 || kind == 4) && p0 == 0 {
              p0 = 140
            }
            if kind == 4 && p1 == 0 {
              p1 = 1618
            }
            q0 = rnd() % 193 - 96
            q1 = rnd() % 65 - 32
          }
          @libavcodec.av1_lr_filter_probe(
            kind,
            w,
            hh,
            edges,
            p0,
            p1,
            p2,
            q0,
            q1,
            plane,
            left,
            lpf,
            p_off,
            0,
            20,
            stride,
            8,
          )
          let mut fh : UInt64 = 1469598103934665603UL
          for y in 0..<hh {
            for x in 0..<w {
              let px : UInt64 = plane[p_off + y * stride + x].to_uint64()
              fh = (fh ^ px) * 1099511628211UL
            }
          }
          if fh != expect[caseid] && first_fail < 0 {
            first_fail = caseid
            println(
              "LR case " +
              caseid.to_string() +
              " kind=" +
              kind.to_string() +
              " w=" +
              w.to_string() +
              " h=" +
              hh.to_string() +
              " edges=" +
              edges.to_string() +
              " got=" +
              fh.to_string() +
              " want=" +
              expect[caseid].to_string(),
            )
          }
          caseid = caseid + 1
        }
      }
    }
  }
  if first_fail >= 0 {
    fail("lr kernel mismatch at case " + first_fail.to_string())
  }
}
