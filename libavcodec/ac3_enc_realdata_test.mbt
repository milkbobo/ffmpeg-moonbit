///|
test "ac3enc: reject malformed planar input" {
  let plane = FixedArray::make(1536, 0)
  assert_eq(
    @libavcodec.ff_ac3_fixed_encode_stream([], 48000, 192000, 0x3),
    Err("ac3: input channel count does not match layout"),
  )
  assert_eq(
    @libavcodec.ff_ac3_fixed_encode_stream([plane, []], 48000, 192000, 0x3),
    Err("ac3: input planes must have equal lengths"),
  )
  assert_eq(
    @libavcodec.ff_ac3_fixed_encode_stream([[0], [0]], 48000, 192000, 0x3),
    Err("ac3: input length must be a multiple of 1536 samples"),
  )
}

///|
test "ac3enc: encode 44.1 kHz surround frames with LFE" {
  let samples = FixedArray::make(4 * 1536, 0)
  let planes = Array::make(6, samples)
  guard @libavcodec.ff_ac3_fixed_encode_stream(planes, 44100, 448000, 0x60F)
    is Ok(bytes) else {
    fail("could not encode 5.1 PCM")
  }
  let mut offset = 0
  let mut saw_padding = false
  for _ in 0..<4 {
    guard @libavcodec.ac3_parse_header(bytes[offset:].to_owned()) is Ok(header) else {
      fail("invalid AC-3 frame at byte \{offset}")
    }
    assert_eq(header.sample_rate, 44100)
    assert_eq(header.channels, 6)
    assert_eq(header.lfe_on, true)
    assert_eq(header.bit_rate, 448000)
    assert_true(header.frame_size == 1950 || header.frame_size == 1952)
    saw_padding = saw_padding || header.frame_size == 1952
    offset += header.frame_size
  }
  assert_eq(offset, bytes.length())
  assert_true(saw_padding)
}

///|
test "ac3enc: docker ac3_fixed stream is bit-exact" {
  let data = read_ac3enc_wav_fixture()
  let planes = ac3enc_test_wav_planes(data)
  let want = "dda2979c556a8be212d3cc5dffbb90f4"
  match @libavcodec.ff_ac3_fixed_encode_stream(planes, 48000, 192000, 0x3) {
    Ok(bytes) => {
      assert_eq(bytes.length(), 30 * 768)
      let digest = FixedArray::make(16, b'\x00')
      @libavutil.av_md5_sum(digest, bytes, bytes.length())
      let hex = "0123456789abcdef"
      let text = StringBuilder()
      for b in digest {
        text.write_char(hex.get_char((b.to_int() >> 4) & 15).unwrap())
        text.write_char(hex.get_char(b.to_int() & 15).unwrap())
      }
      let got = text.to_string()
      if got != want {
        fail("ac3_fixed md5 mismatch: got \{got} want \{want}")
      }
    }
    Err(e) => fail("ac3_fixed encode failed: \{e}")
  }
}

///|
/// Raw input WAV (s16le stereo 48k sine, 46080 samples = 30 frames) for
/// the docker ac3_fixed reference (md5 dda2979c...).
let ac3enc_wav_fixture : Array[Bytes] = [
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
  b"",
]

///|
fn read_ac3enc_wav_fixture() -> Bytes {
  let out : Array[Byte] = []
  for part in ac3enc_wav_fixture {
    for b in part {
      out.push(b)
    }
  }
  @libavutil.av_base64_decode(Bytes::from_array(out), 1 << 20).unwrap()
}

///|
/// Convert the stereo S16LE fixture to planar S32 PCM.
fn ac3enc_test_wav_planes(data : Bytes) -> Array[FixedArray[Int32]] {
  let mut pos = 12
  let mut data_off = 0
  let mut data_len = 0
  while pos + 8 <= data.length() {
    let tag = data[pos] == b'd' &&
      data[pos + 1] == b'a' &&
      data[pos + 2] == b't' &&
      data[pos + 3] == b'a'
    let len = data[pos + 4].to_int() |
      (data[pos + 5].to_int() << 8) |
      (data[pos + 6].to_int() << 16) |
      (data[pos + 7].to_int() << 24)
    if tag {
      data_off = pos + 8
      data_len = len
      break
    }
    pos += 8 + len
  }
  let n = data_len / 4
  let ch0 : FixedArray[Int32] = FixedArray::make(n, 0)
  let ch1 : FixedArray[Int32] = FixedArray::make(n, 0)
  for i = 0; i < n; i = i + 1 {
    let s0 = data[data_off + i * 4].to_int() |
      (data[data_off + i * 4 + 1].to_int() << 8)
    let s1 = data[data_off + i * 4 + 2].to_int() |
      (data[data_off + i * 4 + 3].to_int() << 8)
    ch0[i] = (if (s0 & 0x8000) != 0 { s0 - 0x10000 } else { s0 }) << 16
    ch1[i] = (if (s1 & 0x8000) != 0 { s1 - 0x10000 } else { s1 }) << 16
  }
  [ch0, ch1]
}
