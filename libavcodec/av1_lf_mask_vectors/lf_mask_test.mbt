  let actual : Array[Int64] = []
  for i in 0..<48 {
    let seed = seeds[i]
    let bx = cfg[i * 13 + 0]
    let by = cfg[i * 13 + 1]
    let skip = cfg[i * 13 + 2] != 0
    let bs = cfg[i * 13 + 3]
    let ytx = cfg[i * 13 + 4]
    let uvtx = cfg[i * 13 + 5]
    let layout = cfg[i * 13 + 6]
    let lf_level = FixedArray::make(32 * 32 * 4, (0 : Int32))
    let lvl = FixedArray::make(64, (0 : Int32))
    for d in 0..<4 {
      lvl[d * 16] = cfg[i * 13 + 9 + d]
    }
    let fy = FixedArray::make(2 * 32 * 3 * 2, (0 : UInt32))
    let fuv = FixedArray::make(2 * 32 * 2 * 2, (0 : UInt32))
    let ay = FixedArray::make(32, (0 : Int32))
    let ly = FixedArray::make(32, (0 : Int32))
    let auv = FixedArray::make(32, (0 : Int32))
    let luv = FixedArray::make(32, (0 : Int32))
    for j in 0..<32 {
      let ju = j.reinterpret_as_uint()
      ay[j] = ((ju * 7U + seed * 13U) % 3U).reinterpret_as_int()
      ly[j] = ((ju * 11U + seed * 17U) % 3U).reinterpret_as_int()
      auv[j] = ((ju * 5U + seed * 7U) % 2U).reinterpret_as_int()
      luv[j] = ((ju * 9U + seed * 11U) % 2U).reinterpret_as_int()
    }
    let has_chroma = layout != 0
    let ss_h : Int32 = if layout == 1 || layout == 2 { 1 } else { 0 }
    let ss_v : Int32 = if layout == 1 { 1 } else { 0 }
    @libavcodec.av1_create_lf_mask_inter(
      lf_level,
      lvl,
      32,
      32,
      32,
      ss_h,
      ss_v,
      fy,
      fuv,
      bx,
      by,
      skip,
      bs,
      ytx,
      [cfg[i * 13 + 7], cfg[i * 13 + 8]],
      uvtx,
      ay,
      0,
      ly,
      0,
      auv,
      0,
      luv,
      0,
      has_chroma,
      0,
    )
    let mut h = 17L
    for j in 0..<(2 * 32 * 3 * 2) {
      h = av1_lfm_hash_v(h, fy[j].reinterpret_as_int())
    }
    actual.push(h)
    h = 17L
    for j in 0..<(2 * 32 * 2 * 2) {
      h = av1_lfm_hash_v(h, fuv[j].reinterpret_as_int())
    }
    actual.push(h)
    h = 17L
    for j in 0..<(32 * 32 * 4) {
      h = av1_lfm_hash_v(h, lf_level[j])
    }
    actual.push(h)
    for arr in [ay, ly] {
      h = 17L
      for j in 0..<32 {
        h = av1_lfm_hash_v(h, arr[j])
      }
      actual.push(h)
    }
    if has_chroma {
      for arr in [auv, luv] {
        h = 17L
        for j in 0..<32 {
          h = av1_lfm_hash_v(h, arr[j])
        }
        actual.push(h)
      }
    } else {
      actual.push(0L)
      actual.push(0L)
    }
  }
  for k in 0..<actual.length() {
    if actual[k] != expected[k] {
      fail("mask mismatch at index " + k.to_string())
    }
  }
}
