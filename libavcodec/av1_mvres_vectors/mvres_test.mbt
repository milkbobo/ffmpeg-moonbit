    if y != expected[k] {
      fail("y at \{i}: got \{y}, want \{expected[k]}")
    }
    if x != expected[k + 1] {
      fail("x at \{i}: got \{x}, want \{expected[k + 1]}")
    }
    if msac.rng.reinterpret_as_int() != expected[k + 2] {
      fail("rng at \{i}: got \{msac.rng}, want \{expected[k + 2]}")
    }
    if (msac.dif >> 32).reinterpret_as_int64().to_int() != expected[k + 3] {
      fail("dif at \{i}: got \{(msac.dif >> 32)}, want \{expected[k + 3]}")
    }
  }
