///|
/// MV residual decoding (`av1_read_mv_residual`) verified step by
/// step (y/x/rng/dif) against dav1d 1.5.1 `read_mv_residual` run
/// over LCG byte streams with the default MV CDF
/// (`scripts/_emit_av1_mvres_vectors.py`).

///|
fn av1_mvres_test_lcg(seed : UInt32, n : Int32) -> Bytes {
  let mut state = seed
  let out : Array[Byte] = []
  for _ in 0..<n {
    state = state * 1664525 + 1013904223
    out.push(((state >> 16) & 0xff).reinterpret_as_int().to_byte())
  }
  Bytes::from_array(out)
}

