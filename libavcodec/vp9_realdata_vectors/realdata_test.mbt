///|
/// libvpx-vp9 testsrc2, 128x96 crf30 g=3 alt-ref off, 10 frames.  Reference: FFmpeg 9.0.2 native vp9
/// decoder framemd5 (-threads 1).  Reproduce with
/// scripts/emit_vp9_realdata_vectors.py.

///|
let r1_ivf_b64 : Bytes = b""

///|
let r1_md5 : Array[String] = [
  "1d84924b5d7f3b600d9faebfc92f1206", "25550f1d03c6ebd41ea92d6f0854b992", "b247dd3a9b1ceef0ac10c03730bbae97",
  "89d0f947b672caa2c93b28280b9c1b6e", "a3b4d6d11d14a2c8d9d8dd7542850472", "24ff41b8c90582bc4eca2650e48f65b1",
  "d1d3f356a6bdec28350644209b389110", "ad460606bcaa922edae3a4ed364d58e4", "0aef12245499f768642b26472f753623",
  "1ed732e186386404f0925b5b75ff875c",
]

///|
test "vp9 realdata: 128x96 multi-P session matches FFmpeg 9.0.2" {
  let ivf = @libavutil.av_base64_decode(r1_ivf_b64, 1000000).unwrap()
  let decoder = @libavcodec.vp9_decoder_new()
  let frames = vp9_ivf_frames(ivf)
  let mut shown = 0
  for i, payload in frames {
    let output = decoder.decode_packet(payload).unwrap()
    for frame in output {
      assert_true(shown < r1_md5.length())
      let hash = vp9_frame_md5(frame)
      assert_eq(
        hash,
        r1_md5[shown],
        msg="r1 packet \{i}: got \{hash}, want \{r1_md5[shown]}",
      )
      shown += 1
    }
  }
  assert_eq(shown, r1_md5.length())
}

///|
