///|
/// White-box vectors for the CABAC arithmetic core.
///
/// The reference is FFmpeg's own `libavcodec/tests/cabac.c`: it drives a
/// CABAC *encoder* written in that test file (using `ff_h264_cabac_tables`
/// and `cabac_context_init` state semantics), then decodes the produced bytes
/// with `ff_init_cabac_decoder` / `get_cabac` / `get_cabac_bypass` /
/// `get_cabac_terminate` and requires the bit sequence to come back unchanged.
/// The bit sequence itself is generated by `av_lfg_get()` seeded with 1, so the
/// whole vector is reproducible from FFmpeg's source (`libavutil/lfg.c` +
/// this test file) without embedding magic numbers.
///
/// Porting the encoder half is deliberate: it makes the test an independent
/// implementation check of the decoder rather than a self-round-trip of one
/// routine.

///| `AVLFG` (`libavutil/lfg.h`). */
struct CabacTestLfg {
  state : Array[Int]
  mut index : Int
}

///| `av_lfg_init(c, seed)` — the first 8 words stay zero, then 14 MD5 digests. */
fn cabac_test_lfg_init(seed : Int) -> CabacTestLfg {
  let state : Array[Int] = Array::make(64, 0)
  let tmp : Array[Byte] = Array::make(16, b'\x00')
  for i = 8; i < 64; i = i + 4 {
    tmp[0] = (seed & 0xFF).to_byte()
    tmp[1] = ((seed >> 8) & 0xFF).to_byte()
    tmp[2] = ((seed >> 16) & 0xFF).to_byte()
    tmp[3] = ((seed >> 24) & 0xFF).to_byte()
    tmp[4] = i.to_byte()
    let digest = FixedArray::make(16, b'\x00')
    @libavutil.av_md5_sum(digest, Bytes::from_array(tmp[:]), 16)
    for k = 0; k < 16; k = k + 1 {
      tmp[k] = digest[k]
    }
    for k = 0; k < 4; k = k + 1 {
      let o = k * 4
      state[i + k] = tmp[o].to_int() |
        (tmp[o + 1].to_int() << 8) |
        (tmp[o + 2].to_int() << 16) |
        (tmp[o + 3].to_int() << 24)
    }
  }
  { state, index: 0 }
}

///| `av_lfg_get`: 32-bit wrapping lagged Fibonacci. */
fn cabac_test_lfg_get(c : CabacTestLfg) -> Int {
  let a = c.state[(c.index - 24) & 63] + c.state[(c.index - 55) & 63]
  c.state[c.index & 63] = a
  c.index = c.index + 1
  a
}

///| Bit sink standing in for `PutBitContext` (MSB-first). */
struct CabacTestBits {
  bits : Array[Int]
}

///| `put_cabac_bit`. */
fn CabacTestBits::put_cabac_bit(self : CabacTestBits, b : Int) -> Unit {
  self.bits.push(b)
}

///| `put_bits(pb, n, v)` MSB-first. */
fn CabacTestBits::put_bits(self : CabacTestBits, n : Int, v : Int) -> Unit {
  for i = n - 1; i >= 0; i = i - 1 {
    self.bits.push((v >> i) & 1)
  }
}

///|
/// Pack the sink into bytes, MSB-first. The *first* bit is dropped: FFmpeg's
/// `init_cabac_encoder` does `pb.bit_left++` (see `libavcodec/tests/cabac.c`),
/// which gives the `PutBitContext` one phantom free slot, so the leading zero
/// bit the arithmetic encoder always emits first never reaches the stream.
/// `ff_init_cabac_decoder` compensates by loading a synthetic guard bit.
fn CabacTestBits::to_bytes(self : CabacTestBits) -> Bytes {
  let n = (self.bits.length() - 1 + 7) / 8
  let out : Array[Byte] = Array::make(n + 8, b'\x00')
  for i = 1; i < self.bits.length(); i = i + 1 {
    let j = i - 1
    if self.bits[i] != 0 {
      out[j / 8] = (out[j / 8].to_int() | (1 << (7 - j % 8))).to_byte()
    }
  }
  Bytes::from_array(out[:])
}

///| Reference encoder state (`CABACTestContext` minus the bit writer). */
struct CabacTestEnc {
  mut low : Int
  mut range : Int
  mut outstanding : Int
  pb : CabacTestBits
}

///| `init_cabac_encoder`. */
fn cabac_test_enc_new() -> CabacTestEnc {
  { low: 0, range: 0x1FE, outstanding: 0, pb: { bits: [] } }
}

///| `put_cabac_bit` with the outstanding run: emit `b` then `1-b` per pending. */
fn cabac_test_emit(c : CabacTestEnc, b : Int) -> Unit {
  c.pb.put_cabac_bit(b)
  while c.outstanding > 0 {
    c.pb.put_cabac_bit(1 - b)
    c.outstanding = c.outstanding - 1
  }
}

///| `renorm_cabac_encoder` written against `put_cabac_bit` verbatim. */
fn cabac_test_renorm(c : CabacTestEnc) -> Unit {
  while c.range < 0x100 {
    if c.low < 0x100 {
      cabac_test_emit(c, 0)
    } else if c.low < 0x200 {
      c.outstanding = c.outstanding + 1
      c.low = c.low - 0x100
    } else {
      cabac_test_emit(c, 1)
      c.low = c.low - 0x200
    }
    c.range = c.range + c.range
    c.low = c.low + c.low
  }
}

///| `put_cabac(&c, state, bit)`. */
fn cabac_test_put_cabac(c : CabacTestEnc, state : Array[Int], bit : Int) -> Unit {
  let range_lps = h264_cabac_lps_range(c.range, state[0])
  if bit == (state[0] & 1) {
    c.range = c.range - range_lps
    state[0] = h264_cabac_mlps_state(state[0])
  } else {
    c.low = c.low + (c.range - range_lps)
    c.range = range_lps
    state[0] = h264_cabac_tables[h264_cabac_mlps_state_offset + 127 - state[0]]
  }
  cabac_test_renorm(c)
}

///| `put_cabac_bypass`. */
fn cabac_test_put_cabac_bypass(c : CabacTestEnc, bit : Int) -> Unit {
  c.low = c.low + c.low
  if bit != 0 {
    c.low = c.low + c.range
  }
  if c.low < 0x200 {
    cabac_test_emit(c, 0)
  } else if c.low < 0x400 {
    c.outstanding = c.outstanding + 1
    c.low = c.low - 0x200
  } else {
    cabac_test_emit(c, 1)
    c.low = c.low - 0x400
  }
}

///| `put_cabac_terminate`; returns the byte count of the written stream. */
fn cabac_test_put_cabac_terminate(c : CabacTestEnc, bit : Int) -> Int {
  c.range = c.range - 2
  if bit == 0 {
    cabac_test_renorm(c)
  } else {
    c.low = c.low + c.range
    c.range = 2
    cabac_test_renorm(c)
    cabac_test_emit(c, c.low >> 9)
    c.pb.put_bits(2, ((c.low >> 7) & 3) | 1)
  }
  (c.pb.bits.length() + 7) / 8
}

///|
/// The `libavcodec/tests/cabac.c` vector: 10240 bypass bits, 10240 context
/// coded bits, then a terminating bit. The encoder output is decoded by the
/// ported decoder and every bit must match.
test "cabac: FFmpeg tests/cabac.c vector round-trips through the decoder" {
  let size = 10240
  let prng = cabac_test_lfg_init(1)
  let enc = cabac_test_enc_new()
  // `r[i] = av_lfg_get(&prng) % 7` for the first half, then `(i>>8)&1`.
  let r : Array[Int] = Array::make(size, 0)
  for i = 0; i < size; i = i + 1 {
    r[i] = if 2 * i < size {
      let v = cabac_test_lfg_get(prng)
      // `unsigned % 7` of the low bits: use the unsigned value.
      (v.reinterpret_as_uint() % 7U).reinterpret_as_int()
    } else {
      (i >> 8) & 1
    }
  }
  let state : Array[Int] = Array::make(10, 0)
  for i = 0; i < size; i = i + 1 {
    cabac_test_put_cabac_bypass(enc, r[i] & 1)
  }
  for i = 0; i < size; i = i + 1 {
    cabac_test_put_cabac(enc, state, r[i] & 1)
  }
  let n = cabac_test_put_cabac_terminate(enc, 1)
  let bytes = enc.pb.to_bytes().to_array()
  // `b[i++] = av_lfg_get(&prng); b[i] = av_lfg_get(&prng);`
  let extra0 = cabac_test_lfg_get(prng)
  let extra1 = cabac_test_lfg_get(prng)
  let tail : Array[Byte] = [
    (extra0 & 0xFF).to_byte(), ((extra0 >> 8) & 0xFF).to_byte(),
    ((extra0 >> 16) & 0xFF).to_byte(), ((extra0 >> 24) & 0xFF).to_byte(),
    (extra1 & 0xFF).to_byte(), ((extra1 >> 8) & 0xFF).to_byte(),
    ((extra1 >> 16) & 0xFF).to_byte(), ((extra1 >> 24) & 0xFF).to_byte(),
  ]
  for k = 0; k < tail.length(); k = k + 1 {
    if n + k < bytes.length() {
      bytes[n + k] = tail[k]
    }
  }
  let buf = Bytes::from_array(bytes[:])
  let dec = ff_init_cabac_decoder(buf, 0).unwrap()
  let dstate : Array[Int] = Array::make(10, 0)
  for i = 0; i < size; i = i + 1 {
    let bit = dec.get_cabac_bypass()
    assert_eq(bit, r[i] & 1, msg="bypass mismatch at \{i}")
  }
  for i = 0; i < size; i = i + 1 {
    let bit = dec.get_cabac(dstate, 0)
    assert_eq(bit, r[i] & 1, msg="context mismatch at \{i}")
  }
  assert_true(dec.get_cabac_terminate() != 0, msg="terminator missing")
}

///|
/// `ff_h264_init_cabac_states`: the derivation from `cabac_context_init` is
/// `pre = 2*(((m*qp)>>4) + n) - 127`, then `pre ^= pre>>31` and the `>124`
/// clamp to `124 + (pre&1)`. The expected values are computed the same way the
/// C does for a handful of contexts whose `(m, n)` pairs are quoted from
/// `h264_cabac.c`, which pins the shift/rounding direction (a wrong shift
/// direction shows up immediately because the tables contain negative `m`).
test "cabac: slice state derivation matches the C formula" {
  // I-slice, QP 26: contexts 0..3 are (20,-15), (2,54), (3,74), (20,-15).
  let st = ff_h264_init_cabac_states(26, 8, 2, 0)
  assert_eq(st.length(), 1024)
  // pre = 2*(((20*26)>>4) + -15) - 127 = -93, then `pre ^= pre>>31` -> 92.
  assert_eq(st[0], 92)
  // pre = 2*(((2*26)>>4) + 54) - 127 = -13 -> 12.
  assert_eq(st[1], 12)
  // pre = 2*(((3*26)>>4) + 74) - 127 = 2*(4 + 74) - 127 = 29
  assert_eq(st[2], 29)
  // Negative QP clamps to 0: pre = 2*(0 + 54) - 127 = -19 -> 18.
  let st0 = ff_h264_init_cabac_states(0, 8, 2, 0)
  assert_eq(st0[1], 18)
  // States never exceed 124 + 1 and are never negative (pre ^= pre>>31).
  for i = 0; i < 1024; i = i + 1 {
    assert_true(st[i] >= 0 && st[i] <= 125, msg="state out of range at \{i}")
  }
}

