///|
/// Generated by scripts/generate_aac_ps_tests.py — do not edit by hand.
/// Vectors: docker linuxserver/ffmpeg:9.0.2 libfdk_aac -profile:a aac_he_v2;
/// references from the same build's native float AAC decoder and the
/// instrumented-C dumps of `_build/ps_work`. LGPL-2.1-or-later.

///|
/// Compare float32 C stage dumps with the corresponding MoonBit buffer.
fn ps_payload_check_stage(
  got : Array[Double],
  reference : Bytes,
  offset : Int32,
  frame : Int32,
  tag : String,
  stats : Array[Double],
  slot : Int32,
) -> Int32 raise {
  let mut pos = offset
  for i in 0..<got.length() {
    let word = reference[pos].to_uint() |
      (reference[pos + 1].to_uint() << 8) |
      (reference[pos + 2].to_uint() << 16) |
      (reference[pos + 3].to_uint() << 24)
    let want = Float::reinterpret_from_uint(word).to_double()
    let diff = (got[i] - want).abs()
    if diff > stats[slot * 2] {
      stats[slot * 2] = diff
    }
    stats[slot * 2 + 1] = stats[slot * 2 + 1] + diff
    if diff > 0.00001 + want.abs() * 0.001 {
      fail(
        "frame=\{frame} stage=\{tag} index=\{i} got=\{got[i]} want=\{want} diff=\{diff}",
      )
    }
    pos = pos + 4
  }
  pos
}

///|
/// Encoded parameter sequences, parsed and synthesized by both decoders.
test "PS encoded payload DSP sequences vs FFmpeg C" {
  let payload_data = @libavutil.av_base64_decode(
    b"",
    1 << 20,
  ).unwrap()
  let reference = @libavutil.av_base64_decode(
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"",
    1 << 20,
  ).unwrap()
  let stage_reference = @libavutil.av_base64_decode(
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"" +
    b"",
    1 << 20,
  ).unwrap()
  ps_dsp_direct_reference_test()
  let ps = aac_ps_new()
  let ps_apply = aac_ps_new()
  let x = Array::make(2 * 2 * 38 * 64, 0.0)
  let x_apply = Array::make(2 * 2 * 38 * 64, 0.0)
  let mut index = 0
  let mut worst = 0.0
  let mut sum = 0.0
  let mut stage_pos = 0
  let stage_stats = Array::make(12, 0.0)
  let mut start = 0
  for frame in 0..<8 {
    let case = frame % 8
    let mut end = start
    while end < payload_data.length() && payload_data[end].to_int() != 10 {
      end = end + 1
    }
    let bits_len = end - start
    let buf = Array::make((bits_len + 7) / 8, (0).to_byte())
    for k in 0..<bits_len {
      if payload_data[start + k].to_int() == 49 {
        buf[k / 8] = (buf[k / 8].to_int() | (1 << (7 - k % 8))).to_byte()
      }
    }
    start = end + 1
    let gb = BitReader::new(Bytes::from_array(buf))
    let consumed = ps.common.read_data(gb, bits_len)
    let gb_apply = BitReader::new(Bytes::from_array(buf))
    assert_eq(ps_apply.common.read_data(gb_apply, bits_len), bits_len)
    assert_true(ps_apply.common.start)
    assert_eq(consumed, bits_len)
    assert_true(ps.common.start)
    // Expectations for payload_cases(): header reuse, tool switches and the
    // fixed-grid/fake-envelope paths.
    let exp_nenv : Array[Int32] = [2, 4, 3, 2, 1, 5, 1, 3]
    let exp_iid : Array[Int32] = [34, 34, 34, 34, 10, 10, 34, 20]
    let exp_icc : Array[Int32] = [0, 0, 34, 34, 20, 20, 34, 34]
    let exp_ipdopd : Array[Int32] = [17, 17, 17, 17, 5, 5, 17, 11]
    let exp_34 : Array[Bool] = [
      true, true, true, true, false, false, true, true,
    ]
    let exp_ipdopd_on : Array[Bool] = [
      false, false, false, false, true, true, false, false,
    ]
    assert_eq(ps.common.is34bands, exp_34[case])
    assert_eq(ps.common.enable_ipdopd, exp_ipdopd_on[case])
    assert_eq(ps.common.num_env, exp_nenv[case])
    assert_eq(ps.common.nr_iid_par, exp_iid[case])
    assert_eq(ps.common.nr_icc_par, exp_icc[case])
    assert_eq(ps.common.nr_ipdopd_par, exp_ipdopd[case])
    for p in 0..<2 {
      for t in 0..<38 {
        for k in 0..<64 {
          let value = ((p * 17 + t * 13 + k * 7 + frame * 11) % 127 - 63).to_double() /
            64.0
          x[p * 38 * 64 + t * 64 + k] = value
          x_apply[p * 38 * 64 + t * 64 + k] = value
        }
      }
    }
    let top_qmf = 20 + frame * 6 % 45
    ps_apply.apply(x_apply, top_qmf)
    let grid = if ps.common.is34bands { 1 } else { 0 }
    let top = top_qmf + ps_nr_bands[grid] - 64
    for i in (top * 46 * 2)..<(ps_nr_bands[grid] * 46 * 2) {
      ps.delay[i] = 0.0
    }
    if top < ps_nr_allpass_bands[grid] {
      for i in (top * 3 * 37 * 2)..<(ps_nr_allpass_bands[grid] * 3 * 37 * 2) {
        ps.ap_delay[i] = 0.0
      }
    }
    ps.hybrid_analysis(x, ps.common.is34bands, 32)
    stage_pos = ps_payload_check_stage(
      ps.lbuf,
      stage_reference,
      stage_pos,
      frame,
      "LBUF",
      stage_stats,
      0,
    )
    ps.decorrelation(ps.common.is34bands)
    stage_pos = ps_payload_check_stage(
      ps.rbuf,
      stage_reference,
      stage_pos,
      frame,
      "DEC",
      stage_stats,
      1,
    )
    ps.stereo_processing(ps.common.is34bands)
    stage_pos = ps_payload_check_stage(
      ps.h11,
      stage_reference,
      stage_pos,
      frame,
      "H11",
      stage_stats,
      2,
    )
    stage_pos = ps_payload_check_stage(
      ps.h12,
      stage_reference,
      stage_pos,
      frame,
      "H12",
      stage_stats,
      3,
    )
    stage_pos = ps_payload_check_stage(
      ps.h21,
      stage_reference,
      stage_pos,
      frame,
      "H21",
      stage_stats,
      4,
    )
    stage_pos = ps_payload_check_stage(
      ps.h22,
      stage_reference,
      stage_pos,
      frame,
      "H22",
      stage_stats,
      5,
    )
    ps_hybrid_synthesis(x, 0, ps.lbuf, ps.common.is34bands, 32)
    ps_hybrid_synthesis(x, 2 * 38 * 64, ps.rbuf, ps.common.is34bands, 32)
    for ch in 0..<2 {
      for p in 0..<2 {
        for t in 0..<32 {
          for k in 0..<64 {
            let got = x[(ch * 2 + p) * 38 * 64 + t * 64 + k]
            let actual_apply = x_apply[(ch * 2 + p) * 38 * 64 + t * 64 + k]
            let pos = index * 4
            let word = reference[pos].to_uint() |
              (reference[pos + 1].to_uint() << 8) |
              (reference[pos + 2].to_uint() << 16) |
              (reference[pos + 3].to_uint() << 24)
            let want = Float::reinterpret_from_uint(word).to_double()
            let diff = (got - want).abs()
            if diff > worst {
              worst = diff
            }
            sum = sum + diff
            if diff > 0.00001 + want.abs() * 0.001 {
              fail(
                "frame=\{frame} ch=\{ch} p=\{p} t=\{t} k=\{k} got=\{got} want=\{want} diff=\{diff}",
              )
            }
            if (actual_apply - want).abs() > 0.00001 + want.abs() * 0.001 {
              fail(
                "apply frame=\{frame} ch=\{ch} p=\{p} t=\{t} k=\{k} got=\{actual_apply} want=\{want}",
              )
            }
            index = index + 1
          }
        }
      }
    }
  }
  assert_eq(stage_pos, stage_reference.length())
  for i, name in ["LBUF", "DEC", "H11", "H12", "H21", "H22"] {
    println(
      "PS \{name}: max diff=\{stage_stats[i * 2]} sumAbs=\{stage_stats[i * 2 + 1]}",
    )
  }
  println("PS encoded DSP: \{index} samples, max diff=\{worst} sumAbs=\{sum}")
}
