  let mut n = 0
  for wd_i in 0..<4 {
    let wd = wds[wd_i]
    for _t in 0..<200 {
      s = s * 1103515245U + 12345U
      let e = ((s >> 16) % 160U).reinterpret_as_int()
      s = s * 1103515245U + 12345U
      let ii = ((s >> 16) % 24U).reinterpret_as_int()
      s = s * 1103515245U + 12345U
      let h = ((s >> 16) % 12U).reinterpret_as_int()
      for k in 0..<(20 * 8) {
        s = s * 1103515245U + 12345U
        buf[k] = ((s >> 16) & 255U).reinterpret_as_int()
      }
      @libavcodec.av1_lf_filter_kernel(buf, 4 * 20 + 10, 20, 1, wd, e, ii, h)
      let mut hh : UInt64 = 1469598103934665603UL
      for k in 0..<(20 * 8) {
        hh = hh ^ buf[k].to_uint64()
        hh = hh * 1099511628211UL
      }
      if hh != expect[n] {
        fail(
          "case " +
          n.to_string() +
          " (wd " +
          wd.to_string() +
          ") got " +
          hh.to_string() +
          " want " +
          expect[n].to_string(),
        )
      }
      n = n + 1
    }
  }
  assert_eq(n, 800)
}
