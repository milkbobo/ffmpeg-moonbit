///|
/// Real-data AMR-NB decoding tests.  Fixtures encoded with FFmpeg 9.0.2
/// libopencore_amrnb at every mode (4.75-12.2 kbit/s), 8 kHz mono, 0.4 s:
///   ffmpeg -f lavfi -i "aevalsrc=<three tones + bursts>:s=8000:d=0.4" \
///          -c:a libopencore_amrnb -b:a <mode> -f amr mode_<mode>.amr
/// The reference is FFmpeg's own `-f s16le` decode.  FFmpeg notes that this
/// float decoder is not bit-exact against the 3GPP reference; against the C
/// float decoder the port stays within one s16 LSB.

///|
fn amr_concat(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
let amr_4750_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_4750_ref_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_5150_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_5150_ref_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_5900_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_5900_ref_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_6700_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_6700_ref_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_7400_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_7400_ref_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_7950_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_7950_ref_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_10200_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_10200_ref_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_12200_b64 : Bytes = amr_concat([
  b"",
])

///|
let amr_12200_ref_b64 : Bytes = amr_concat([
  b"",
])

///|
/// Decode one AMR-NB fixture and compare its s16 output to FFmpeg's PCM.
fn amr_check_fixture(
  name : String,
  mode : Int32,
  fixture_b64 : Bytes,
  ref_b64 : Bytes,
) -> Unit raise {
  let data = @libavutil.av_base64_decode(fixture_b64, 1000000).unwrap()
  let reference = @libavutil.av_base64_decode(ref_b64, 1000000).unwrap()
  assert_eq(data[0], b'#')
  assert_eq(data[1], b'!')
  assert_eq(data[5], b'\n')
  let dec = @libavcodec.amrnb_decoder_new()
  let pcm : Array[Int32] = []
  let mut pos = 6
  let mut frames = 0
  while pos < data.length() {
    let frame = data[pos:].to_owned()
    let size = @libavcodec.amrnb_frame_size(frame)
    assert_true(size > 0, msg=name)
    if pos + size > data.length() {
      break
    }
    if frames == 0 {
      assert_eq((frame[0].to_int() >> 3) & 15, mode, msg=name)
    }
    let samples = match dec.decode_frame(frame[0:size].to_owned()) {
      Ok(v) => v
      Err(e) => fail("\{name}: frame \{frames}: \{e}")
    }
    assert_eq(samples.length(), 160, msg=name)
    for v in samples {
      let q = if v >= 1.0 {
        32767
      } else if v <= -1.0 {
        -32768
      } else {
        (v * 32768.0).round().to_int()
      }
      pcm.push(q)
    }
    frames = frames + 1
    pos = pos + size
  }
  assert_eq(frames, 21, msg=name)
  assert_eq(pcm.length(), 3360, msg=name)
  assert_eq(reference.length(), 3360 * 2, msg=name)
  let mut max_diff = 0
  for i = 0; i < pcm.length(); i = i + 1 {
    let raw = reference[i * 2].to_int() | (reference[i * 2 + 1].to_int() << 8)
    let want = if raw >= 32768 { raw - 65536 } else { raw }
    let d = if pcm[i] > want { pcm[i] - want } else { want - pcm[i] }
    if d > max_diff {
      max_diff = d
    }
  }
  assert_true(max_diff <= 1, msg="\{name}: max diff \{max_diff}")
}

///|
test "AMR-NB: all eight modes match FFmpeg PCM" {
  amr_check_fixture("amr_4750", 0, amr_4750_b64, amr_4750_ref_b64)
  amr_check_fixture("amr_5150", 1, amr_5150_b64, amr_5150_ref_b64)
  amr_check_fixture("amr_5900", 2, amr_5900_b64, amr_5900_ref_b64)
  amr_check_fixture("amr_6700", 3, amr_6700_b64, amr_6700_ref_b64)
  amr_check_fixture("amr_7400", 4, amr_7400_b64, amr_7400_ref_b64)
  amr_check_fixture("amr_7950", 5, amr_7950_b64, amr_7950_ref_b64)
  amr_check_fixture("amr_10200", 6, amr_10200_b64, amr_10200_ref_b64)
  amr_check_fixture("amr_12200", 7, amr_12200_b64, amr_12200_ref_b64)
}

///|
test "AMR-NB: DTX and unknown frame types are rejected" {
  // TOC with frame type 8 (DTX/SID) is refused by the float decoder.
  let dtx : Array[Byte] = [b'\x44', b'\x00', b'\x00', b'\x00', b'\x00', b'\x00']
  let dec = @libavcodec.amrnb_decoder_new()
  match dec.decode_frame(Bytes::from_array(dtx)) {
    Ok(_) => fail("DTX must be rejected")
    Err(_) => ()
  }
  // Frame type 15 is no-data; frame type 9-14 are reserved.
  match dec.decode_frame(b"\x7C\x00") {
    Ok(_) => fail("no-data must be rejected")
    Err(_) => ()
  }
  match dec.decode_frame(b"\x4C\x00") {
    Ok(_) => fail("reserved mode must be rejected")
    Err(_) => ()
  }
}
