///|
test "h264 mono pixels: h264_mono_i filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(h264_mono_i_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("h264_mono_i: " + error)
    }
    let expected = if skip { h264_mono_i_unf_md5 } else { h264_mono_i_md5 }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "h264_mono_i skip=\{skip} frame=\{i} poc=\{frame.poc}: \{got} != \{expected[i]}",
        )
      }
    }
  }
}

