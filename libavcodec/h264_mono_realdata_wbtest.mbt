  b"KRCFv1SUlcJn/nDwBcqTp64kKDpq7C////6BmCfUf8VFqI1GNoJ//V1wGb/zi59pxF3Sta8crt7kcPBY+AOvyoxtgRiDlc7Fk8LvhuXjVDDrx9wi" +
  b"2TgWOL1K7BY4y8y9um9iGbyJRKnve4A="

///|
let h264_mono_depth10_md5 : Array[String] = [
  "4b7c89637d80e0cddae05ba6121ac9e1", "1c873bd68b77a2048fd91bfc0b168b46", "33c17a89f84de0c766290c22520331ca",
  "c99a90bf4cbed57aff48a0d043d84342", "77b00f98cb6ac54f1dfca2ba0315902e", "29665406501957b4c2b6fbb62a8a463e",
  "cb09d44d7bdcecc3700e9377c862846d", "4dc0e27f515d262f748e80026b0222af", "af6c42522399b93ee5a9a872930f0739",
  "5158fc10db710e290c5680d35088b68e",
]

///|
let h264_mono_depth10_unf_md5 : Array[String] = [
  "9e67547de136c61773737d5bf96bc3dc", "bdcf18340f2165dd40a4d00c51cfe6c7", "37de9f3051e047809af29066bb39b266",
  "7ff4e72852dcaed96281723970b76ada", "a141b2e8cf4d46b333b2bdf83a1c4d40", "30c5004194c0cadfdab30f738def7f23",
  "06bbe3abb95758529ddc39e1b9a623d9", "650b959f240e69412f337fbcbc4e2b42", "a769c8391901b3d96f976424e56a7e59",
  "4cced2c5ceb82633979e541b2875f8ca",
]

///|
test "h264 mono pixels: h264_mono_depth10 filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(h264_mono_depth10_b64, 1000000).unwrap()
  for skip in [true, false] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("h264_mono_depth10: " + error)
    }
    let expected = if skip {
      h264_mono_depth10_unf_md5
    } else {
      h264_mono_depth10_md5
    }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "h264_mono_depth10 skip=\{skip} frame=\{i} poc=\{frame.poc}: \{got} != \{expected[i]}",
        )
      }
    }
  }
}
