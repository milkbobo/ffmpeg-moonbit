///|
/// Real aptX and aptX HD streams written by ffmpeg 9.0.2 from a
/// deterministic stereo source; references are FFmpeg decodes to s32le.

///|
let aptx_fixtures : Array[(String, Bytes, Bool, String)] = [
  (
    "aptx", b"",
    false, "94f1435cf1c254939f1a262f9e948c2a",
  ),
  (
    "aptx_hd", b"",
    true, "a436a744db4b879933c5292ef1e61d17",
  ),
]

///|
fn aptx_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "aptx: ffmpeg streams decode bit-exactly" {
  for fixture in aptx_fixtures {
    let (name, b64, hd, want_md5) = fixture
    let data = @libavutil.av_base64_decode(b64, 20000).unwrap()
    let audio = match @libavcodec.ff_aptx_decode(data, hd~) {
      Ok(v) => v
      Err(e) => fail("\{name}: decode failed: \{e}")
    }
    assert_eq(audio.samples.length(), 16000, msg=name)
    assert_eq(aptx_md5(audio.pcm_bytes()), want_md5, msg=name)
  }
}
