///|
/// AUTOGENERATED by scripts/aac_mdct_tx_dump.c (FFmpeg 9.0.2 av_tx)
/// inside the ffref oracle image: sum/xor of the f32 bit patterns of
/// every runtime table and of two reference transforms. Do not edit.
/// Original FFmpeg code is LGPL-2.1-or-later.
///
/// Checksum pairs `(sum, xor)` in the order checked below.
let aac_mdct_tx_ref_checks : Array[UInt32] = [
  // sine1024
  0xE715E2C2U, 0x07926F78U,
  // sine128
   0x7D1AE5DCU, 0x073982E4U,
  // cos512
   0x7F188616U, 0x00EB7EC0U,
  // cos256
   0xC06AF51AU, 0x033C98BAU,
  // cos128
   0xE0F3FDB0U, 0x00FA9350U,
  // cos64
   0xF117EEEEU, 0x02DD64A6U,
  // cos32
   0xF90B66F1U, 0x007C5B2FU,
  // cos16
   0xFCE57766U, 0x011A68B8U,
  // cos8
   0x7EB504F3U, 0x00B504F3U,
  // exp1024_re
   0x723506D0U, 0x7E8B3128U,
  // exp1024_im
   0x6DA7F470U, 0x03E94D00U,
  // exp128_re
   0xAFA27579U, 0x0259B1D7U,
  // exp128_im
   0xAC35161CU, 0x7F37343AU,
  // map512
   0x0001FF00U, 0x00000000U,
  // map64
   0x000007E0U, 0x00000000U,
  // vec_long_in
   0xCE1A5A00U, 0x03B09600U,
  // vec_long_out
   0x582BEFB0U, 0x0FECF92AU,
  // vec_short_in
   0x3C42F600U, 0x814CF600U,
  // vec_short_out
   0x7143157DU, 0x8DC3587FU,
  // kbd1024
   0x9683D6D6U, 0x04BDF2EAU,
  // kbd128
   0x31710509U, 0x03C95A49U,
]

///|
/// `(sum, xor)` of the f32 bit patterns, the fingerprint the dumped
/// `aac_mdct_tx_ref_checks` compares against.
fn aac_mdct_tx_checksum(v : Array[Double]) -> (UInt32, UInt32) {
  let mut sum = 0U
  let mut xoro = 0U
  for x in v {
    let bits = Float::from_double(x).reinterpret_as_uint()
    sum = sum + bits
    xoro = xoro ^ bits
  }
  (sum, xoro)
}

///|
/// Same for the int32 tables.
fn aac_mdct_tx_checksum_i(v : Array[Int32]) -> (UInt32, UInt32) {
  let mut sum = 0U
  let mut xoro = 0U
  for x in v {
    let bits = x.reinterpret_as_uint()
    sum = sum + bits
    xoro = xoro ^ bits
  }
  (sum, xoro)
}

///|
/// The LCG the dumper uses for the reference transform inputs.
fn aac_mdct_tx_ref_input(n : Int32, seed : UInt32) -> Array[Double] {
  let out : Array[Double] = Array::make(n, 0.0)
  let mut s = seed
  for i = 0; i < n; i = i + 1 {
    s = s * 1664525U + 1013904223U
    out[i] = mtx_f32(((s >> 8) & 0xFFFFU).to_double() / 32768.0 - 1.0)
  }
  out
}

///|
/// Pins the ported `av_tx` FLOAT MDCT against the oracle: every runtime
/// table and two reference transforms are fingerprinted by the sum/xor of
/// their f32 bit patterns (`aac_mdct_tx_ref_checks`, dumped from the stock
/// library by `scripts/aac_mdct_tx_dump.c`). Transform inputs are regenerated
/// with the dumper's LCG.
test "aac_mdct_tx: runtime tables match the dumped oracle checksums" {
  let tx = AacMdctTx::new()
  let c = aac_mdct_tx_ref_checks
  let (s, x) = aac_mdct_tx_checksum(tx.sine1024)
  assert_eq((s, x), (c[0], c[1]), msg="sine1024 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.sine128)
  assert_eq((s, x), (c[2], c[3]), msg="sine128 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.cos512)
  assert_eq((s, x), (c[4], c[5]), msg="cos512 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.cos256)
  assert_eq((s, x), (c[6], c[7]), msg="cos256 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.cos128)
  assert_eq((s, x), (c[8], c[9]), msg="cos128 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.cos64)
  assert_eq((s, x), (c[10], c[11]), msg="cos64 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.cos32)
  assert_eq((s, x), (c[12], c[13]), msg="cos32 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.cos16)
  assert_eq((s, x), (c[14], c[15]), msg="cos16 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.cos8)
  assert_eq((s, x), (c[16], c[17]), msg="cos8 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.exp1024_re)
  assert_eq((s, x), (c[18], c[19]), msg="exp1024_re checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.exp1024_im)
  assert_eq((s, x), (c[20], c[21]), msg="exp1024_im checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.exp128_re)
  assert_eq((s, x), (c[22], c[23]), msg="exp128_re checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.exp128_im)
  assert_eq((s, x), (c[24], c[25]), msg="exp128_im checksum")
  let (s, x) = aac_mdct_tx_checksum_i(tx.map512)
  assert_eq((s, x), (c[26], c[27]), msg="map512 checksum")
  let (s, x) = aac_mdct_tx_checksum_i(tx.map64)
  assert_eq((s, x), (c[28], c[29]), msg="map64 checksum")
}

///|
/// The KBD windows (`window_shape` 1, §371) against `ff_aac_kbd_long_1024`
/// and `ff_aac_kbd_short_128` as the oracle's `ff_aac_float_common_init`
/// builds them - the alpha-6 short window takes `av_bessel_i0`'s `exp`
/// branch, so this also pins that path's f32 outcome.
test "aac_mdct_tx: KBD windows match the dumped oracle checksums" {
  let tx = AacMdctTx::new()
  let c = aac_mdct_tx_ref_checks
  let (s, x) = aac_mdct_tx_checksum(tx.kbd_long())
  assert_eq((s, x), (c[38], c[39]), msg="kbd1024 checksum")
  let (s, x) = aac_mdct_tx_checksum(tx.kbd_short())
  assert_eq((s, x), (c[40], c[41]), msg="kbd128 checksum")
  assert_true(physical_equal(tx.long_window(1), tx.kbd_long()))
  assert_true(physical_equal(tx.long_window(0), tx.sine_long()))
  assert_true(physical_equal(tx.short_window(1), tx.kbd_short()))
  assert_true(physical_equal(tx.short_window(0), tx.sine_short()))
}

///|
test "aac_mdct_tx: long transform matches the av_tx reference dump" {
  let tx = AacMdctTx::new()
  let c = aac_mdct_tx_ref_checks
  let input = aac_mdct_tx_ref_input(2048, 12345U)
  let (s, x) = aac_mdct_tx_checksum(input)
  assert_eq((s, x), (c[30], c[31]), msg="vec_long_in checksum")
  let out = aac_mdct_tx_1024(tx, input)
  let (s, x) = aac_mdct_tx_checksum(out)
  assert_eq((s, x), (c[32], c[33]), msg="vec_long_out checksum")
}

///|
test "aac_mdct_tx: short transform matches the av_tx reference dump" {
  let tx = AacMdctTx::new()
  let c = aac_mdct_tx_ref_checks
  let input = aac_mdct_tx_ref_input(256, 67890U)
  let (s, x) = aac_mdct_tx_checksum(input)
  assert_eq((s, x), (c[34], c[35]), msg="vec_short_in checksum")
  let out = aac_mdct_tx_128(tx, input)
  let (s, x) = aac_mdct_tx_checksum(out)
  assert_eq((s, x), (c[36], c[37]), msg="vec_short_out checksum")
}
