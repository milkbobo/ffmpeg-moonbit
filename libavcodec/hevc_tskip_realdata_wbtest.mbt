///|
/// Real x265 Annex B HEVC stream with transform skip enabled and FFmpeg 9.0.2
/// per-frame MD5 references. `transform_skip_enabled_flag` is set and x265
/// emits transform-skipped 4x4 luma/chroma blocks (dequant only, no IDCT).
///
/// Generation (docker `linuxserver/ffmpeg:9.0.2`, cwd = this directory):
///
/// ```
/// docker run --rm -v "$PWD:/w" -w /w linuxserver/ffmpeg:9.0.2 -v error ///   -f lavfi -i "testsrc2=duration=0.3:size=320x240:rate=10" -frames:v 3 ///   -c:v libx265 -x265-params "keyint=7:min-keyint=7:bframes=0:tskip=1" ///   -f hevc -y /w/tskip.265
/// docker run --rm -v "$PWD:/w" -w /w linuxserver/ffmpeg:9.0.2 ///   -v error -i /w/tskip.265 -f framemd5 -
/// # unfiltered (`-skip_loop_filter all`) references likewise.
/// ```
///
/// Original FFmpeg code is LGPL-2.1-or-later; this port keeps the same license.

///|
let hevc_tskip_b64 : Bytes = b""

