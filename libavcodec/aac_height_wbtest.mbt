///|
/// AAC PCE height and three-layer layout inference from FFmpeg 9.0.2
/// aacdec.c / aacdec_tab.c. Reference PCM is generated by
/// scripts/generate_aac_height_vectors.py. LGPL-2.1-or-later.
test "aac height: PCE 22.2 top bottom LFE2 and reordered tagged elements match FFmpeg" {
  assert_eq(
    aac_check_layout(aac_height_pce22_b64, aac_height_pce22_pcm_b64, [
      0, 1, 2, 3, 4, 5, 6, 7, 8, 35, 9, 10, 12, 14, 13, 11, 15, 17, 36, 37, 16, 38,
      39, 40,
    ]),
    4,
  )
}

///|
test "aac height: top PCE comment length excludes LFE entries" {
  assert_eq(
    aac_check_layout(aac_height_pce_top_b64, aac_height_pce_top_pcm_b64, [
      0, 1, 2, 3, 4, 5, 12, 14,
    ]),
    4,
  )
}

///|
test "aac height: named top centers sort by whole CPE mask and preserve pair adjacency" {
  assert_eq(
    aac_check_layout(
      aac_height_top_centers_b64,
      aac_height_top_centers_pcm_b64,
      [0, 1, 2, 3, 4, 5, 13, 12, 14, 16, 15, 17],
    ),
    4,
  )
}

///|
test "aac height: reserved height values retain base order like FFmpeg" {
  assert_eq(
    aac_check_layout(aac_height_reserved_b64, aac_height_reserved_pcm_b64, [
      0, 1,
    ]),
    4,
  )
}

///|
test "aac height: indexed configurations 11 to 14 follow the C three-layer maps" {
  let positions = [
    [0, 1, 2, 3, 4, 5, 8],
    [0, 1, 2, 3, 4, 5, 9, 10],
    [
      0, 1, 2, 3, 4, 5, 6, 7, 8, 35, 9, 10, 12, 14, 13, 11, 15, 17, 36, 37, 16, 38,
      39, 40,
    ],
    [0, 1, 2, 3, 4, 5, 12, 14],
  ]
  for config = 11; config <= 14; config = config + 1 {
    assert_eq(
      aac_default_layout(config).unwrap().map(ch => ch.position),
      positions[config - 11],
    )
  }
  let layout = aac_default_layout(13).unwrap()
  assert_eq(layout[0].element_tag, 1) // CPE1 FL/FR, CPE0 FLc/FRc
  assert_eq(layout[6].element_tag, 0)
  assert_eq(layout[14].element_tag, 2) // SCE2 top front center
  assert_eq(layout[9].element_type, 3) // second LFE
  assert_eq(layout[9].element_tag, 1)
}

///|
test "aac height: marker thresholds invalid layer fallback and unsupported named layouts" {
  // A short AC comment is ordinary comment text, with no height syntax.
  let data = aac_test_pce([[1, 0]], [], [], [], comment=b"\xac")
  assert_eq(
    aac_decode_pce(BitReader::new(data)).unwrap().map(ch => ch.position),
    [0, 1],
  )
  // Reserved value 3 disables the whole reordering operation.
  let data = aac_test_pce([[0, 1], [1, 0]], [], [], [], comment=b"\xac\xd0\x00")
  assert_eq(
    aac_decode_pce(BitReader::new(data)).unwrap().map(ch => ch.position),
    [0, 1, 2],
  )
  let data = aac_test_pce([[0, 0]], [], [], [], cc=1, comment=b"\xac\x40\x00")
  assert_eq(
    aac_decode_pce(BitReader::new(data)).unwrap_err(),
    "height PCE with coupling has no supported named layout",
  )
}

///|
test "aac height: truncated PCE comments leave all channel histories unchanged" {
  let data = @libavutil.av_base64_decode(aac_height_pce_top_b64, 16384).unwrap()
  let frame_size = ff_adts_header_parse_buf(data).unwrap().frame_length
  let payload = data.clamped_view(start=7, end=frame_size).to_owned()
  let config = new_mpeg4_audio_config()
  config.sampling_index = 3
  let dec = new_aac_decoder(config, 8)
  for length = 0; length < payload.length(); length = length + 1 {
    assert_true(
      dec.decode_frame(payload.clamped_view(end=length).to_owned()) is Err(_),
    )
    assert_eq(dec.layout.length(), 0)
    assert_eq(dec.state_keys, Array::make(8, -1))
    for state in dec.channels {
      assert_eq(state.prev_window_shape, 0)
      for sample in state.saved {
        assert_eq(sample, 0.0)
      }
    }
  }
}
