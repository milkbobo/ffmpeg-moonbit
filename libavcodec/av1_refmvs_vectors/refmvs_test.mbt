///|
/// `av1_refmvs_find` verified against dav1d 1.5.1 `refmvs.c` over
/// LCG-built spatial/temporal contexts (24 seeds x 14 sizes x 3 ref
/// variants); get_gmv_2d and mv_projection unit vectors included
/// (`scripts/_emit_av1_refmvs_vectors.py`).

///|
fn av1_refmvs_test_rnd(st : Ref[UInt32]) -> UInt32 {
  st.val = st.val * 1664525 + 1013904223
  st.val >> 8
}

///|
fn av1_refmvs_test_inrange(st : Ref[UInt32], hi : Int32) -> Int32 {
  (av1_refmvs_test_rnd(st) % hi.reinterpret_as_uint()).reinterpret_as_int()
}

///|
/// Rebuild one seed's contexts; mirrors dump_refmvs.c build_case.
fn av1_refmvs_test_build(
  seed : Int32,
) -> (
  @libavcodec.Av1Rf,
  FixedArray[FixedArray[@libavcodec.Av1Rb]],
  FixedArray[@libavcodec.Av1Rtb],
  UInt32,
) {
  let st : Ref[UInt32] = Ref(seed.reinterpret_as_uint())
  let sign_bias : FixedArray[Int32] = FixedArray::make(7, 0)
  let pocdiff : FixedArray[Int32] = FixedArray::make(7, 0)
  for i in 0..<7 {
    sign_bias[i] = (av1_refmvs_test_rnd(st) & 1).reinterpret_as_int()
    pocdiff[i] = av1_refmvs_test_inrange(st, 63) - 31
  }
  let invalid = (0x8000, 0x8000)
  let blank : @libavcodec.Av1Rb = {
    ref0: 0,
    ref1: -1,
    bs: 17,
    mf: 0,
    mv0: invalid,
    mv1: invalid,
  }
  let rows = FixedArray::makei(37, _ => FixedArray::make(48, blank))
  for y in 0..<37 {
    let mut x = 0
    while x < 48 {
      let k = av1_refmvs_test_inrange(st, 4)
      if k == 0 {
        let b : @libavcodec.Av1Rb = {
          ref0: 0,
          ref1: -1,
          bs: 17,
          mf: 0,
          mv0: invalid,
          mv1: invalid,
        }
        rows[y][x] = b
        rows[y][x + 1] = b
        x = x + 2
      } else {
        let r0 = 1 + av1_refmvs_test_inrange(st, 7)
        let r1 = if k == 3 { 1 + av1_refmvs_test_inrange(st, 7) } else { -1 }
        let y0 = av1_refmvs_test_inrange(st, 4096) - 2048
        let x0 = av1_refmvs_test_inrange(st, 4096) - 2048
        let y1 = av1_refmvs_test_inrange(st, 4096) - 2048
        let x1 = av1_refmvs_test_inrange(st, 4096) - 2048
        let mf = (av1_refmvs_test_rnd(st) & 3).reinterpret_as_int()
        let b : @libavcodec.Av1Rb = {
          ref0: r0,
          ref1: r1,
          bs: 17,
          mf,
          mv0: (y0, x0),
          mv1: (y1, x1),
        }
        rows[y][x] = b
        rows[y][x + 1] = b
        x = x + 2
      }
    }
  }
  let tblank : @libavcodec.Av1Rtb = { mv: invalid, ref_: 0, }
  let rp = FixedArray::makei(16 * 40, _ => tblank)
  for i in 0..<(16 * 40) {
    if av1_refmvs_test_inrange(st, 4) == 0 {
      rp[i] = { mv: invalid, ref_: 0, }
    } else {
      let y = av1_refmvs_test_inrange(st, 4096) - 2048
      let x = av1_refmvs_test_inrange(st, 4096) - 2048
      let r = 1 + av1_refmvs_test_inrange(st, 7)
      rp[i] = { mv: (y, x), ref_: r, }
    }
  }
  // gmv models matching the dump header: [0] rot-zoom, [3] translation
  let gm_types : FixedArray[Int32] = FixedArray::make(7, 0)
  let gm_mats : FixedArray[FixedArray[Int32]] = FixedArray::makei(7, _ => {
    [0, 0, 65536, 0, 0, 65536]
  })
  gm_types[0] = 2
  gm_mats[0] = [73728, 67584, 64458, 72, -72, 64458]
  gm_types[3] = 1
  gm_mats[3] = [32768, -16384, 65536, 0, 0, 65536]
  let rf : @libavcodec.Av1Rf = {
    iw4: 32,
    ih4: 32,
    sign_bias,
    pocdiff,
    hp: true,
    force_integer_mv: false,
    use_ref_frame_mvs: true,
    gm_types,
    gm_matrices: gm_mats,
  }
  (rf, rows, rp, st.val)
}

