///|
/// Deep snapshot of dav1d's CdfContext. Every adaptive table is owned by
/// the snapshot so tiles and reference slots cannot mutate one another.
/// Generated by scripts/emit_av1_cdf_copy.mbtx from Av1CdfCtx.
pub fn Av1CdfCtx::copy(self : Av1CdfCtx) -> Av1CdfCtx {
  {
    eob_bin_16: self.eob_bin_16.copy(),
    eob_bin_32: self.eob_bin_32.copy(),
    eob_bin_64: self.eob_bin_64.copy(),
    eob_bin_128: self.eob_bin_128.copy(),
    eob_bin_256: self.eob_bin_256.copy(),
    eob_bin_512: self.eob_bin_512.copy(),
