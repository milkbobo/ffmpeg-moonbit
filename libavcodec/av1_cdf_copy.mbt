    br_tok: self.br_tok.copy(),
    eob_hi_bit: self.eob_hi_bit.copy(),
    coef_skip: self.coef_skip.copy(),
    dc_sign: self.dc_sign.copy(),
    uv_mode: self.uv_mode.copy(),
    partition: self.partition.copy(),
    cfl_alpha: self.cfl_alpha.copy(),
    txtp_inter1: self.txtp_inter1.copy(),
    txtp_inter2: self.txtp_inter2.copy(),
    txtp_intra1: self.txtp_intra1.copy(),
    txtp_intra2: self.txtp_intra2.copy(),
    cfl_sign: self.cfl_sign.copy(),
    angle_delta: self.angle_delta.copy(),
    filter_intra: self.filter_intra.copy(),
    seg_id: self.seg_id.copy(),
    pal_sz: self.pal_sz.copy(),
    color_map: self.color_map.copy(),
    txsz: self.txsz.copy(),
    delta_q: self.delta_q.copy(),
    delta_lf: self.delta_lf.copy(),
    restore_switchable: self.restore_switchable.copy(),
    restore_wiener: self.restore_wiener.copy(),
    restore_sgrproj: self.restore_sgrproj.copy(),
    txtp_inter3: self.txtp_inter3.copy(),
    use_filter_intra: self.use_filter_intra.copy(),
    txpart: self.txpart.copy(),
    skip: self.skip.copy(),
    pal_y: self.pal_y.copy(),
    pal_uv: self.pal_uv.copy(),
    intrabc: self.intrabc.copy(),
    y_mode: self.y_mode.copy(),
    wedge_idx: self.wedge_idx.copy(),
    comp_inter_mode: self.comp_inter_mode.copy(),
    filter: self.filter.copy(),
    interintra_mode: self.interintra_mode.copy(),
    motion_mode: self.motion_mode.copy(),
    skip_mode: self.skip_mode.copy(),
    newmv_mode: self.newmv_mode.copy(),
    globalmv_mode: self.globalmv_mode.copy(),
    refmv_mode: self.refmv_mode.copy(),
    drl_bit: self.drl_bit.copy(),
    intra: self.intra.copy(),
    comp: self.comp.copy(),
    comp_dir: self.comp_dir.copy(),
    jnt_comp: self.jnt_comp.copy(),
    mask_comp: self.mask_comp.copy(),
    wedge_comp: self.wedge_comp.copy(),
    ref_: self.ref_.copy(),
    comp_fwd_ref: self.comp_fwd_ref.copy(),
    comp_bwd_ref: self.comp_bwd_ref.copy(),
    comp_uni_ref: self.comp_uni_ref.copy(),
    seg_pred: self.seg_pred.copy(),
