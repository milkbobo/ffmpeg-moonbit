/// MoonBit transcription of the DCA (DTS Coherent Acoustics) tables in
/// FFmpeg 9.0.2 `libavcodec/dcadata.c`, `dcahuff.c`, `dca.c` and
/// `dca_sample_rate_tab.c`, generated by
/// `.scratch/_dca_check/gen_tables.py`. Original FFmpeg code is
/// LGPL-2.1-or-later; this transcription keeps the same license.
///
/// Large tables travel as base64 and are decoded once at startup; the
/// Huffman source tables are `{ symbol, code length }` pairs in the
/// exact order `ff_dca_init_vlcs` consumes them (canonical codes are
/// derived from the lengths at init time).

///|
/// Concatenate base64 chunks into one blob.
fn dca_concat_parts(parts : Array[Bytes]) -> Bytes {
  let out : Array[Byte] = []
  for part in parts {
    for b in part {
      out.push(b)
    }
  }
  Bytes::from_array(out)
}

///|
/// Decode one base64 blob into sign-extended int8 values.
fn dca_decode_i8(parts : Array[Bytes]) -> FixedArray[Int32] {
  let b64 = dca_concat_parts(parts)
  let raw = @libavutil.av_base64_decode(b64, 1 << 20).unwrap()
  let out = FixedArray::make(raw.length(), 0)
  for i = 0; i < raw.length(); i = i + 1 {
    let v = raw[i].to_uint().reinterpret_as_int()
    out[i] = if (v & 0x80) != 0 { v - 0x100 } else { v }
  }
  out
}

///|
/// Decode one base64 blob into little-endian int16 values.
fn dca_decode_i16(parts : Array[Bytes]) -> FixedArray[Int32] {
  let b64 = dca_concat_parts(parts)
  let raw = @libavutil.av_base64_decode(b64, 1 << 20).unwrap()
  let n = raw.length() / 2
  let out = FixedArray::make(n, 0)
  for i = 0; i < n; i = i + 1 {
    let v = raw[i * 2].to_int() | (raw[i * 2 + 1].to_int() << 8)
    // Sign-extend the little-endian 16-bit value.
    out[i] = if (v & 0x8000) != 0 { v - 0x10000 } else { v }
  }
  out
}

///|
/// Decode one base64 blob into little-endian int32 values.
fn dca_decode_i32(parts : Array[Bytes]) -> FixedArray[Int32] {
  let b64 = dca_concat_parts(parts)
  let raw = @libavutil.av_base64_decode(b64, 1 << 20).unwrap()
  let n = raw.length() / 4
  let out = FixedArray::make(n, 0)
  for i = 0; i < n; i = i + 1 {
    let v = raw[i * 4].to_uint() |
      (raw[i * 4 + 1].to_uint() << 8) |
      (raw[i * 4 + 2].to_uint() << 16) |
      (raw[i * 4 + 3].to_uint() << 24)
    out[i] = v.reinterpret_as_int()
  }
  out
}

