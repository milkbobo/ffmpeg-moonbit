///|
/// Tests for HEVC intra prediction, cross-checked against FFmpeg 9.0.2 C DSP
/// (compiled standalone from libavcodec/hevc/pred.c + pred_template.c).
///
/// Reference inputs: top[0]=corner=200, top[i]=(i*37+11)%256 (i>=1);
/// left[0]=150, left[i]=(i*53+7)%256. For each size 4/8/16/32 and modes
/// 0..34 (0 planar, 1 DC with c_idx=0, 2..34 angular) the C sums and the
/// top-left/bottom-right samples are recorded below.

///|
fn hevc_intra_ref_inputs(size : Int32) -> (Array[Int32], Array[Int32]) {
  let top : Array[Int32] = []
  let left : Array[Int32] = []
  for i in 0..<=(2 * size) {
    top.push(if i == 0 { 200 } else { (i * 37 + 11) % 256 })
    left.push(if i == 0 { 150 } else { (i * 53 + 7) % 256 })
  }
  (top, left)
}

///|
fn hevc_intra_check(
  size : Int32,
  sums : Array[Int32],
  firsts : Array[Int32],
  lasts : Array[Int32],
) -> Unit raise {
  let (top, left) = hevc_intra_ref_inputs(size)
  let dst : Array[Int32] = Array::make(size * size, 0)
  for mode in 0..<=34 {
    if mode == 0 {
      hevc_pred_planar(dst, size, size, top, left)
    } else if mode == 1 {
      hevc_pred_dc(dst, size, size, top, left, 0)
    } else {
      hevc_pred_angular(dst, size, size, top, left, 0, mode)
    }
    let mut sum = 0
    for v in dst {
      sum = sum + v
    }
    assert_eq(sum, sums[mode])
    assert_eq(dst[0], firsts[mode])
    assert_eq(dst[size * size - 1], lasts[mode])
  }
}

///|
test "hevc intra: all sizes and modes match FFmpeg C" {
  // size 4
  hevc_intra_check(
    4,
    [
      1792, 1951, 1792, 1872, 1944, 1996, 2056, 2112, 2164, 2204, 2054, 2190, 2123,
      2043, 1940, 1861, 1799, 1644, 1808, 1735, 1837, 1802, 1782, 1779, 1720, 1683,
      1634, 1748, 1888, 2072, 2256, 2412, 2468, 2424, 2368,
    ],
    [
      67, 88, 113, 103, 95, 88, 82, 75, 68, 63, 0, 66, 74, 85, 97, 108, 119, 133,
      200, 172, 148, 129, 110, 91, 72, 58, 3, 50, 54, 58, 63, 68, 72, 78, 85,
    ],
    [
      106, 122, 175, 135, 102, 76, 49, 23, 92, 168, 219, 206, 186, 159, 133, 106,
      80, 83, 200, 86, 62, 80, 99, 117, 136, 150, 159, 168, 182, 201, 219, 206, 96,
      23, 51,
    ],
  )
  // size 8
  hevc_intra_check(
    8,
    [
      8926, 7424, 8192, 8120, 7872, 7824, 8088, 8344, 8376, 7904, 7236, 7466, 7426,
      7455, 7450, 7840, 7912, 7533, 7872, 7697, 8008, 8655, 8307, 8891, 8071, 7603,
      7151, 7360, 7488, 7664, 7840, 8032, 8144, 7992, 7936,
    ],
    [
      67, 85, 113, 103, 95, 88, 82, 75, 68, 63, 0, 66, 74, 85, 97, 108, 119, 133,
      200, 172, 148, 129, 110, 91, 72, 58, 3, 50, 54, 58, 63, 68, 72, 78, 85,
    ],
    [
      158, 116, 87, 136, 197, 144, 91, 38, 177, 202, 175, 149, 109, 56, 67, 206,
      153, 87, 200, 67, 113, 150, 187, 224, 69, 33, 51, 70, 97, 134, 171, 208, 181,
      36, 91,
    ],
  )
  // size 16
  hevc_intra_check(
    16,
    [
      32566, 30720, 34816, 34960, 34480, 34216, 33512, 33152, 32816, 31792, 30549,
      31648, 33322, 31554, 31297, 32326, 32203, 31234, 31744, 30831, 32167, 33533,
      30554, 33728, 31815, 31018, 29892, 30768, 31792, 32952, 32304, 32256, 32688,
      32736, 32768,
    ],
    [
      59, 87, 113, 103, 95, 88, 82, 75, 68, 63, 0, 66, 74, 85, 97, 108, 119, 133,
      200, 172, 148, 129, 110, 91, 72, 58, 3, 50, 54, 58, 63, 68, 72, 78, 85,
    ],
    [
      134, 120, 167, 8, 132, 154, 176, 70, 220, 140, 87, 34, 211, 105, 127, 149,
      43, 166, 200, 122, 215, 33, 107, 181, 127, 54, 91, 128, 184, 130, 76, 150,
      224, 60, 171,
    ],
  )
  // size 32
  hevc_intra_check(
    32,
    [
      176234, 131072, 131840, 133360, 134672, 134776, 134400, 133760, 133152, 135744,
      132608, 132029, 139677, 131532, 133441, 133718, 132764, 128542, 130560, 125050,
      130502, 135764, 122628, 134073, 131505, 128862, 128512, 133824, 133968, 133576,
      134096, 135400, 135624, 137104, 137728,
    ],
    [
      59, 128, 113, 103, 95, 88, 82, 75, 68, 63, 60, 66, 74, 85, 97, 108, 119, 133,
      200, 172, 148, 129, 110, 91, 72, 58, 48, 50, 54, 58, 63, 68, 72, 78, 85,
    ],
    [
      214, 128, 71, 9, 0, 44, 88, 132, 176, 17, 167, 61, 158, 202, 246, 34, 78, 69,
      200, 233, 162, 54, 202, 94, 242, 97, 171, 245, 100, 248, 140, 32, 180, 109,
      75,
