///|
test "h264 frame_num gap: gap_real_mbaff filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(gap_real_mbaff_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("gap_real_mbaff: " + error)
    }
    let expected = if skip {
      gap_real_mbaff_unf_md5
    } else {
      gap_real_mbaff_md5
    }
    assert_eq(frames.length(), 15)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail("gap_real_mbaff skip=\{skip} frame=\{i}: \{got} != \{expected[i]}")
      }
    }
  }
}

