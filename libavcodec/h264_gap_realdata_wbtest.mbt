///|
test "h264 frame_num gap: gap_valid_aging filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(gap_valid_aging_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("gap_valid_aging: " + error)
    }
    let expected = if skip {
      gap_valid_aging_unf_md5
    } else {
      gap_valid_aging_md5
    }
    assert_eq(frames.length(), 6)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "gap_valid_aging skip=\{skip} frame=\{i}: \{got} != \{expected[i]}",
        )
      }
    }
  }
}

