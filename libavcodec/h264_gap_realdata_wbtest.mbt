test "h264 frame_num gap: gap_gray8 filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(gap_gray8_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("gap_gray8: " + error)
