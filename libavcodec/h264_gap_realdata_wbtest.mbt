    let expected = if skip { gap_gray8_unf_md5 } else { gap_gray8_md5 }
    assert_eq(frames.length(), 2)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail("gap_gray8 skip=\{skip} frame=\{i}: \{got} != \{expected[i]}")
      }
    }
  }
}

