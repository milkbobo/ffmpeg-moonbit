///|
test "h264 frame_num gap: gap_idr filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(gap_idr_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("gap_idr: " + error)
    }
    let expected = if skip { gap_idr_unf_md5 } else { gap_idr_md5 }
    assert_eq(frames.length(), 4)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail("gap_idr skip=\{skip} frame=\{i}: \{got} != \{expected[i]}")
      }
    }
  }
}

