]

///|
test "h264 frame_num gap: gap_gray_reorder filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(gap_gray_reorder_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("gap_gray_reorder: " + error)
    }
    let expected = if skip {
      gap_gray_reorder_unf_md5
    } else {
      gap_gray_reorder_md5
    }
    assert_eq(frames.length(), 3)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "gap_gray_reorder skip=\{skip} frame=\{i}: \{got} != \{expected[i]}",
        )
      }
    }
  }
}

