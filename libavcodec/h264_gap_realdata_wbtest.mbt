    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("gap_real_cavlc: " + error)
    }
    let expected = if skip {
      gap_real_cavlc_unf_md5
    } else {
      gap_real_cavlc_md5
    }
    assert_eq(frames.length(), 2)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail("gap_real_cavlc skip=\{skip} frame=\{i}: \{got} != \{expected[i]}")
      }
    }
  }
}

