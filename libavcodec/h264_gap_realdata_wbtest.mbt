///|
let gap_real_cabac_md5 : Array[String] = [
  "b4fb3105bb8ab58dc1205e07761b4c15", "9f6c519fa32828a89177d728d896f4ab", "7e4ebf7f848c30591cde2f6db6f659f5",
  "67b9e4bebc39a8fc3f4a9c59fbf36611", "1a70f9bbd6a8699ca2725b36fec7c8b8",
]

///|
let gap_real_cabac_unf_md5 : Array[String] = [
  "d93049cc5dd366fd84991668f521df31", "c627713f90825bf984ec30ba96293aea", "8e93d6744465d19aa3e31eb88da61168",
  "afe938fa22d1a12d65c5acae77ba4a0d", "bf44f9c9b32607c049b3b71b8b2b25a3",
]

///|
test "h264 frame_num gap: gap_real_cabac filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(gap_real_cabac_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("gap_real_cabac: " + error)
    }
    let expected = if skip {
      gap_real_cabac_unf_md5
    } else {
      gap_real_cabac_md5
    }
    assert_eq(frames.length(), 5)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail("gap_real_cabac skip=\{skip} frame=\{i}: \{got} != \{expected[i]}")
      }
    }
  }
}

