///|
/// rav1e 4:4:4 10-bit keyframes: segmentation plus SWITCHABLE restoration.
/// Expected packed-frame MD5s: libdav1d framemd5 via linuxserver/ffmpeg:9.0.2.
let seg_rav44410_parts : Array[Bytes] = [
  b"",
  b"",
  b"",
  b"",
]

///|
test "av1 rav1e segmentation and switchable restoration match libdav1d" {
  let encoded : Array[Byte] = []
  for part in seg_rav44410_parts {
    for i in 0..<part.length() {
      encoded.push(part[i])
    }
  }
  let ivf = @libavutil.av_base64_decode(Bytes::from_array(encoded[:]), 1048576).unwrap()
  let want = [
    "6d2e878462c1662a0d512bdfe777939f",
    "409f3b3dba66f0ad7d11d913c562ed9d",
    "4697af2a0fe6608f8d665fb11c1265a9",
    "82650ec88b7303f28d4d9e90bbfc5a56",
  ]
  let mut pos = 32
  let mut seq : @libavcodec.Av1SequenceParameters? = None
  let mut frame = 0
  while pos + 12 <= ivf.length() {
    let size = ivf[pos].to_int() | (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16) | (ivf[pos + 3].to_int() << 24)
    let obus = ivf[pos + 12:pos + 12 + size].to_owned()
    pos = pos + 12 + size
    if seq is None {
      match @libavcodec.av1_parse_sequence_header(obus) {
        Ok(s) => seq = Some(s)
        Err(e) => fail(e)
      }
    }
    let s = match seq {
      Some(s) => s
      None => fail("no sequence header")
    }
    let hdr = match @libavcodec.av1_parse_frame_header(obus, s) {
      Ok(h) => h
      Err(e) => fail(e)
    }
    assert_true(hdr.segmentation_enabled)
    let tiles = match @libavcodec.av1_extract_tiles(obus, hdr) {
      Ok(t) => t
      Err(e) => fail(e)
    }
    let out = match @libavcodec.av1_decode_keyframe(s, hdr, tiles[0].data()) {
      Ok(f) => f
      Err(e) => fail(e)
    }
    let digest : FixedArray[Byte] = FixedArray::make(16, b' ')
    let packed = out.packed()
    @libavutil.av_md5_sum(digest, packed, packed.length())
    let digits : Bytes = b"0123456789abcdef"
    let chars : Array[Char] = []
    for i in 0..<16 {
      let v = digest[i].to_uint().reinterpret_as_int()
      chars.push(digits[v >> 4].to_char())
      chars.push(digits[v & 15].to_char())
    }
    assert_eq(String::from_array(chars[:]), want[frame])
    frame += 1
  }
  assert_eq(frame, want.length())
}
