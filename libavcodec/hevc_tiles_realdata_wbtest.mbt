///|
/// Real libkvazaar Annex B HEVC tile stream and FFmpeg 9.0.2 per-frame MD5
/// references. The 320x240 picture is split into 2x2 uniform tiles (5x4 CTBs,
/// 2/3 CTB columns and 2/2 CTB rows); `loop_filter_across_tiles_enabled_flag`
/// is 0, so deblocking and SAO must not cross tile boundaries.
///
/// Generation (docker `linuxserver/ffmpeg:9.0.2`, cwd = this directory):
///
/// ```
/// docker run --rm -v "$PWD:/w" -w /w linuxserver/ffmpeg:9.0.2 -v error ///   -f lavfi -i "testsrc2=duration=0.3:size=320x240:rate=10" -frames:v 3 ///   -pix_fmt yuv420p -c:v libkvazaar -kvazaar-params "tiles=2x2,keyint=7,bframes=0" ///   -f hevc -y /w/tiles.265
/// docker run --rm -v "$PWD:/w" -w /w linuxserver/ffmpeg:9.0.2 ///   -v error -i /w/tiles.265 -f framemd5 -
/// # unfiltered (`-skip_loop_filter all`) references likewise.
/// ```
///
/// Original FFmpeg code is LGPL-2.1-or-later; this port keeps the same license.

///|
let hevc_tiles_b64 : Bytes = b""

///|
let hevc_tiles_filtered_refs : Array[String] = [
  "416dbe27731b1116d281d47966f5b20b", "87d0cfaf2fb9398bf478a4e0922ec546", "ce10bdb5500540644374e7552631b941",
]

///|
let hevc_tiles_unfiltered_refs : Array[String] = [
  "61c165aca4eb7688b2470786b324ddc4", "88e49c708dd6cd9c0f498d73c18901b1", "1e7e618ffe5946877645492df02a1301",
]
