  "a4f98b8cfc7a5d3936d3d6aa8b40c9f5", "840c06cc70b31027054760590805ccbd", "f375f5c47044d9b49906dc32b42abab3",
  "a4f98b8cfc7a5d3936d3d6aa8b40c9f5", "bbaffac56431e683af1ce7e02de5a901", "22c15aa7464463b251cd975626bbcca0",
]

///|
test "h264 PAFF pixels: jm_paff_b_slices filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_slices_b64, 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_slices: " + error)
    }
    let expected = if skip {
      jm_paff_b_slices_unf_md5
    } else {
      jm_paff_b_slices_md5
    }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_slices" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}
