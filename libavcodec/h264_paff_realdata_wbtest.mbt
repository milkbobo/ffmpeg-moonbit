  "3682e0418391bea888788f4d877d05db", "0d85971ee4b96f8eee2a0a231cfc3754", "c0fa3b3856df8569aaf9db8e835689cf",
  "3682e0418391bea888788f4d877d05db", "81550455ad88a6c95c84382e77ae1fea", "da8cb420b65327a6784bd7afafa01a4f",
]

///|
test "h264 PAFF pixels: jm_paff_b_bottom_first filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_bottom_first_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_bottom_first: " + error)
    }
    let expected = if skip {
      jm_paff_b_bottom_first_unf_md5
    } else {
      jm_paff_b_bottom_first_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_bottom_first" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

