let jm_paff_mixed_spatial_unf_md5 : Array[String] = [
  "8203a5f08b1303b6fef718c6f5d3b1d6", "7b229b409d59ed1c2bcb1779deea4f18", "15b24bab237f76cb9bb18e9bcdd8a6cd",
  "f020cd21dd0dd6a8c8c43d9f076353b3", "ad864403c299d62765295b57e62b9d00", "5b92c6f29d48eb06bfa74116d3ee1de5",
  "f66e68aafd6563e179a75cea00225503", "58a025629a89fa9a59aac1ba0120ace3", "056a6b5b7948903a07ce1af377c2bb12",
  "f020cd21dd0dd6a8c8c43d9f076353b3", "67be30fab1cade93df0dc09337e54acc", "6e1b37f3381c8a5d1052e8e826f35011",
]

///|
test "h264 PAFF pixels: jm_paff_mixed_spatial filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_mixed_spatial_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_mixed_spatial: " + error)
    }
    let expected = if skip {
      jm_paff_mixed_spatial_unf_md5
    } else {
      jm_paff_mixed_spatial_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_mixed_spatial" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

