///|
let jm_paff_b_temporal_cabac_unf_md5 : Array[String] = [
  "9a0547566d6048c81dbbec0f9b0eff0d", "9cc6dd45c233f4e53ea5385630def69b", "abf853acb10d1da31cfce614baf5a8b4",
  "bbce5222762962c0cc4ebf755625c69e", "0a7f61d911054b2050163e842c440675", "32ad711a28f3f47a2ea106d27ae98c0b",
  "bbce5222762962c0cc4ebf755625c69e", "eb7f0d5f2b9c2f7b59169e073bf65828", "238d30dddaf41a0da38be7e1838beff5",
  "bbce5222762962c0cc4ebf755625c69e", "4b26a513045ce251b7b0f34f0a9ce0c9", "00bf4f14215d8f4b9a367fb76ca39a31",
]

///|
test "h264 PAFF pixels: jm_paff_b_temporal_cabac filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(
    jm_paff_b_temporal_cabac_b64(),
    1000000,
  ).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_temporal_cabac: " + error)
    }
    let expected = if skip {
      jm_paff_b_temporal_cabac_unf_md5
    } else {
      jm_paff_b_temporal_cabac_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_temporal_cabac" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

