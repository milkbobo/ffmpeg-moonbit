  "bbce5222762962c0cc4ebf755625c69e", "8e16d9d4f3d4763ff01a80f86265fdea", "6b1c9a6a2b2d5f18157ec41eff029c1e",
  "bbce5222762962c0cc4ebf755625c69e", "7cce18b63b9ad08ab1b1941becc13962", "00bf4f14215d8f4b9a367fb76ca39a31",
]

///|
test "h264 PAFF pixels: jm_paff_b_cabac filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_cabac_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_cabac: " + error)
    }
    let expected = if skip {
      jm_paff_b_cabac_unf_md5
    } else {
      jm_paff_b_cabac_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_cabac" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

