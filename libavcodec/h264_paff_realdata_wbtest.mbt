let jm_paff_b_mono_unf_md5 : Array[String] = [
  "c7287b6ca26ccd075d4ccac9b892ad12", "32ca6f8716fbd08bfc6184fc541ce05e", "ecbfbcde31169ce4bd49dc61ed1fff36",
  "fc194768e974b2cf5ca46079a933d510", "f4eeadc6765d15b0752259033aae42f3", "1b71778fd3353c48f42c57d580524734",
  "fc194768e974b2cf5ca46079a933d510", "3750abff9c4f6a358ce6c484325881f2", "62a25ab8bf34ab10fbd932507db4f92a",
  "fc194768e974b2cf5ca46079a933d510", "bb9a042c542d7a5f8c23c0508440d76b", "f3842a9029627b5a1ff2b614796ceaf8",
]

///|
test "h264 PAFF pixels: jm_paff_b_mono filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_mono_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_mono: " + error)
    }
    let expected = if skip {
      jm_paff_b_mono_unf_md5
    } else {
      jm_paff_b_mono_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_mono" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

