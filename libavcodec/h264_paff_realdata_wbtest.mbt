  "2fe2bf520f724235b476dafef5d42d0a", "c312fd63fc6ec9aaffc03ef88d116f1e", "35e3143af5fad4661524225ba881856a",
  "2fe2bf520f724235b476dafef5d42d0a", "f9a25d236868087d7eabe442737dfad6", "f7751817b16a13ef74e1837f440f21ad",
]

///|
test "h264 PAFF pixels: jm_paff_b_12 filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_12_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_12: " + error)
    }
    let expected = if skip { jm_paff_b_12_unf_md5 } else { jm_paff_b_12_md5 }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_12" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

