  "9349a15a0679fa58a5a54792f22da513", "21ad28136e1a07a889c5bd57f94727f9", "2c3438af99ecbd3d88a3589a2823b98d",
  "dc896514fe8ab03adf9be08de74a1be2", "f734deb5e77c554a6524bba0041bc3e8", "199a655e7e76cc26da833b877030d2bf",
  "dc896514fe8ab03adf9be08de74a1be2", "42aad772c4e50380f55cac520e4b1ab5", "b99e4f1ef068cab28b4df7933876fb99",
  "dc896514fe8ab03adf9be08de74a1be2", "1e47e8617b68eb8c67c026749f764ef2", "7f7da29a21e944bcefb6a9c0bc3b9f85",
]

///|
let jm_paff_b_slices_unf_md5 : Array[String] = [
  "cf06e779892d588f3ce84cd6875da02c", "bb389fd2f68a43435964b8600239ba17", "5cf8164d75b406e621741f29d89f8e1d",
  "a4f98b8cfc7a5d3936d3d6aa8b40c9f5", "a5c260d0166df33b8c710cc7e77292cb", "5b2aecd90f1f10161899cc346f7a9c3e",
  "a4f98b8cfc7a5d3936d3d6aa8b40c9f5", "840c06cc70b31027054760590805ccbd", "f375f5c47044d9b49906dc32b42abab3",
  "a4f98b8cfc7a5d3936d3d6aa8b40c9f5", "bbaffac56431e683af1ce7e02de5a901", "22c15aa7464463b251cd975626bbcca0",
]

///|
test "h264 PAFF pixels: jm_paff_b_slices filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_slices_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_slices: " + error)
    }
    let expected = if skip {
      jm_paff_b_slices_unf_md5
    } else {
      jm_paff_b_slices_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_slices" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

