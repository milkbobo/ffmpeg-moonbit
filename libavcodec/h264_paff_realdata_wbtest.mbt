]

///|
test "h264 PAFF pixels: jm_paff_b_444 filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_444_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_444: " + error)
    }
    let expected = if skip { jm_paff_b_444_unf_md5 } else { jm_paff_b_444_md5 }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_444" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

