  "b9b3b7a4a44d3726da868bdb6bac9dd7", "ddd6be8765db9f05aa7a5759cb52f05b", "52a7481b283b113b5af63acc351f21e1",
  "e82d74bb2f3a8adf33be9d31f33fdc22", "cbb93564a2b3d891ad0787bd4460a1a1", "7acc1600f1c19e55694919e9104c9593",
  "516d5f2dd18eea264342b8bc569f838a", "77c915c74f2c1e946d9e8eef627a3f49", "3d80f2f3d96b6c80bc55c8b755f4fb93",
  "3d5858336cdeb1dd5a6c701ed345a4a5", "d9827238502bff212109d12a51560ed3", "d1320da3d0bf7c81287ee0ce40ac13ba",
]

///|
test "h264 PAFF pixels: jm_paff_p_poc2 filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_p_poc2_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_p_poc2: " + error)
    }
    let expected = if skip {
      jm_paff_p_poc2_unf_md5
    } else {
      jm_paff_p_poc2_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_p_poc2" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

