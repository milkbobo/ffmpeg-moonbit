  "6bb1d29d5c511cfcf8ecb49d7351592b", "57095b953d5736bed7ef9d2f7d466e27", "7a7bb7bacb63491be4b2cfd47bbe30aa",
  "6bb1d29d5c511cfcf8ecb49d7351592b", "c340fcafc35e81d8445963fc46cf727b", "8730440013da39288da88f43513931eb",
]

///|
test "h264 PAFF pixels: jm_paff_b_cavlc filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_cavlc_b64, 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_cavlc: " + error)
    }
    let expected = if skip {
      jm_paff_b_cavlc_unf_md5
    } else {
      jm_paff_b_cavlc_md5
    }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_cavlc" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

