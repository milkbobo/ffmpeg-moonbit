///|
let jm_paff_b_422_unf_md5 : Array[String] = [
  "7facaf070e34cc70aad086be02ca9041", "57b030dcb973f43c0e893757a5af04fd", "02b0568d9969d128db6072572f40acd8",
  "ca8530055f40474d05b7a459ccf84445", "05f3043406f366969bb694b241b60b94", "c8a5d67a10ed1c4976ec0ef542a22ecf",
  "ca8530055f40474d05b7a459ccf84445", "8c10789ce508285550b0806462add3f2", "a0a0d18a016ff888fee0de145979ef14",
  "ca8530055f40474d05b7a459ccf84445", "3003be3557ede2f339fbaf7a470f078d", "12ada91ed9d0d3ccae9733dffc0611b7",
]

///|
test "h264 PAFF pixels: jm_paff_b_422 filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_422_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_422: " + error)
    }
    let expected = if skip { jm_paff_b_422_unf_md5 } else { jm_paff_b_422_md5 }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_422" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

