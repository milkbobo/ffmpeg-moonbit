///|
test "h264 PAFF pixels: jm_paff_b_10_cavlc filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_10_cavlc_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_10_cavlc: " + error)
    }
    let expected = if skip {
      jm_paff_b_10_cavlc_unf_md5
    } else {
      jm_paff_b_10_cavlc_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_10_cavlc" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

