  "97e5d4760f2c8941b620991406e92629", "512bd4a0a808f399c209df930c07de08", "ca06be543cf4c4616e624793a93b1dd6",
  "c2dc2033f37baa04b40594ab34d0e36c", "a7c248ad8f80524bfe5096e1d332554e", "27c432e795d009ab87ec5bfdb805b9d5",
]

///|
test "h264 PAFF pixels: jm_paff_p_cavlc filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_p_cavlc_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_p_cavlc: " + error)
    }
    let expected = if skip {
      jm_paff_p_cavlc_unf_md5
    } else {
      jm_paff_p_cavlc_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 6)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_p_cavlc" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

