  "c5115a7c072df4ed9072319693d8005a", "fd26054bf33b589cab32773134434429", "2ac740c24e0fef68e270e1aa6c0b1234",
  "6b75b3f81fbe467613b6d187e189197b", "2d29ac0248a4b4cfe2d444bebf7de664", "698a8c5287f2df38f637eef38e020aea",
  "6b75b3f81fbe467613b6d187e189197b", "f00b67095994475d986d6aa697b1e912", "a590eaed48fca98047eb3282994c22a2",
  "6b75b3f81fbe467613b6d187e189197b", "03a1922a5970c9cf7a05feb02c0c4acd", "bc5ff24299e3682e1b4e080eea915998",
]

///|
test "h264 PAFF pixels: jm_paff_b_444_10 filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_444_10_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_444_10: " + error)
    }
    let expected = if skip {
      jm_paff_b_444_10_unf_md5
    } else {
      jm_paff_b_444_10_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_444_10" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}
