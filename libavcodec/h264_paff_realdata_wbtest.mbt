///|
let jm_paff_mixed_temporal_unf_md5 : Array[String] = [
  "e591a348c15701ac1e72ebefe84d749b", "47a71c3cc3ee39a6178bd83232ce5cea", "c3a3b0f8522a7787b1863d6dddc23667",
  "85d84078016fc5d249da902276159429", "ea0c57055b0235191e7f4af56efc2c5a", "57611e62df4cad573f255700be2f6e24",
  "97a1ee1e39d1beee5533dbc2e877ddff", "2196de5b2c515b86d5f6e494f3df9f95", "de7de4400297a3edc20dbb020ba43be8",
  "759ab7b247dad1c3b9c7be65a6efe007", "bfc3989f0d61bd2f2bd1285e3cc90e2a", "698591de707c713fd7e81d9051f805b8",
]

///|
test "h264 PAFF pixels: jm_paff_mixed_temporal filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_mixed_temporal_b64(), 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_mixed_temporal: " + error)
    }
    let expected = if skip {
      jm_paff_mixed_temporal_unf_md5
    } else {
      jm_paff_mixed_temporal_md5
    }
    assert_eq(frames.length(), expected.length())
    assert_eq(frames.length(), 12)
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_mixed_temporal" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

