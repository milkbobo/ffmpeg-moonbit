let jm_paff_p_cabac_md5 : Array[String] = [
  "87a1e24d15036c363492e4e8743ea44a", "9acbd563556569d7179e81525e3033bd", "db1c61c97ce473733d14d37985088b0e",
]

///|
let jm_paff_p_cabac_unf_md5 : Array[String] = [
  "b9b3b7a4a44d3726da868bdb6bac9dd7", "ddd6be8765db9f05aa7a5759cb52f05b", "52a7481b283b113b5af63acc351f21e1",
]

///|
test "h264 PAFF pixels: jm_paff_p_cabac filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_p_cabac_b64, 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_p_cabac: " + error)
    }
    let expected = if skip {
      jm_paff_p_cabac_unf_md5
    } else {
      jm_paff_p_cabac_md5
    }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_p_cabac" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

