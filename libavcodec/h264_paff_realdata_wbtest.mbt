  "4a0f0819322992f521c6ac770347dba1", "f678f59c61d2a6071053ccd318058a25", "fd0615d7fec16f4d2d85393a188b8a92",
  "6bb1d29d5c511cfcf8ecb49d7351592b", "5d41d2311355934212fa3925c24ebb5d", "c8b4ca28b8da7664cb0bc714dbd5b4c2",
  "6bb1d29d5c511cfcf8ecb49d7351592b", "11646313b931bed5c489e1c3dc9c195d", "e2ea0bd1ea3d54c8bf7f2749f93c045e",
  "6bb1d29d5c511cfcf8ecb49d7351592b", "27da40f62a6dfec90cda73813d0fea23", "8730440013da39288da88f43513931eb",
]

///|
test "h264 PAFF pixels: jm_paff_b_temporal_cavlc filtered/unfiltered" {
  let data = @libavutil.av_base64_decode(jm_paff_b_temporal_cavlc_b64, 1000000).unwrap()
  for skip in [false, true] {
    let frames = match h264_decode_annexb_display_frames(data, skip) {
      Ok(value) => value
      Err(error) => fail("jm_paff_b_temporal_cavlc: " + error)
    }
    let expected = if skip {
      jm_paff_b_temporal_cavlc_unf_md5
    } else {
      jm_paff_b_temporal_cavlc_md5
    }
    assert_eq(frames.length(), expected.length())
    for i, frame in frames {
      let got = h264_yuv_md5(frame)
      if got != expected[i] {
        fail(
          "jm_paff_b_temporal_cavlc" +
          (if skip { " unf" } else { " filt" }) +
          " frame " +
          i.to_string() +
          " got " +
          got +
          " exp " +
          expected[i],
        )
      }
    }
  }
}

