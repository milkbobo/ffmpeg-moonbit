///|
/// Real WavPack fixtures written by ffmpeg 9.0.2 (`-c:a wavpack`) from the
/// deterministic 8 kHz sources plus a 44.1 kHz 32-bit FLAC source. The
/// references are FFmpeg decodes to s16le/s32le.

///|
let wavpack_fixtures : Array[
  (String, Bytes, Int32, Int32, Int32, Int32, String),
] = [
  // s16_stereo
  (
    "s16_stereo",
    b"" +
    b"",
    8000,
    2,
    16,
    20000,
    "a7e2b29654ceeba8f06a3c71151c6f33",
  ),
  // s16_mono
  (
    "s16_mono", b"",
    8000, 1, 16, 16718, "793c16dbb267f097863dfb4ed31af572",
  ),
  // s24_stereo
  (
    "s24_stereo",
    b"" +
    b"",
    8000,
    2,
    32,
    20000,
    "322c025b332b30e4de9ab0a987169cea",
  ),
  // s32_stereo
  (
    "s32_stereo", b"",
    44100, 2, 32, 8820, "4f632c4c409a0a2ccfc0ab5a294dae98",
  ),
]

///|
fn wavpack_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
test "wavpack: ffmpeg fixtures decode bit-exactly" {
  for fixture in wavpack_fixtures {
    let (name, b64, rate, channels, bits, count, want_md5) = fixture
    let data = @libavutil.av_base64_decode(b64, 600000).unwrap()
    let audio = match @libavcodec.ff_wavpack_decode(data) {
      Ok(v) => v
      Err(e) => fail("\{name}: decode failed: \{e}")
    }
    assert_eq(audio.sample_rate, rate, msg=name)
    assert_eq(audio.channels, channels, msg=name)
    assert_eq(audio.bits, bits, msg=name)
    assert_eq(audio.samples.length(), count * channels, msg=name)
    assert_eq(wavpack_md5(audio.pcm_bytes()), want_md5, msg=name)
  }
}
