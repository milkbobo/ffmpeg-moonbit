///|
/// VP9 alt-ref stream generated with libvpx `-auto-alt-ref 1`
/// (`testsrc2=size=64x48:rate=30` gray), 64x48 8-bit 4:2:0, 21 packets:
/// 1 keyframe + 20 alt-ref/inter frames.  Expected values are the reference
/// decoder's per-frame MD5s (`ffmpeg -f ivf -i vp9_alt.ivf -f framemd5`).
/// Also asserts the diagnostic counter: with this encoder configuration
/// every inter frame uses single-reference prediction (`comp_pred_mode` 0),
/// so compound-prediction blocks never occur.
///
/// Original FFmpeg code is LGPL-2.1-or-later; the vector is libre test data.

///|
/// base64 of the IVF file (17953 bytes).
let vp9_altref_stream_b64 : Bytes = b""

///|
let vp9_altref_md5 : Array[String] = [
  "da087eb6e453f1d0e6f7c692bda0a218", "1afead67cbe40f211c2e2df58a01fd37", "a4d7800fea8648c8886e4433f8faf3eb",
  "ec0b6195e0955a1e130167daf7b87708", "8e752d94047cf7c20c0b0eb2072aa401", "c62c03af84ee32601e049793232912fa",
  "d33e4977bbae357427b0da99615fddaf", "79152ed59c4027c3f4a583d52c1368c8", "09ad326ea5cd65b5497e910a5f352413",
  "55de2797d76570119a75e9ec5c2d1547", "2f93fd2b3ec8346ba6b3d0eefd79c5a2", "1aaa0fac699b3c831f125a7b907584c1",
  "79eeda81c7a73e2132853d97a34ca1ca", "ef69816de190098c387b068a712d0170", "db3cee2f6a8e2b9f93b8dcaa214b2972",
  "a5b0ff7e513f8cc391d30970fc2aa4a9", "b49e13629fa95ef5ba4617e2ff8b120b", "1648da9030a189b312955ec62d8a02f9",
  "f08cd983dee1c71f8d13e3d94eef4d17", "218f683d00bd47b46a7a06d29590268b", "d6a1d9c5f101f2d47232c45c7b82f028",
]

///|
fn vp9_altref_hex(bytes : FixedArray[Byte], n : Int32) -> String {
  let digits : Bytes = b"0123456789abcdef"
  let chars : Array[Char] = []
  for i = 0; i < n; i = i + 1 {
    let v = bytes[i].to_uint().reinterpret_as_int()
    chars.push(digits[(v >> 4) & 0xF].to_char())
    chars.push(digits[v & 0xF].to_char())
  }
  String::from_array(chars[:])
}

///|
test "vp9 altref: 21 frames match ffmpeg and use no compound prediction" {
  let ivf = @libavutil.av_base64_decode(vp9_altref_stream_b64, 1000000).unwrap()
  let dec = @libavcodec.vp9_decoder_new()
  let mut pos = 32
  let mut i = 0
  while pos + 12 <= ivf.length() {
    let sz = ivf[pos].to_int() |
      (ivf[pos + 1].to_int() << 8) |
      (ivf[pos + 2].to_int() << 16) |
      (ivf[pos + 3].to_int() << 24)
    if sz < 0 || pos + 12 + sz > ivf.length() {
      break
    }
    let pkt = ivf[pos + 12:pos + 12 + sz].to_owned()
    pos = pos + 12 + sz
    match dec.decode_packet(pkt) {
      Ok(fs) =>
        for _ in 0..<fs.length() {
          let yuv = dec.frame_bytes()
          let digest = FixedArray::make(16, b'␀')
          @libavutil.av_md5_sum(digest, yuv, yuv.length())
          let hex = vp9_altref_hex(digest, 16)
          assert_eq(hex, vp9_altref_md5[i])
          i = i + 1
        }
      Err(e) => fail("packet \{i}: \{e}")
    }
  }
  assert_eq(i, 21)
  // libvpx -auto-alt-ref never emits compound-prediction blocks here.
  assert_eq(dec.comp_inter_blocks, 0)
}
