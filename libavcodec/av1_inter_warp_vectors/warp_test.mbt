  let actual : Array[Int32] = []
  for i in 0..<96 {
    let rows = av1_warp_test_rows(seeds[i])
    let bx4 = cfg[i * 12 + 0]
    let by4 = cfg[i * 12 + 1]
    let bw4 = cfg[i * 12 + 2]
    let bh4 = cfg[i * 12 + 3]
    let w4 = cfg[i * 12 + 4]
    let h4 = cfg[i * 12 + 5]
    let have_left = cfg[i * 12 + 6] != 0
    let have_top = cfg[i * 12 + 7] != 0
    let top_right = cfg[i * 12 + 8] != 0
    let ref_ = cfg[i * 12 + 9]
    let mvy = cfg[i * 12 + 10]
    let mvx = cfg[i * 12 + 11]
    let (mask0, mask1) = @libavcodec.av1_inter_find_matching_ref(
      rows, bx4, by4, bw4, bh4, w4, h4, have_left, have_top, top_right, 64, ref_,
    )
    assert_eq(mask0, exp_m0[i])
    assert_eq(mask1, exp_m1[i])
    if (mask0 | mask1) != 0UL {
      let r = @libavcodec.av1_inter_derive_warpmv(
        rows,
        bx4,
        by4,
        bw4,
        bh4,
        mask0,
        mask1,
        (mvy, mvx),
      )
      actual.push(r.typ)
      for j in 0..<6 {
        actual.push(r.matrix[j])
      }
      actual.push(r.alpha)
      actual.push(r.beta)
      actual.push(r.gamma)
      actual.push(r.delta)
    } else {
      actual.push(-1)
      for _ in 0..<10 {
        actual.push(0)
      }
    }
  }
  assert_eq(actual, expected)
}
