  let expected : Array[Int32] = []
  let actual : Array[Int32] = []
  for i in 0..<64 {
    let np = data[i * 46]
    let pts : FixedArray[Int32] = FixedArray::makei(32, j => {
      data[i * 46 + 1 + j]
    })
    let bw4 = data[i * 46 + 33]
    let bh4 = data[i * 46 + 34]
    let mvy = data[i * 46 + 35]
    let mvx = data[i * 46 + 36]
    let bx4 = data[i * 46 + 37]
    let by4 = data[i * 46 + 38]
    let wm = @libavcodec.av1_warpmv_default()
    let ret = @libavcodec.av1_warpmv_find_affine_int(
      pts,
      np,
      bw4,
      bh4,
      (mvy, mvx),
      bx4,
      by4,
      wm,
    )
    actual.push(if ret { 1 } else { 0 })
    for j in 0..<6 {
      actual.push(wm.matrix[j])
    }
    for j in 39..<46 {
      expected.push(data[i * 46 + j])
    }
  }
  assert_eq(actual, expected)
}

