  let expected : Array[Int32] = []
  let actual : Array[Int32] = []
  for i in 0..<64 {
    let wm = @libavcodec.av1_warpmv_default()
    for j in 0..<6 {
      wm.matrix[j] = data[i * 11 + j]
    }
    let invalid = @libavcodec.av1_warpmv_get_shear_params(wm)
    actual.push(if invalid { 1 } else { 0 })
    actual.push(wm.alpha)
    actual.push(wm.beta)
    actual.push(wm.gamma)
    actual.push(wm.delta)
    for j in 6..<11 {
      expected.push(data[i * 11 + j])
    }
  }
  assert_eq(actual, expected)
}

