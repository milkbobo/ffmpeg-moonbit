    2, 2,
  ]
  // The C probe adapts one CdfContext across both LCG seeds.
  let cdf = @libavcodec.av1_cdf_copy_defaults(0)
  for s in 0..<2 {
    let stream = av1_txtree_lcg_bytes(seeds[s], 8192)
    for i in 0..<128 {
      let k = s * 128 + i
      let bs = cfg[k * 9]
      let a_tx = FixedArray::make(32, 0)
      let l_tx = FixedArray::make(32, 0)
      for j in 0..<32 {
        a_tx[j] = (j * 3 + bs) % 5
        l_tx[j] = (j * 5 + i % 8) % 5
      }
      let msac = @libavcodec.Av1Msac::init(
        av1_txtree_slice(stream, i * 13),
        false,
      )
      let r = @libavcodec.av1_read_vartx_tree(
        msac,
        cdf,
        bs,
        cfg[k * 9 + 1] != 0,
        cfg[k * 9 + 2] != 0,
        cfg[k * 9 + 3] != 0,
        cfg[k * 9 + 4],
        a_tx,
        l_tx,
        cfg[k * 9 + 5],
        cfg[k * 9 + 6],
        cfg[k * 9 + 7],
        cfg[k * 9 + 8],
      )
      if r.max_ytx != exp_max[k] ||
        r.uvtx != exp_uv[k] ||
        r.split0.reinterpret_as_int() != exp_s0[k] ||
        r.split1.reinterpret_as_int() != exp_s1[k] {
        fail(
          "txtree k " +
          k.to_string() +
          " cfg " +
          cfg[k * 9].to_string() +
          " " +
          cfg[k * 9 + 1].to_string() +
          " " +
          cfg[k * 9 + 2].to_string() +
          " " +
          cfg[k * 9 + 3].to_string() +
          " " +
          cfg[k * 9 + 4].to_string() +
          ": " +
          r.max_ytx.to_string() +
          "/" +
          r.uvtx.to_string() +
          "/" +
          r.split0.reinterpret_as_int().to_string() +
          "/" +
          r.split1.reinterpret_as_int().to_string() +
          " != " +
          exp_max[k].to_string() +
          "/" +
          exp_uv[k].to_string() +
          "/" +
          exp_s0[k].to_string() +
          "/" +
          exp_s1[k].to_string(),
        )
      }
      assert_eq(msac.rng.reinterpret_as_int(), exp_rng[k])
      assert_eq((msac.dif >> 32).reinterpret_as_int64(), exp_dif[k])
      for j in 0..<32 {
        if a_tx[j] != exp_a[k * 32 + j] || l_tx[j] != exp_l[k * 32 + j] {
          fail(
            "txtree ctx k " +
            k.to_string() +
            " j " +
            j.to_string() +
            ": a " +
            a_tx[j].to_string() +
            "/" +
            l_tx[j].to_string() +
            " != " +
            exp_a[k * 32 + j].to_string() +
            "/" +
            exp_l[k * 32 + j].to_string(),
          )
        }
      }
    }
  }
}
