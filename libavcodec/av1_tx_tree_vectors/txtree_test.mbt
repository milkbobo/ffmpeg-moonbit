///|
/// Inter transform-tree partitioning verified against dav1d 1.5.1
/// `read_vartx_tree`/`read_tx_tree` over LCG byte streams: `txpart`
/// symbols, split masks and the `tx` neighbour context updates
/// (`scripts/_emit_av1_txtree_vectors.py`).

///|
fn av1_txtree_lcg_bytes(seed : UInt32, n : Int32) -> Bytes {
  let mut state = seed
  let out : Array[Byte] = []
  for _ in 0..<n {
    state = state * 1664525 + 1013904223
    out.push(((state >> 16) & 0xff).reinterpret_as_int().to_byte())
  }
  Bytes::from_array(out)
}

///|
/// Each fixture case decodes from `buf + i * 13`, so the test slices
/// the LCG stream before handing it to the range decoder.
fn av1_txtree_slice(src : Bytes, start : Int32) -> Bytes {
  let out : Array[Byte] = []
  for i in start..<src.length() {
    out.push(src[i])
  }
  Bytes::from_array(out)
}

