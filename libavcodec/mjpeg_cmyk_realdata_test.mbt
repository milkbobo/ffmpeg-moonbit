///|
/// ImageMagick CMYK JPEG (17x13, 4 components 1x1) decoded through the Adobe
/// APP14 transform paths: transform 2 (YCCK) -> yuva444p and transform 0
/// (CMYK) -> gbrap, byte-identical to `ffmpeg -f rawvideo` for the same
/// files.

///|
let jpeg_cmyk_t2_b64 : Bytes = b""

///|
let jpeg_cmyk_t0_b64 : Bytes = b""

///|
fn mjpeg_cmyk_md5(data : Bytes) -> String {
  let digest = FixedArray::make(16, b'\x00')
  @libavutil.av_md5_sum(digest, data, data.length())
  let hex = "0123456789abcdef"
  let text = StringBuilder()
  for byte in digest {
    text.write_char(hex.get_char((byte.to_int() >> 4) & 15).unwrap())
    text.write_char(hex.get_char(byte.to_int() & 15).unwrap())
  }
  text.to_string()
}

///|
fn mjpeg_cmyk_check(
  encoded : Bytes,
  pix_fmt : String,
  reference : String,
) -> Unit raise {
  let bytes = @libavutil.av_base64_decode(encoded, 10000).unwrap()
  let img = match @libavcodec.av_mjpeg_decode(bytes) {
    Ok(v) => v
    Err(e) => fail("decode: \{e}")
  }
  assert_eq(img.width, 17)
  assert_eq(img.height, 13)
  assert_eq(img.pix_fmt, pix_fmt)
  assert_eq(img.planes.length(), 4)
  let planes : Array[Byte] = []
  for p in img.planes {
    assert_eq(p.length(), 17 * 13)
    for b in p {
      planes.push(b)
    }
  }
  assert_eq(mjpeg_cmyk_md5(Bytes::from_array(planes)), reference, msg=pix_fmt)
}

///|
test "mjpeg: CMYK and YCCK 4-component match ffmpeg" {
  mjpeg_cmyk_check(
    jpeg_cmyk_t2_b64, "yuva444p", "af5279d0431426b8a115004ccb2ea1f1",
  )
  mjpeg_cmyk_check(
    jpeg_cmyk_t0_b64, "gbrap", "9718a46965a8f9486f1ea7ffda6d3583",
  )
}

///|
let jpeg_cmyk_sub_t2_b64 : Bytes = b""

///|
let jpeg_cmyk_sub_t0_b64 : Bytes = b""

///|
test "mjpeg: subsampled CMYK upscales to 4:4:4 like ffmpeg" {
  mjpeg_cmyk_check(
    jpeg_cmyk_sub_t2_b64, "yuva444p", "1754acfb95e8a3aee9bcd6d433294cc2",
  )
  mjpeg_cmyk_check(
    jpeg_cmyk_sub_t0_b64, "gbrap", "df26a976fa3aec66d9d762a9aad1fdaf",
  )
}

///|
let jpeg_cmyk_prog_t2_b64 : Bytes = b""

///|
let jpeg_cmyk_prog_t0_b64 : Bytes = b""

///|
test "mjpeg: progressive CMYK matches the sequential decode" {
  mjpeg_cmyk_check(
    jpeg_cmyk_prog_t2_b64, "yuva444p", "af5279d0431426b8a115004ccb2ea1f1",
  )
  mjpeg_cmyk_check(
    jpeg_cmyk_prog_t0_b64, "gbrap", "9718a46965a8f9486f1ea7ffda6d3583",
  )
}
